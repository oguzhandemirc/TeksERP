// =============================================================================
// TeksERP satıcı sunucusu — Prisma şeması
// =============================================================================
// Çekirdek kurallar burada da geçerli (kök CLAUDE.md):
//   - PK: UUID; her DateTime timestamptz; UUID kolon @db.Uuid.
//   - Durum tabloları "şu an ne", defterler "ne oldu" — defter satırı DEĞİŞMEZ
//     (yalnız createdAt; geri alma ters satırdır, silme/düzeltme değil).
//   - Soft delete: `aktif` / durum geçişi. Hard delete yalnız TELEMETRİ sınıfında
//     (Yoklama, NonceDefteri — yaşa göre budanır; hiçbir iş kararı onları okumaz).
//   - Sır hijyeni: özel anahtar, parola, etkinleştirme kodunun düz metni DB'ye GİRMEZ.
// Model adları tel sözlüğüyle aynı dilde (Türkçe); kod bildirimleri İngilizce.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUM'LAR — protokoldeki kümelerin aynası (bekçi: test_sema_aynasi)
// -----------------------------------------------------------------------------

/// Protokol `LICENSE_CLASSES` ile birebir.
enum LisansSinifi {
  URETIM
  TEST
  DR
  DEMO
  BAYI
  BARINDIRILAN
}

enum KurulumDurumu {
  /// Portalda açıldı, fabrika henüz etkinleştirmedi.
  ETKINLESMEDI
  ETKIN
  /// DR sunucusu üretimi devraldı; kira `devredildi: true` taşır.
  DEVREDILDI
  /// Kira verilmez (403 KURULUM_IPTAL).
  IPTAL
}

enum KodDurumu {
  AKTIF
  KULLANILDI
  IPTAL
}

/// Protokol `ACTIVATION_CODE_KINDS` ile birebir: `ilk` hiç etkinleşmemiş kurulumu açar (ya da aynı
/// anahtarla yeniden etkinleştirir); `tasima` onaylı taşıma talebinin tek kullanımlık kodudur (D8).
enum KodTuru {
  ilk
  tasima
}

enum TasimaDurumu {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

/// Kiranın zincirdeki doğuş biçimi (plan §4 çatal kararı).
enum ZincirKarari {
  /// Etkinleştirme: zincirin kökü.
  ETKINLESTIRME
  /// Uçtaki kiranın çocuğu.
  NORMAL
  /// (a) Aynı parmak izinden geride kalmış uç — uca yakalar, uyarı yok.
  YAKALA
  /// (c) Farklı parmak izi aynı ucu taşıyor — ilk pencerede uyarıyla verilir.
  CATAL
  /// Onaylı taşımadan sonra yeni anahtarın ilk kirası (yeni zincir).
  TASIMA
}

enum YaptirimTuru {
  /// Yalnız mesaj bandı.
  K0
  /// Güncelleme dondurma.
  K1
  /// Modül dondurma.
  K2
  /// Süreli kısıtlı kip (kisitlamaTarihi).
  K3
  /// Anında kısıtlı kip.
  K4
  /// Anında tam durdurma.
  K5
  /// Gözlem ↔ zorla geçişi (önceki/yeni değer parametrede).
  ZORLAMA
  /// Vadeli geçerlilik bitişi değişimi (uzat / kalıcıya çevir / vade).
  GECERLILIK
  /// Ters kayıt: `geriAlinanEylemId`yi kaldırır.
  GERI_AL
}

enum PlanliEylemDurumu {
  BEKLIYOR
  UYGULANDI
  IPTAL
}

enum TaksitKalemDurumu {
  BEKLIYOR
  ODENDI
  /// Vade + gecikme günü geçti, planlı yaptırım uygulandı.
  GECIKTI
  IPTAL
}

enum KopyaUyariTuru {
  /// İki farklı parmak izi aynı kira ucunu ileri taşıyor.
  ZINCIR_CATALI
  /// Ölçülen parmak izi kabul edilen kümeyle eşleşmiyor.
  PARMAK_IZI_UYUSMAZ
  /// Aynı parmak izi ardışık "yakala" üretiyor (ayırt edilemeyen tam kopya) — yalnız uyarı.
  AYNI_PARMAK_IZI_TEKRAR
  /// Yoklamada sunulan kira bu kurulumun kira defterinde yok (başka kurulumdan taşınmış/uydurulmuş) — yalnız uyarı.
  YABANCI_KIRA
  /// Yoklamadaki kip (gözlem/zorla) kurulumun kirasındaki zorlamayla uyuşmuyor (kira/durum silinmiş) — yalnız uyarı.
  KIP_UYUSMAZ
}

enum KopyaUyariDurumu {
  ACIK
  KAPANDI
}

enum AnahtarTuru {
  KOK
  HAZIRLIK_KOK
  ALT
  INDIRME
  BAYI
}

enum AnahtarDurumu {
  AKTIF
  EMEKLI
  IPTAL
}

/// Dağıtım kanalının türü — `deploy/kanallar.json` `tur` değerleriyle aynı sözlük.
enum KanalTuru {
  uretim
  hazirlik
}

// -----------------------------------------------------------------------------
// KANAL — dağıtım kanalı (güncelleme sunucusundaki `/<kod>/electron/` · `/<kod>/mobil/` yol segmenti)
// -----------------------------------------------------------------------------

/// Kurulum bir kanala bağlıdır; kira `kanal.guncelSurumler`i buradan alır (yayın bildirimi Faz 3).
/// `kod` kimliktir ve DEĞİŞMEZ (indirme belirtecinin yol öneki); ad · tür · güncel sürümler değişir.
model Kanal {
  id             String    @id @default(uuid()) @db.Uuid
  kod            String    @unique @db.VarChar(40)
  ad             String    @db.VarChar(200)
  tur            KanalTuru
  /// `{backend?, panel?, tablet?}` sürüm metinleri — protokol KİRA `kanal.guncelSurumler` şeması.
  guncelSurumler Json      @default("{}")
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  kurulumlar Kurulum[]

  @@map("kanal")
}

// -----------------------------------------------------------------------------
// MASTER: Müşteri → Tesis → Kurulum → Hak
// -----------------------------------------------------------------------------

model Musteri {
  id        String   @id @default(uuid()) @db.Uuid
  ad        String   @db.VarChar(200)
  vergiNo   String?  @db.VarChar(20)
  /// Müşteriyi yöneten bayi (yoksa doğrudan satıcı). Bayinin kurulum adedi bu bağdan sayılır.
  bayiId    String?  @db.Uuid
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bayi     Bayi?   @relation(fields: [bayiId], references: [id], onDelete: Restrict)
  tesisler Tesis[]

  dagitimDosyalari    DagitimDosyasi[]
  indirmeBaglantilari IndirmeBaglantisi[]
  yuklemeIstekleri    YuklemeIstegi[]
  yuklemeOturumlari   YuklemeOturumu[]
  dagitimDefteri      DagitimDefteri[]

  @@index([bayiId])
  @@map("musteri")
}

model Tesis {
  id        String   @id @default(uuid()) @db.Uuid
  musteriId String   @db.Uuid
  ad        String   @db.VarChar(200)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  musteri    Musteri   @relation(fields: [musteriId], references: [id])
  kurulumlar Kurulum[]

  @@index([musteriId])
  @@map("tesis")
}

/// Bir fabrika sunucusu (backend kurulumu). `kurulumId` LİSANS kimliğidir: portalda doğar (D14),
/// fabrikaya etkinleştirme yanıtıyla gider ve `LICENSE_DIR`de durur; HAK/kira/kod ona bağlanır.
/// Fabrika DB'sinin installationId'si yalnız bilgidir (`sonOrtam.installationId`). `id` satıcının kendi anahtarıdır.
model Kurulum {
  id        String        @id @default(uuid()) @db.Uuid
  tesisId   String        @db.Uuid
  /// Lisans kimliği — portal üretir (sunucu tarafında `randomUUID`), dışarıdan verilmez.
  kurulumId String        @unique @db.Uuid
  ad        String?       @db.VarChar(200)
  sinif     LisansSinifi
  kanalKodu String        @db.VarChar(40)
  durum     KurulumDurumu @default(ETKINLESMEDI)

  /// Kurulum anahtarının açık yarısı (base64url x) ve kimliği (`kur-…`). Etkinleştirmede yazılır.
  acikAnahtar          String? @db.VarChar(64)
  anahtarKimligi       String? @unique @db.VarChar(64)
  /// Kabul edilen parmak izi kümesi `{f1..f5: özet | null}` — yoklamada kayar (eşleşince).
  kabulEdilenParmakIzi Json?
  /// Kurulumun X25519 AÇIK anahtarı (Faz 2d): modül anahtarları buna sarılır. Kurulum anahtarıyla imzalı
  /// etkinleştirme/yoklamadan yazılır (çatal/red/açık kopya uyarısında YAZILMAZ); değişimi `kurulum_kaydi`nda.
  sifrelemeAnahtari    String? @db.VarChar(64)

  /// Zincir ucu: bu kuruluma verilmiş en son kira.
  sonKiraId String? @unique @db.Uuid

  /// Kip: false = gözlem (varsayılan; bugünkü davranış), true = zorla. Değişim defteri YaptirimEylemi(ZORLAMA).
  zorlama           Boolean @default(false)
  yoklamaAraligiDk  Int     @default(60)
  /// Patron bulutu eşitleme aralığı (dk, 1–60; CHECK) — kiraya basılır, fabrika eşitleme işi okur.
  esitlemeAraligiDk Int     @default(5)
  /// Buluttaki geçmişin saklama süresi (ay: 3 · 13 · 25; NULL = tüm geçmiş; CHECK) — iç API `saklamaAy`.
  bulutSaklamaAy    Int?    @default(13)

  platform         String?   @db.VarChar(10)
  sonOrtam         Json?
  sonSaglik        Json?
  sonYoklamaZamani DateTime? @db.Timestamptz
  etkinlesmeZamani DateTime? @db.Timestamptz
  aktif            Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  tesis                  Tesis               @relation(fields: [tesisId], references: [id])
  kanal                  Kanal               @relation(fields: [kanalKodu], references: [kod], onDelete: Restrict, onUpdate: Restrict)
  sonKira                Kira?               @relation("KurulumSonKira", fields: [sonKiraId], references: [id], onDelete: NoAction)
  haklar                 Hak[]
  kiralar                Kira[]              @relation("KurulumKiralari")
  kodlar                 EtkinlestirmeKodu[]
  tasimalar              TasimaTalebi[]
  kayitlar               KurulumKaydi[]
  yoklamalar             Yoklama[]
  noncelar               NonceDefteri[]
  yaptirimlar            YaptirimEylemi[]
  planliEylemler         PlanliEylem[]
  kopyaUyarilari         KopyaUyarisi[]
  taksitPlanlari         TaksitPlani[]
  ilkKurulumBaglantilari IndirmeBaglantisi[]
  destekTalepleri        DestekTalebi[]
  bildirimler            Bildirim[]

  @@index([tesisId])
  @@index([kanalKodu])
  @@map("kurulum")
}

/// Lisans hakkı (yapısal şartlar). Değişen her şey yeni bir HakSurumu (KÖK imzalı HAK belgesi) doğurur.
model Hak {
  id              String    @id @default(uuid()) @db.Uuid
  kurulumId       String    @db.Uuid
  /// `TKS-YYYY-NNNN` — doğuşta materyalize edilir, render'da biçimlenmez.
  lisansNo        String    @unique @db.VarChar(20)
  moduller        String[]
  kalici          Boolean   @default(false)
  bakimBitis      DateTime  @db.Timestamptz
  /// Vadeli/demo/taksit geçerlilik bitişi (kiraya yazılır). Değişim defteri YaptirimEylemi(GECERLILIK).
  gecerlilikBitis DateTime? @db.Timestamptz
  /// Son imzalı sürüm (0 = henüz imzalanmadı).
  guncelSurum     Int       @default(0)
  aktif           Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  kurulum  Kurulum     @relation(fields: [kurulumId], references: [id])
  surumler HakSurumu[]
  kiralar  Kira[]

  @@index([kurulumId])
  @@map("hak")
}

/// HAK belgesinin imzalı sürümleri — EKLEME-YALNIZ defter.
model HakSurumu {
  id           String   @id @default(uuid()) @db.Uuid
  hakId        String   @db.Uuid
  surum        Int
  /// İmzalı HAK (JWS). Açık belge — sır değil.
  belge        String
  imzalayanKid String   @db.VarChar(64)
  verilis      DateTime @db.Timestamptz
  sebep        String   @db.VarChar(500)
  yapan        String   @db.VarChar(120)
  createdAt    DateTime @default(now()) @db.Timestamptz

  hak Hak @relation(fields: [hakId], references: [id])

  @@unique([hakId, surum])
  @@map("hak_surumu")
}

// -----------------------------------------------------------------------------
// KİRA ZİNCİRİ
// -----------------------------------------------------------------------------

/// Verilen her kira — EKLEME-YALNIZ defter; zincir `oncekiKiraId` ile kurulur.
model Kira {
  /// Belgedeki `kiraId` ile aynı.
  id               String       @id @default(uuid()) @db.Uuid
  kurulumId        String       @db.Uuid
  oncekiKiraId     String?      @db.Uuid
  hakId            String       @db.Uuid
  hakSurum         Int
  anahtarKimligi   String       @db.VarChar(64)
  karar            ZincirKarari
  /// Kirayı İSTEYENİN ölçtüğü parmak izi (çatal kararı bununla verilir).
  istemciParmakIzi Json
  verilis          DateTime     @db.Timestamptz
  bitis            DateTime     @db.Timestamptz
  /// İmzalı KİRA (JWS).
  belge            String
  createdAt        DateTime     @default(now()) @db.Timestamptz

  kurulum           Kurulum             @relation("KurulumKiralari", fields: [kurulumId], references: [id])
  hak               Hak                 @relation(fields: [hakId], references: [id])
  onceki            Kira?               @relation("KiraZinciri", fields: [oncekiKiraId], references: [id], onDelete: NoAction)
  cocuklar          Kira[]              @relation("KiraZinciri")
  uctaOlduguKurulum Kurulum?            @relation("KurulumSonKira")
  etkinlestirmeKodu EtkinlestirmeKodu[]

  @@index([kurulumId, createdAt])
  @@index([oncekiKiraId])
  @@map("kira")
}

/// Tekrar oynatma defteri — TELEMETRİ sınıfı: `sonKullanim` geçince budanır (istek zaten
/// ±10 dk zaman denetiminden geçemez). `(kapsam, nonce)` UNIQUE = atomik kayıt. Kapsam kurulumun
/// satıcı kimliğidir; kurulumsuz taşıma talebinde `kid:<anahtar kimliği>` (o satırda `kurulumId` boş).
model NonceDefteri {
  id          String   @id @default(uuid()) @db.Uuid
  kapsam      String   @db.VarChar(80)
  kurulumId   String?  @db.Uuid
  nonce       String   @db.VarChar(64)
  amac        String   @db.VarChar(20)
  sonKullanim DateTime @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  kurulum Kurulum? @relation(fields: [kurulumId], references: [id], onDelete: Restrict)

  @@unique([kapsam, nonce])
  @@index([kurulumId])
  @@index([sonKullanim])
  @@map("nonce_defteri")
}

/// Yoklama telemetrisi — allowlist'li sağlık özeti. Yaşa göre budanır; iş kararı okumaz
/// (zincir kararı Kira'dan, güncel sağlık Kurulum.sonSaglik'ten).
model Yoklama {
  id        String   @id @default(uuid()) @db.Uuid
  kurulumId String   @db.Uuid
  /// NORMAL · YAKALA · TEKRAR · CATAL · RED_KIRA_VERILMEDI · DEVREDILDI …
  sonuc     String   @db.VarChar(40)
  kiraId    String?  @db.Uuid
  durum     Json
  saat      Json
  ortam     Json
  saglik    Json
  gozlem    Json
  parmakIzi Json
  createdAt DateTime @default(now()) @db.Timestamptz

  kurulum Kurulum @relation(fields: [kurulumId], references: [id])

  @@index([kurulumId, createdAt])
  @@index([createdAt])
  @@map("yoklama")
}

// -----------------------------------------------------------------------------
// YAPTIRIM
// -----------------------------------------------------------------------------

/// Yaptırım DEFTERİ — eylem ve ters eylem satır olarak; satır değişmez, silinmez.
model YaptirimEylemi {
  id                String       @id @default(uuid()) @db.Uuid
  kurulumId         String       @db.Uuid
  tur               YaptirimTuru
  /// Türe göre: {mesaj?, kisitlamaTarihi?, donmusModuller?, onceki?, yeni?}
  parametre         Json
  sebep             String       @db.VarChar(500)
  yapan             String       @db.VarChar(120)
  /// GERI_AL satırında kaldırılan eylem — UNIQUE: bir eylem yalnız bir kez geri alınır.
  geriAlinanEylemId String?      @unique @db.Uuid
  /// Planlı eylemden doğduysa kaynağı.
  planliEylemId     String?      @unique @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz

  kurulum      Kurulum         @relation(fields: [kurulumId], references: [id])
  geriAlinan   YaptirimEylemi? @relation("YaptirimTers", fields: [geriAlinanEylemId], references: [id], onDelete: NoAction)
  tersKaydi    YaptirimEylemi? @relation("YaptirimTers")
  planliEylem  PlanliEylem?    @relation(fields: [planliEylemId], references: [id], onDelete: NoAction)
  taksitKalemi TaksitKalemi?

  @@index([kurulumId, createdAt])
  @@map("yaptirim_eylemi")
}

/// Vadesinde kendiliğinden uygulanacak yaptırım (ör. vade + 15 gün ödeme yoksa K3).
model PlanliEylem {
  id             String            @id @default(uuid()) @db.Uuid
  kurulumId      String            @db.Uuid
  tur            YaptirimTuru
  parametre      Json
  vade           DateTime          @db.Timestamptz
  durum          PlanliEylemDurumu @default(BEKLIYOR)
  sebep          String            @db.VarChar(500)
  yapan          String            @db.VarChar(120)
  uygulamaZamani DateTime?         @db.Timestamptz
  /// İptal (BEKLIYOR → IPTAL) — kim, ne zaman, neden; durumla çift yüklem (CHECK).
  iptalZamani    DateTime?         @db.Timestamptz
  iptalEden      String?           @db.VarChar(120)
  iptalSebebi    String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  kurulum  Kurulum         @relation(fields: [kurulumId], references: [id])
  yaptirim YaptirimEylemi?

  @@index([durum, vade])
  @@map("planli_eylem")
}

model TaksitPlani {
  id            String    @id @default(uuid()) @db.Uuid
  kurulumId     String    @db.Uuid
  aciklama      String    @db.VarChar(500)
  /// Ödeme onayında geçerlilik bitişi bir sonraki bekleyen vade + bu kadar gün olur.
  uzatmaGun     Int       @default(15)
  /// Vade + bu kadar gün ödeme yoksa K3.
  gecikmeGun    Int       @default(15)
  /// K3'ün geri sayımı (gün).
  kisitlamaGun  Int       @default(15)
  aktif         Boolean   @default(true)
  yapan         String    @db.VarChar(120)
  /// Planın kapanışı (aktif → pasif): bekleyen kalemler IPTAL olur; durumla çift yüklem (CHECK).
  kapanisZamani DateTime? @db.Timestamptz
  kapatan       String?   @db.VarChar(120)
  kapanisSebebi String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  kurulum  Kurulum        @relation(fields: [kurulumId], references: [id])
  kalemler TaksitKalemi[]

  @@index([kurulumId])
  @@map("taksit_plani")
}

model TaksitKalemi {
  id               String            @id @default(uuid()) @db.Uuid
  planId           String            @db.Uuid
  sira             Int
  vade             DateTime          @db.Timestamptz
  tutar            Decimal           @db.Decimal(14, 2)
  durum            TaksitKalemDurumu @default(BEKLIYOR)
  odemeZamani      DateTime?         @db.Timestamptz
  /// Gecikmede uygulanan yaptırım eylemi.
  yaptirimEylemiId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz
  updatedAt        DateTime          @updatedAt @db.Timestamptz

  plan     TaksitPlani     @relation(fields: [planId], references: [id])
  yaptirim YaptirimEylemi? @relation(fields: [yaptirimEylemiId], references: [id], onDelete: NoAction)

  @@unique([planId, sira])
  @@index([durum, vade])
  @@map("taksit_kalemi")
}

// -----------------------------------------------------------------------------
// ETKİNLEŞTİRME · TAŞIMA · KOPYA
// -----------------------------------------------------------------------------

/// Tek kullanımlık etkinleştirme kodu. Düz metin saklanmaz: sunucu sırrıyla (pepper, anahtar
/// dizininde) HMAC-SHA256 + son 4 karakter — son 4 YALNIZ burada (denetim/kurulum kaydı kod kimliğini taşır).
model EtkinlestirmeKodu {
  id                     String    @id @default(uuid()) @db.Uuid
  kurulumId              String    @db.Uuid
  kodOzeti               String    @unique @db.VarChar(64)
  kodSonu                String    @db.VarChar(4)
  tur                    KodTuru   @default(ilk)
  /// Yalnız `tasima` kodunda: onaylanan talep (kodu yalnız o talebin anahtarı kullanır).
  tasimaTalebiId         String?   @unique @db.Uuid
  durum                  KodDurumu @default(AKTIF)
  gecerlilikBitis        DateTime  @db.Timestamptz
  kullanimZamani         DateTime? @db.Timestamptz
  /// Kodu tüketen kurulum anahtarı — aynı anahtarla tekrar (ağ tekrarı) aynı sonucu alır.
  kullananAnahtarKimligi String?   @db.VarChar(64)
  /// Etkinleştirmede verilen kira — tekrarın cevabı buradan.
  kiraId                 String?   @db.Uuid
  yapan                  String    @db.VarChar(120)
  createdAt              DateTime  @default(now()) @db.Timestamptz
  updatedAt              DateTime  @updatedAt @db.Timestamptz

  kurulum      Kurulum       @relation(fields: [kurulumId], references: [id])
  kira         Kira?         @relation(fields: [kiraId], references: [id], onDelete: NoAction)
  tasimaTalebi TasimaTalebi? @relation(fields: [tasimaTalebiId], references: [id], onDelete: NoAction)

  @@index([kurulumId])
  @@map("etkinlestirme_kodu")
}

/// Taşıma talebi: yeni anahtar + parmak izi, portal onayını bekler (durum makinesi, atomik claim).
/// Kimliksiz talep (yeni makine lisans kimliğini bilmiyor) kuruluma BAĞSIZ doğar (`kurulumId` boş);
/// bağı onaylayan operatör kurar. Onay tek kullanımlık `tasima` kodu üretir (D8), anahtar değişimi kodla.
model TasimaTalebi {
  id                 String       @id @default(uuid()) @db.Uuid
  kurulumId          String?      @db.Uuid
  yeniAcikAnahtar    String       @db.VarChar(64)
  yeniAnahtarKimligi String       @db.VarChar(64)
  yeniParmakIzi      Json
  ortam              Json
  gerekce            String?      @db.VarChar(500)
  durum              TasimaDurumu @default(BEKLIYOR)
  kararZamani        DateTime?    @db.Timestamptz
  kararVeren         String?      @db.VarChar(120)
  kararSebebi        String?      @db.VarChar(500)
  createdAt          DateTime     @default(now()) @db.Timestamptz
  updatedAt          DateTime     @updatedAt @db.Timestamptz

  kurulum Kurulum?            @relation(fields: [kurulumId], references: [id], onDelete: Restrict)
  kodlar  EtkinlestirmeKodu[]

  @@unique([kurulumId, yeniAnahtarKimligi])
  @@index([durum])
  @@index([yeniAnahtarKimligi])
  @@map("tasima_talebi")
}

/// Kopya şüphesi. İlk pencerede yalnız uyarı; ikinci pencerede sürerse eşleşmeyen tarafa kira yok.
model KopyaUyarisi {
  id             String           @id @default(uuid()) @db.Uuid
  kurulumId      String           @db.Uuid
  tur            KopyaUyariTuru
  durum          KopyaUyariDurumu @default(ACIK)
  ilkGorulme     DateTime         @db.Timestamptz
  sonGorulme     DateTime         @db.Timestamptz
  gorulmeSayisi  Int              @default(1)
  /// Kabul edilen kümeye uyan taraf ve uymayan taraf (özetler; ham kimlik yok).
  sahipParmakIzi Json?
  digerParmakIzi Json
  /// İkinci pencerede kira reddedildi mi (ilk red anı).
  redZamani      DateTime?        @db.Timestamptz
  kapanisZamani  DateTime?        @db.Timestamptz
  kapatan        String?          @db.VarChar(120)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz

  kurulum Kurulum @relation(fields: [kurulumId], references: [id])

  @@index([kurulumId, durum])
  @@map("kopya_uyarisi")
}

/// Kurulum geçmişi DEFTERİ: etkinleşme, anahtar değişimi (taşıma), DR devri, iptal…
/// Eski anahtarın açık yarısı burada kalır — taşınmış anahtarla gelen istek KURULUM_IPTAL alır.
model KurulumKaydi {
  id                 String   @id @default(uuid()) @db.Uuid
  kurulumId          String   @db.Uuid
  /// ETKINLESTI · YENIDEN_ETKINLESTI · TASINDI · DR_DEVRALDI · DEVREDILDI · DR_GERI_ALINDI · IPTAL …
  olay               String   @db.VarChar(40)
  anahtarKimligi     String?  @db.VarChar(64)
  acikAnahtar        String?  @db.VarChar(64)
  /// Değişimde bırakılan (eski) anahtar.
  eskiAnahtarKimligi String?  @db.VarChar(64)
  eskiAcikAnahtar    String?  @db.VarChar(64)
  ayrinti            Json?
  yapan              String   @db.VarChar(120)
  /// Fabrikanın `kur.ps1` kaydının kimliği (`kurulumKayitlari[].kayitId`) — yoklama tekrarında aynı satır ikinci kez yazılmaz.
  kaynakKayitId      String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  kurulum Kurulum @relation(fields: [kurulumId], references: [id])

  @@unique([kurulumId, kaynakKayitId])
  @@index([kurulumId, createdAt])
  @@index([eskiAnahtarKimligi])
  @@map("kurulum_kaydi")
}

// -----------------------------------------------------------------------------
// DESTEK — fabrikanın panelinden açılan talepler (`POST /v1/destek`, kurulum imzalı).
// Talep DURUM tablosudur; ne olduğu (açılış · yanıt · kapanış) `destek_olayi` DEFTERİNDEDİR.
// -----------------------------------------------------------------------------

enum DestekDurumu {
  ACIK
  YANITLANDI
  KAPANDI
}

enum DestekOlayTuru {
  ACILDI
  YANIT
  KAPATILDI
}

model DestekTalebi {
  id            String       @id @default(uuid()) @db.Uuid
  kurulumId     String       @db.Uuid
  /// Fabrikanın yerel talep kimliği — (kurulum, talepId) tekrar gönderimde aynı talebi döndürür.
  talepId       String       @db.Uuid
  /// Doğuşta materyalize (`DST-000001`); sıra `destek_talep_no_seq`.
  talepNo       String       @unique @db.VarChar(40)
  konu          String       @db.VarChar(200)
  aciklama      String
  acan          String?      @db.VarChar(120)
  panelSurum    String?      @db.VarChar(60)
  ekTuru        String?      @db.VarChar(20)
  ek            Bytes?
  saglik        Json
  ortam         Json
  durum         DestekDurumu @default(ACIK)
  kapanisZamani DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  kurulum Kurulum       @relation(fields: [kurulumId], references: [id])
  olaylar DestekOlayi[]

  @@unique([kurulumId, talepId])
  @@index([durum, updatedAt])
  @@index([kurulumId, updatedAt])
  @@map("destek_talebi")
}

/// Destek DEFTERİ — açılış, satıcı yanıtı, kapanış satır olarak; satır değişmez, silinmez.
model DestekOlayi {
  id        String         @id @default(uuid()) @db.Uuid
  talepId   String         @db.Uuid
  tur       DestekOlayTuru
  metin     String?
  yapan     String         @db.VarChar(120)
  createdAt DateTime       @default(now()) @db.Timestamptz

  talep DestekTalebi @relation(fields: [talepId], references: [id])

  @@index([talepId, createdAt])
  @@map("destek_olayi")
}

/// Modül anahtarı KASASI (Faz 2d): şifreli modül paketinin AES-256 anahtarı, kasa anahtarıyla
/// (`ANAHTAR_DIZINI/modul-kasasi.key`, 0600 — DB'de DEĞİL) AES-256-GCM sarılı. Düz anahtar DB'ye,
/// loga, denetime GİRMEZ; `kid` anahtarın özetidir (sır değil). Silinmez: emeklilik `aktif=false`.
model ModulAnahtari {
  id        String   @id @default(uuid()) @db.Uuid
  modul     String   @db.VarChar(64)
  /// Anahtarın sürümü (döndürme): paket başlığı `modul + surum + kid` taşır.
  surum     Int
  kid       String   @unique @db.VarChar(40)
  sarili    String   @db.VarChar(200)
  aktif     Boolean  @default(true)
  yapan     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([modul, surum])
  @@map("modul_anahtari")
}

/// Satıcı anahtarlarının KÜNYESİ — yalnız AÇIK yarı; özel yarı DB'ye ASLA girmez.
model AnahtarKaydi {
  id          String         @id @default(uuid()) @db.Uuid
  kid         String         @unique @db.VarChar(80)
  tur         AnahtarTuru
  acikAnahtar String         @db.VarChar(64)
  siniflar    LisansSinifi[]
  /// Kök imzalı sertifika (açık belge); kökler için null.
  sertifika   String?
  baslangic   DateTime?      @db.Timestamptz
  bitis       DateTime?      @db.Timestamptz
  durum       AnahtarDurumu  @default(AKTIF)
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  @@map("anahtar_kaydi")
}

/// Denetim (audit) — AYAK İZİ: iş kararı buradan okunmaz. Sır/özel anahtar/parola/kod düz metni GİRMEZ.
model Denetim {
  id        String   @id @default(uuid()) @db.Uuid
  olay      String   @db.VarChar(60)
  varlik    String   @db.VarChar(40)
  varlikId  String?  @db.VarChar(64)
  yapan     String   @db.VarChar(120)
  ozet      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([varlik, varlikId])
  @@index([createdAt])
  @@map("denetim")
}

// -----------------------------------------------------------------------------
// BAYİ — hesap + tavan (modül ⊆ · sınıf ⊆ · kurulum adedi). Bayi imzalı HAK, protokolün
// kriptografik sertifika kısıtına EK olarak GÜNCEL tavana karşı sunucuda yeniden doğrulanır.
// -----------------------------------------------------------------------------

model Bayi {
  id               String   @id @default(uuid()) @db.Uuid
  ad               String   @db.VarChar(200)
  vergiNo          String?  @db.VarChar(20)
  /// Bayinin imza anahtarının kid'i (`bayi-…`); kök imzalı sertifikası bu bayinin id'sini taşır.
  anahtarKid       String?  @unique @db.VarChar(80)
  /// Güncel tavan sürümü (0 = tavan yok → bayi hiçbir HAK imzalayamaz). Değişim defteri BayiTavani.
  guncelTavanSurum Int      @default(0)
  aktif            Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  tavanlar     BayiTavani[]
  musteriler   Musteri[]
  kullanicilar PortalKullanici[]

  @@map("bayi")
}

/// Bayi tavanının sürümleri — EKLEME-YALNIZ defter (tetikleyiciyle değişmez).
model BayiTavani {
  id            String         @id @default(uuid()) @db.Uuid
  bayiId        String         @db.Uuid
  surum         Int
  moduller      String[]
  siniflar      LisansSinifi[]
  /// Bayinin müşterilerinde açık (iptal edilmemiş, aktif) kurulum sayısının üst sınırı.
  kurulumAdedi  Int
  /// Bayinin kurulum açabileceği kanallar (satıcı atar; boş = kurulum açamaz).
  kanallar      String[]       @default([])
  /// Bayi KALICI hak imzalayabilir mi (yönetici kararı g; varsayılan hayır).
  kaliciIzni    Boolean        @default(false)
  /// Bayinin imzaladığı HAK'ta bakım bitişi imza anından en çok bu kadar ay sonra olabilir.
  bakimAyTavani Int            @default(12)
  sebep         String         @db.VarChar(500)
  yapan         String         @db.VarChar(120)
  createdAt     DateTime       @default(now()) @db.Timestamptz

  bayi Bayi @relation(fields: [bayiId], references: [id])

  @@unique([bayiId, surum])
  @@map("bayi_tavani")
}

// -----------------------------------------------------------------------------
// PORTAL — kullanıcı (parola scrypt + TOTP ZORUNLU), oturum (telemetri), işlem kimliği (idempotency)
// -----------------------------------------------------------------------------

enum PortalRolu {
  SATICI_YONETICI
  SATICI_OPERATOR
  BAYI
}

/// Oturumun doğduğu dinleyici — oturum yalnız orada geçerlidir (satıcı rolleri tailnet ve erişim, bayi genel).
/// ERISIM: satıcı portalının Cloudflare Access arkasındaki genel yolu (kök parolalı uçlar orada yok).
enum PortalDinleyici {
  GENEL
  TAILNET
  ERISIM
}

model PortalKullanici {
  id             String     @id @default(uuid()) @db.Uuid
  /// Küçük harf, [a-z0-9._-] — doğuşta normalleştirilir.
  kullaniciAdi   String     @unique @db.VarChar(60)
  adSoyad        String     @db.VarChar(120)
  rol            PortalRolu
  /// Yalnız BAYI rolünde dolu (CHECK).
  bayiId         String?    @db.Uuid
  /// scrypt$N$r$p$tuz$özet — düz parola DB'ye girmez.
  parolaOzeti    String     @db.VarChar(200)
  /// TOTP sırrı AES-256-GCM ile sarılı (anahtar ANAHTAR_DIZINI'nde, DB'de değil).
  totpSirSifreli String     @db.VarChar(200)
  /// Son kabul edilen TOTP adımı (tekrar oynatma kilidi).
  totpSonAdim    Int?
  basarisizGiris Int        @default(0)
  kilitBitis     DateTime?  @db.Timestamptz
  /// İmza parolası (kök/bayi) ardışık hata sayacı ve süreli kilidi (D11) — giriş kilidinden AYRI.
  imzaBasarisiz  Int        @default(0)
  imzaKilitBitis DateTime?  @db.Timestamptz
  sonGiris       DateTime?  @db.Timestamptz
  parolaDegisim  DateTime   @db.Timestamptz
  aktif          Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz
  updatedAt      DateTime   @updatedAt @db.Timestamptz

  bayi      Bayi?           @relation(fields: [bayiId], references: [id], onDelete: Restrict)
  oturumlar PortalOturumu[]

  @@map("portal_kullanici")
}

/// Portal oturumu — TELEMETRİ sınıfı: iş kararı okumaz, bitişinden sonra budanır. Belirteç düz
/// saklanmaz (sha256). Oturum doğduğu dinleyiciye bağlıdır.
model PortalOturumu {
  id            String          @id @default(uuid()) @db.Uuid
  kullaniciId   String          @db.Uuid
  belirtecOzeti String          @unique @db.VarChar(64)
  dinleyici     PortalDinleyici
  sonKullanim   DateTime        @db.Timestamptz
  bitis         DateTime        @db.Timestamptz
  kapanisZamani DateTime?       @db.Timestamptz
  kapanisNedeni String?         @db.VarChar(40)
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz

  kullanici PortalKullanici @relation(fields: [kullaniciId], references: [id])

  @@index([kullaniciId])
  @@index([bitis])
  @@map("portal_oturumu")
}

/// Portal işlem kimliği (clientToken) — idempotency: eylem ile AYNI tx'te yazılır, yanıt (sırsız)
/// saklanır; aynı kimlikle tekrar aynı yanıtı alır. TELEMETRİ sınıfı: saklama süresi sonunda budanır.
model PortalIslemi {
  id          String   @id @default(uuid()) @db.Uuid
  clientToken String   @unique @db.Uuid
  kullaniciId String   @db.Uuid
  eylem       String   @db.VarChar(60)
  /// Gövdenin (sır alanları çıkarılmış) sha256'sı — gövde kapısı.
  govdeOzeti  String   @db.VarChar(64)
  yanitDurumu Int
  yanit       Json
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@map("portal_islemi")
}

// -----------------------------------------------------------------------------
// DAĞITIM (Faz 3d) — ilk kurulum bağlantısı · iki yönlü dosya paylaşımı · yayın bildirimi.
// Belirteçlerin düz metni DB'ye GİRMEZ (sunucu sırrıyla HMAC özeti + son 4). Dosya GÖVDELERİ diskte
// (`DOSYA_DIZINI`, derlemeler `DERLEME_DIZINI`); saklama süresi dolan gövde budanır, SATIR KALIR.
// Defterler (tetikleyiciyle değişmez): `dagitim_defteri` · `yayin_bildirimi`.
// -----------------------------------------------------------------------------

enum IndirmeTuru {
  ILK_KURULUM
  DOSYA
}

enum BaglantiDurumu {
  AKTIF
  IPTAL
}

enum DosyaYonu {
  /// Bizden müşteriye (portaldan yüklenir, /d ile iner).
  GIDEN
  /// Müşteriden bize (/y yükleme isteğiyle gelir).
  GELEN
}

enum YuklemeDurumu {
  ACIK
  TAMAMLANDI
  TERK
}

/// Paylaşılan dosya. `govdeBudandiAt` DURUM kolonudur (olayın kendisi `dagitim_defteri`nde GOVDE_BUDANDI).
model DagitimDosyasi {
  id              String    @id @default(uuid()) @db.Uuid
  musteriId       String    @db.Uuid
  yon             DosyaYonu
  ad              String    @db.VarChar(200)
  mime            String    @db.VarChar(100)
  boyut           BigInt
  sha256          String    @db.Char(64)
  /// `DOSYA_DIZINI` altındaki göreli yol — sunucu üretir (kullanıcı adı yola GİRMEZ).
  depoAnahtari    String    @unique @db.VarChar(80)
  saklamaBitis    DateTime  @db.Timestamptz
  govdeBudandiAt  DateTime? @db.Timestamptz
  yuklemeIstegiId String?   @db.Uuid
  yukleyen        String    @db.VarChar(120)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  musteri       Musteri             @relation(fields: [musteriId], references: [id])
  yuklemeIstegi YuklemeIstegi?      @relation(fields: [yuklemeIstegiId], references: [id], onDelete: Restrict)
  baglantilar   IndirmeBaglantisi[]
  oturum        YuklemeOturumu?

  @@index([musteriId, createdAt])
  @@index([saklamaBitis])
  @@map("dagitim_dosyasi")
}

/// /d/<belirteç> — süreli, indirme sayısı sınırlı bağlantı. ILK_KURULUM derleme dosyasını (sha256 bağlantı
/// doğarken donar; dosya değişirse iner DEĞİL), DOSYA paylaşılan dosyayı indirir. Sayaç ↔ durum çift yüklem + CHECK.
model IndirmeBaglantisi {
  id            String         @id @default(uuid()) @db.Uuid
  tur           IndirmeTuru
  musteriId     String         @db.Uuid
  /// Satıcı kurulum kaydı (`kurulum.id`) — yalnız ILK_KURULUM'da, isteğe bağlı.
  kurulumId     String?        @db.Uuid
  dosyaId       String?        @db.Uuid
  derlemeAdi    String?        @db.VarChar(200)
  derlemeSha256 String?        @db.Char(64)
  derlemeBoyut  BigInt?
  belirtecOzeti String         @unique @db.Char(64)
  belirtecSonu  String         @db.VarChar(8)
  bitis         DateTime       @db.Timestamptz
  azamiIndirme  Int
  indirmeSayisi Int            @default(0)
  sonIndirme    DateTime?      @db.Timestamptz
  durum         BaglantiDurumu @default(AKTIF)
  aciklama      String?        @db.VarChar(500)
  olusturan     String         @db.VarChar(120)
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  musteri Musteri         @relation(fields: [musteriId], references: [id])
  kurulum Kurulum?        @relation(fields: [kurulumId], references: [id], onDelete: Restrict)
  dosya   DagitimDosyasi? @relation(fields: [dosyaId], references: [id], onDelete: Restrict)

  @@index([musteriId, createdAt])
  @@index([kurulumId])
  @@index([dosyaId])
  @@map("indirme_baglantisi")
}

/// /y/<belirteç> — müşterinin bize dosya yüklemesi için süreli, kotalı istek. Kota rezervasyonu ↔ durum çift yüklem + CHECK.
model YuklemeIstegi {
  id             String         @id @default(uuid()) @db.Uuid
  musteriId      String         @db.Uuid
  belirtecOzeti  String         @unique @db.Char(64)
  belirtecSonu   String         @db.VarChar(8)
  bitis          DateTime       @db.Timestamptz
  kotaBayt       BigInt
  /// Açık oturumların beyan ettiği + tamamlanan dosyaların baytı (terk edilen oturum iade eder).
  kullanilanBayt BigInt         @default(0)
  azamiDosyaBayt BigInt
  durum          BaglantiDurumu @default(AKTIF)
  aciklama       String?        @db.VarChar(500)
  olusturan      String         @db.VarChar(120)
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  musteri   Musteri          @relation(fields: [musteriId], references: [id])
  oturumlar YuklemeOturumu[]
  dosyalar  DagitimDosyasi[]

  @@index([musteriId, createdAt])
  @@map("yukleme_istegi")
}

/// Sürdürülebilir parçalı yükleme (Cloudflare gövde sınırı ≤ 100 MB → parça ≤ `PARCA_AZAMI_MB`).
/// GELEN oturum bir isteğe bağlıdır; GIDEN oturumu satıcı portalda açar.
model YuklemeOturumu {
  id          String        @id @default(uuid()) @db.Uuid
  clientToken String        @unique @db.Uuid
  istekId     String?       @db.Uuid
  musteriId   String        @db.Uuid
  yon         DosyaYonu
  dosyaAdi    String        @db.VarChar(200)
  mime        String        @db.VarChar(100)
  toplamBayt  BigInt
  parcaBayt   Int
  parcaSayisi Int
  /// İstemcinin beyan ettiği bütün dosya özeti — tamamlamada birleşik gövdeyle karşılaştırılır.
  sha256      String        @db.Char(64)
  durum       YuklemeDurumu @default(ACIK)
  sonEtkinlik DateTime      @db.Timestamptz
  dosyaId     String?       @unique @db.Uuid
  olusturan   String        @db.VarChar(120)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  musteri  Musteri          @relation(fields: [musteriId], references: [id])
  istek    YuklemeIstegi?   @relation(fields: [istekId], references: [id], onDelete: Restrict)
  dosya    DagitimDosyasi?  @relation(fields: [dosyaId], references: [id], onDelete: Restrict)
  parcalar YuklemeParcasi[]

  @@index([istekId])
  @@index([durum, sonEtkinlik])
  @@map("yukleme_oturumu")
}

/// Alınan parça (ekleme-yalnız; aynı sıra aynı özetle gelirse idempotent, farklı özetle 409).
model YuklemeParcasi {
  id        String   @id @default(uuid()) @db.Uuid
  oturumId  String   @db.Uuid
  sira      Int
  bayt      Int
  sha256    String   @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz

  oturum YuklemeOturumu @relation(fields: [oturumId], references: [id])

  @@unique([oturumId, sira])
  @@map("yukleme_parcasi")
}

/// DAĞITIM DEFTERİ — ne oldu: BAGLANTI_VERILDI · INDIRILDI · BAGLANTI_IPTAL · YUKLEME_ISTEGI_VERILDI ·
/// YUKLEME_ISTEGI_IPTAL · DOSYA_YUKLENDI · YUKLEME_TERK · GOVDE_BUDANDI. Değişmez (tetikleyici); iptal ters kayıttır.
model DagitimDefteri {
  id         String   @id @default(uuid()) @db.Uuid
  olay       String   @db.VarChar(40)
  musteriId  String   @db.Uuid
  baglantiId String?  @db.Uuid
  istekId    String?  @db.Uuid
  dosyaId    String?  @db.Uuid
  oturumId   String?  @db.Uuid
  yapan      String   @db.VarChar(120)
  ayrinti    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  musteri Musteri @relation(fields: [musteriId], references: [id])

  @@index([musteriId, createdAt])
  @@index([baglantiId])
  @@index([istekId])
  @@index([dosyaId])
  @@map("dagitim_defteri")
}

/// Yayın betiklerinin imza anahtarı (yalnız AÇIK yarı; özel yarı yayıncının makinesinde). Pasife alınır, silinmez.
model YayinciAnahtari {
  id          String   @id @default(uuid()) @db.Uuid
  kid         String   @unique @db.VarChar(80)
  ad          String   @db.VarChar(200)
  acikAnahtar String   @db.VarChar(64)
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("yayinci_anahtari")
}

/// YAYIN DEFTERİ (imzalı bildirim) — YAYIN · TERFI · TERFI_ATLANDI. `bildirimKimligi` içerikten türer:
/// aynı olayın tekrarı aynı satırı döndürür (idempotent). Değişmez (tetikleyici).
model YayinBildirimi {
  id              String   @id @default(uuid()) @db.Uuid
  bildirimKimligi String   @unique @db.Char(64)
  olay            String   @db.VarChar(20)
  urun            String   @db.VarChar(20)
  kanalKodu       String   @db.VarChar(40)
  surum           String   @db.VarChar(40)
  yayinciKid      String   @db.VarChar(80)
  olayZamani      DateTime @db.Timestamptz
  ayrinti         Json?
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([kanalKodu, createdAt])
  @@map("yayin_bildirimi")
}

// -----------------------------------------------------------------------------
// BİLDİRİM GİDEN KUTUSU — satıcı olayı KENDİ tx'inde satır yazar (tx geri alınırsa satır yok); gönderimi
// çıkışı olan yan konteyner (`satici-bildirim`) yapar: DB'ye YALNIZ bu tabloda SELECT + durum kolonlarında
// UPDATE yetkili `satici_bildirim` rolüyle bağlanır, satıcının kendisi dış bağlantısız kalır.
// Defter DEĞİL (silinse raporlanan hiçbir sayı değişmez) — iletim kaydıdır. Gövde ALLOWLIST'tir (DB CHECK
// `bildirim_govde_gecerli`): talep metni, ekran görüntüsü, sağlık ayrıntısı, kişisel veri GİRMEZ.
// -----------------------------------------------------------------------------

enum BildirimOlayi {
  DESTEK_TALEBI
  KOPYA_SUPHESI
  KOPYA_KIRA_REDDI
  TASIMA_TALEBI
  DR_DEVRI
  KURULUM_SESSIZ
  KIRA_BITISI_YAKLASIYOR
  GECERLILIK_BITISI_YAKLASIYOR
  TAKSIT_VADESI_YAKLASIYOR
  PLANLI_EYLEM_UYGULANDI
  TAKSIT_GECIKTI
  DENEME
}

enum BildirimKanali {
  EPOSTA
  TELEGRAM
}

enum BildirimDurumu {
  BEKLIYOR
  /// Bir gönderici aldı (`kilitBitis`e dek); süre dolarsa yeniden alınabilir.
  GONDERILIYOR
  GONDERILDI
  /// Kalıcı hata · deneme tavanı · süresi geçti — `sonHata` kısa KOD taşır.
  HATA
  /// Kanal yapılandırılmamış: gönderim denenmedi.
  KAPALI
}

/// Olay × kanal başına bir satır; aynı olay aynı kanala ikinci kez yazılmaz (`tekillikAnahtari`, UNIQUE = atomik).
model Bildirim {
  id                String         @id @default(uuid()) @db.Uuid
  olay              BildirimOlayi
  kanal             BildirimKanali
  /// Olay + kayıt (+ tarih/uç): zamana bağlı olayda aynı dönem ikinci satır doğurmaz.
  tekillikAnahtari  String         @db.VarChar(200)
  kurulumId         String?        @db.Uuid
  /// İlgili kaydın kimliği (destek talebi, kopya uyarısı, taşıma talebi…) — yalnız süzme/temizlik.
  ilgiliKayit       String?        @db.Uuid
  /// ALLOWLIST gövde: musteri · tesis · kurulum · lisansNo · sinif · konu · referans · tarih · portalYolu.
  govde             Json
  durum             BildirimDurumu @default(BEKLIYOR)
  deneme            Int            @default(0)
  sonrakiDeneme     DateTime       @default(now()) @db.Timestamptz
  kilitBitis        DateTime?      @db.Timestamptz
  /// Kısa hata KODU (ham yanıt gövdesi, başlık, sır GİRMEZ).
  sonHata           String?        @db.VarChar(80)
  /// Sağlayıcının ileti kimliği (Resend e-posta id · Telegram message_id).
  saglayiciKimligi  String?        @db.VarChar(100)
  /// Telegram sohbeti süper gruba taşındıysa (400 + migrate_to_chat_id) YENİ sohbet kimliği — yalnız sayı, sır
  /// DEĞİL; yalnız `TELEGRAM_SOHBET_TASINDI` satırında (CHECK). Portal ve nabız gösterir, gönderici kendisi GEÇMEZ.
  yeniSohbetKimligi String?        @db.VarChar(24)
  gonderimZamani    DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  kurulum Kurulum? @relation(fields: [kurulumId], references: [id], onDelete: Restrict)

  @@unique([tekillikAnahtari, kanal])
  @@index([durum, sonrakiDeneme])
  @@index([kanal, updatedAt])
  @@index([createdAt])
  @@index([kurulumId])
  @@map("bildirim")
}
