# Satıcı sunucusu ortam şablonu — gerçek değerler .env'e (repoya girmez, chmod 600).
# DB adı: yerelde yalnız *_test; tekserp_fabrika_* ASLA.
DATABASE_URL='postgresql://<kullanici>:<parola>@localhost:5432/<ad>_test?schema=public'
# Genel dinleyici (Traefik/Cloudflare arkası; konteynerde 0.0.0.0)
PORT_GENEL=4610
GENEL_BIND=127.0.0.1
# Tailnet dinleyicisi (portal; joker adres açılışta REDDEDİLİR — Tailscale arayüz IP'si)
TAILNET_BIND=127.0.0.1
PORT_TAILNET=4611
# Anahtar dizini (kök parolalı, alt/indirme 0600) — repoya girmez
ANAHTAR_DIZINI=anahtarlar
# Yalnız test: gömülü ROOT_PUBLIC_KEYS (hazırlık kökü dahil) yerine çapa dosyası
# GUVEN_CAPASI_DOSYASI=capa.json
# Vekil arkasında istemci IP başlığı (yalnız CF arkasında). Başlık YALNIZ güvenilen kenar ağından (yerleşik
# Cloudflare aralıkları ya da GUVENILIR_VEKIL_AGLARI) gelen bağlantıda okunur; araya iç vekil (Traefik) giriyorsa
# onun ağı IC_VEKIL_AGLARI'na yazılır (güven kararı X-Forwarded-For'un son halkasına göre).
# VEKIL_IP_BASLIGI=cf-connecting-ip
# GUVENILIR_VEKIL_AGLARI=173.245.48.0/20,2400:cb00::/32
# IC_VEKIL_AGLARI=172.31.252.0/28
# /v1 hız sınırı (dakikalık): istemci IP'si başına · kurulum başına (imza doğrulandıktan sonra sayılır)
# V1_HIZ_IP_DK=120
# V1_HIZ_KURULUM_DK=30
# Kapı zili: kurulum başına eşzamanlı SSE aboneliği (aşan yeni abonelik en eskisini kapatır)
# ZIL_AZAMI_ABONE=3
# Geri döngü (127/8 · ::1) yalnız 1 iken tailnet kaynağı (Tailscale kurulana dek SSH tüneli; varsayılan kapalı)
# TAILNET_LOOPBACK=0
# İmza parolası (kök/bayi): kullanıcı başına ardışık hata eşiği · kilit (dk) · imza alt süreci slotu (1–2)
# IMZA_PAROLA_ESIGI=5
# IMZA_KILIT_DK=15
# IMZA_ESZAMANLI=1
# Portal (satıcı: tailnet /portal/api · bayi: genel /bayi/api) — varsayılanlar gösterildi
# PORTAL_OTURUM_BOSTA_DK=30
# PORTAL_OTURUM_AZAMI_SAAT=12
# PORTAL_GIRIS_ESIGI=5
# PORTAL_KILIT_DK=15
# PORTAL_GIRIS_HIZ_DK=20
# PORTAL_OTURUM_SAKLAMA_GUN=30
# PORTAL_ISLEM_SAKLAMA_GUN=30
# Denetim budaması (günde bir; denetim ayak izidir): başarısız giriş satırları · diğer denetim (gün)
# DENETIM_GIRIS_SAKLAMA_GUN=90
# DENETIM_SAKLAMA_GUN=730
# Tailnet dinleyicisi HTTPS arkasındaysa satıcı çerezine Secure (genel dinleyicide her zaman Secure)
# TAILNET_CEREZ_GUVENLI=0
# Derlenmiş web arayüzü (satici/web → dist/portal · dist/bayi); yoksa /portal ve /bayi 404, API çalışır
# PORTAL_WEB_DIZINI=../web/dist
# --- Dağıtım (Faz 3d) ---
# Paylaşılan dosya gövdeleri + yarım yükleme parçaları (satıcının kendi birimi):
# DOSYA_DIZINI=dosyalar
# İlk kurulum derlemeleri (müşteri başına filigranlı derleme buraya konur; yalnız okunur):
# DERLEME_DIZINI=derlemeler
# Güncelleme sunucusunun yayın kökü (html/ + defter/) — SALT-OKUNUR bağ; yoksa sürüm görünümü "ölçülemedi":
# YAYIN_DIZINI=/yayin
# PARCA_AZAMI_MB=50        (Cloudflare ücretsiz plan istek gövdesi ≤ 100 MB)
# DOSYA_AZAMI_MB=4096
# DOSYA_SAKLAMA_GUN=30     (dolunca GÖVDE budanır, satır + defter kalır)
# YUKLEME_TERK_SAAT=48
# DAGITIM_HIZ_IP_DK=120
# Genel dinleyicinin dışarıdan görünen kökü: portal /d · /y bağlantısını tam adresle verir (yoksa yalnız yol):
# GENEL_KOK_ADRESI=https://lisans.etkiliyazilim.com
