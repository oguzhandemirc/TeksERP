# Satıcı sunucusu ortam şablonu — gerçek değerler .env'e (repoya girmez, chmod 600).
# DB adı: yerelde yalnız *_test; tekserp_fabrika_* ASLA.
DATABASE_URL='postgresql://<kullanici>:<parola>@localhost:5432/<ad>_test?schema=public'
# Genel dinleyici (Traefik/Cloudflare arkası; konteynerde 0.0.0.0)
PORT_GENEL=4610
GENEL_BIND=127.0.0.1
# Anahtar dizini (kök parolalı, alt/indirme 0600) — repoya girmez
ANAHTAR_DIZINI=anahtarlar
# Yalnız test: gömülü ROOT_PUBLIC_KEYS (hazırlık kökü dahil) yerine çapa dosyası
# GUVEN_CAPASI_DOSYASI=capa.json
# Vekil arkasında istemci IP başlığı (yalnız CF arkasında). Başlık YALNIZ güvenilen kenar ağından (yerleşik
# Cloudflare aralıkları ya da GUVENILIR_VEKIL_AGLARI) gelen bağlantıda okunur; araya iç vekil (Traefik) giriyorsa
# onun ağı IC_VEKIL_AGLARI'na yazılır (güven kararı X-Forwarded-For'un son halkasına göre).
# VEKIL_IP_BASLIGI=cf-connecting-ip
# GUVENILIR_VEKIL_AGLARI=173.245.48.0/20,2400:cb00::/32
# IC_VEKIL_AGLARI=172.31.252.0/28
# /v1 hız sınırı (dakikalık): istemci IP'si başına · kurulum başına (imza doğrulandıktan sonra sayılır)
# V1_HIZ_IP_DK=120
# V1_HIZ_KURULUM_DK=30
# Kapı zili: kurulum başına eşzamanlı SSE aboneliği (aşan yeni abonelik en eskisini kapatır)
# ZIL_AZAMI_ABONE=3
# İmza parolası (kök/bayi): kullanıcı başına ardışık hata eşiği · kilit (dk) · imza alt süreci slotu (1–2)
# IMZA_PAROLA_ESIGI=5
# IMZA_KILIT_DK=15
# IMZA_ESZAMANLI=1
# Portal (satıcı: ERİŞİM /portal/api · bayi: genel /bayi/api) — varsayılanlar gösterildi
# PORTAL_OTURUM_BOSTA_DK=30
# PORTAL_OTURUM_AZAMI_SAAT=12
# PORTAL_GIRIS_ESIGI=5
# PORTAL_KILIT_DK=15
# PORTAL_GIRIS_HIZ_DK=20
# PORTAL_OTURUM_SAKLAMA_GUN=30
# PORTAL_ISLEM_SAKLAMA_GUN=30
# Denetim budaması (günde bir; denetim ayak izidir): başarısız giriş satırları · diğer denetim (gün)
# DENETIM_GIRIS_SAKLAMA_GUN=90
# DENETIM_SAKLAMA_GUN=730
# Derlenmiş web arayüzü (satici/web → dist/portal · dist/bayi); yoksa /portal ve /bayi 404, API çalışır
# PORTAL_WEB_DIZINI=../web/dist
# İç API (patron bulutu → satıcı, /ic/v1/*): üçüncü dinleyici. Sır dosyası verilmezse dinleyici AÇILMAZ.
# PORT_IC=4612
# IC_BIND=127.0.0.1
# Kaynak ağları (soket adresi; verilmezse yalnız geri döngü). Compose'ta patron konteynerinin /32 adresi.
# IC_KAYNAK_AGLARI=172.30.61.3/32
# Ortak sır (Bearer; 32–512 görünür ASCII, 0600/0640, repoya girmez)
# IC_API_BELIRTEC_DOSYASI=anahtarlar/ic-api.belirtec
# İç zil: kurulum başına dakikalık tavan · çağrı sayacının denetime yazılma aralığı (dk)
# IC_ZIL_HIZ_DK=12
# IC_SAYAC_DK=60
# --- Satıcı portalı (ERİŞİM dinleyicisi, Cloudflare Access arkası; portalın TEK yolu, tünel yok; runbook docs/ops/PORTAL-GENEL-ERISIM.md) ---
# Port verilmezse dinleyici AÇILMAZ. Joker adres açılışta REDDEDİLİR (compose'ta satıcının kenar adresi).
# PORT_ERISIM=4613
# ERISIM_BIND=127.0.0.1
# Access takım alanı (<takım>.cloudflareaccess.com; JWKS ve iss buradan) + uygulamanın AUD etiketi (64 onaltılık).
# Üçünden biri yoksa ERİŞİM dinleyicisi her isteğe 404 (portal KAPALI). Orada yalnız izin listesindeki rotalar
# (src/http/erisim-rotalari.ts) bağlanır.
# CF_ACCESS_TAKIM_ALANI=<takım>.cloudflareaccess.com
# CF_ACCESS_AUD=<64 onaltılık>
# JWKS dosyası: satıcı ağa ÇIKMAZ — yan konteyner (dist/jwks-cekici.js) yazar, satıcı salt okunur okur.
# CF_ACCESS_JWKS_DOSYASI=/erisim-jwks/certs.json
# JWKS dosyasının yaş tavanı (gün, 1–30; dosyanın yazım zamanından): aşan küme RED (genel portal 404), yarısında uyarı
# CF_ACCESS_JWKS_AZAMI_YAS_GUN=7
# --- Dağıtım (Faz 3d) ---
# Paylaşılan dosya gövdeleri + yarım yükleme parçaları (satıcının kendi birimi):
# DOSYA_DIZINI=dosyalar
# İlk kurulum derlemeleri (müşteri başına filigranlı derleme buraya konur; yalnız okunur):
# DERLEME_DIZINI=derlemeler
# Güncelleme sunucusunun yayın kökü (html/ + defter/) — SALT-OKUNUR bağ; yoksa sürüm görünümü "ölçülemedi":
# YAYIN_DIZINI=/yayin
# PARCA_AZAMI_MB=50        (Cloudflare ücretsiz plan istek gövdesi ≤ 100 MB)
# DOSYA_AZAMI_MB=4096
# DOSYA_SAKLAMA_GUN=30     (dolunca GÖVDE budanır, satır + defter kalır)
# YUKLEME_TERK_SAAT=48
# DAGITIM_HIZ_IP_DK=120
# Genel dinleyicinin dışarıdan görünen kökü: portal /d · /y bağlantısını tam adresle verir (yoksa yalnız yol):
# GENEL_KOK_ADRESI=https://lisans.etkiliyazilim.com
# --- Bildirim (olay → giden kutusu; gönderim yan konteynerde — satıcı DIŞARI BAĞLANMAZ) ---
# Bu kadar saattir başarılı yoklama yoksa "kurulum ses vermiyor" (kurulum + son yoklama anı başına bir kez):
# BILDIRIM_SESSIZ_SAAT=24
# Kira · geçerlilik · taksit bitişi/vadesi bu kadar gün içindeyse "yaklaşıyor":
# BILDIRIM_VADE_GUN=7
# Zamana bağlı olay taraması aralığı (dk; bakım işinin içinde):
# BILDIRIM_TARAMA_DK=15
# Sessizlik + kira bitişi uyarısının sınıfları (TEST · DEMO varsayılanda yok):
# BILDIRIM_SESSIZ_SINIFLAR=URETIM,DR,BARINDIRILAN
# Gönderici (yan konteyner, `node dist/notifications/sender-main.js`) kendi ortamını okur, bu .env'i OKUMAZ:
#   DATABASE_URL (satici_bildirim rolü) · TELEGRAM_BOT_TOKEN[_DOSYASI] · TELEGRAM_CHAT_ID · RESEND_API_KEY[_DOSYASI] ·
#   BILDIRIM_EPOSTA_ALICI · BILDIRIM_EPOSTA_GONDEREN · BILDIRIM_PORTAL_ADRESI · BILDIRIM_DONGU_SN (15) ·
#   BILDIRIM_DENEME_TAVANI (6) · BILDIRIM_AZAMI_YAS_SAAT (72) · BILDIRIM_NABIZ_DOSYASI · BILDIRIM_SAAT_DILIMI
