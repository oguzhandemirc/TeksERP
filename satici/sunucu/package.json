{
  "name": "tekserp-satici-sunucu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "TeksERP satıcı sunucusu — lisans API'si (etkinleştirme, yoklama, kapı zili, taşıma, DR)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:plain": "tsc --noEmit --pretty false",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts:plain": "tsc --noEmit --pretty false -p tsconfig.scripts.json",
    "test": "tsx scripts/run-all-tests.ts",
    "anahtar": "tsx scripts/anahtar.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.20.0",
    "prisma": "7.10.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "tsx": "4.22.4",
    "typescript": "6.0.2"
  }
}
