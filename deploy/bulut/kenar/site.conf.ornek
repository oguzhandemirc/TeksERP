# =============================================================================
# TeksERP bulut kenarı (nginx, konak ağında 443) — BİZİM YÖNETTİĞİMİZ sunucu için ŞABLON
# =============================================================================
# Kurulum: docs/ops/LINUX-DOCKER-KURULUM.md §10 madde 4. Sunucuda `kenar/site.conf` olur
# (SUNUCU_ADI yerine kanal adı yazılır); müşteri yerindeki kuruluma GİRMEZ (gelen port açılmaz).
# Bekçi: scripts/test_bulut_kenar.mjs (zone/anahtar/ret gövdesi/günlük biçimi/AOP) · nginx -t provası runbook'ta.
#
# Hız bölgeleri (denetim 2026-11-01 K1-3):
#   kenar_ip    — istemci başına GENEL tavan; cömert (fabrika tek NAT adresinden çıkar). IPv6 /64'e indirilir:
#                 Cloudflare istemciyi /128 geçirir, tek bir /64'ün sahibi her istekte yeni "adres" olabilir.
#                 Muaf adres bu kovaya da sayılmaz.
#   kenar_giris_ip — IP (/64) başına giriş tavanı; toplamdan önce: tek adres toplam kovayı boşaltamaz.
#   kenar_giris — giriş uçlarının (parola/PIN/kart girişi, yerinde onay, cihaz duyurusu) TOPLAM tavanı; saldırgan
#                 adres sayısından bağımsız bcrypt CPU'sunu korur. muaf/adresler.conf'taki fabrika/ofis adresleri
#                 bu toplamdan muaftır (muaf/adresler.conf): saldırı sürerken fabrika giriş yapmaya devam eder.
# Ret yanıtı backend'in hata biçimindedir (success:false, details.code RATE_LIMITED, Retry-After).
# =============================================================================

# Fabrika/ofis çıkış adresleri (geo, $remote_addr = realip sonrası gerçek istemci). Dosya BOŞ doğar = kimse muaf
# değil; geo içindeki include glob kabul etmez, dosya yoksa nginx açılmaz (runbook §10 onu boş yaratır).
geo $kenar_muaf {
    default 0;
    include /etc/nginx/muaf/adresler.conf;
}

# Genel kova anahtarı: IPv4 tam adres, IPv6 ilk 64 bit ("::" kısaltmasında eksik gruplar 0).
map $remote_addr $kenar_ip_anahtar {
    "~^(?<g1>[0-9a-f]+):(?<g2>[0-9a-f]+):(?<g3>[0-9a-f]+):(?<g4>[0-9a-f]+):" "6:$g1:$g2:$g3:$g4";
    "~^(?<g1>[0-9a-f]+):(?<g2>[0-9a-f]+):(?<g3>[0-9a-f]+)::"                 "6:$g1:$g2:$g3:0";
    "~^(?<g1>[0-9a-f]+):(?<g2>[0-9a-f]+)::"                                  "6:$g1:$g2:0:0";
    "~^(?<g1>[0-9a-f]+)::"                                                   "6:$g1:0:0:0";
    "~^::"                                                                   "6:0:0:0:0";
    default                                                                  $remote_addr;
}

# Toplam giriş kovası: muaf olmayan adresten gelen, OPTIONS/GET/HEAD dışındaki giriş isteği. $uri çözülmüş ve
# normalleşmiş yoldur; büyük/küçük harf ve sondaki "/" Express'te aynı uca gider → ~* ve isteğe bağlı "/".
# Boş anahtar = sayılmaz.
map "$kenar_muaf|$request_method|$uri" $kenar_giris_anahtar {
    default "";
    "~*^0\|(?!(GET|HEAD|OPTIONS)\|)[A-Z]+\|/api/auth/login[^/]*(/.*)?$"                            giris;
    "~*^0\|(?!(GET|HEAD|OPTIONS)\|)[A-Z]+\|/api/devices/(announce|rebind-requests/onsite-approve)/?$" giris;
}

# Genel kova muaf (fabrika) adreste sayılmaz: tek NAT ardındaki bütün tablet/panel trafiği 429'da yeniden
# denemediği için (denetim Y4) tavan ölçülmemiş tepeyi boğmasın. Muaf olmayan fabrikada tavan, teslimden önce
# erişim günlüğünden ölçülen saniyelik tepenin ~3 katına ayarlanır (runbook §10).
map "$kenar_muaf|$kenar_ip_anahtar" $kenar_ip_kova {
    default "";
    "~^0\|(?<ipk>.+)$" $ipk;
}

# IP başına giriş kovası (toplamdan ÖNCE): tek adres toplam kovayı boşaltıp herkesin girişini 429'a düşüremesin.
# Hız (1 r/s) toplamın (3 r/s) altında → tek kaynak toplamı tüketemez; nginx önceki bölgede reddedilen isteği
# sonraki bölgeye saymaz. Backend'in örtük IP giriş kovası (dakikada 60) mertebesinde.
map "$kenar_giris_anahtar|$kenar_ip_anahtar" $kenar_giris_ip_anahtar {
    default "";
    "~^giris\|(?<gik>.+)$" $gik;
}

limit_req_zone $kenar_ip_kova          zone=kenar_ip:10m       rate=30r/s;
limit_req_zone $kenar_giris_ip_anahtar zone=kenar_giris_ip:10m rate=60r/m;
limit_req_zone $kenar_giris_anahtar    zone=kenar_giris:1m     rate=3r/s;
limit_req_status 429;

# Günlük: sorgu dizesi YAZILMAZ ($request/$args/$request_uri değil, $uri) — `totp/enroll?token=` gibi belirteçli
# adresler düz kalmasın (D6, "sır log'a girmez"). Referer de yazılmaz (aynı belirteci taşıyabilir).
log_format tekserp_kenar '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent $request_time "$http_user_agent"';

server_tokens off;

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name SUNUCU_ADI.etkiliyazilim.com;

    ssl_certificate     /etc/nginx/tls/origin.pem;
    ssl_certificate_key /etc/nginx/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Authenticated Origin Pulls: yalnız Cloudflare'in istemci sertifikasıyla gelen el sıkışma kabul edilir
    # (başka bir CF kiracısı ya da köken IP'sini bilen biri kenarın hız kurallarını atlayamaz). Sıra runbook'ta:
    # önce Cloudflare'de AOP açılır, sonra bu iki satır.
    ssl_client_certificate /etc/nginx/tls/cloudflare-origin-pull-ca.pem;
    ssl_verify_client on;

    include /etc/nginx/cloudflare-ips.conf;
    client_max_body_size 20m;
    access_log /var/log/nginx/access.log tekserp_kenar;

    limit_req zone=kenar_ip       burst=300 nodelay;
    limit_req zone=kenar_giris_ip burst=10  nodelay;
    limit_req zone=kenar_giris    burst=10  nodelay;
    error_page 429 = @kenar_hiz_siniri;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
    # Web oturum çerezi (tam izin listeli JWT ~3,8 KB) yanıt başlığını 4K varsayılanın üstüne taşır → "upstream sent too big header" 502.
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;

    location / {
        proxy_pass http://127.0.0.1:4000;
    }

    # TOTP kurulum bağlantısı belirteci sorgu dizesindedir; hata günlüğü istek satırını (sorgu dahil) basar →
    # bu yolda yalnız kritik hata yazılır.
    location ^~ /api/auth/totp/ {
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://127.0.0.1:4000;
    }

    location @kenar_hiz_siniri {
        default_type "application/json; charset=utf-8";
        # Panel başka kökenden okuyabilsin (gövde sır taşımaz); yoksa tarayıcı 429'u ağ hatası sanar.
        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Vary Origin always;
        add_header Retry-After 1 always;
        add_header Cache-Control no-store always;
        return 429 '{"success":false,"message":"Çok fazla istek gönderildi. 1 saniye sonra tekrar deneyin.","details":{"code":"RATE_LIMITED","bucket":"kenar","retryAfterSec":1}}';
    }
}
