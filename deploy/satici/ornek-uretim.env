# ÜRETİM satıcısı compose değişkenleri — sunucuda `/opt/stack/apps/tekserp-satici-uretim/.env` (oguzhan, 0600).
# Proje ORTAM=uretim (tek ortam): ağlar, birimler, sır grubu, DB hacmi ve Traefik yönlendiricisi buradan türer.
# SIR İÇERMEZ: DB parolası ve iç API belirteci *_DOSYASI satırlarındaki dosyalarda, anahtarlar ANAHTAR_DIZINI_HOST'ta.
# Kurulum sırası ve ölçümler: docs/ops/SATICI-KURULUM.md §13. Yalıtım denetimi:
#   node deploy/satici/compose-denetle.mjs --env-file <bu .env> [--patron-env <patronun .env'i>]

ORTAM=uretim
SATICI_HOST=lisans.etkiliyazilim.com

# imaj-derle.sh çıktısındaki etiketler — üretim kökü çapaya girdikten SONRAKİ HEAD'den (§13.2)
SATICI_IMAJ=tekserp-satici:<sha>
SATICI_YEDEK_IMAJ=tekserp-satici-yedek:<sha>

# --- Portal GENEL ERİŞİMİ (Cloudflare Access) — ÜRETİMDE ZORUNLU, portalın TEK yolu (tünel yok) -------------------
# Tek portal: portal.etkiliyazilim.com üretim satıcısına bağlanır (compose-denetle Ⓞ: örtü yoksa ❌). Satıcıya çıkış ağı AÇILMAZ: JWKS'i `satici-jwks` yan konteyneri
# kendi `jwks-cikis` köprüsünden çekip dizine yazar, satıcı o dizini SALT OKUNUR bağlar. Access değerleri
# docs/ops/PORTAL-GENEL-ERISIM.md'den; dizin önceden kurulur (uretim-hazirla.sh kurar, 10001 0755).
COMPOSE_FILE=docker-compose.yml:docker-compose.portal-genel.yml
PORTAL_HOST=portal.etkiliyazilim.com
CF_ACCESS_TAKIM_ALANI="<takım>.cloudflareaccess.com"
CF_ACCESS_AUD="<Access uygulamasının AUD etiketi, 64 onaltılık>"
ERISIM_JWKS_DIZINI_HOST=/opt/stack/apps/tekserp-satici-uretim/erisim-jwks
JWKS_CIKIS_AGI=172.31.251.48/29

# --- Bildirim yan konteyneri — YER AYRILDI, KAPALI (runbook SATICI-KURULUM §5c) ----------------------------------
# Açılınca COMPOSE_FILE sonuna ":docker-compose.bildirim.yml" eklenir ve aşağıdaki satırlar açılır. Üretimde yalıtım
# denetimi --patron-env <patronun .env'i> İSTER (Ⓑ7 patron ağları; verilmezse ÖLÇÜLMEDİ → çıkış 2).
# BILDIRIM_CIKIS_AGI=172.31.251.64/28
# BILDIRIM_DB_PAROLA_DOSYASI=/opt/stack/apps/tekserp-satici-uretim/sirlar/bildirim-db-parolasi
# TELEGRAM_BOT_TOKEN_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-uretim/sirlar/telegram-bot-belirteci
# TELEGRAM_CHAT_ID_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-uretim/sirlar/telegram-grup-kimligi
# RESEND_API_KEY_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-uretim/sirlar/resend-api-anahtari
# BILDIRIM_EPOSTA_ALICI=info@etkiliyazilim.com
# BILDIRIM_EPOSTA_GONDEREN="TeksERP Bildirim <bildirim@etkiliyazilim.com>"
# BILDIRIM_PORTAL_ADRESI=https://portal.etkiliyazilim.com/portal

# Satıcı köprüleri — tek /24 içinde, patronun 172.31.250'siyle çakışmaz (§13.1 ölçümüyle doğrulanır)
KENAR_AGI=172.31.251.0/28
KENAR_IP=172.31.251.2
KENAR_DINAMIK_ARALIK=172.31.251.8/29
IC_API_AGI=172.31.251.32/28
IC_API_IP=172.31.251.34
PATRON_IC_IP=172.31.251.35
IC_API_DINAMIK_ARALIK=172.31.251.40/29

# Sır dosyası grubu — hazırlığın (61061) ve patronun (61062) grubundan AYRI: ortamlar birbirinin sırrını okuyamaz
SIR_GID=61063
DB_PAROLA_DOSYASI=/opt/stack/apps/tekserp-satici-uretim/sirlar/db-parolasi
# Satıcı ↔ patron ortak Bearer'ı (root:SIR_GID 0440); patron dizininde AYRI kopya (PATRON-BULUTU-KURULUM §14)
IC_API_BELIRTEC_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-uretim/sirlar/ic-api-belirteci

# Birimler — anahtar birimi törenin `anahtarlar/` kümesi (+ paket ara kopyası), SALT OKUNUR bağlanır
ANAHTAR_DIZINI_HOST=/opt/stack/apps/tekserp-satici-uretim/anahtarlar
YEDEK_ALICI_DIZINI_HOST=/opt/stack/apps/tekserp-satici-uretim/yedek-alici
YEDEK_DIZINI_HOST=/srv/tekserp-satici-yedek/uretim

# Dağıtım (3d-1) — /dosyalar YAZILIR (10001:10001 0700) · /derlemeler + /yayin SALT OKUNUR
DOSYA_DIZINI_HOST=/srv/tekserp-satici-dosya/uretim
DERLEME_DIZINI_HOST=/opt/stack/apps/tekserp-satici-uretim/derlemeler
YAYIN_DIZINI_HOST=/opt/stack/apps/tekserp-guncelleme
GENEL_KOK_ADRESI=https://lisans.etkiliyazilim.com

# Yedek döngüsü (varsayılanlar)
YEDEK_ARALIK_SAAT=24
YEDEK_SAKLA_GUN=30
YEDEK_EN_AZ=7
