# Satıcı compose değişkenleri — sunucuda `/opt/stack/apps/tekserp-satici-hazirlik/.env` (root, 0600).
# SIR İÇERMEZ: DB parolası DB_PAROLA_DOSYASI'ndaki dosyada, anahtarlar ANAHTAR_DIZINI_HOST'ta.
# Değerlerin nasıl ölçüleceği: docs/ops/SATICI-KURULUM.md §2–§3.

ORTAM=hazirlik
SATICI_HOST=lisans-test.etkiliyazilim.com

# imaj-derle.sh çıktısındaki etiketler (HEAD'in kısa sha'sı)
SATICI_IMAJ=tekserp-satici:<sha>
SATICI_YEDEK_IMAJ=tekserp-satici-yedek:<sha>

# `tailscale ip -4` (VDS'in tailnet adresi) — port YALNIZ buna yayımlanır
TAILNET_IP=100.x.y.z
TAILNET_PORT=4611

# Satıcıya özel iki köprü ağı: `docker network ls` + `ip -4 route` ile çakışmadığı ölçülür
KENAR_AGI=172.31.252.0/28
KENAR_IP=172.31.252.2
TAILNET_AGI=172.31.253.0/28
TAILNET_KONTEYNER_IP=172.31.253.2

# Sır dosyası grubu (DB parolasını satıcı + DB + yedek konteynerleri okur; başka kimse)
SIR_GID=61061
DB_PAROLA_DOSYASI=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/db-parolasi

# Birimler
ANAHTAR_DIZINI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/anahtarlar
YEDEK_ALICI_DIZINI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/yedek-alici
YEDEK_DIZINI_HOST=/srv/tekserp-satici-yedek/hazirlik

# Yedek döngüsü (varsayılanlar)
YEDEK_ARALIK_SAAT=24
YEDEK_SAKLA_GUN=30
YEDEK_EN_AZ=7
