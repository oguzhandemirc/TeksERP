# Satıcı compose değişkenleri — sunucuda `/opt/stack/apps/tekserp-satici-hazirlik/.env` (root, 0600).
# SIR İÇERMEZ: DB parolası DB_PAROLA_DOSYASI'ndaki dosyada, anahtarlar ANAHTAR_DIZINI_HOST'ta.
# Değerlerin nasıl ölçüleceği: docs/ops/SATICI-KURULUM.md §2–§3.

ORTAM=hazirlik
SATICI_HOST=lisans-test.etkiliyazilim.com

# imaj-derle.sh çıktısındaki etiketler (HEAD'in kısa sha'sı)
SATICI_IMAJ=tekserp-satici:<sha>
SATICI_YEDEK_IMAJ=tekserp-satici-yedek:<sha>

# `tailscale ip -4` (VDS'in tailnet adresi) — port YALNIZ buna yayımlanır
TAILNET_IP=100.x.y.z
TAILNET_PORT=4611

# GERİ DÖNGÜ KİPİ (Tailscale onayı gelene dek, runbook §4a): aşağıdaki satır açılır ve TAILNET_IP=127.0.0.1
# yazılır (kullanılmaz; ana dosyanın zorunlu alanı). Portal hiçbir yere yayımlanmaz, Mac'ten SSH tüneliyle.
# COMPOSE_FILE=docker-compose.yml:docker-compose.loopback.yml

# Satıcıya özel iki köprü ağı: `docker network ls` + `ip -4 route` ile çakışmadığı ölçülür
KENAR_AGI=172.31.252.0/28
KENAR_IP=172.31.252.2
# Traefik'in dinamik adresi buradan (KENAR_IP bu aralığın DIŞINDA kalır; denetim ⑥b)
KENAR_DINAMIK_ARALIK=172.31.252.8/29
TAILNET_AGI=172.31.253.0/28
TAILNET_KONTEYNER_IP=172.31.253.2
# İç API köprüsü (patron bulutu → satıcı, 4612; port yayını YOK). Sabit adresler dinamik aralığın DIŞINDA,
# ağ geçidi (.1) hiçbiri değil (denetim ⑧). Patron compose'u bu ağa PATRON_IC_IP ile katılır.
IC_API_AGI=172.31.254.0/28
IC_API_IP=172.31.254.2
PATRON_IC_IP=172.31.254.3
IC_API_DINAMIK_ARALIK=172.31.254.8/29

# Sır dosyası grubu (DB parolasını satıcı + DB + yedek konteynerleri okur; başka kimse)
SIR_GID=61061
DB_PAROLA_DOSYASI=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/db-parolasi
# Satıcı ↔ patron ortak Bearer'ı (root:SIR_GID 0440, 32–512 görünür ASCII; patron dizininde AYRI kopya — deploy/patron/ornek.env)
IC_API_BELIRTEC_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/ic-api-belirteci

# Birimler
ANAHTAR_DIZINI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/anahtarlar
YEDEK_ALICI_DIZINI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/yedek-alici
YEDEK_DIZINI_HOST=/srv/tekserp-satici-yedek/hazirlik

# Dağıtım (3d-1) — runbook docs/ops/LISANS-DEVREYE-ALMA-TESTFABRIKA.md §2.5; denetim ⑨
# /dosyalar YAZILIR (satıcının kendi birimi; 10001:10001 0700) — yayın kökünün ve anahtar biriminin DIŞINDA
DOSYA_DIZINI_HOST=/srv/tekserp-satici-dosya/hazirlik
# /derlemeler SALT OKUNUR (müşteri başına ilk kurulum derlemeleri; root 0755)
DERLEME_DIZINI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/derlemeler
# /yayin SALT OKUNUR — güncelleme sunucusunun kökü (html/ + defter/; sürüm görünümü buradan okur)
YAYIN_DIZINI_HOST=/opt/stack/apps/tekserp-guncelleme
# Genel dinleyicinin dışarıdan görünen kökü (portal /d · /y bağlantısı tam adresle)
GENEL_KOK_ADRESI=https://lisans-test.etkiliyazilim.com

# Yedek döngüsü (varsayılanlar)
YEDEK_ARALIK_SAAT=24
YEDEK_SAKLA_GUN=30
YEDEK_EN_AZ=7

# --- Bildirim yan konteyneri (örtü docker-compose.bildirim.yml) — runbook docs/ops/SATICI-KURULUM.md §5c ---
# Açmak için COMPOSE_FILE sonuna ":docker-compose.bildirim.yml" eklenir (geri döngü kipinde üç dosya birden):
# COMPOSE_FILE=docker-compose.yml:docker-compose.bildirim.yml
# Göndericinin TEK dış çıkış ağı — satıcının/patronun ağlarıyla ve 100.64/10 ile çakışmaz (§3 ölçümü);
# DOCKER-USER kuralı (vds/bildirim-cikis.sh) yalnız DNS + tcp/443'e izin verir.
BILDIRIM_CIKIS_AGI=172.31.255.0/28
# Kanal değerleri DOSYADA (root:SIR_GID 0440; BOŞ dosya = o kanal KAPALI) — değer bu dosyaya/runbook'a YAZILMAZ.
# DB parolası onaltılık (satici-baslat URL'e koyar); Telegram grup kimliği işaretli tam sayı (sıradan grup -<sayı>).
BILDIRIM_DB_PAROLA_DOSYASI=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/bildirim-db-parolasi
TELEGRAM_BOT_TOKEN_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/telegram-bot-belirteci
TELEGRAM_CHAT_ID_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/telegram-grup-kimligi
RESEND_API_KEY_DOSYASI_HOST=/opt/stack/apps/tekserp-satici-hazirlik/sirlar/resend-api-anahtari
# E-posta hedefleri (sır DEĞİL). Gönderen TIRNAKLI: bu dosya kabukla da okunur (`<` yönlendirmedir).
BILDIRIM_EPOSTA_ALICI=info@etkiliyazilim.com
BILDIRIM_EPOSTA_GONDEREN="TeksERP Bildirim <bildirim@etkiliyazilim.com>"
# İletideki portal bağlantısının kökü (tailnet): http://<tailnet-adı>:4611/portal — geri döngü kipinde
# http://127.0.0.1:14611/portal (portal-baglan.mjs). Boşsa iletide yalnız yol yazılır.
BILDIRIM_PORTAL_ADRESI=http://tekserp-vds:4611/portal
# Göndericinin sabit DNS çözücüleri (çıkış kuralı yalnız bunlara 53'ü açar):
# BILDIRIM_DNS_1=1.1.1.1
# BILDIRIM_DNS_2=9.9.9.9
