# Patron bulutu compose değişkenleri — sunucuda `/opt/stack/apps/tekserp-patron-uretim/.env` (0600).
# SIR İÇERMEZ: üç DB parolası ve iç API belirteci *_DOSYASI satırlarındaki dosyalarda, TOTP sarma anahtarı
# ANAHTAR_DIZINI_HOST'ta. Değerlerin nasıl ölçüleceği: docs/ops/PATRON-BULUTU-KURULUM.md §3–§4.

ORTAM=uretim
PATRON_HOST=patron.etkiliyazilim.com

# imaj-derle.sh çıktısındaki etiketler (HEAD'in kısa sha'sı)
PATRON_IMAJ=tekserp-patron:<sha>
PATRON_YEDEK_IMAJ=tekserp-patron-yedek:<sha>

# Patrona özel kenar köprüsü: `docker network ls` + `ip -4 route` ile çakışmadığı ölçülür (satıcı 172.31.251.0/24).
KENAR_AGI=172.31.250.0/28
KENAR_IP=172.31.250.2
# Traefik'in dinamik adresi buradan (KENAR_IP bu aralığın DIŞINDA kalır; denetim ⑥b)
KENAR_DINAMIK_ARALIK=172.31.250.8/29
# Dış çıkış köprüsü (B5 bildirimleri: Expo push · web push) — internal DEĞİL, yalnız patron katılır (denetim ④);
# kenarla ve satıcının ağlarıyla çakışmaz (denetim ⑥ · ⑨).
CIKIS_AGI=172.31.250.16/28

# Satıcı iç API'si (satıcı compose'unun ağı ve adresleri — satıcının .env'iyle AYNI değerler):
#   SATICI_IC_API_AGI = tekserp-satici-<ortam>-ic-api · SATICI_IC_API_IP = satıcının IC_API_IP'si ·
#   PATRON_IC_IP = satıcının PATRON_IC_IP'si (satıcı kaynak kapısı yalnız bu /32'yi kabul eder)
SATICI_IC_API_AGI=tekserp-satici-uretim-ic-api
SATICI_IC_API_IP=172.31.251.34
PATRON_IC_IP=172.31.251.35
# satici (iç API + önbellek; varsayılan) | kayit (satıcı CLI'siyle DB'ye yazılmış kurulum kaydı)
KURULUM_KAYNAGI=satici

# Sır dosyası grubu — SATICININKİNDEN AYRI bir sayı (61061 satıcı): patron satıcının sırrını okuyamaz, tersi de.
SIR_GID=61062
GOC_PAROLA_DOSYASI=/opt/stack/apps/tekserp-patron-uretim/sirlar/goc-parolasi
UYGULAMA_PAROLA_DOSYASI=/opt/stack/apps/tekserp-patron-uretim/sirlar/uygulama-parolasi
ESITLEME_PAROLA_DOSYASI=/opt/stack/apps/tekserp-patron-uretim/sirlar/esitleme-parolasi
# Satıcının ic-api-belirteci dosyasının KOPYASI (root:SIR_GID 0440); boş dosya = iç API kapalı (KURULUM_KAYNAGI=kayit)
IC_API_BELIRTEC_DOSYASI_HOST=/opt/stack/apps/tekserp-patron-uretim/sirlar/ic-api-belirteci
# Tesis DB rol anahtarı (32 bayt base64url, root:SIR_GID 0440; ÖNCEDEN üretilir — runbook). Sunucu · göç · hazırlayıcı.
TESIS_ROL_ANAHTARI_DOSYASI_HOST=/opt/stack/apps/tekserp-patron-uretim/sirlar/tesis-rol-anahtari

# Birimler
ANAHTAR_DIZINI_HOST=/opt/stack/apps/tekserp-patron-uretim/anahtarlar
YEDEK_ALICI_DIZINI_HOST=/opt/stack/apps/tekserp-patron-uretim/yedek-alici
YEDEK_DIZINI_HOST=/srv/tekserp-patron-yedek/uretim

# Yedek döngüsü (varsayılanlar)
YEDEK_ARALIK_SAAT=24
YEDEK_SAKLA_GUN=30
YEDEK_EN_AZ=7

# Bildirimler (B5): kapali (varsayılan = bugünkü davranış) | sahte | gercek. `gercek` BILDIRIM_VAPID_KONU ister
# (mailto: ya da https:) ve VAPID anahtar çiftini anahtar biriminde ÖNCEDEN üretilmiş bulur (runbook §2.1).
BILDIRIM_KIPI=kapali
# BILDIRIM_VAPID_KONU=mailto:<adres>
