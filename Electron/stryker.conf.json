{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Odaklı mutasyon testi. Yalnız SAF + testi olan lib dosyaları mutasyona uğrar (tarih/random/IO yok). YAVAŞ → CI'da DEĞİL, on-demand: npm run test:mutation. Detay: MUTATION-TESTING.md.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 30000,
  "mutate": [
    "src/lib/query-builder.ts",
    "src/lib/roll-name.ts",
    "src/lib/station-colors.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
