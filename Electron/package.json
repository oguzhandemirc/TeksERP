{
  "name": "adnan-sahin-erp-admin",
  "productName": "Adnan Şahin ERP",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adnan Şahin ERP — Admin Panel by Etkili Yazılım",
  "author": {
    "name": "Etkili Yazılım",
    "email": "info@etkiliyazilim.com"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:all": "electron-vite build && electron-builder -mwl",
    "preview": "electron-vite preview",
    "electron:rebuild": "electron-rebuild -f -w serialport,node-hid",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "e2e": "electron-vite build && playwright test",
    "e2e:run": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.10",
    "axios": "^1.15.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "node-hid": "^3.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "serialport": "^13.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.6",
    "vitest-axe": "^0.1.0"
  },
  "build": {
    "appId": "com.etkiliyazilim.adnan-sahin-erp",
    "productName": "Adnan Şahin ERP",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/node-hid/**",
      "**/node_modules/bindings/**"
    ],
    "directories": {
      "output": "release/${version}",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "TeksERP-LOGO.png",
          "TeksERP-LOGO.ico",
          "TeksERP-INTRO.mp4",
          "splash.html"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "resources/TeksERP-LOGO.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/TeksERP-LOGO.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adnan Şahin ERP",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "resources/TeksERP-LOGO.ico",
      "uninstallerIcon": "resources/TeksERP-LOGO.ico",
      "installerHeaderIcon": "resources/TeksERP-LOGO.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "uninstallDisplayName": "Adnan Şahin ERP",
      "menuCategory": "Etkili Yazılım"
    },
    "linux": {
      "icon": "resources/TeksERP-LOGO.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
