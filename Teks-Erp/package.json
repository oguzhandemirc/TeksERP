{
  "name": "tekserp-backend",
  "version": "2.9.5",
  "engines": {
    "node": ">=22"
  },
  "description": "TeksERP - Tekstil ERP Backend",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc && node scripts/build-araclar.mjs",
    "seed": "npx prisma db seed",
    "seed:fixtures": "tsx prisma/seed-fixtures.ts",
    "seed:demo": "tsx prisma/seed-demo-stations.ts",
    "seed:scenario": "ts-node prisma/seed-shipping-scenario.ts",
    "seed:ticaret-demo": "tsx prisma/seed-ticaret-demo.ts",
    "setup:ticaret": "tsx scripts/setup-ticaret.ts",
    "superadmin:kur": "node dist/tools/superadmin-olustur.cjs",
    "superadmin:kur:kaynak": "tsx scripts/superadmin-olustur.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "lint": "eslint src scripts prisma",
    "typecheck": "tsc --noEmit",
    "typecheck:plain": "tsc --noEmit --pretty false",
    "typecheck:scripts:plain": "tsc --noEmit --pretty false -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "tsx scripts/run-all-tests.ts",
    "test:load": "tsx scripts/load_test.ts",
    "check:docs": "node ../scripts/check-docs.mjs",
    "check:migrations": "node ../scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bonjour-service": "1.4.4",
    "bwip-js": "^4.10.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "opentype.js": "^2.0.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  }
}
