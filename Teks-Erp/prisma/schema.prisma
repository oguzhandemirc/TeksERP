/// Kullanıcı bazlı UI tercihleri (accent rengi, tema, yoğunluk, menü favorileri,
/// kayıtlı tablo görünümleri). Şema esnekliği için tek `Json` blob — frontend
/// `AppPreferences` tipini sahiplenir, alan eklemek migration gerektirmez.
/// Sorgulanmaz (yalnız PK by userId fetch), bu yüzden GIN index gerekmez.
model UserPreference {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  preferences Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("user_preferences")
}

/// Oturum kaydı — anlık JWT iptal + aynı-tip cihaz oturum politikası (kick/notify/off).
/// jti login'de (jwt.sign jwtid) üretilir; auth.middleware her istekte revokedAt kontrol
/// eder → iptal edilen oturum bir sonraki istekte 401 alır (tokenVersion'dan bağımsız,
/// daha ince taneli: tek cihazı düşürür, tüm oturumları değil).
///
/// TEKLİK NOTU: (userId, deviceType) üzerinde partial-unique index YOK — kasıtlı.
/// 'off'/'notify' politikaları aynı kullanıcı için çoklu aktif same-type oturum
/// gerektirir; teklik ('kick') UYGULAMA KATMANINDA sağlanır
/// (SessionRegistryService.openLoginSession tx: updateMany revoke → create).
///
/// deviceId serbest VARCHAR (FK DEĞİL) — kayıtsız/eşleşmemiş client de login yapıp
/// oturum açabilmeli; buraya devices tablosuna FK koymak o senaryoyu kilitlerdi.
model Session {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  deviceType   ClientType
  jti          String     @unique @db.Uuid
  deviceId     String?    @db.VarChar(64)
  createdAt    DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz
  expiresAt    DateTime   @db.Timestamptz
  revokedAt    DateTime?  @db.Timestamptz
  revokeReason String?    @db.VarChar(32)
  lastSeenAt   DateTime?  @db.Timestamptz

  // Ayak izi korunur — kullanıcı silinirken (soft-delete kalıbı) oturum geçmişi kaybolmaz.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// İKİ ADIMLI DOĞRULAMA KURULUM PENCERESİ (2026-09-01, uzaktan erişim).
///
/// Uzaktan (Cloudflare Tunnel üzerinden) giriş TOTP olmadan kabul edilmez. Peki
/// TOTP'yi kullanıcı NEREDE kurar? Üç seçenek tartıldı:
///   • "Parola doğruysa uzaktan da kursun" → parola sızmışsa saldırgan 2FA'yı
///     KENDİ telefonuna bağlar ve meşru sahibi kilitler. 2FA'nın koruduğu tek
///     senaryoyu kapatır; REDDEDİLDİ.
///   • "Yalnız fabrika ağından" → en sert, ama telefon her değiştiğinde
///     fabrikaya gitmek gerekir.
///   • SEÇİLEN: `admin:users` yetkisi olan biri pencereyi AÇAR, kullanıcı o
///     pencerede istediği yerden kurar. Kurulumu bir İNSAN yetkilendirir; parola
///     tek başına yetmez. Kayıp telefon da aynı kapıdan çözülür.
///
/// Pencere TEK KULLANIMLIKTIR ve kısa ömürlüdür (`expiresAt`). `secret` burada
/// bekler; `consumedAt` yazılana kadar `User.totpSecret`e TAŞINMAZ — yarım kalan
/// bir kurulum kimsenin girişini bozmaz.
model TotpEnrollment {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  /// Pencereyi açan yönetici (audit izi — "bu 2FA'yı kim yetkilendirdi").
  openedById String @db.Uuid
  /// Kurulum bağlantısının tek kullanımlık anahtarı (URL'de taşınır).
  token      String @unique @db.Uuid
  /// Aday TOTP sırrı (base32). Doğrulanana kadar User'a yazılmaz.
  secret     String @db.VarChar(64)

  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user     User @relation("TotpEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  openedBy User @relation("TotpEnrollmentOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("totp_enrollments")
}

/// KURTARMA KODLARI — telefon kaybedildiğinde hesabın tek çıkışı.
///
/// ⚠️ `codeHash` bcrypt'tir, düz metin DEĞİL (`quickPin`/`cardToken`'dan ayrılan
/// nokta budur ve bilinçlidir): kurtarma kodu parolaya denk bir sırdır, oysa PIN
/// LAN-only fiziksel bir kolaylıktır. Yedek dosyası sızsa bile kurtarma kodları
/// kullanılamaz.
///
/// Satır SİLİNMEZ, `usedAt` damgalanır — "kaç kod kaldı" ve "ne zaman kullanıldı"
/// soruları denetimde sorulur.
model UserRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  codeHash String    @db.VarChar(72)
  usedAt   DateTime? @db.Timestamptz

  /// Append-only → `updatedAt` YOK (konvansiyon). Tek güncelleme `usedAt`
  /// tek-seferlik atomik claim damgasıdır (bkz. başlık: satır SİLİNMEZ).
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation("UserRecoveryCodeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_recovery_codes")
}

/// Yetki kataloğu — runtime'da sadece bu tablo + UserPermission birlikte tüketilir.
/// `category` admin UI'sında gruplamak için: "web" (web ekran/aksiyon), "mobile"
/// (mobil ekran), "admin" (admin operasyonları).
model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(64) // "order:read", "mobile:kk2", "admin:users", "mobile:*"
  module      String             @db.VarChar(32) // "SALES", "PRODUCTION", "FINANCE", "MOBILE" (D-15: sınırlı)
  category    PermissionCategory @default(web)
  description String?

  // Relations
  userPermissions     UserPermission[]
  templateMemberships PermissionTemplateItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([module])
  @@index([category])
  @@map("permissions")
}

/// Direct grant: User ↔ Permission (N:N).
/// Efektif yetki tek kaynaktan okunur — rol katmanı yoktur.
/// `validFrom`/`validUntil` opsiyonel: "Ali bu hafta Ahmet vardiyasına bakacak" gibi
/// zaman sınırlı atamalar için. Null ise sınırsız.
/// `grantedById` audit izi için: yetkiyi hangi admin verdi.
model UserPermission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  permissionId String    @db.Uuid
  validFrom    DateTime? @db.Timestamptz
  validUntil   DateTime? @db.Timestamptz
  grantedById  String?   @db.Uuid

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([userId, permissionId])
  // D-6: @@index([userId]) kaldırıldı — @@unique([userId, permissionId]) sol-prefix'i kapsar.
  @@index([permissionId])
  @@map("user_permissions")
}

/// Admin-side şablon — sadece "kullanıcı oluştururken hızlıca yetki paketi seç"
/// kısayolu. Runtime'da User'a hiçbir şekilde join'lenmez; uygulandığında
/// permission'ları UserPermission'a kopyalanır ve şablon-user bağı kalmaz.
/// Bu sayede şablonu sonradan değiştirmek mevcut kullanıcıları etkilemez.
model PermissionTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  /// Sistem rolünün KALICI kimliği (`constants/role-template-catalog.ts`).
  /// Boot uzlaştırması şablonu bu kodla bulur — fabrika adı değiştirse bile
  /// ikizi doğmaz. NULL = fabrikanın panelden kendi yarattığı şablon
  /// (uzlaştırma ona hiç dokunmaz). Sistem şablonu SİLİNMEZ, pasifleştirilir:
  /// sert silme bir sonraki restart'ta diriliş demekti.
  code        String? @unique @db.VarChar(64)
  name        String  @unique @db.VarChar(64)
  description String? @db.VarChar(200)
  isActive    Boolean @default(true)

  permissions PermissionTemplateItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ.
  /// `GENERATED ALWAYS AS (public.tr_fold("name")) STORED` (migration
  /// `20260819060000_search_fold`). Prisma generated kolonu bilmez; `dbgenerated()`
  /// olmadan `migrate dev` her diff'te `DROP DEFAULT` üretir (ölçüldü).
  /// ⚠️ Yazma yolları bu alanı GÖNDEREMEZ — `sanitizeWriteData` dbgenerated
  /// alanları düşürür; PG de reddeder. `sortBy`/`filter` yüzeyine de KAPALIDIR.
  /// ⚠️ Kolonun tipini/collation'ını değiştirmek isteyen ÖNCE bunu DROP etmeli.
  nameFold  String?  @default(dbgenerated())

  // ── KAYIT KÜNYESİ (Faz A2, 2026-08-19) — docs/design/KAYIT-KUNYESI-TASARIM.md
  createdById String? @db.Uuid
  createdBy   User?   @relation("PermissionTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("PermissionTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@index([nameFold])
  @@map("permission_templates")
}

model PermissionTemplateItem {
  templateId   String @db.Uuid
  permissionId String @db.Uuid

  template   PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([templateId, permissionId])
  @@index([permissionId])
  @@map("permission_template_items")
}

// =============================================================================
// 2. MASTER DATA - Station, Machine, Route
// =============================================================================

model Station {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(32) // e.g. "BOYAHANE_DIS", "KURSUN_1"
  name       String      @db.VarChar(100)
  type       StationType // INTERNAL or EXTERNAL
  kind       StationKind @default(OTHER) // Domain rolü — API davranış dispatch'i
  department String?     @db.VarChar(32) // DOKUMA, DEVERE, TERBIYE, SEVKIYAT etc. (D-15: sınırlı)
  isActive   Boolean     @default(true)

  /// İş emri adım picker'ında bu istasyon gösterilsin mi?
  /// false → KK1 gibi giriş noktası istasyonları (sadece Roll oluşturma için
  /// kullanılır, üretim akışına WorkOrderStep olarak girmez).
  allowAsWorkOrderStep Boolean @default(true)

  // EXTERNAL istasyonlar için varsayılan fason kategorisi. WO oluşturulurken
  // fason planlama modalında otomatik önerilir (kullanıcı değiştirebilir).
  defaultCategoryId String?                @db.Uuid
  defaultCategory   SubcontractorCategory? @relation("StationDefaultCategory", fields: [defaultCategoryId], references: [id])

  /// Bu istasyon RENK uygulayabilir mi? (2026-08-10)
  ///
  /// Eskiden bu soru YALNIZ `defaultCategory.appliesColor`'dan türetiliyordu ve
  /// kategorisi olmayan bir İÇ istasyon tanım gereği "renk veremez" oluyordu —
  /// iç boyahane senaryosunun önündeki asıl engel buydu. Yetenek artık
  /// istasyonun KENDİ alanı; EXTERNAL satırlar göçte kategoriden dolduruldu.
  ///
  /// ⚠️ VARSAYILAN FALSE. Göçte iç istasyonlara da `false` yazıldı — bugünkü
  /// davranışı BİREBİR korumak için: eski kural `hasDefaultCategory &&
  /// canApplyColor` bileşik koşuluydu ve kategorisiz istasyonda sonucu
  /// **false**'tu. `true` yazmak Tambur/Kurşun adımına renk yazılmasına izin
  /// verirdi (2026-08-06 notunun açıkça uyardığı şey).
  ///
  /// ⚠️ Bu bayrak PLANLAMA sorusunu yanıtlar ("bu adım renk verebilir mi").
  /// Fason kabulde rengin FİİLEN uygulanıp uygulanmadığı hâlâ o sevkin
  /// `requiredCategory.appliesColor` bayrağından okunur — satın alınan hizmet
  /// odur. İkisini birleştirme; ortak yüklem `stepCanApplyColor`.
  appliesColor Boolean @default(false)

  /// Bu istasyon ÖZELLİK uygulayabilir mi? Renk ile aynı gerekçe.
  /// ⚠️ VARSAYILAN TRUE — eski kural kategorisiz istasyonda `canApplyProperty`
  /// için **true** üretiyordu (KURSUN özelliği KURSUN_KK2'ye böyle bağlanmıştı).
  appliesProperty Boolean @default(true)

  /// Bu istasyon KALİTE KONTROL (KK/muayene) yürütür mü? (2026-09-03)
  ///
  /// Eskiden bu soru istasyonun TÜRÜNDEN türetiliyordu (`kind === PROCESS_QC`)
  /// ve 28 karar noktasına elle kopyalanmıştı; yani "kalite" bir yetenek değil
  /// bir tür adıydı ve ikinci bir KK istasyonu tanımlanamıyordu.
  ///
  /// ⚠️ VARSAYILAN FALSE — bugünkü davranışı BİREBİR korumak için: göçte YALNIZ
  /// `kind = 'PROCESS_QC'` satırları `true`ya çekildi (migration
  /// 20260903020000). `true` varsayılan, her yeni istasyonu sessizce kalite
  /// yürütür yapardı; kalite bir istisnadır, kural değil.
  ///
  /// ⚠️ Bu bayrak PLANLAMA sorusunu yanıtlar ("bu adım KK yürütür mü").
  /// `appliesColor`/`appliesProperty`den farkı: KATEGORİDE KARŞILIĞI YOK —
  /// `SubcontractorCategory`de `appliesQuality` kolonu yoktur, çünkü fason
  /// firma kalite notu yazmaz (kalite kaydı KK1 girişi + Tambur finalize'da
  /// doğar). Bu yüzden `seedCapabilityFromCategory` bu alana DOKUNMAZ ve ortak
  /// yüklem `stepCanApplyQuality` tek argümanlıdır.
  appliesQuality Boolean @default(false)

  /// Bu istasyonun makinelerinde LEVENT DOĞAR mı? (devere makinesi, 2026-09-12)
  ///
  /// ⚠️ VARSAYILAN FALSE — bugünkü davranışı BİREBİR korumak için: hiçbir mevcut
  /// istasyon devere değildir. Yetenek kalıbı `appliesQuality` emsalidir: soru
  /// istasyonun TÜRÜNDEN (`StationKind`) türetilmez, kendi alanıdır — yoksa
  /// "devere" bir tür adı olur ve ikinci bir devere istasyonu tanımlanamazdı.
  /// Yüzeyi devere modülü açıkken çizilir; kapalıyken form alanı yoktur.
  producesWarpBeam Boolean @default(false)

  // Relations
  machines             Machine[]
  /// Bu istasyonda sisteme GİREN toplar (Roll.entryStationId) — kalıcı köken izi.
  entryRolls           Roll[]             @relation("RollEntryStation")
  routeSteps           RouteStep[]
  workOrderSteps       WorkOrderStep[]
  cardScans            TravelerCardScan[]
  colorCapabilities    StationColor[]
  propertyCapabilities StationProperty[]
  peripherals          PeripheralDevice[] // MAKİNESİZ istasyona sabit donanım (SHIPPING kantarı vb.)
  workSessions         WorkSession[]
  // NOT: Kurşun bypass ataması İSTASYONA değil MAKİNEYE yapılır
  // (Machine.kursunBypasses) — PROCESS_QC istasyonu tektir, altındaki
  // fiziksel kurşun makineleri N adettir. Bu yüzden Station'da karşı-ilişki YOK.

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ.
  /// `GENERATED ALWAYS AS (public.tr_fold("name")) STORED` (migration
  /// `20260819060000_search_fold`). Prisma generated kolonu bilmez; `dbgenerated()`
  /// olmadan `migrate dev` her diff'te `DROP DEFAULT` üretir (ölçüldü).
  /// ⚠️ Yazma yolları bu alanı GÖNDEREMEZ — `sanitizeWriteData` dbgenerated
  /// alanları düşürür; PG de reddeder. `sortBy`/`filter` yüzeyine de KAPALIDIR.
  /// ⚠️ Kolonun tipini/collation'ını değiştirmek isteyen ÖNCE bunu DROP etmeli.
  nameFold  String?  @default(dbgenerated())

  // ── KAYIT KÜNYESİ (2026-08-19) — docs/design/KAYIT-KUNYESI-TASARIM.md ──
  // Kaydın kimliğine ait KALICI gerçek: kim oluşturdu / kim son değiştirdi.
  // Audit'ten OKUNMAZ — audit 6 ayda arşivlenir, künye kaybolmamalı.
  // NULLABLE: geçmiş kayıtlarda değer yok; NOT NULL migration'ı canlıda tablo
  // yeniden yazımı demektir. Backfill audit'ten yapılır, eşleşmeyen null kalır.
  // FK index BİLİNÇLİ YOK — "kim yaptı" audit FK'sı, sorgulanmadıkça indexlenmez
  // (printedById/grantedById emsali, CLAUDE.md perf kuralı 1 istisnası).
  createdById String? @db.Uuid
  createdBy   User?   @relation("StationCreatedBy", fields: [createdById], references: [id])
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("StationUpdatedBy", fields: [updatedById], references: [id])

  @@index([type])
  @@index([kind])
  @@index([defaultCategoryId])
  @@index([nameFold])
  @@map("stations")
}

model Machine {
