// =============================================================================
// TeksERP - Prisma Schema
// =============================================================================
// Architecture Rules Applied (core-architecture.md):
//   - PK: String @id @default(uuid()) on ALL models
//   - Timestamps: createdAt + updatedAt on ALL models
//   - Soft Delete: isActive flag (no physical DELETE)
//   - Audit: SystemLog records every CUD operation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum StationType {
  INTERNAL
  EXTERNAL
}

/// İstasyonun domain rolü — API davranış farkları için kullanılır.
/// Örn. PROCESS_QC istasyonunda Kurşun+QC2 per-roll akışı çalışır.
enum StationKind {
  RAW_QC // KK1 — ham mal girişi / dokuma çıkışı
  PROCESS_QC // Kurşun + Kalite Kontrol 2 (tek fiziksel istasyon)
  TAMBUR // Final karar noktası
  SUBCONTRACTOR // Fason / boyahane (dış işlem)
  SHIPPING // Sevkiyat/tartı — üretim dışı, MAKİNESİZ istasyon (istasyona-bağlı donanım + istasyon-oturumu)
  OTHER // Diğer / özel istasyon
}

/// Top üzerinde yapılan her somut işlemin log'u.
/// Boolean bayrak kullanmak yerine tarih + operatör + metadata ile tam iz bırakır.
enum RollOperationType {
  KURSUN_APPLIED // PROCESS_QC: bu topa kurşun geçildi
  QC2_COMPLETED // PROCESS_QC: bu topun kalite kontrolü bitti
  TAMBUR_PROCESSED // TAMBUR: bu top için kesim/karar alındı
  SUBCONTRACTOR_SENT // SUBCONTRACTOR: fasona sevk edildi
  SUBCONTRACTOR_RETURNED // SUBCONTRACTOR: fasondan döndü
}

enum ItemType {
  YARN
  FABRIC
  CONSUMABLE
}

/// Top'un sisteme nasıl girdiğini ifade eder — raporlama ayrımı için kritik.
/// itemType "ne olduğunu", entrySource "nereden geldiğini" söyler.
enum RollEntrySource {
  SUPPLIER_RECEIPT // Tedarikçiden satın alınan mal kabul (kumaş, yarn, consumable)
  TAMBUR_SPLIT // Tambur'da KES kararı sonucu ayrılan parça (parentRollId dolu)
  SUBCONTRACTOR_RETURN // Boyahane vb. fason dönüşü — açık kumaş Roll (parentReceiptId dolu, barcode null)
}

enum RollStatus {
  STOCK
  IN_PRODUCTION
  PRODUCED // Son üretim adımı bitti, Tambur'a girmedi (tek-adımlı WO veya rotada Tambur yok)
  SCRAP // Gerçek fire — Tambur kalite reddi vb. fiziksel hurda
  CANCELLED // Operatör iptali (yanlış giriş) — fire değil, sadece kayıt geri alındı
  AT_SUBCONTRACTOR // Fason/boyahanede işlem görüyor
  A1_STOCK // 2. Kalite satılabilir stok
  RETURNED_FROM_SUBCONTRACTOR // Fason dönüşünde yeni barkodlar üretildi, eski kapatıldı
  WAREHOUSE // Tambur sonrası depoya kaldırıldı — satışa / sevke hazır
  SHIPPED // Çuval kapanıp tartıldı — müşteriye sevk edildi (sevk muhasebesi bu anda işlenir)
  TAMBUR_CONSUMED // Tambur'da bölündü; tüm metraj çocuk topları olarak doğdu — parent retire
  SUBCONTRACTOR_CONSUMED // Fason kabulde kapandı — yeni "açık kumaş" Roll'ları receipt üzerinden doğacak
  AT_KARTELA // Bitmiş top kartela fason firmasında işlemde (KartelaDispatch)
  KARTELA_CONSUMED // Kartela kabulde kapandı — metraj N kartela (Swatch) olarak doğdu, parent retire
}

enum CompanyType {
  CUSTOMER
  SUPPLIER
}

// F6+D-15: Device.kind serbest string yerine enum (saha cihaz tipi).
enum DeviceKind {
  TABLET
  PHONE
  DESKTOP
}

// Phase 1: yaşam döngüsü sadeleşti. READY/SHORT/IN_PRODUCTION kaldırıldı —
// "envanter hazır mı?" / "üretim sürüyor mu?" runtime hesabı (allocation +
// workOrder.status üzerinden). Lifecycle:
//   PENDING → APPROVED → PARTIAL_SHIPPED → COMPLETED / CANCELLED
enum OrderStatus {
  PENDING
  APPROVED
  PARTIAL_SHIPPED
  COMPLETED
  CANCELLED
}

enum WorkOrderType {
  ORDER_PRODUCTION // Siparişe Özel Üretim
  STOCK_PRODUCTION // Stoka Üretim
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  // F71: PAUSED kaldırıldı (app'te hiç atanmıyordu; 16 ref backend'de temizlendi — bba0f15).
}

enum StepStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum TravelerCardStatus {
  ACTIVE // Mal ile birlikte gezen geçerli kart
  REPRINTED // Yeniden basıldı, bu kopya artık geçersiz
  VOIDED // Manuel iptal (hasar/kayıp dışında iptal)
  COMPLETED // WorkOrder COMPLETED olunca otomatik pasife çekilir
}

enum ScanType {
  ARRIVAL // İstasyona vardı
  DEPARTURE // İstasyondan ayrıldı
  INFO // Bilgi amaçlı tarama (istasyon hareketi değil)
}

/// Etiket türü — her tür için ayrı template havuzu var, default da ayrı.
/// ROLL_RAW: KK1 ham mal kabul (renksiz, sade alanlar).
/// ROLL_FINISHED: Tambur sonrası bitmiş kumaş (renk + müşteri + sipariş + alias).
/// SWATCH: Kartela etiketi.
enum LabelKind {
  ROLL_RAW
  ROLL_FINISHED
  SWATCH
}

/// Yazıcı dili — etiket render driver registry anahtarı. Faz-1: yalnız
/// RASTER_HTML fiziksel basar (HTML + OS sürücü); PPLA ÜRETİLİR (Argox native
/// komut), ham gönderim simüle (donanım I/O Faz-2). PPLB/ZPL gelecek.
enum PrinterLanguage {
  RASTER_HTML
  PPLA
  PPLB
  ZPL
}

/// Baskı yöntemi — ribonlu (termal transfer) vs ribonsuz (direkt termal). Boş → yazıcı
/// otomatik algılar (komut gönderilmez, güvenli varsayılan). Seçiliyse dil-özel komuta
/// çevrilir: PPLA `<STX>KI7` 0/1, ZPL `^MTD`/`^MTT`. PPLB'de iş-başına komut yok (atlanır).
enum PrinterMediaType {
  DIRECT_THERMAL
  THERMAL_TRANSFER
}

/// Etiket yönü — medya geometrisinden türer (w ≥ h → LANDSCAPE).
enum LabelOrientation {
  PORTRAIT
  LANDSCAPE
}

/// Çevre cihazı bağlantı tipi — cihaz kaydı + yönlendirme. NETWORK_TCP=ağ yazıcı
/// (RAW 9100), BLUETOOTH_SPP=seri köprü (HC-05/06), BLE, USB, SERIAL_COM.
enum ConnectionType {
  NETWORK_TCP
  BLUETOOTH_SPP
  BLE
  USB
  SERIAL_COM
}

/// Çevre cihazı türü. LABEL_PRINTER tam bağlanır; SCALE/METER/SIGNAL_SOURCE
/// kayıt-only (gerçek BT okuma Faz-2, kayıt modelinde yer tutar).
enum PeripheralKind {
  LABEL_PRINTER
  SCALE
  METER
  SIGNAL_SOURCE
}

/// Tambur kararında bir hata için yapılan aksiyon.
enum RollErrorAction {
  CUT
  NO_CUT
}

/// Hata tipinin görsel/operasyonel önceliği — UI renklendirmesi.
enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/// SystemLog event türü. DOMAIN = CUD audit, AUTH = login event'leri,
/// SYSTEM = startup/error gibi sistem olayları.
enum SystemLogCategory {
  DOMAIN
  AUTH
  SYSTEM
}

/// Yetki katalogunun UI'da gruplanma kategorisi.
enum PermissionCategory {
  web
  mobile
  admin
}

/// Ürün birim cinsi — sipariş/üretim hesaplarında kullanılır.
enum ItemUnit {
  MT
  KG
  ADET
}

/// Sipariş para birimi — config/currencies.ts ile senkron tutulur.
/// Yeni currency eklemek için: enum'a ekle + currencies.ts'i güncelle + migration.
enum Currency {
  TRY
  USD
  EUR
  GBP
}

/// Login yapan istemci türü — aynı-tip oturum politikası bunun üzerinden çalışır
/// (1 Electron + 1 mobil serbest; 2. aynı-tip kick/notify/off ile yönetilir).
enum ClientType {
  ELECTRON
  MOBILE
}

// =============================================================================
// 1. RBAC - Auth & User Management
// =============================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String
  fullName     String    @db.VarChar(100)
  isActive     Boolean   @default(true)
  // JWT iptal sayacı: yetki grant/revoke/set + şifre sıfırlamada artar. verifyToken
  // her istekte token'daki sürümle karşılaştırır → eski oturum anında düşer.
  tokenVersion Int       @default(1)
  /// QR personel kartı sırrı (32-hex, düz saklanır — fiziksel kart taşıyıcı sır;
  /// bcrypt login sıcak yolunda gereksiz). Kart içeriği "TEKSU:<userId>:<cardToken>".
  /// Kart kaybolursa admin ROTASYON yapar → eski kart anında ölür. NULL = kart yok.
  /// Kartla giriş yalnız auth.loginMethods "card" içerirken çalışır.
  cardToken    String?   @unique @db.VarChar(64)
  /// Salt-PIN girişi için HIZLI PIN (6 hane) — şifreden AYRI ve sistem genelinde
  /// BENZERSİZ (PIN tek başına kimliği belirler; findUnique ile giriş). Düz saklanır
  /// (LAN-only + kısa ömür/rotasyon admin'den; cardToken emsali). NULL = tanımsız.
  /// Salt-PIN girişi yalnız auth.loginMethods "pin" içerirken çalışır.
  quickPin     String?   @unique @db.VarChar(12)
  /// KALICI SİLME işareti (geri alınamaz). NULL = normal kayıt (isActive true=aktif,
  /// false=GEÇİCİ pasif, geri alınabilir). Dolu = silinmiş: kayıt yalnız veri
  /// bütünlüğü/geçmiş için durur, listede görünmez, aktifleştirilemez; username
  /// serbest bırakılır (del_ ön-ek), kimlikler temizlenir. Pasif ≠ silinmiş.
  deletedAt    DateTime? @db.Timestamptz

  // Relations
  permissions                UserPermission[]        @relation("UserPermissionUser")
  grantedPermissions         UserPermission[]        @relation("UserPermissionGrantedBy")
  logs                       SystemLog[]
  printedTravelerCards       TravelerCard[]          @relation("TravelerCardPrintedBy")
  cardScans                  TravelerCardScan[]
  rollMovements              RollMovement[]
  printedManifests           Manifest[]              @relation("ManifestPrintedBy")
  printedDocuments           PrintedDocument[]       @relation("PrintedDocumentPrintedBy")
  dispatches                 SubcontractorDispatch[] @relation("DispatchCreatedBy")
  cancelledDispatches        SubcontractorDispatch[] @relation("DispatchCancelledBy")
  directShippedDispatches    SubcontractorDispatch[] @relation("DispatchDirectShippedBy")
  receipts                   SubcontractorReceipt[]  @relation("ReceiptCreatedBy")
  cancelledReceipts          SubcontractorReceipt[]  @relation("ReceiptCancelledBy")
  kartelaDispatches          KartelaDispatch[]       @relation("KartelaDispatchBy")
  cancelledKartelaDispatches KartelaDispatch[]       @relation("KartelaDispatchCancelledBy")
  kartelaReceipts            KartelaReceipt[]        @relation("KartelaReceiptBy")
  cancelledKartelaReceipts   KartelaReceipt[]        @relation("KartelaReceiptCancelledBy")
  swatchesCreated            Swatch[]                @relation("SwatchCreatedBy")
  rollOperations             RollOperation[]
  detectedRollErrors         RollError[]             @relation("RollErrorDetectedBy")
  processedRollErrors        RollError[]             @relation("RollErrorProcessedBy")
  createdRolls               Roll[]                  @relation("RollCreatedBy")
  manualClosedOrders         Order[]                 @relation("OrderManualClosedBy")
  systemSettingsUpdates      SystemSetting[]
  preference                 UserPreference?
  receivedReturns            RollReturn[]            @relation("RollReturnReceivedBy")
  cancelledReturns           RollReturn[]            @relation("RollReturnCancelledBy")
  workSessions               WorkSession[]
  sessions                   Session[]
  dispatchedShipments        Shipment[]              @relation("ShipmentDispatchedBy")
  weighedSacks               Sack[]                  @relation("SackWeighedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Kullanıcı bazlı UI tercihleri (accent rengi, tema, yoğunluk, menü favorileri,
/// kayıtlı tablo görünümleri). Şema esnekliği için tek `Json` blob — frontend
/// `AppPreferences` tipini sahiplenir, alan eklemek migration gerektirmez.
/// Sorgulanmaz (yalnız PK by userId fetch), bu yüzden GIN index gerekmez.
model UserPreference {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  preferences Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// Oturum kaydı — anlık JWT iptal + aynı-tip cihaz oturum politikası (kick/notify/off).
/// jti login'de (jwt.sign jwtid) üretilir; auth.middleware her istekte revokedAt kontrol
/// eder → iptal edilen oturum bir sonraki istekte 401 alır (tokenVersion'dan bağımsız,
/// daha ince taneli: tek cihazı düşürür, tüm oturumları değil).
///
/// TEKLİK NOTU: (userId, deviceType) üzerinde partial-unique index YOK — kasıtlı.
/// 'off'/'notify' politikaları aynı kullanıcı için çoklu aktif same-type oturum
/// gerektirir; teklik ('kick') UYGULAMA KATMANINDA sağlanır
/// (SessionRegistryService.openLoginSession tx: updateMany revoke → create).
///
/// deviceId serbest VARCHAR (FK DEĞİL) — kayıtsız/eşleşmemiş client de login yapıp
/// oturum açabilmeli; buraya devices tablosuna FK koymak o senaryoyu kilitlerdi.
model Session {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  deviceType   ClientType
  jti          String     @unique @db.Uuid
  deviceId     String?    @db.VarChar(64)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?    @db.VarChar(32)
  lastSeenAt   DateTime?

  // Ayak izi korunur — kullanıcı silinirken (soft-delete kalıbı) oturum geçmişi kaybolmaz.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Yetki kataloğu — runtime'da sadece bu tablo + UserPermission birlikte tüketilir.
/// `category` admin UI'sında gruplamak için: "web" (web ekran/aksiyon), "mobile"
/// (mobil ekran), "admin" (admin operasyonları).
model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(64) // "order:read", "mobile:kk2", "admin:users", "mobile:*"
  module      String             @db.VarChar(32) // "SALES", "PRODUCTION", "FINANCE", "MOBILE" (D-15: sınırlı)
  category    PermissionCategory @default(web)
  description String?

  // Relations
  userPermissions     UserPermission[]
  templateMemberships PermissionTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([category])
  @@map("permissions")
}

/// Direct grant: User ↔ Permission (N:N).
/// Efektif yetki tek kaynaktan okunur — rol katmanı yoktur.
/// `validFrom`/`validUntil` opsiyonel: "Ali bu hafta Ahmet vardiyasına bakacak" gibi
/// zaman sınırlı atamalar için. Null ise sınırsız.
/// `grantedById` audit izi için: yetkiyi hangi admin verdi.
model UserPermission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  permissionId String    @db.Uuid
  validFrom    DateTime?
  validUntil   DateTime?
  grantedById  String?   @db.Uuid

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionId])
  // D-6: @@index([userId]) kaldırıldı — @@unique([userId, permissionId]) sol-prefix'i kapsar.
  @@index([permissionId])
  @@map("user_permissions")
}

/// Admin-side şablon — sadece "kullanıcı oluştururken hızlıca yetki paketi seç"
/// kısayolu. Runtime'da User'a hiçbir şekilde join'lenmez; uygulandığında
/// permission'ları UserPermission'a kopyalanır ve şablon-user bağı kalmaz.
/// Bu sayede şablonu sonradan değiştirmek mevcut kullanıcıları etkilemez.
model PermissionTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(64)
  description String? @db.VarChar(200)
  isActive    Boolean @default(true)

  permissions PermissionTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permission_templates")
}

model PermissionTemplateItem {
  templateId   String @db.Uuid
  permissionId String @db.Uuid

  template   PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([templateId, permissionId])
  @@index([permissionId])
  @@map("permission_template_items")
}

// =============================================================================
// 2. MASTER DATA - Station, Machine, Route
// =============================================================================

model Station {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(32) // e.g. "BOYAHANE_DIS", "KURSUN_1"
  name       String      @db.VarChar(100)
  type       StationType // INTERNAL or EXTERNAL
  kind       StationKind @default(OTHER) // Domain rolü — API davranış dispatch'i
  department String?     @db.VarChar(32) // DOKUMA, DEVERE, TERBIYE, SEVKIYAT etc. (D-15: sınırlı)
  isActive   Boolean     @default(true)

  /// İş emri adım picker'ında bu istasyon gösterilsin mi?
  /// false → KK1 gibi giriş noktası istasyonları (sadece Roll oluşturma için
  /// kullanılır, üretim akışına WorkOrderStep olarak girmez).
  allowAsWorkOrderStep Boolean @default(true)

  // EXTERNAL istasyonlar için varsayılan fason kategorisi. WO oluşturulurken
  // fason planlama modalında otomatik önerilir (kullanıcı değiştirebilir).
  defaultCategoryId String?                @db.Uuid
  defaultCategory   SubcontractorCategory? @relation("StationDefaultCategory", fields: [defaultCategoryId], references: [id])

  // Relations
  machines             Machine[]
  routeSteps           RouteStep[]
  workOrderSteps       WorkOrderStep[]
  cardScans            TravelerCardScan[]
  colorCapabilities    StationColor[]
  propertyCapabilities StationProperty[]
  peripherals          PeripheralDevice[] // MAKİNESİZ istasyona sabit donanım (SHIPPING kantarı vb.)
  workSessions         WorkSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([kind])
  @@index([defaultCategoryId])
  @@map("stations")
}

model Machine {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  code      String  @unique @db.VarChar(32)
  name      String  @db.VarChar(100)
  isActive  Boolean @default(true)

  // Relations
  station        Station            @relation(fields: [stationId], references: [id])
  devices        Device[]
  peripherals    PeripheralDevice[] // birleşik cihaz kaydı (yazıcı/kantar/metre/sinyal — makineye sabit)
  rollOperations RollOperation[]
  rollMovements  RollMovement[]
  workSessions   WorkSession[]
  rollsCreated   Roll[]             @relation("RollCreatedMachine") // KK1 girişi makine atfı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stationId])
  @@map("machines")
}

/// Sahada makinenin yanında sabit duran tablet/cihaz.
/// `deviceId` tablet ilk açılışta üretilen, AsyncStorage'da kalıcı UUID.
/// Allowlist modeli: tablet `announce` eder → PENDING → admin onaylar+atar → APPROVED.
/// `machineId` = atandığı makine (atıf + cihaz çözümü); null = atanmamış.
/// Cihaz değişmedikçe operatör değişse bile hangi makinede işlendiği bilinir.
model Device {
  id         String       @id @default(uuid()) @db.Uuid
  deviceId   String       @unique @db.VarChar(64) // Tablet local UUID
  name       String       @db.VarChar(100) // Admin'in verdiği etiket — "Tambur-1 Tablet"
  machineId  String?      @db.Uuid
  lastSeenAt DateTime?
  isActive   Boolean      @default(true)
  /// Allowlist durumu: PENDING (yeni, atama bekliyor) / APPROVED (onaylı + kullanır).
  status     DeviceStatus @default(PENDING)
  /// Cihaz türü: TABLET / PHONE / DESKTOP (yönetici PC'si). Sadece görsel/etiket.
  kind       DeviceKind   @default(TABLET)

  // Relations
  machine       Machine?           @relation(fields: [machineId], references: [id])
  peripherals   PeripheralDevice[] // (eski) tablete-bağlı tekil sahiplik (registerBt geçişte)
  hardwareLinks DevicePeripheral[] // YENİ: cihazın kullandığı donanım (çok-çok, paylaşılabilir)
  workSessions  WorkSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([status])
  @@map("devices")
}

/// Birleşik CİHAZ KAYDI — yazıcılar (ağ/Bluetooth/USB/seri) + tekstil makine
/// sinyal kaynakları (kantar/metraj, kayıt-only). Her cihaz dilini (languageOverride;
/// boş → global `label.printerLanguage`), MEDYASINI (labelWidthMm vd.; boş → sistem
/// varsayılan medyası) ve şablon yönlendirmesini taşır →
/// baskı anında cihaz→{dil,medya,şablon} çözülür. Sahiplik tam-biri: makineye
/// SABİT (machineId) VEYA tablete-BAĞLI (deviceId, BT yazıcı tabletle gezer).
/// Saha donanımının TEK kaynağı — eski `MachineHardware` emekliye ayrıldı.
/// Okuma davranışı — cihaz VERİsi (kod değil). POLL: pollCommand yolla, cevabı oku
/// (Tambur metresi "TTTTTT" → metraj). STREAM: cihaz sürekli yayınlar; dinle, son
/// (kararlı) çerçeveyi al (Sevkiyat kantarı sürekli kg akıtır). Yeni davranışlı
/// cihaz = yeni satır + bu alan; uygulama kodu değişmez.
enum PeripheralReadMode {
  POLL
  STREAM
}

model PeripheralDevice {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(48)
  name String @db.VarChar(100)

  kind           PeripheralKind
  connectionType ConnectionType

  address         String? @db.VarChar(128) // IP / MAC / COM yolu / BLE UUID
  port            Int? // NETWORK_TCP (null → 9100 kullanımda)
  identifyPattern String? @db.VarChar(255) // SCALE/METER veri çözüm regex'i

  // --- Giriş cihazı (SCALE/METER) okuma protokolü — davranış tamamen VERİ ---
  readMode    PeripheralReadMode @default(POLL) // POLL=sor-cevap (komut yolla), STREAM=sürekli yayın (dinle)
  pollCommand String?            @db.VarChar(64) // POLL sorgu komutu; escape destekli (\r \n \xNN), TAM gönderilir
  terminator  String?            @db.VarChar(8) // Yanıt satır sonu (örn "\r\n"); boş → herhangi CR/LF
  decimals    Int? // Codec yuvarlama hassasiyeti (boş → 1)
  scale       Decimal?           @db.Decimal(10, 4) // Ham → mühendislik çarpanı (cm→m: 0.01); boş → 1
  unit        String?            @db.VarChar(8) // "m" / "kg"
  timeoutMs   Int? // Okuma zaman aşımı ms (boş → 2500)
  role        String?            @db.VarChar(24) // Makine içi ayraç: "2-KAT" / "4-KAT" / "PRIMARY"
  simulate    Boolean            @default(false) // Per-cihaz simülasyon (gerçek I/O yerine sahte değer)

  // Sahiplik — tam biri (serviste enforce edilir).
  machineId String?  @db.Uuid
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  deviceId  String?  @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// MAKİNESİZ istasyona sabit donanım (örn. sevkiyat çuval kantarı). Yalnız makinesi
  /// olmayan istasyona bağlanabilir (serviste enforce) — makineli istasyonda donanım
  /// MAKİNEYE bağlanmalı (yan yana özdeş HC-06 belirsizliğinin tek çözümü makine bağı).
  stationId String?  @db.Uuid
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  // Yazıcı MEDYASI — takılı etiket ölçüsü DOĞRUDAN cihazda (Etiket Stüdyosu v2:
  // ayrı LabelFormatProfile "Boyutlar" kataloğu EMEKLİ; baskıda medya buradan,
  // eleman koordinatları varyanttan). Boş → sistem varsayılan medyası (ayar).
  labelWidthMm  Decimal? @db.Decimal(6, 2)
  labelHeightMm Decimal? @db.Decimal(6, 2)
  labelDpi      Int? // boş → 203
  labelGapMm    Decimal? @db.Decimal(5, 2) // etiketler arası (gap sensörü); boş → 2

  languageOverride PrinterLanguage? // cihaz dili (boş → global ayar label.printerLanguage)
  mediaType        PrinterMediaType? // baskı yöntemi (boş → yazıcı otomatik; PPLA/ZPL'de komuta çevrilir)
  /// Raster baskı: kanvas-varyantlı etiket 1bpp bitmap (raster) olarak gönderilir
  /// (önizleme=baskı birebir); false = bugünkü komut üretimi (bayt-aynı). Cihaz-başına
  /// opt-in; PPLA'da grafik komutu (F0) doğrulanana dek açılsa bile komuta düşer.
  rasterMode Boolean @default(false)

  isActive   Boolean   @default(true)
  /// KALICI silinme damgası (users.deletedAt kalıbı) — NULL=normal (isActive ile
  /// aktif/pasif); dolu=silinmiş: hiçbir listede görünmez, düzenlenemez/geri
  /// getirilemez; satır yalnız veri bütünlüğü için durur (kod DEL- önekiyle serbest).
  deletedAt  DateTime? @db.Timestamptz
  lastSeenAt DateTime?
  notes      String?   @db.VarChar(500)

  templateRoutes PeripheralTemplateRoute[]
  deviceLinks    DevicePeripheral[] // YENİ: bu donanımı kullanan cihaz(lar) (çok-çok)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([deviceId])
  @@index([stationId])
  @@index([connectionType])
  @@index([isActive])
  @@map("peripheral_devices")
}

/// Cihaz ↔ donanım atama (ÇOK-ÇOK). Bir cihaz birçok donanım kullanır; bir donanım
/// (ör. ağ yazıcısı) birçok cihaza atanabilir — PAYLAŞIM. Admin manuel yönetir.
/// (BT okuyucu/kantar fiziksel olarak tek host'a bağlanır; model paylaşıma izin verir,
/// doğru atama yöneticinin sorumluluğudur.)
model DevicePeripheral {
  id           String           @id @default(uuid()) @db.Uuid
  deviceId     String           @db.Uuid
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@unique([deviceId, peripheralId])
  @@index([peripheralId])
  @@map("device_peripherals")
}

/// Cihaz başına LabelKind → şablon yönlendirme. JSON yerine indekslenebilir +
/// FK-bütünlüklü child tablo. (peripheralId, kind) tekil.
model PeripheralTemplateRoute {
  id           String           @id @default(uuid()) @db.Uuid
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  kind         LabelKind
  templateId   String           @db.Uuid
  template     LabelTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([peripheralId, kind])
  @@index([templateId])
  @@map("peripheral_template_routes")
}

/// Tablet allowlist durumu — PairingCode (6-haneli kod) emekliye ayrıldı; cihaz
/// kimliği artık `Device.status` (announce → PENDING → admin onayı → APPROVED).
enum DeviceStatus {
  PENDING
  APPROVED
}

/// Çalışma oturumunun kapanış nedeni. Açık oturumda (endedAt null) NULL kalır;
/// kapatan HER yol set eder (servis tek geçit).
enum WorkSessionEndReason {
  LOGOUT // Kullanıcı çıkışı / mobil "oturumu kapat"
  NEW_LOGIN // Aynı cihazda yeni oturum açıldı (vardiya değişimi)
  TAKEOVER // Başka cihaz aynı makineyi devraldı
  IDLE // Hareketsizlik zaman aşımı (tembel kapatma — workSession.idleTimeoutMinutes)
  ADMIN // Panelden zorla kapatıldı
}

/// ÇALIŞMA OTURUMU (ayak izi): KİM (userId) HANGİ CİHAZLA (deviceId) NEREDE
/// (machineId/stationId) NE ZAMAN (startedAt–endedAt) çalıştı. Donanım çözümü
/// (for-session) ve üretim atfı (RollOperation.machineId vb.) AKTİF oturumdan okunur.
/// stationId HER ZAMAN dolu: makineli oturumda server makineden türetip DONDURUR
/// (makine sonradan istasyon değiştirse geçmiş bozulmaz — denormalize bilinçli);
/// makinesiz istasyon oturumunda (SHIPPING) machineId null kalır.
model WorkSession {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  /// FK devices.id (PK, UUID) — tabletin local kimliği (devices.deviceId) DEĞİL.
  deviceId  String  @db.Uuid
  machineId String? @db.Uuid
  stationId String  @db.Uuid

  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  endReason      WorkSessionEndReason?
  /// Son aktivite — device.middleware'in lastSeenAt throttle'ına piggyback (60sn'de
  /// bir fire-and-forget). Tembel idle kapatma (resolveActiveSession) bunun eskiliğine bakar.
  lastActivityAt DateTime              @default(now())

  // Ayak izi tarihçesi korunur — hiçbir taraf silinirken oturum geçmişi kaybolmaz/boşalmaz.
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)
  station Station  @relation(fields: [stationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([machineId, startedAt])
  @@index([stationId, startedAt])
  @@index([deviceId, startedAt])
  // Aktif oturum filtreleri (endedAt IS NULL) — canlı panel + resolveActiveSession
  @@index([endedAt])
  // DB'de ayrıca ŞEMA-DIŞI iki partial unique var (migration 20260702121000):
  //   work_sessions_active_machine_uq (machineId) WHERE "endedAt" IS NULL AND "machineId" IS NOT NULL
  //   work_sessions_active_device_uq  (deviceId)  WHERE "endedAt" IS NULL
  // "Bir makinede tek aktif oturum + bir cihazda tek aktif oturum" invariant'ının DB
  // seddi — eşzamanlı open yarışının kaybedeni P2002 alır (servis 409'a çevirir).
  // Partial UNIQUE @@index ile ifade edilemediğinden şemada karşılığı bilinçli YOK
  // (roll_movements_one_open_per_roll_step_uq emsali).
  @@map("work_sessions")
}

model Route {
  id          String  @id @default(uuid()) @db.Uuid
  code        String? @unique @db.VarChar(32) // Opsiyonel kısa kod: "BKT-STD"
  name        String  @db.VarChar(100) // e.g. "Boyahane + Kursun + Tambur"
  description String?
  isFavorite  Boolean @default(false) // Sık kullanılan şablon
  customerId  String? @db.Uuid // Müşteriye özel default rota (opsiyonel)
  isActive    Boolean @default(true)

  // Relations
  customer       Customer?       @relation("CustomerDefaultRoutes", fields: [customerId], references: [id])
  steps          RouteStep[]
  workOrders     WorkOrder[] // Bu şablondan türetilen WO'lar (analytics)
  productRecipes ProductRecipe[] // Bu rotayı kullanan üretim reçeteleri

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([isFavorite])
  @@map("routes")
}

model RouteStep {
  id                     String  @id @default(uuid()) @db.Uuid
  routeId                String  @db.Uuid
  stationId              String  @db.Uuid
  sequence               Int // Order in the route
  defaultNotes           String? // Şablonda saklanan istasyon talimatı — WO oluşturulurken notes'a kopyalanır
  // Saha #14: rota şablonu fason planlamasını da saklasın — eskiden yalnız
  // WO formunun stepPlanning overlay'i vardı, şablona seçilen firma KAYBOLUYORDU.
  // WO açılışında bu değerler default olarak klonlanır (overlay yine ezebilir).
  requiredCategoryId     String? @db.Uuid
  plannedSubcontractorId String? @db.Uuid

  // Relations
  route                Route                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station              Station                @relation(fields: [stationId], references: [id])
  requiredCategory     SubcontractorCategory? @relation("RouteStepRequiredCategory", fields: [requiredCategoryId], references: [id])
  plannedSubcontractor Subcontractor?         @relation("RouteStepPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId, sequence])
  // K7: stationId lider-kolon index'i — "bu istasyon hangi rotalarda?" sorguları
  // (station hardRemove guard'ı dahil) composite'in 2. kolonunu kullanamıyordu.
  @@index([stationId])
  @@index([requiredCategoryId])
  @@index([plannedSubcontractorId])
  @@map("route_steps")
}

/// Üretim reçetesi — bir ürünü (kumaş + renk + özellikler + en + rota) tek
/// isim/kod altında paketler. İş emri açılışında seçilince hedef alanlar + rota
/// otomatik dolar (örn "PATOS GRİ-038"). Rota tekrar-kullanılabilir kalır;
/// reçete rotanın ÜSTÜNDE ayrı bir katmandır — rotayı dönüştürmez.
model ProductRecipe {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(32)
  name     String   @db.VarChar(100)
  itemId   String   @db.Uuid
  colorId  String?  @db.Uuid
  width    Decimal? @db.Decimal(12, 3)
  foldType String?
  routeId  String?  @db.Uuid
  isActive Boolean  @default(true)

  // Relations
  item       Item                    @relation(fields: [itemId], references: [id])
  color      Color?                  @relation(fields: [colorId], references: [id])
  route      Route?                  @relation(fields: [routeId], references: [id])
  properties ProductRecipeProperty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([colorId])
  @@index([routeId])
  @@map("product_recipes")
}

/// ProductRecipe ↔ FabricProperty M:N — reçetenin üretim özellikleri.
/// Append-only pivot (sadece createdAt).
model ProductRecipeProperty {
  id         String @id @default(uuid()) @db.Uuid
  recipeId   String @db.Uuid
  propertyId String @db.Uuid

  recipe   ProductRecipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([recipeId, propertyId])
  @@index([propertyId])
  @@map("product_recipe_properties")
}

// =============================================================================
// 3. ITEM (Stock Card) & INVENTORY
// =============================================================================

/// Stok kartı — tek kayıt olarak ürünün kendisini tanımlar (örn. "Patos").
/// Renk ve özellikler kimliğin parçası DEĞİLDİR; rulo/sipariş/iş emri seviyesinde
/// taşınır. Üründe sadece "izin verilen renk/özellik listesi" tutulur (M:N).
/// Boş liste = tüm aktif renk/özelliğe izin var.
model Item {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(32)
  name     String   @db.VarChar(100)
  itemType ItemType // YARN, FABRIC, CONSUMABLE
  unit     ItemUnit @default(MT)
  isActive Boolean  @default(true)

  // Relations
  rolls              Roll[]
  orderLines         OrderLine[]
  swatches           Swatch[]
  /// Item'a uygulanabilir renkler (allowed). Boş = tüm aktif Color serbest.
  allowedColors      ItemAllowedColor[]
  /// Item'a uygulanabilir özellikler (allowed). Boş = tüm aktif FabricProperty serbest.
  allowedProperties  ItemAllowedProperty[]
  workOrdersAsTarget WorkOrder[]           @relation("WorkOrderTargetItem")
  /// Müşteri-bazlı isim alias'ları — etiket basımında "müşterideki adı" için.
  customerAliases    CustomerItemAlias[]
  productRecipes     ProductRecipe[]
  rollReturns        RollReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemType])
  @@map("items")
}

model Roll {
  id          String  @id @default(uuid()) @db.Uuid
  /// Fiziksel barkod. KK1 girişinde + Tambur kesim çıktısında basılır.
  /// Açık kumaş Roll'ları (Kurşun/KK2'de doğan) için NULL — fiziksel etiket basılmaz.
  /// Unique constraint: PostgreSQL'de NULL'lar tek olabilir (multiple NULLs allowed).
  barcode     String? @unique @db.VarChar(64)
  /// Idempotency anahtarı — mobil/istemci üretir (UUID); ağ-retry'de mükerrer top
  /// yaratılmasını önler. Barkod artık SUNUCU tarafından sıralı atandığından
  /// (TEKS+YYMMDD+H/F+A001..) dedup görevini barkod yerine bu alan yapar. Sunucu-üretimi
  /// (KK1 dışı) kayıtlar için NULL — partial unique index (NULL'lar çakışmaz).
  clientToken String? @unique @db.Uuid
  itemId      String  @db.Uuid
  /// Rulonun kazandığı renk. Üretim sürecinde "renk veren" fason adımı (örn.
  /// boyahane) başarıyla tamamlandıktan sonra WO.targetColorId'den kopyalanır.
  /// NULL = ham (henüz renk kazanmamış). Rulonun "ham/işlenmiş" ayrımının tek
  /// kaynak doğrusudur.
  colorId     String? @db.Uuid

  // Measurements
  initialQty Decimal  @db.Decimal(12, 3) // Initial measurement (meters)
  currentQty Decimal  @db.Decimal(12, 3) // Remaining/net quantity
  weightKg   Decimal? @db.Decimal(12, 3)

  // Status & Quality
  status         RollStatus @default(STOCK)
  /// Snapshot — yazıldığı andaki kalite kodu (katalog değişse bile sabit).
  /// Service-level zorunlu (inventory/tambur/subcontractor explicit set eder).
  qualityGrade   String
  /// Canonical — QualityGrade kataloğundaki gerçek kayda referans.
  /// Eski satırlarda null kalabilir; yeni Tambur finalize kayıtlarında doldurulur.
  qualityGradeId String?    @db.Uuid
  width          Decimal?   @db.Decimal(12, 3) // En (cm) — KK1 girişinde ölçülen kumaş eni

  // Top'un sisteme nasıl girdiği — raporlama ayrımı için.
  // itemType "ne olduğunu", entrySource "nereden geldiğini" söyler.
  entrySource RollEntrySource @default(SUPPLIER_RECEIPT)

  // Kartelalık işareti — Tambur finalize'da set edilir. Depoda kartelaya gidecek
  // topları kolay bulmak için bir filtre/rozet. Sevki ENGELLEMEZ; işaretsiz top da
  // kartelaya gönderilebilir. Backend toggle ile kaldırılabilir (frontend gerekmez).
  markedForKartela Boolean @default(false)

  // Production Links (real relations — not plain strings)
  producedInStepId String? @db.Uuid // Hangi WO step'inde üretildi (KK1 girişi / Tambur çıktısı)
  currentStepId    String? @db.Uuid // Şu anda hangi WO step'inde

  // Lineage — fason dönüşünde veya tambur kesiminde kaynak rulo
  parentRollId String? @db.Uuid

  // Lineage — fason kabul (boyahane vb.) sonrası açık kumaş olarak doğan Roll'ların
  // kaynak SubcontractorReceipt'i. Receipt = batch (renk + property) referansı.
  // Açık kumaş ileride Tambur'da bölünüp gerçek toplara dönüşür (parentRollId).
  parentReceiptId String? @db.Uuid

  // Fason dalı / parti kimliği — paralel akış (lane) izlenebilirliği (Phase 4).
  // origin = sevki yaratan SubcontractorDispatch.id; fason kabulde born roll'a,
  // Tambur kesiminde çocuk roll'a KALITILIR → bir dal tüm rota boyunca (depodaki
  // bölünmüş çocuklar dahil) tek kimlikle izlenir. NULL = fason'a hiç girmemiş
  // ana akış. FK değil (dispatch silinmez ama soft-cancel olur; serbest grup anahtarı).
  batchSplitId String? @db.Uuid

  // Audit — KK1 girişinde / sistem genelinde topu kim oluşturdu
  // (vardiya devirlerinde "bu kaydı kim aldı" sorgusu için)
  createdById String? @db.Uuid

  // Audit — KK1 girişinde topun oluşturulduğu MAKİNE (aktif çalışma oturumundan
  // damgalanır — Faz 2). KK1 girişi RollOperation üretmediği için makine atfı Roll
  // üstünde kapanır (createdById'nin makine kardeşi). NULL = oturumsuz giriş (web).
  createdMachineId String? @db.Uuid

  // Paketleme — topun okutulduğu sevkiyat oturumu. NULL = henüz sevkiyata girmedi
  // (serbest depo). Çuvallanan top PLANNED boyunca WAREHOUSE kalır ama
  // shipmentId dolu → SERBEST stoktan düşer (çuval depo/kapı önü). SHIPPED'a yalnız
  // DISPATCHED'te (kamyon aldı) çekilir; iptalde shipmentId temizlenir, serbest depoya döner.
  // GEVŞEK MODEL: top→sipariş bağı YOK; etiket müşterisi baskı anında seçilir.
  shipmentId String? @db.Uuid

  // Çuval — topun fiziksel olarak içinde bulunduğu çuval (Sack). NULL = sevkiyata
  // okutuldu ama henüz çuvalda değil. Çuval-önce akışta okutma doğrudan aktif çuvala
  // yazar. Çuval içeriği = sackId'si o çuval olan toplar (irsaliyede ürün-bazlı döküm +
  // claim/iz sürme). shipment ile tutarlı: sack.shipmentId == roll.shipmentId.
  sackId String? @db.Uuid

  // GEVŞEK MODEL: topun ÜSTÜNDEKİ son basılan etiketin denormalize snapshot'ı
  // (müşteri/sipariş/ürün-renk adı + baskı tarihi/operatör). BAĞ DEĞİL — yalnız
  // "şu an hangi etiket basılı" bilgisi; kapsama/sevk mantığına GİRMEZ. Müşterisiz
  // (stok) baskıda null'a çekilir. Küçük/nullable alan; index/filtre yok → liste
  // sorgusunda dönse de perf etkisi yok, asıl detay (findRollById) kullanır.
  lastLabelSnapshot Json?

  // Etiket bayat mı? Veri/metraj/renk/kalite/en/özellik "Yeniden Etiketle/Düzelt" ile
  // değiştirilince true → topun ÜSTÜNDEKİ fiziksel etiket artık veriyle uyuşmuyor
  // (yeniden basılmalı). Etiket basılınca (recordPrintEvent) false'a döner. Küçük bayrak;
  // filtre/index yok — detay/context/liste select'inde döner, "yeniden bas" uyarısını besler.
  labelDirty Boolean @default(false)

  // Relations
  item                 Item                        @relation(fields: [itemId], references: [id])
  color                Color?                      @relation(fields: [colorId], references: [id])
  qualityGradeRef      QualityGrade?               @relation(fields: [qualityGradeId], references: [id])
  errors               RollError[]
  movements            RollMovement[]
  operations           RollOperation[]
  parent               Roll?                       @relation("RollLineage", fields: [parentRollId], references: [id])
  children             Roll[]                      @relation("RollLineage")
  parentReceipt        SubcontractorReceipt?       @relation("RollFromReceipt", fields: [parentReceiptId], references: [id])
  /// Bu rol parent olarak hangi RollOperation kayıtlarına kaynak — Tambur kalıtım izi
  inheritedOperations  RollOperation[]             @relation("RollOperationInherited")
  dispatchItems        SubcontractorDispatchItem[]
  receiptItems         SubcontractorReceiptItem[]
  kartelaDispatchItems KartelaDispatchItem[]       @relation("RollKartelaDispatchItems")
  kartelaConsumedItems KartelaReceiptItem[]        @relation("RollKartelaConsumed")
  swatchesFrom         Swatch[]                    @relation("SwatchParentRoll")
  currentStep          WorkOrderStep?              @relation("RollCurrentStep", fields: [currentStepId], references: [id])
  producedInStep       WorkOrderStep?              @relation("RollProducedInStep", fields: [producedInStepId], references: [id])
  createdBy            User?                       @relation("RollCreatedBy", fields: [createdById], references: [id])
  createdMachine       Machine?                    @relation("RollCreatedMachine", fields: [createdMachineId], references: [id])
  properties           RollProperty[]
  shipment             Shipment?                   @relation(fields: [shipmentId], references: [id])
  sack                 Sack?                       @relation(fields: [sackId], references: [id])
  returns              RollReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([parentRollId])
  // PARTIAL (WHERE "parentReceiptId" IS NOT NULL) — migration 20260606001717.
  // Çoğu ruloda null; partial = küçük indeks + null insert'te bakım yok. Şemada
  // @@index tam görünür ama DB'de partial'dır (Prisma 7 predicate'i drift saymaz).
  @@index([parentReceiptId])
  @@index([createdById])
  // KK1 makine atfı raporu ("bu makinede girilen toplar")
  @@index([createdMachineId])
  // Liste sayfaları: status filter + createdAt desc sort
  @@index([status, createdAt])
  // Ham/işlenmiş filter: WHERE "colorId" IS NULL (ham) — yüksek seçicilikli partial index
  // (Postgres native; Prisma şemasında native değil ama @@index runtime'da partial olmadan
  // eklenir; ileride raw migration ile partial CONCURRENTLY üretmek gerekebilir.)
  @@index([colorId, status])
  // Raporlama: kaynak bazlı dönem sorguları (örn. "Mart 2027 ham kumaş üretimi")
  @@index([entrySource, createdAt])
  // WO detayı: "şu adımda üretilen + WAREHOUSE/A1_STOCK" sorgusu
  @@index([producedInStepId, status])
  // Fason kuyruğu: "bu adımda + AT_SUBCONTRACTOR" listeleme
  @@index([currentStepId, status])
  // Dal/lane izi: bir partinin (batchSplitId) tüm rotadaki tops'larını topla.
  // PARTIAL (WHERE "batchSplitId" IS NOT NULL) — migration 20260606001717.
  @@index([batchSplitId])
  @@index([qualityGradeId])
  // Sevkiyat oturumunun topları (shipmentId = X). PARTIAL (WHERE "shipmentId" IS
  // NOT NULL) — migration 20260606001717. NOT: "depodaki serbest stok" (shipmentId
  // IS NULL) bu indeksi KULLANMAZ — o sorgu zaten status indeksinden geçer (null
  // satırlar çoğunluk, düşük seçicilik; ölçüldü: balance groupBy status indeksini seçer).
  @@index([shipmentId])
  // Çuval içeriği: bir çuvaldaki toplar (irsaliye/detay dökümü).
  // PARTIAL (WHERE "sackId" IS NOT NULL) — migration 20260606001717.
  @@index([sackId])
  // Spec-toplam karşılanma: item+renk+en eşleşen WAREHOUSE/STOCK toplar (fungible havuz)
  @@index([status, itemId, colorId, width])
  // Kartelalık filtresi: Tambur'da işaretlenmiş depodaki toplar. PARTIAL (WHERE
  // "markedForKartela" = true) — migration 20260607020000. True olan satırlar
  // toplam rollerin %1-2'si → micro-index; false satırlar indekslenmez.
  @@index([markedForKartela])
  // F123: status-filtreli listede currentQty sıralaması (depo miktar). initialQty/width/
  // qualityGrade İÇİN eklenmedi — rolls çok-index'li (D-8); ölçekte EXPLAIN ihtiyaç gösterirse.
  @@index([status, currentQty])
  @@map("rolls")
}

// =============================================================================
// 4. SALES, ORDER & FINANCE
// =============================================================================

model Customer {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique @db.VarChar(32)
  name      String      @db.VarChar(100)
  taxNumber String?
  type      CompanyType @default(CUSTOMER)
  isActive  Boolean     @default(true)

  // Relations
  orders         Order[]
  defaultRoutes  Route[]                 @relation("CustomerDefaultRoutes")
  branches       CustomerBranch[]
  itemAliases    CustomerItemAlias[]
  colorAliases   CustomerColorAlias[]
  shipments      Shipment[]
  sacks          Sack[]
  rollReturns    RollReturn[]
  templateRoutes CustomerTemplateRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("customers")
}

// =============================================================================
// CUSTOMER BRANCH — Müşterinin sevk noktası (şube/depo/mağaza adresi)
// =============================================================================
// Sevkiyatın hedefi her zaman bir şubedir. Aynı müşterinin farklı şehir/şube
// sevkiyatları ayrı planlanır. Soft delete: isActive=false.
// =============================================================================
model CustomerBranch {
  id           String  @id @default(uuid()) @db.Uuid
  customerId   String  @db.Uuid
  code         String? @db.VarChar(50) // Müşterinin iç şube kodu (opsiyonel)
  name         String  @db.VarChar(100) // "Ankara Şubesi", "Merkez Depo" gibi
  address      String?
  city         String?
  district     String?
  contactName  String?
  contactPhone String?
  notes        String?
  isActive     Boolean @default(true)

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders    Order[]
  shipments Shipment[]
  sacks     Sack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isActive])
  @@map("customer_branches")
}

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique @db.VarChar(64)
  customerId  String  @db.Uuid
  branchId    String? @db.Uuid // Hedef şube — opsiyonel; bir sipariş tek bir şubeye gider. Mevcut kayıtlar için null kabul.

  // Finance & Pricing
  currency    Currency @default(TRY)
  totalAmount Decimal? @db.Decimal(14, 2)

  status    OrderStatus @default(PENDING)
  orderDate DateTime    @default(now())
  deadline  DateTime?

  /// Denormalize sevk toplamı (m). Tek yazma noktası: recomputeOrderFulfillment.
  /// Liste sayfasında "shippedQty / sum(lines.quantity)" gösterimi için.
  shippedQty Decimal @default(0) @db.Decimal(12, 3)

  // Tamamlanma kaydı
  completedAt       DateTime? // İlk COMPLETED'a düştüğü an (otomatik veya manuel)
  manualClosedById  String?   @db.Uuid // Manuel kapatan kullanıcı (null = otomatik kapandı)
  manualCloseReason String?   @db.Text

  // Relations
  customer       Customer        @relation(fields: [customerId], references: [id])
  branch         CustomerBranch? @relation(fields: [branchId], references: [id])
  manualClosedBy User?           @relation("OrderManualClosedBy", fields: [manualClosedById], references: [id])
  lines          OrderLine[]
  shipmentLinks  ShipmentOrder[] // Paketleme oturumlarında seçildiği sevkiyatlar
  rollReturns    RollReturn[] // Bu siparişe atfedilen iadeler (sevk muhasebesini değiştirmez)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@index([manualClosedById])
  @@index([status, createdAt(sort: Desc)])
  @@index([deadline])
  @@map("orders")
}

// Sipariş satırı — `itemId` baz ürünü (örn. PATOS) işaret eder. Renk ayrı
// alanda (`colorId`); özellikler `requiredProperties` (M:N) ile saklanır.
// Planlamacı WO açarken bu üçü targetItem/targetColor/targetProperties
// önerisi olarak kullanır.
model OrderLine {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  itemId     String   @db.Uuid
  /// Müşterinin istediği renk. NULL = ham talep (ileride satılabilir; bugün
  /// default akış değil). Item.allowedColors dolu ise bu listeden olmalı.
  colorId    String?  @db.Uuid
  quantity   Decimal  @db.Decimal(12, 3) // Requested quantity (meters)
  /// Denormalize SEVK toplamı (m) — Σ(SackAllocation.qty; çuval DISPATCHED'te). Tek yazma
  /// noktası recomputeOrderFulfillment. recomputeOrderStatus/status bunu okur.
  /// Açık miktar = quantity − shippedQty (rezerv/packedQty YOK — düşüş yalnız sevkte).
  shippedQty Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice  Decimal? @db.Decimal(12, 2) // For future finance module
  width      Decimal? @db.Decimal(12, 3) // İstenen en (cm)

  /// Tambur kesim talimatı — eşit-parça otomatik öneri. Örn 400 = "her 400 m'de bir kes".
  /// NULL = serbest kesim (operatör karar verir). Tambur bu değerden kesim önerir.
  pieceLengthM Decimal? @db.Decimal(12, 3)
  /// Kesim/sevk için serbest not (pieceLengthM'e sığmayan istisna talimatlar).
  cutNote      String?

  /// "Müşterideki adı" — sipariş satırı bazlı override (1-shot).
  /// NULL ise effective name CustomerItemAlias.alias'tan (master, live) okunur;
  /// o da yoksa Item.name (default). Master değişti → bu null satırlar otomatik
  /// yansıtır; bu alan dolu ise kilit (özel istek için frozen).
  customerItemName  String?
  /// "Müşterideki rengin adı" — aynı override mantığı (CustomerColorAlias → Color.name).
  customerColorName String?

  // Relations
  order                 Order                               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item                  Item                                @relation(fields: [itemId], references: [id])
  color                 Color?                              @relation(fields: [colorId], references: [id])
  workOrderLinks        WorkOrderToOrderLine[]
  requiredProperties    OrderLineRequiredProperty[]
  sackAllocations       SackAllocation[]
  directShipAllocations SubcontractorDirectShipAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  // D-6: @@index([itemId]) kaldırıldı — @@index([itemId, createdAt]) sol-prefix'i kapsar.
  @@index([colorId])
  // Sipariş-önce aramalı liste (cursor keyset createdAt asc) + ürün-filtreli sayfalama.
  @@index([createdAt])
  @@index([itemId, createdAt])
  @@map("order_lines")
}

/// OrderLine ↔ FabricProperty M:N — müşterinin sipariş satırı için
/// istediği özellikler. WO oluşturulurken planlamacıya öneri olarak gelir.
model OrderLineRequiredProperty {
  id          String @id @default(uuid()) @db.Uuid
  orderLineId String @db.Uuid
  propertyId  String @db.Uuid

  orderLine OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  property  FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderLineId, propertyId])
  @@index([propertyId])
  @@map("order_line_required_properties")
}

// =============================================================================
// 5. WORK ORDER (BATCH) & DYNAMIC ROUTING
// =============================================================================

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  batchNumber      String          @unique @db.VarChar(64) // Parti Numarası
  type             WorkOrderType   @default(ORDER_PRODUCTION)
  width            Decimal?        @db.Decimal(12, 3) // En (cm) — kumaş eni
  targetQuantity   Decimal?        @db.Decimal(12, 3) // Hedef uzunluk/metraj
  targetWeight     Decimal?        @db.Decimal(12, 3) // Hedef ağırlık (kg) — opsiyonel; tekstilde mt+kg planlanır
  parameters       Json? // Dynamic params: serbest meta
  status           WorkOrderStatus @default(PLANNED)
  plannedStartDate DateTime? // Planlanan başlangıç tarihi
  plannedEndDate   DateTime? // Planlanan termin / bitiş tarihi

  // 3.1 — Rota şablonu referansı (snapshot kopya sonrası bile tutulur; analytics için)
  routeTemplateId String? @db.Uuid
  routeTemplate   Route?  @relation(fields: [routeTemplateId], references: [id])

  // Hedef ürün — planlamacının "ne üretiyoruz" cevabı. Item'ın kendisini işaret
  // eder. Renk ve özellikler ayrı alanlardadır: targetColorId + targetProperties M:N.
  // targetColorId, rotadaki "renk veren" (SubcontractorCategory.appliesColor=true)
  // Fason Kabul'ünde Roll'a kopyalanır. targetProperties ise "özellik veren"
  // (SubcontractorCategory.appliesProperty=true) adımda kopyalanır — aynı adım
  // her ikisini de yapabilir (Boyahane gibi).
  // ORDER_PRODUCTION: orderLine.itemId/colorId/properties'den otomatik
  // STOCK_PRODUCTION: zorunlu (manuel seçilir)
  targetItemId  String? @db.Uuid
  targetColorId String? @db.Uuid

  /// Tambur planlama bilgisi — kumaşın kaç-kat sarılacağı ("2-KAT" / "4-KAT" gibi).
  /// Tambur ekranında **bilgi olarak** gösterilir; nihai kararı operatör verir
  /// (finalize sırasında override edebilir, gerçek değer RollOperation
  /// metadata'sına yazılır).
  foldType String?

  // O-9: WorkOrder.dyehouseNote kaldırıldı — fason talimatı tek kaynağı
  // WorkOrderStep.notes (bkz. project_dyehouse_note). Kolon drift-fix ile yanlışlıkla
  // geri gelmişti, kod kullanmıyordu; migration 20260708140000 ile DROP edildi.

  // Soft-delete bayrağı — hardDelete artık `isActive=false` yapar; bağlı
  // RollOperation / TravelerCard / Manifest / Swatch / Dispatch / Receipt
  // ve WorkOrderStep kayıtları korunur (izlenebilirlik + audit). Listeler
  // default `isActive: true` filtreler. Detay endpoint (findById) arşivli
  // WO'ları da getirir.
  isActive Boolean @default(true)

  /// Parti ayırma soy bağı — bu WO, başka bir WO'nun partisinden ayrıldıysa
  /// kaynak WO'nun id'si. Eski refakat kartı okutulunca kabul ekranı bu bağla
  /// ayrılan partilerin bekleyen gruplarını da gösterir; Dallar panelinde
  /// "ayrıldı → P-XXX" izi bu bağdan okunur. NULL = ayrılmamış normal WO.
  splitFromId String? @db.Uuid

  // Relations
  steps            WorkOrderStep[]
  orderLinks       WorkOrderToOrderLine[]
  travelerCards    TravelerCard[]
  manifests        Manifest[]
  dispatches       SubcontractorDispatch[]
  receipts         SubcontractorReceipt[]
  targetItem       Item?                     @relation("WorkOrderTargetItem", fields: [targetItemId], references: [id])
  targetColor      Color?                    @relation("WorkOrderTargetColor", fields: [targetColorId], references: [id])
  targetProperties WorkOrderTargetProperty[]
  splitFrom        WorkOrder?                @relation("WorkOrderSplitLineage", fields: [splitFromId], references: [id])
  splitChildren    WorkOrder[]               @relation("WorkOrderSplitLineage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeTemplateId])
  @@index([targetItemId])
  @@index([targetColorId])
  // Sevk picker'ı: WHERE status IN (...) ORDER BY createdAt DESC için composite
  @@index([status, createdAt(sort: Desc)])
  // "Termini Yakın" sıralaması: WHERE status IN (...) ORDER BY plannedEndDate ASC
  @@index([status, plannedEndDate])
  // Soft-delete filtreli listeler için
  @@index([isActive])
  // Ayrılma soy bağı — null-yoğun; migration'da partial'a çevrilir (IS NOT NULL)
  @@index([splitFromId])
  @@map("work_orders")
}

model WorkOrderStep {
  id           String     @id @default(uuid()) @db.Uuid
  workOrderId  String     @db.Uuid
  stationId    String     @db.Uuid
  stepSequence Int // Order in the route: 1, 2, 3
  status       StepStatus @default(PENDING)
  stepData     Json? // Station-specific data (e.g. Tambur: { "foldType": "4-kat" })
  notes        String? // Adıma özel talimat / not
  skipReason   String? // R6: SKIPPED ise neden
  startedAt    DateTime?
  completedAt  DateTime?

  // EXTERNAL adımlar için planlama alanları:
  //   requiredCategoryId    : Adım hangi tür fason hizmeti gerektiriyor (Boyahane, Yıkama vs)
  //   plannedSubcontractorId: Planlamada hangi firma seçildi (opsiyonel — sevk anında değiştirilebilir)
  requiredCategoryId     String? @db.Uuid
  plannedSubcontractorId String? @db.Uuid

  /// Planlamanın atadığı sıralama önceliği (Kurşun/KK2 kuyruğu gibi WO bazlı
  /// kuyruklar için). Düşük değer önce işlenir; tablet `open-cards`
  /// listesi ve Electron Kurşun Sırası bu alanı ortak okur.
  priority       Int       @default(0)
  /// Acil rozeti — planlama işaretler, operatör tablette kırmızı görür.
  isUrgent       Boolean   @default(false)
  urgentMarkedAt DateTime?

  // Relations
  workOrder            WorkOrder               @relation(fields: [workOrderId], references: [id])
  station              Station                 @relation(fields: [stationId], references: [id])
  movements            RollMovement[]
  cardScans            TravelerCardScan[]
  dispatches           SubcontractorDispatch[]
  receipts             SubcontractorReceipt[]
  operations           RollOperation[]
  currentRolls         Roll[]                  @relation("RollCurrentStep")
  producedRolls        Roll[]                  @relation("RollProducedInStep")
  detectedErrors       RollError[]             @relation("RollErrorDetectedAt")
  processedErrors      RollError[]             @relation("RollErrorProcessedAt")
  requiredCategory     SubcontractorCategory?  @relation("StepRequiredCategory", fields: [requiredCategoryId], references: [id])
  plannedSubcontractor Subcontractor?          @relation("StepPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D-12: adım sırası benzersiz — aynı WO'da iki adım aynı stepSequence'a sahip
  // olamaz (refakat kartı okutma sırası / "sıradaki adım" çözümlemesi belirsizleşmesin).
  @@unique([workOrderId, stepSequence])
  @@index([workOrderId, status])
  @@index([requiredCategoryId])
  @@index([plannedSubcontractorId])
  // Kurşun+KK2 / Tambur "Açık Kartlar" kuyruğu: station + bekleyen step + sıra.
  // @@index tam görünür ama DB'de PARTIAL'dır (WHERE status <> 'COMPLETED') —
  // COMPLETED yığını indekslenmez, açık kuyruk sorgusu O(açık step). Prisma 7
  // predicate'i drift saymaz. Migration: 20260607010000.
  @@index([stationId, status, isUrgent, priority, startedAt])
  @@map("work_order_steps")
}

/// Join table: WorkOrder ↔ OrderLine (N:N)
/// 3.2 — `allocatedQty`: bu WO'nun bu sipariş satırından tahsis ettiği metraj
model WorkOrderToOrderLine {
  workOrderId  String  @db.Uuid
  orderLineId  String  @db.Uuid
  allocatedQty Decimal @default(0) @db.Decimal(12, 3) // Metraj/kg cinsinden tahsis (sipariş birimiyle aynı)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([workOrderId, orderLineId])
  @@index([orderLineId])
  @@map("work_order_to_order_lines")
}

// =============================================================================
// 6. PRODUCTION DATA - Errors & Defects
// =============================================================================

/// Kalite derecesi kataloğu — Tambur/QC kararlarında operatör ekranında
/// buton olarak çıkar. Admin yönetir. Roll.qualityGrade alanı bu katalogdan
/// seçilen code'un snapshot'ıdır (katalog değişse bile eski toplar bozulmaz).
model QualityGrade {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(32) // "1.KALITE", "A1", "A2", "FIRE" (eski) veya KAL-YYMM-XXXX (admin)
  name         String     @db.VarChar(100) // UI'da görünen etiket
  description  String?
  color        String?    @db.VarChar(7) // "#10b981" vb. — UI rozeti için opsiyonel
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  /// Tambur'da bu kalite seçildiğinde çocuk top'un alacağı hedef RollStatus.
  /// 1. Kalite → WAREHOUSE, alt kaliteler (A1/A2/2.K) → A1_STOCK, FİRE → SCRAP.
  targetStatus RollStatus @default(SCRAP)

  /// İADE'ye özel hedef statü — müşteri iadesinde (returnGradingEnabled açık) bu
  /// kalite seçilirse top bu statüye iner (FİRE→SCRAP, A1→A1_STOCK, 1.Kalite→WAREHOUSE).
  /// `targetStatus`'tan KASTEN AYRI: targetStatus Tambur kesimi içindir (seed hep
  /// WAREHOUSE, dokunulmaz); bu kolon YALNIZ iade akışınca okunur. null → WAREHOUSE.
  returnTargetStatus RollStatus?

  rolls       Roll[]
  rollReturns RollReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("quality_grades")
}

/// İade nedeni kataloğu — admin CRUD. İade ekranında seçilebilir; ayrıca serbest
/// metin (RollReturn.reasonText) de girilebilir, ikisi de opsiyonel/boş bırakılabilir.
/// Soft-delete (isActive=false); mevcut RollReturn.reasonId snapshot'ları korunur.
model ReturnReason {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32) // "YANLIS_URUN", "HASARLI" ...
  name        String  @db.VarChar(100)
  description String?
  color       String? @db.VarChar(7) // UI rozeti (opsiyonel)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  rollReturns RollReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("return_reasons")
}

/// Hata tipi kataloğu — operatör ekranında buton olarak çıkar, elle girilmez.
/// Yönetici ekranı üzerinden eklenir/silinir. severity hataya görsel öncelik verir.
model DefectType {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(32)
  name        String          @db.VarChar(100)
  description String?
  severity    DefectSeverity? // UI renklendirme için
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  rollErrors RollError[]

  @@index([isActive])
  @@map("defect_types")
}

/// Top barkod sıra sayacı — gün+tip başına atomik sıralı numara kaynağı.
/// Barkod = `TEKS`+`YYMMDD`+`H|F`+encodeRollSeq(n). `INSERT … ON CONFLICT (day,type)
/// DO UPDATE n=n+1 RETURNING n` ile ÇAKIŞMASIZ (satır kilidi serileştirir) — offline
/// istemci sırayı üretemediği için sunucu tek kaynak. Yeni gün → yeni satır (n=1'den).
model RollBarcodeCounter {
  day  String @db.VarChar(6) /// YYMMDD
  type String @db.VarChar(1) /// H (ham) | F (final)
  n    Int    @default(0)

  @@id([day, type])
  @@map("roll_barcode_counters")
}

/// Top üzerinde tespit edilen hatalar. Kurşun/QC2 istasyonunda açılır,
/// Tambur istasyonunda karara bağlanır (kesildi/korundu/A1).
///
/// Hata tipi iki alanla tutulur:
///   - defectTypeId → DefectType FK (canonical, işlem anında seçilir)
///   - errorType    → DefectType.name'in snapshot'ı (katalog ileride yeniden
///                    adlandırılsa bile historik etiket korunur)
model RollError {
  id           String           @id @default(uuid()) @db.Uuid
  rollId       String           @db.Uuid
  /// Hatanın tespit edildiği metre noktası (KK2 operatörü "60. metrede hata"
  /// girer). Hata sadece NOKTA olarak takip edilir; aralık bilgisi tutulmaz.
  /// Tambur operatörü ekranda bu noktayı görüp fiziksel kesim kararı verir.
  startMeter   Decimal          @db.Decimal(12, 3)
  defectTypeId String?          @db.Uuid
  errorType    String? // DefectType.name snapshot (kayıt anında kopyalanır)
  isProcessed  Boolean          @default(false) // Tambur kararı verildi mi?
  actionTaken  RollErrorAction? // Tambur kararı

  // Lifecycle — tespit (Kurşun/QC2) ve işlem (Tambur) ayrı izlenir.
  detectedAtStepId  String?   @db.Uuid
  detectedByUserId  String?   @db.Uuid
  detectedAt        DateTime  @default(now())
  processedAtStepId String?   @db.Uuid
  processedByUserId String?   @db.Uuid
  processedAt       DateTime?

  // Relations
  roll            Roll           @relation(fields: [rollId], references: [id])
  defectType      DefectType?    @relation(fields: [defectTypeId], references: [id])
  detectedAtStep  WorkOrderStep? @relation("RollErrorDetectedAt", fields: [detectedAtStepId], references: [id])
  processedAtStep WorkOrderStep? @relation("RollErrorProcessedAt", fields: [processedAtStepId], references: [id])
  detectedBy      User?          @relation("RollErrorDetectedBy", fields: [detectedByUserId], references: [id])
  processedBy     User?          @relation("RollErrorProcessedBy", fields: [processedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mükerrer-hata yarışı guard'ı: (rollId,startMeter,defectTypeId) tekil. Migration
  // 20260623100000 bu @@index'i PARTIAL UNIQUE'e (WHERE defectTypeId IS NOT NULL)
  // çevirir (drift-free yöntem — şemada index, migration'da unique+partial). Tambur/
  // KK2 reportError eşzamanlı çift-tıkta P2002 → 409 DUPLICATE_ROLL_ERROR.
  // @@unique (index DEĞİL): DB'de PARTIAL UNIQUE (WHERE defectTypeId IS NOT NULL). Prisma 7
  // partial predicate'i drift saymaz; ama uniqueness FARKI (index↔unique) drift SAYAR →
  // bu yüzden @@unique olmalı (aksi halde migrate dev sonsuz CREATE üretir).
  @@unique([rollId, startMeter, defectTypeId], map: "roll_errors_roll_meter_defect_uq")
  @@index([detectedAtStepId])
  @@index([processedAtStepId])
  @@index([isProcessed])
  @@index([defectTypeId])
  // Tambur ekranı: bir topun bekleyen hatalarını listele
  @@index([rollId, isProcessed])
  // Operatör performans raporu: kim hangi tarihte hata kapadı
  @@index([processedByUserId, processedAt])
  // D-5: detectedByUserId sorgu yolu (Cihaz İşlem Dökümü raporu); processedBy emsaliyle simetrik.
  @@index([detectedByUserId, detectedAt])
  // Dashboard "bugün açılan hata" + kalite raporu tarih aralıkları (H-14):
  @@index([detectedAt])
  @@index([processedAt])
  @@map("roll_errors")
}

/// Top üzerinde yapılan somut işlem log'u (Kurşun geçildi, QC2 bitti, Tambur kararı, paketleme vb.).
/// Boolean bayrak yerine tarih + operatör + metadata ile tam iz bırakır.
/// Aynı roll × step × type için tek kayıt (@@unique) — idempotent tekrar basışlarda overwrite edilmez.
model RollOperation {
  id                        String            @id @default(uuid()) @db.Uuid
  rollId                    String            @db.Uuid
  workOrderStepId           String            @db.Uuid
  operationType             RollOperationType
  operatorId                String?           @db.Uuid
  /// Aynı istasyonda birden fazla makine varsa hangisinde işlendiğinin kaydı.
  /// İşlemin tabletten geldiği durumlarda Device→Machine üzerinden otomatik dolar.
  machineId                 String?           @db.Uuid
  metadata                  Json? // Operasyona özgü veri (qty, weight, cutPoints, foldType vb.)
  /// Tambur bölünmesinde parent'tan kopyalanan op'larda parent.id; orijinal kayıtlarda null.
  /// Aggregation/istatistik sorguları bu satırları "WHERE inheritedFromParentRollId IS NULL"
  /// ile filtreleyerek çift sayımı önler.
  inheritedFromParentRollId String?           @db.Uuid

  // Relations
  roll                Roll          @relation(fields: [rollId], references: [id])
  step                WorkOrderStep @relation(fields: [workOrderStepId], references: [id])
  operator            User?         @relation(fields: [operatorId], references: [id])
  machine             Machine?      @relation(fields: [machineId], references: [id])
  inheritedFromParent Roll?         @relation("RollOperationInherited", fields: [inheritedFromParentRollId], references: [id])

  createdAt DateTime @default(now())

  @@unique([rollId, workOrderStepId, operationType])
  // O-13: @@index([rollId]) (unique sol-prefix'i) ve @@index([operationType]) (tek başına
  // sürücü değil) kaldırıldı. O-14: rapor için operationType+createdAt (operationType-only'yi de kapsar).
  @@index([operationType, createdAt])
  @@index([operatorId])
  @@index([machineId])
  @@index([inheritedFromParentRollId])
  // Bir adımın işlem log'u (workOrderStepId filtreli + zaman sıralı)
  @@index([workOrderStepId, createdAt])
  // Operatör performans raporu createdAt aralığıyla tarar (H-14)
  @@index([createdAt])
  @@map("roll_operations")
}

// =============================================================================
// SYSTEM SETTING — runtime'da güncellenebilir konfigürasyon (key-value)
// =============================================================================
// Admin (admin:settings) okur/yazar.
// =============================================================================
model SystemSetting {
  key         String  @id @db.VarChar(100)
  /// Tip-güvenli değer: boolean, number, string, array veya object.
  /// Reader fonksiyonları JsonValue'dan beklenen tipi çıkarır.
  value       Json
  description String?
  updatedById String? @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =============================================================================
// 8. REFAKAT KARTI (Traveler Card) — Adım 5
// =============================================================================

model TravelerCard {
  id          String             @id @default(uuid()) @db.Uuid
  cardNumber  String             @unique @db.VarChar(64) // İnsan okur: RK-YYMM-000123
  barcode     String             @unique @db.VarChar(64) // Tarama: RK-YYMM-XXXXXX-C (Code128 uyumlu)
  workOrderId String             @db.Uuid
  version     Int                @default(1) // Aynı WO için kaçıncı basım (reprint)
  status      TravelerCardStatus @default(ACTIVE)
  printedAt   DateTime           @default(now())
  printedById String?            @db.Uuid
  voidedAt    DateTime?
  voidReason  String?

  /// Basım anında DONDURULAN içerik (ürün/renk/rota/metraj/sipariş + render config).
  /// Kart bir kimlik jetonu değil, içeriği snapshot'lanmış bir belge: reprint
  /// orijinali birebir üretir, WO sonradan değişse de eski kart sabit kalır.
  /// Sorgulanmıyor → GIN yok; sadece detay/print'te okunur (liste select'ine girmez).
  snapshot Json?

  // Relations
  workOrder WorkOrder          @relation(fields: [workOrderId], references: [id])
  printedBy User?              @relation("TravelerCardPrintedBy", fields: [printedById], references: [id])
  scans     TravelerCardScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@index([status])
  // WO başına EN FAZLA 1 ACTIVE kart invariant'ı. Migration 20260623110000 bu
  // @@index'i PARTIAL UNIQUE'e (WHERE status='ACTIVE') çevirir (drift-free yöntem).
  // Eşzamanlı çift-print → ikinci create P2002; print/reprint bunu 409'a çevirir.
  @@index([workOrderId], map: "traveler_cards_wo_active_uniq")
  @@map("traveler_cards")
}

model TravelerCardScan {
  id              String   @id @default(uuid()) @db.Uuid
  cardId          String   @db.Uuid
  stationId       String   @db.Uuid
  workOrderStepId String?  @db.Uuid // Eşleştirilen WO adımı (server-side otomatik çözümlenir)
  scanType        ScanType
  scannedAt       DateTime @default(now())
  scannedById     String?  @db.Uuid
  deviceId        String? // El terminali MAC/serial
  notes           String?

  // Relations
  card      TravelerCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  station   Station        @relation(fields: [stationId], references: [id])
  step      WorkOrderStep? @relation(fields: [workOrderStepId], references: [id])
  scannedBy User?          @relation(fields: [scannedById], references: [id])

  createdAt DateTime @default(now())

  @@index([stationId, scannedAt])
  @@index([workOrderStepId])
  @@index([scannedById])
  // Bir kartın taramaları (cardId filtreli + zaman sıralı)
  @@index([cardId, scannedAt(sort: Desc)])
  @@map("traveler_card_scans")
}

// =============================================================================
// 10. ROLL MOVEMENT — Top hareket geçmişi (3.4)
// =============================================================================

model RollMovement {
  id              String    @id @default(uuid()) @db.Uuid
  rollId          String    @db.Uuid
  workOrderStepId String    @db.Uuid
  qtyIn           Decimal   @db.Decimal(12, 3) // İstasyona girişteki metraj
  qtyOut          Decimal?  @db.Decimal(12, 3) // İstasyon çıkışındaki metraj (FINISH/SKIP'te doldurulur)
  weightIn        Decimal?  @db.Decimal(12, 3)
  weightOut       Decimal?  @db.Decimal(12, 3)
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  operatorId      String?   @db.Uuid
  /// Aynı istasyonda birden fazla makine varsa hangisinde işlendiğinin kaydı.
  machineId       String?   @db.Uuid
  notes           String?

  // Relations
  roll     Roll          @relation(fields: [rollId], references: [id])
  step     WorkOrderStep @relation(fields: [workOrderStepId], references: [id])
  operator User?         @relation(fields: [operatorId], references: [id])
  machine  Machine?      @relation(fields: [machineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderStepId])
  @@index([enteredAt])
  // Dashboard "bugün biten" + tarih aralıklı raporlar (H-14). DB'de PARTIAL'dır
  // (WHERE "exitedAt" IS NOT NULL — açık hareket sorguları zaten küçük partial
  // unique'i tarar; migration 20260612102000, drift-free desen).
  @@index([exitedAt])
  @@index([operatorId])
  @@index([machineId])
  // Bir topun hareket geçmişi (rollId filtreli + zaman sıralı)
  @@index([rollId, enteredAt(sort: Desc)])
  // DB'de ayrıca ŞEMA-DIŞI partial unique var: roll_movements_one_open_per_roll_step_uq
  // (rollId, workOrderStepId) WHERE "exitedAt" IS NULL — "bir top bir adımda en
  // fazla BİR açık movement" invariant'ının DB seddi (çift START/SKIP/FINISH
  // yarışlarının kaybedeni P2002 alır). Migration 20260612101000. Partial UNIQUE
  // @@index ile eşleşmediğinden şemada karşılığı bilinçli olarak YOK.
  @@map("roll_movements")
}

// =============================================================================
// 10.1 SUBCONTRACTOR (Fason) — Sevk & Mal Kabul
// =============================================================================

model SubcontractorDispatch {
  id                     String   @id @default(uuid()) @db.Uuid
  dispatchNo             String   @unique @db.VarChar(64) // SD-YYMM-NNNNNN
  workOrderId            String   @db.Uuid
  stepId                 String   @db.Uuid
  subcontractorId        String   @db.Uuid // Gerçekleşen fason firma
  // Sevk anında "plan ne diyordu" snapshot'ı — rapor için.
  // step.plannedSubcontractorId değişebilir; bu alan o anki değeri dondurur.
  plannedSubcontractorId String?  @db.Uuid
  plateNumber            String?
  driverName             String?
  dispatchedAt           DateTime @default(now())
  dispatchedById         String?  @db.Uuid
  notes                  String?
  // Fason talimatı — genel "sevk notu"ndan (notes) AYRI. Default kaynağı sevk
  // edilen adımın notu (WorkOrderStep.notes); operatör flag açıkken override eder.
  // Belgeye DONDURULMAZ; requestedColor gibi canlı tutulur → sevk sonrası
  // (Electron'dan) düzenlenebilir, baskı her zaman güncel değeri overlay gösterir.
  instruction            String?
  totalQty               Decimal  @default(0) @db.Decimal(12, 3) // Toplam sevk edilen metraj (snapshot)
  // İrsaliye snapshot'ı artık PrintedDocument tablosunda (versiyonlu resmi belge).

  // İptal — soft cancel (kayıt silinmez, izlenebilirlik korunur)
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Doğrudan sevk — fason fiilen son durak; mal fabrikaya dönmeden fasondan
  // doğrudan müşteriye sevk edildi. Bu sevk receive() ile değil bu işaretle
  // kapanır (toplar SUBCONTRACTOR_CONSUMED, adım/WO tamamlanır).
  directShippedAt   DateTime?
  directShippedById String?   @db.Uuid
  directShipReason  String?

  // Relations
  workOrder             WorkOrder                           @relation(fields: [workOrderId], references: [id])
  step                  WorkOrderStep                       @relation(fields: [stepId], references: [id])
  subcontractor         Subcontractor                       @relation("DispatchSubcontractor", fields: [subcontractorId], references: [id])
  plannedSubcontractor  Subcontractor?                      @relation("DispatchPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])
  dispatchedBy          User?                               @relation("DispatchCreatedBy", fields: [dispatchedById], references: [id])
  cancelledBy           User?                               @relation("DispatchCancelledBy", fields: [cancelledById], references: [id])
  directShippedBy       User?                               @relation("DispatchDirectShippedBy", fields: [directShippedById], references: [id])
  items                 SubcontractorDispatchItem[]
  directShipAllocations SubcontractorDirectShipAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plannedSubcontractorId])
  @@index([cancelledById])
  // Liste sayfasında ORDER BY dispatchedAt DESC için — derin sayfalama hızlanır
  @@index([dispatchedAt])
  // Composite: WO-filtreli + tarih sıralı liste (workorder detay panelinde kullanılır)
  @@index([workOrderId, dispatchedAt])
  // Composite: Fason firma-filtreli + tarih sıralı liste (firma raporları için)
  @@index([subcontractorId, dispatchedAt])
  // Composite: Step-filtreli + tarih sıralı (step başına son sevkiyat)
  @@index([stepId, dispatchedAt(sort: Desc)])
  @@index([dispatchedById])
  @@map("subcontractor_dispatches")
}

model SubcontractorDispatchItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispatchId       String   @db.Uuid
  rollId           String   @db.Uuid
  dispatchedQty    Decimal  @db.Decimal(12, 3)
  dispatchedWeight Decimal? @db.Decimal(12, 3)

  // Relations
  dispatch     SubcontractorDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  roll         Roll                       @relation(fields: [rollId], references: [id])
  receiptItems SubcontractorReceiptItem[] @relation("ReceiptItemSource")

  createdAt DateTime @default(now())

  @@index([dispatchId])
  @@index([rollId])
  @@map("subcontractor_dispatch_items")
}

/// Fasondan doğrudan sevkte (Shipment'sız) hangi sipariş satırına ne kadar
/// metraj karşılandığını kaydeder. SackAllocation'ın (çuval-merkezli) fason
/// kardeşi — çuvala/sevkiyata bağlı değil, doğrudan dispatch'ten yazılır. OrderLine.
/// shippedQty = Σ(sevk edilmiş SackAllocation) + Σ(SubcontractorDirectShipAllocation).
/// Append-only, izlenebilirlik için (doğrudan sevk terminaldir, geri-alma kapsam dışı).
model SubcontractorDirectShipAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  dispatchId  String  @db.Uuid
  orderLineId String  @db.Uuid
  qty         Decimal @db.Decimal(12, 3)

  dispatch  SubcontractorDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderLine OrderLine             @relation(fields: [orderLineId], references: [id])

  createdAt DateTime @default(now())

  // Aynı sevkte bir satıra iki kez karşılanma yazılamaz (ShipmentAllocation deseni).
  // map: DB'deki gerçek index adı (63-karakter truncation'ı Prisma'nın ürettiğinden
  // farklı) — aksi halde migrate dev sonsuz RENAME üretir.
  @@unique([dispatchId, orderLineId], map: "subcontractor_direct_ship_allocations_dispatchId_orderLineId_ke")
  @@index([orderLineId])
  @@map("subcontractor_direct_ship_allocations")
}

model SubcontractorReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNo       String   @unique @db.VarChar(64) // SR-YYMM-NNNNNN
  manifestNo      String?  @db.VarChar(64) // İrsaliye no (fason firma tarafından verilir, opsiyonel)
  workOrderId     String   @db.Uuid
  stepId          String   @db.Uuid
  subcontractorId String   @db.Uuid
  receivedAt      DateTime @default(now())
  receivedById    String?  @db.Uuid
  notes           String?
  // Ölçüm (metraj/ağırlık/fire) fason kabulde yapılmaz; sonraki istasyonun
  // FINISH akışı kendi qty/weight değerlerini kaydeder.

  /// Boyahane gibi "açık kumaş döndüren" fason senaryosu: fason kabulde orijinal
  /// Roll'lar SUBCONTRACTOR_CONSUMED'a çekilir, yeni "açık kumaş" Roll'ları bu
  /// receipt'ten doğar. appliedColorId + appliedProperties = receipt seviyesinde
  /// uygulanan kimlik (renk + özellikler); yeni Roll'lar bunu inherit eder.
  /// Renk vermeyen fason kategorilerinde (yıkama, zımpara) NULL kalır.
  appliedColorId String? @db.Uuid

  // Soft-cancel — kabul yanlış girilmişse operatör geri çeker.
  // Rulalar AT_SUBCONTRACTOR'a döner, colorId/RollProperty (renk veren adımdan
  // gelmişse) sıfırlanır. Belge silinmez, audit izi kalır.
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  workOrder         WorkOrder                      @relation(fields: [workOrderId], references: [id])
  step              WorkOrderStep                  @relation(fields: [stepId], references: [id])
  subcontractor     Subcontractor                  @relation("ReceiptSubcontractor", fields: [subcontractorId], references: [id])
  receivedBy        User?                          @relation("ReceiptCreatedBy", fields: [receivedById], references: [id])
  cancelledBy       User?                          @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id])
  items             SubcontractorReceiptItem[]
  appliedColor      Color?                         @relation(fields: [appliedColorId], references: [id])
  appliedProperties SubcontractorReceiptProperty[]
  /// Bu receipt'ten doğan "açık kumaş" Roll'ları (Kurşun/KK2 öncesi).
  bornRolls         Roll[]                         @relation("RollFromReceipt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId])
  @@index([manifestNo])
  @@index([appliedColorId])
  // Mobil/web liste sayfası ORDER BY receivedAt DESC için — milyon satırda kritik
  @@index([receivedAt])
  // Composite: WO-filtreli + tarih sıralı liste (WO detayında "kabuller" sekmesi)
  @@index([workOrderId, receivedAt])
  // Composite: Fason firma-filtreli + tarih sıralı liste
  @@index([subcontractorId, receivedAt])
  @@map("subcontractor_receipts")
}

/// SubcontractorReceipt ↔ FabricProperty M:N — fason kabulde uygulanan özellikler.
/// Receipt seviyesinde tutulur (Roll seviyesinde değil), çünkü fason boyahane
/// dönüşünde Roll'lar terminal'e çekilir; yeni doğan açık kumaş Roll'ları bu
/// listeyi inherit eder.
model SubcontractorReceiptProperty {
  id         String @id @default(uuid()) @db.Uuid
  receiptId  String @db.Uuid
  propertyId String @db.Uuid

  receipt  SubcontractorReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  property FabricProperty       @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([receiptId, propertyId])
  @@index([propertyId])
  @@map("subcontractor_receipt_properties")
}

model SubcontractorReceiptItem {
  id                   String  @id @default(uuid()) @db.Uuid
  receiptId            String  @db.Uuid
  /// Fason dönüşünde kabul edilen orijinal top (yeni etiket basılmaz).
  /// Composite unique ile (receiptId, newRollId) — aynı top birden fazla
  /// CANCELLED receipt'te audit izi olarak kalabilir, sadece aktif receipt
  /// içinde tek satır olur. Globally @unique idi → cancel sonrası tekrar
  /// kabul "Unique constraint" ile patlıyordu.
  newRollId            String  @db.Uuid
  sourceDispatchItemId String? @db.Uuid // Göz kontrolü ile eşleştirilen kaynak sevk kalemi
  notes                String?

  // Relations
  receipt            SubcontractorReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  newRoll            Roll                       @relation(fields: [newRollId], references: [id])
  sourceDispatchItem SubcontractorDispatchItem? @relation("ReceiptItemSource", fields: [sourceDispatchItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([receiptId, newRollId])
  // D-6: @@index([receiptId]) kaldırıldı — @@unique([receiptId, newRollId]) sol-prefix'i kapsar.
  @@index([newRollId])
  @@index([sourceDispatchItemId])
  @@map("subcontractor_receipt_items")
}

// =============================================================================
// 10.3 SUBCONTRACTOR (Fason Firma) — Customer'dan ayrı domain
// =============================================================================
// Müşteri ≠ Fason firma. Bir firma her ikisi olursa iki ayrı kayıt açılır.
// Kategori (Boyahane, Yıkama, Zımpara...) admin tarafından yönetilen DB-driven
// liste; firma birden fazla kategoride hizmet verebilir (M:N).

model SubcontractorCategory {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32) // DYE_HOUSE, SANDING, PRINTING...
  name        String  @db.VarChar(100) // "Boyahane", "Zımpara"
  description String?
  isActive    Boolean @default(true)

  /// "Renk veren" kategori bayrağı. true ise bu kategorideki Fason Kabul
  /// başarıyla tamamlandığında, kabul edilen rulonun colorId'si
  /// WO.targetColorId'den otomatik kopyalanır. Bir rotada tek bir adımın
  /// bu flag'li kategoride olması beklenir (sistem ilk kabul'de uygular;
  /// aynı rota içinde ikinci kez uygulanmaz). Örn. Boyahane.
  appliesColor Boolean @default(false)

  /// "Özellik veren" kategori bayrağı. true ise bu kategorideki Fason Kabul
  /// başarıyla tamamlandığında, kabul edilen rulonun özellikleri
  /// WO.targetProperties'tan otomatik kopyalanır. appliesColor'dan bağımsızdır
  /// — Boyahane ikisini de uygular; Zımpara/Kurşun gibi adımlar ileride
  /// yalnız özellik uygulayabilir ("zımparalanmış", "kurşunlanmış").
  appliesProperty Boolean @default(false)

  // Relations
  subcontractors  SubcontractorToCategory[]
  workOrderSteps  WorkOrderStep[]           @relation("StepRequiredCategory")
  routeSteps      RouteStep[]               @relation("RouteStepRequiredCategory")
  defaultStations Station[]                 @relation("StationDefaultCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subcontractor_categories")
}

model Subcontractor {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(32)
  name       String  @db.VarChar(100)
  taxNumber  String?
  phone      String?
  address    String?
  isActive   Boolean @default(true)
  /// İş emri fason adımında firma seçicide default gelir (kategori bazında client eşleşir).
  isFavorite Boolean @default(false)

  // Relations
  categories        SubcontractorToCategory[]
  dispatches        SubcontractorDispatch[]   @relation("DispatchSubcontractor")
  plannedDispatches SubcontractorDispatch[]   @relation("DispatchPlannedSubcontractor")
  receipts          SubcontractorReceipt[]    @relation("ReceiptSubcontractor")
  plannedSteps      WorkOrderStep[]           @relation("StepPlannedSubcontractor")
  plannedRouteSteps RouteStep[]               @relation("RouteStepPlannedSubcontractor")
  kartelaDispatches KartelaDispatch[]         @relation("KartelaDispatchSub")
  kartelaReceipts   KartelaReceipt[]          @relation("KartelaReceiptSub")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subcontractors")
}

/// M:N — bir firma birden fazla kategoride hizmet verebilir
model SubcontractorToCategory {
  subcontractorId String @db.Uuid
  categoryId      String @db.Uuid

  subcontractor Subcontractor         @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  category      SubcontractorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([subcontractorId, categoryId])
  @@index([categoryId])
  @@map("subcontractor_category_links")
}

// =============================================================================
// 10.2 SWATCH (Kartela) — Tambur'dan üretilen örnek kart
// =============================================================================

model Swatch {
  id              String   @id @default(uuid()) @db.Uuid
  cardNumber      String   @unique @db.VarChar(64) // SW-YYMM-NNN
  barcode         String   @unique @db.VarChar(64) // SW-YYMM-XXXXXX-C (Crockford checksum)
  itemId          String   @db.Uuid
  /// Kartelanın rengi — kaynak rolden veya manuel girilir.
  colorId         String?  @db.Uuid
  width           Decimal? @db.Decimal(12, 3) // cm
  length          Decimal? @db.Decimal(12, 3) // cm (örn. 30cm) — kabulde opsiyonel girilir
  weightKg        Decimal? @db.Decimal(12, 3) // kabulde/tartıda opsiyonel girilir (ihracat araç kg kapasitesi için)
  // Doğum batch'i — kartela fason kabulinde bu receipt'ten doğdu.
  parentReceiptId String?  @db.Uuid
  // Kaynak (tükenen) orijinal top — kartelanın çıktığı bitmiş ürün.
  parentRollId    String?  @db.Uuid
  purpose         String? // Müşteri sunumu, arşiv, laboratuvar vb.
  createdById     String?  @db.Uuid

  // Sevkiyat — kartelanın okutulduğu sevkiyat oturumu (top gibi gönderilir, siparişe sayılmaz).
  shipmentId String? @db.Uuid
  // Çuval — kartela da bitmiş ürün gibi çuvala konur; çuval içeriğinde/irsaliyede görünür.
  sackId     String? @db.Uuid

  // Soft delete — kartela fason kabulü iptal edilince doğan kartelalar geri alınır
  // (fiziksel DELETE yok). Listeler default cancelledAt: null filtreler.
  cancelledAt  DateTime?
  cancelReason String?

  // Relations
  item          Item            @relation(fields: [itemId], references: [id])
  color         Color?          @relation(fields: [colorId], references: [id])
  parentReceipt KartelaReceipt? @relation("SwatchFromReceipt", fields: [parentReceiptId], references: [id])
  parentRoll    Roll?           @relation("SwatchParentRoll", fields: [parentRollId], references: [id])
  createdBy     User?           @relation("SwatchCreatedBy", fields: [createdById], references: [id])
  shipment      Shipment?       @relation(fields: [shipmentId], references: [id])
  sack          Sack?           @relation(fields: [sackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([colorId])
  @@index([parentReceiptId])
  @@index([parentRollId])
  @@index([shipmentId])
  @@index([sackId])
  // Cursor listesi + stats (ORDER BY createdAt DESC WHERE cancelledAt IS NULL).
  // @@index tam görünür ama DB'de PARTIAL'dır (WHERE cancelledAt IS NULL) —
  // soft-delete tablosunda iptal edilmiş kartelalar indekslenmez (migration
  // 20260607030000). Prisma 7 partial predicate'i drift saymaz.
  @@index([createdAt])
  @@map("swatches")
}

// =============================================================================
// 10.4 KARTELA FASON — Bitmiş ürün → kartela firmasına sevk & dönüş
// =============================================================================
// Üretim fasonundan AYRI, WO'suz akış. Depodaki bitmiş bir top kartela firmasına
// (Subcontractor) top olarak gönderilir; fasonda işlenip N kartela (Swatch) olarak
// döner. Orijinal top KABULDE komple tükenir (KARTELA_CONSUMED). İzlenebilirlik:
// Swatch → parentReceipt → dispatch → firma + Swatch.parentRoll (kaynak top).

model KartelaDispatch {
  id              String   @id @default(uuid()) @db.Uuid
  dispatchNo      String   @unique @db.VarChar(64) // KD-YYMM-NNNNNN
  subcontractorId String   @db.Uuid // Kartela fason firma
  plateNumber     String?
  driverName      String?
  dispatchedAt    DateTime @default(now())
  dispatchedById  String?  @db.Uuid
  notes           String?
  totalQty        Decimal  @default(0) @db.Decimal(12, 3) // Toplam sevk metrajı (snapshot)
  // Çeki listesi snapshot'ı artık PrintedDocument tablosunda (versiyonlu resmi belge).

  // İptal — soft cancel (kayıt silinmez, iz korunur)
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  subcontractor Subcontractor         @relation("KartelaDispatchSub", fields: [subcontractorId], references: [id])
  dispatchedBy  User?                 @relation("KartelaDispatchBy", fields: [dispatchedById], references: [id])
  cancelledBy   User?                 @relation("KartelaDispatchCancelledBy", fields: [cancelledById], references: [id])
  items         KartelaDispatchItem[]
  receipts      KartelaReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatchedAt])
  @@index([subcontractorId, dispatchedAt])
  @@index([dispatchedById])
  @@index([cancelledById])
  @@map("kartela_dispatches")
}

model KartelaDispatchItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispatchId       String   @db.Uuid
  rollId           String   @db.Uuid
  dispatchedQty    Decimal  @db.Decimal(12, 3)
  dispatchedWeight Decimal? @db.Decimal(12, 3)

  // Relations
  dispatch     KartelaDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  roll         Roll                 @relation("RollKartelaDispatchItems", fields: [rollId], references: [id])
  receiptItems KartelaReceiptItem[] @relation("KartelaReceiptItemSource")

  createdAt DateTime @default(now())

  @@index([dispatchId])
  @@index([rollId])
  @@map("kartela_dispatch_items")
}

model KartelaReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNo       String   @unique @db.VarChar(64) // KR-YYMM-NNNNNN
  manifestNo      String?  @db.VarChar(64) // Fason firma irsaliye no (opsiyonel)
  dispatchId      String?  @db.Uuid // Bilgi amaçlı; asıl bağ top üzerinden (receiptItem.consumedRoll)
  subcontractorId String   @db.Uuid
  receivedAt      DateTime @default(now())
  receivedById    String?  @db.Uuid
  notes           String?

  // İptal — soft cancel
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  dispatch      KartelaDispatch?     @relation(fields: [dispatchId], references: [id])
  subcontractor Subcontractor        @relation("KartelaReceiptSub", fields: [subcontractorId], references: [id])
  receivedBy    User?                @relation("KartelaReceiptBy", fields: [receivedById], references: [id])
  cancelledBy   User?                @relation("KartelaReceiptCancelledBy", fields: [cancelledById], references: [id])
  items         KartelaReceiptItem[]
  swatches      Swatch[]             @relation("SwatchFromReceipt") // Bu kabulde doğan kartelalar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receivedAt])
  @@index([subcontractorId, receivedAt])
  @@index([dispatchId])
  @@index([receivedById])
  @@index([cancelledById])
  @@map("kartela_receipts")
}

model KartelaReceiptItem {
  id                   String  @id @default(uuid()) @db.Uuid
  receiptId            String  @db.Uuid
  consumedRollId       String  @db.Uuid // KARTELA_CONSUMED'a çekilen orijinal (tükenen) top
  sourceDispatchItemId String? @db.Uuid // Otomatik eşleşen kaynak sevk kalemi
  kartelaCount         Int // Bu toptan doğan kartela adedi (1 top → N kartela)
  notes                String?

  // Relations
  receipt            KartelaReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  consumedRoll       Roll                 @relation("RollKartelaConsumed", fields: [consumedRollId], references: [id])
  sourceDispatchItem KartelaDispatchItem? @relation("KartelaReceiptItemSource", fields: [sourceDispatchItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([receiptId, consumedRollId])
  // D-6: @@index([receiptId]) kaldırıldı — @@unique([receiptId, consumedRollId]) sol-prefix'i kapsar.
  @@index([consumedRollId])
  @@index([sourceDispatchItemId])
  @@map("kartela_receipt_items")
}

// =============================================================================
// 11. MANIFEST (Çeki Listesi) — 3.5
// =============================================================================

model Manifest {
  id          String   @id @default(uuid()) @db.Uuid
  manifestNo  String   @unique @db.VarChar(64)
  workOrderId String   @db.Uuid
  printedAt   DateTime @default(now())
  printedById String?  @db.Uuid
  snapshot    Json // Yazdırma anındaki roll listesi (immutable belge)
  notes       String?

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  printedBy User?     @relation("ManifestPrintedBy", fields: [printedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@map("manifests")
}

// =============================================================================
// 11.6b YAZDIRILABİLİR RESMİ BELGE DEFTERİ — versiyonlu irsaliye snapshot'ları
// =============================================================================
// Bir sevk OLAYI (Shipment / SubcontractorDispatch / KartelaDispatch) = bir belge
// zinciri; her satır bir VERSİYON. İçerik + belge şablon ayarı (override) + firma
// künyesi freeze anında `snapshot` JSON'una donar — kaynak sonradan değişse bile
// belge sabit kalır (yasal kayıt). Yeni sevk olayı = yeni sourceId = yepyeni zincir;
// önceki belge ASLA güncellenmez. Düzeltme = reissue (gerekçeli yeni versiyon,
// eski SUPERSEDED olarak saklanır). Kaynak iptal edilirse VOIDED (İPTAL filigranı).
// Satır içerikleri immutable; yalnız status/supersede/void meta alanları güncellenir.
// =============================================================================

enum PrintedDocType {
  SHIPMENT_DISPATCH // Sevk irsaliyesi (Shipment)
  SUBCONTRACTOR_DISPATCH // Fason sevk irsaliyesi (SubcontractorDispatch)
  KARTELA_DISPATCH // Kartela çeki listesi (KartelaDispatch)
  // NOT: ALTER TYPE ADD VALUE enum'a SONA ekler; sıra DB ile uyumlu kalsın diye
  // (drift-free) en altta. (migration 20260614130000_subcontractor_direct_ship)
  SUBCONTRACTOR_DIRECT_SHIP // Fasondan doğrudan sevk irsaliyesi (son durak fason)
}

enum PrintedDocStatus {
  ACTIVE // Güncel versiyon — baskı bunu kullanır
  SUPERSEDED // Revizyonla yerini yeni versiyona bıraktı (tarihsel kayıt)
  VOIDED // Kaynak iptal edildi — baskıda İPTAL filigranı
}

model PrintedDocument {
  id            String           @id @default(uuid()) @db.Uuid
  docType       PrintedDocType
  // Polimorfik kaynak: shipmentId / subcontractorDispatchId / kartelaDispatchId.
  // FK YOK (3 tabloya birden bağlanamaz); bütünlük servis katmanında.
  sourceId      String           @db.Uuid
  version       Int              @default(1)
  status        PrintedDocStatus @default(ACTIVE)
  // İnsan-okur belge no (shipmentNo/dispatchNo) — listede snapshot JSON'u
  // çekmeden göstermek için ayrı kolon (perf kuralı 13).
  documentNo    String           @db.VarChar(64)
  snapshot      Json
  // Revizyon (v2+) gerekçesi — v1'de null. Yıkıcı-işlem-onayı konvansiyonu gereği zorunlu.
  reissueReason String?
  supersededAt  DateTime?
  voidedAt      DateTime?
  voidReason    String?
  // Lazy-freeze ile (eski kayıttan) geriye dönük üretildi mi — baskıda dipnot.
  reconstructed Boolean          @default(false)
  printedById   String?          @db.Uuid
  printedBy     User?            @relation("PrintedDocumentPrintedBy", fields: [printedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([docType, sourceId, version])
  @@index([docType, sourceId, status])
  @@index([printedById])
  @@map("printed_documents")
}

// =============================================================================
// 11.7 SEVKIYAT — Sevkiyat (Shipment) + Çuval (Sack = depo nesnesi)
// =============================================================================
// ÇUVAL DEPO MODELİ (top→sipariş bağı YOK; mühür/rezerv YOK). Akış: WAREHOUSE serbest top →
// çuval aç (customerId OPSİYONEL) → top okut → (opsiyonel tart). Çuval DEPODA bekler
// (shipmentId NULL, her an düzenlenebilir). Çuval(lar) seçilip müşteri/şube atanır + sipariş
// seçilir → sevkiyat kurulur (Shipment PLANNED; SackAllocation sevk-anı spec+şube FIFO ile
// yazılır — distributeSacksToLines). Düşüş yalnız DISPATCHED'te: shippedQty'ye terfi + toplar
// SHIPPED. Çuval İÇERİK tutar (Roll/Swatch.sackId) → irsaliyede ürün-bazlı döküm.
// =============================================================================

enum ShipmentStatus {
  PLANNED // Onay bekliyor (yalnız sevk-onayı AÇIKKEN): kuruldu + tahsis yazıldı, toplar hâlâ WAREHOUSE. Sevk Kapısı'ndan dispatch edilir.
  DISPATCHED // Sevk edildi — toplar SHIPPED, fiziksel stok bina dışı (stok yalnız burada düşer). Onay KAPALIYKEN createShipment doğrudan buraya kurar.
  CANCELLED // İptal — çuvallar depoya döner (shipmentId null), tahsisler silinir
}

/// Saha #19+#22: sevkiyat varış kapsamı. Yurtiçi default; çuval tartısı zorunluluğu
/// yalnız EXPORT'ta (yurtiçi kg girilmeden sevk edilebilir). Sevkiyatta rozet + filtre
/// olarak görünür (sıkı bir ayrım değil, farkedilebilirlik).
enum ShipmentDestination {
  DOMESTIC // Yurtiçi
  EXPORT // Yurtdışı / ihracat
}

/// Çuval — MÜŞTERİYE ait fiziksel paket birimi + ÇUVAL DEPO HAVUZUNUN çekirdeği.
/// Brüt tartı (no + kg) + İÇERİK: hangi toplar/kartelalar bu çuvalda (Roll.sackId /
/// Swatch.sackId). Çuval DEPODA duran bir nesnedir: açılır, içine top okutulur, (brüt
/// tartılır + kod girilir). shipmentId NULL = depoda (her an düzenlenebilir); dolu =
/// sevkiyata atanmış. customerId OPSİYONEL (oluştururken atanabilir; yoksa sevkte atanır).
/// Mühür/rezerv YOK — sipariş bağı yalnız sevkte kurulur. İçinde karışık ürün serbest;
/// irsaliyedeki çuval-bazlı ürün dökümü buradan türetilir.
model Sack {
  id          String    @id @default(uuid()) @db.Uuid
  sackNo      String    @unique @db.VarChar(64) // Sistem çuval kodu — CV + GGAAYY + NNNN (insan-okur = tarama)
  // Çuval müşterisi OPSİYONEL — oluştururken atanabilir (bilinen sipariş için), yoksa
  // sevk kurarken atanır. Depoda müşterisiz çuval = genel stok.
  customerId  String?   @db.Uuid
  branchId    String?   @db.Uuid
  shipmentId  String?   @db.Uuid // NULL = çuval depo havuzunda; dolu = sevkiyata atanmış
  seq         Int? // Sevkiyat içinde sıra (Çuval 1, 2, 3...); havuzdayken NULL
  weightKg    Decimal?  @db.Decimal(12, 3) // Brüt tartı (kumaş + dara); tekli top kg tutulmaz
  // O-19: tartı izi — kim tarttı, ne zaman.
  weighedById String?   @db.Uuid
  weighedAt   DateTime?

  // Relations
  customer    Customer?        @relation(fields: [customerId], references: [id])
  branch      CustomerBranch?  @relation(fields: [branchId], references: [id])
  shipment    Shipment?        @relation(fields: [shipmentId], references: [id])
  weighedBy   User?            @relation("SackWeighedBy", fields: [weighedById], references: [id])
  rolls       Roll[] // Bu çuvaldaki toplar (içerik)
  swatches    Swatch[] // Bu çuvaldaki kartelalar (içerik)
  allocations SackAllocation[] // Sevkte yazılan sipariş-satırı tahsisi (hangi çuval → hangi satır)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sevkiyat içinde çuval sırası benzersiz (NULL'lar çakışmaz — havuz çuvalları seq=NULL).
  @@unique([shipmentId, seq])
  // O-22: Roll/Swatch↔Sack↔Shipment tutarlılık invariant'ının FK hedefi. Bu unique
  // sayesinde rolls & swatches'a composite FK (sackId, shipmentId) -> sacks(id,
  // shipmentId) kurulur (DEFERRABLE, raw-SQL). MATCH SIMPLE: shipmentId NULL (havuz
  // çuvalı) iken FK atlanır. Composite FK Prisma şemasında YOK — DB seviyesinde yaşar.
  // ⚠️ DRIFT: `migrate dev` bu 2 FK'yı (rolls/swatches consistency) DROP etmek İSTER.
  // ASLA uygulama — `migrate dev --create-only` kullan, üretilen DropForeignKey satırlarını SİL.
  @@unique([id, shipmentId])
  // Havuz/liste sorguları: müşteri + oluşturma sırası (FIFO = createdAt).
  @@index([customerId, createdAt])
  @@map("sacks")
}

/// Sevkiyat — çuval depo havuzundan seçilen çuvallarla kurulan "kamyon". Tek müşteri+şube.
/// PLANNED (kuruldu, karşılanma donduruldu) → DISPATCHED (kamyona
/// yüklendi, toplar SHIPPED). Sipariş kümesi (ShipmentOrder) donmuş tahsislerden türetilir;
/// irsaliye çuval içeriğinden basılır.
model Shipment {
  id            String              @id @default(uuid()) @db.Uuid
  shipmentNo    String              @unique @db.VarChar(64)
  customerId    String              @db.Uuid
  branchId      String?             @db.Uuid
  status        ShipmentStatus      @default(PLANNED)
  // Saha #19+#22: yurtiçi/yurtdışı — tartı zorunluluğu yalnız EXPORT, board'da rozet+filtre.
  destination   ShipmentDestination @default(DOMESTIC)
  // Saha #21: sevkiyata özel prosedür / ihracat referans kodu (örn. gümrük beyanname no).
  // Boşsa ekranlarda müşteri/şube `code`'u gösterilir; bu alan sevkiyat bazında override.
  procedureCode String?             @db.VarChar(64)

  // Araç / sürücü (dispatch'te girilir)
  plateNumber String? @db.VarChar(32)
  driverName  String? @db.VarChar(100)
  carrier     String? @db.VarChar(100)

  dispatchedAt   DateTime? // Kamyona yüklenip çıktığı an
  // O-19: operatör izi — kim sevk etti (kalıcı, best-effort audit yerine).
  dispatchedById String?   @db.Uuid

  // Relations
  customer     Customer        @relation(fields: [customerId], references: [id])
  dispatchedBy User?           @relation("ShipmentDispatchedBy", fields: [dispatchedById], references: [id])
  branch       CustomerBranch? @relation(fields: [branchId], references: [id])
  sacks        Sack[]
  orders       ShipmentOrder[] // Donmuş tahsislerden türetilen sipariş kümesi (denorm; irsaliye orderNos)
  rolls        Roll[] // Atanan çuvalların içindeki toplar
  swatches     Swatch[] // Atanan çuvalların içindeki kartelalar (siparişe sayılmaz)
  returns      RollReturn[] // Bu sevkiyattan gelen iadeler (izlenebilirlik)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([branchId])
  @@index([status, createdAt])
  @@map("shipments")
}

/// Sevkiyat ↔ Order (N:N) — DENORM: sevkiyat kurulurken donmuş tahsislerin sipariş
/// kümesinden türetilir (irsaliye/fiş orderNos bunu okur). Append-only.
model ShipmentOrder {
  shipmentId String  @db.Uuid
  orderId    String  @db.Uuid
  // Sevkiyatın aktifliğinin DENORM bayrağı (shipment.status = PLANNED).
  // Bakımı UYGULAMA katmanında: dispatch/cancel -> false. Havuz modelinde "bir sipariş
  // tek aktif sevkiyatta" kuralı KALKTI (malı iki planlı sevkiyata bölünebilir) →
  // eski partial unique (shipment_orders_active_order_uq) migration ile düşürülür.
  isActive   Boolean @default(true)

  // D-10: muhasebe defteri — shipment fiziksel silinirse allocation/order defteri
  // sessizce yok olup shippedQty'yi bozmasın. App shipment'ı hard-delete etmez.
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@id([shipmentId, orderId])
  @@index([orderId])
  @@map("shipment_orders")
}

/// Sevk defteri (ÇUVAL bazlı) — bir çuvalın metrajının sipariş satırlarına tahsisi.
/// SEVK kurulurken yazılır (createShipment): distributeSacksToLines spec+şube FIFO ile
/// hangi çuval → hangi satır → ne kadar. PLANNED: bekler (shippedQty'ye SAYILMAZ).
/// DISPATCHED: OrderLine.shippedQty'ye sayılır. Sevkiyat iptalinde silinir. Rezerv/packedQty
/// YOK. "Hangi top" değil "ne kadar metraj".
model SackAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  sackId      String  @db.Uuid
  orderLineId String  @db.Uuid
  qty         Decimal @db.Decimal(12, 3) // Bu çuvalın bu satıra düşürdüğü metraj

  // Restrict: çuval silinmeden önce tahsis rebalance ile temizlenir (defter kaybolmasın).
  sack      Sack      @relation(fields: [sackId], references: [id], onDelete: Restrict)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  createdAt DateTime @default(now())

  // Aynı çuval+satıra iki kez tahsis yazılamaz (rebalance sil-yaz deseni + saf savunma).
  @@unique([sackId, orderLineId])
  @@index([orderLineId])
  @@map("sack_allocations")
}

/// İADE DEFTERİ — müşteriden geri dönen topun kaydı. Append-only; izlenebilirliğin
/// omurgası. Sevk muhasebesine (OrderLine.shippedQty / SackAllocation) DOKUNMAZ
/// → sipariş kapalı (COMPLETED) kalır. "Hangi siparişten / hangi üründen / ne kadar
/// iade" tamamen bu tablodan türetilir. İade anında top SHIPPED→WAREHOUSE'a çekilir
/// (statü hep WAREHOUSE — Tambur çıktısıyla tutarlı); kalite yalnız personel
/// (returnGradingEnabled açıkken) override ederse `qualityGradeId`'de saklanır.
model RollReturn {
  id             String  @id @default(uuid()) @db.Uuid
  rollId         String  @db.Uuid // İade edilen top
  fromShipmentId String? @db.Uuid // Geldiği sevkiyat (varsa)
  customerId     String  @db.Uuid // Müşteri (sevkiyattan türetilir)
  orderId        String? @db.Uuid // Personelin seçtiği sipariş (tek aday=otomatik; yoksa null)

  // Spec snapshot — top sonradan Tambur'da kesilse bile rapor sağlam kalsın
  itemId  String   @db.Uuid
  colorId String?  @db.Uuid
  width   Decimal? @db.Decimal(12, 3)
  qty     Decimal  @db.Decimal(12, 3) // İade anındaki currentQty

  // Neden + not (hepsi opsiyonel; ikisi de boş olabilir)
  reasonId   String? @db.Uuid // ReturnReason FK (seçilen)
  reasonText String? @db.Text // Serbest metin neden
  note       String? @db.Text // Teslim alan personel notu

  // Kalite — yalnız personel override ettiyse dolar (yoksa top çıktığı kaliteyle döner)
  qualityGradeId String? @db.Uuid

  receivedById String @db.Uuid // İadeyi teslim alan personel

  // İade öncesi durum snapshot'ı — iptal (geri al) bunlarla topu eski haline döndürür.
  prevSackId         String? @db.Uuid // İade anındaki sackId (iptalde geri yazılır)
  prevQualityGrade   String? // İade anındaki qualityGrade etiketi
  prevQualityGradeId String? @db.Uuid // İade anındaki qualityGradeId

  /// İade anında topa UYGULANAN statü (WAREHOUSE/A1_STOCK/SCRAP — kalite override'ına
  /// göre). İptal (geri al) guard'ı "top hâlâ iade ettiği rafta mı" kontrolünü bununla
  /// yapar; sonradan kesim/yeniden sevk görmüşse iptal engellenir. null → legacy/WAREHOUSE.
  appliedStatus RollStatus?

  // İptal (yanlış iade kabulü geri alındı) — sebeple birlikte.
  cancelledAt   DateTime?
  cancelReason  String?   @db.Text
  cancelledById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roll         Roll          @relation(fields: [rollId], references: [id])
  fromShipment Shipment?     @relation(fields: [fromShipmentId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  color        Color?        @relation(fields: [colorId], references: [id])
  reason       ReturnReason? @relation(fields: [reasonId], references: [id])
  qualityGrade QualityGrade? @relation(fields: [qualityGradeId], references: [id])
  receivedBy   User          @relation("RollReturnReceivedBy", fields: [receivedById], references: [id])
  cancelledBy  User?         @relation("RollReturnCancelledBy", fields: [cancelledById], references: [id])

  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([itemId, colorId, width])
  // K7: colorId lider-kolon index'i — renge göre iade sorgusu composite'in
  // 2. kolonunu kullanamıyordu (renk pasifleştirme/rapor yolları).
  @@index([colorId])
  @@index([fromShipmentId])
  @@index([rollId])
  @@index([reasonId])
  @@index([receivedById])
  @@index([qualityGradeId])
  @@index([cancelledById])
  @@index([cancelledAt])
  @@index([createdAt])
  @@map("roll_returns")
}

// =============================================================================
// 11.6 FABRIC IDENTITY — Color, FabricProperty + ItemProperty + Capabilities + Targets
// =============================================================================
//
// Final Item ham bir kumaşın renk + özellik kombinasyonunu içerir (örn.
// "PATOS-MAVI-YANMAZ"). Müşteri sipariş verirken doğrudan final Item seçer;
// renk/özellik bilgisi Item.colorId ve Item.properties'de zaten gömülüdür.
//
// Akış:
//   1) Admin Color (Mavi) ve FabricProperty (Yanmazlık) kayıtlarını yönetir.
//   2) Admin StationColor + StationProperty ile bir istasyonun hangi renk/özellik
//      uygulayabileceğini bağlar (zorunlu kısıt — WO planlamada kontrol edilir).
//   3) Planlamacı/Tanımlar ekranı: ham + renk + özellikler kombinasyonu için
//      manuel olarak final Item tanımlar (kod deterministic üretilir, isim
//      otomatik önerilir). Aynı kombinasyon ikinci kez tanımlanmaya
//      çalışılırsa sistem mevcut Item'ı önerir.
//   4) WorkOrder.targetItemId final Item'a işaret eder; renk/özellik bilgisi
//      hedef Item'dan okunur. Fason dönüşünde Roll.itemId final Item ile
//      güncellenir (item-derive.helper.ts → findDerivedItemOrThrow).
// =============================================================================

/// Renk kataloğu — Mavi, Kırmızı, Yeşil...
/// Roll, OrderLine, WorkOrder.targetColor, Swatch ve Item.allowedColors buradan
/// referans alır.
model Color {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32) // "MAVI", "KIRMIZI"
  name      String   @db.VarChar(100)
  hex       String?  @db.VarChar(7) // UI rozeti için #RRGGBB
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  itemAllowed         ItemAllowedColor[]
  rolls               Roll[]
  orderLines          OrderLine[]
  workOrderTargets    WorkOrder[]            @relation("WorkOrderTargetColor")
  swatches            Swatch[]
  stationCapabilities StationColor[]
  /// Müşteri-bazlı isim alias'ları — etiket basımında "müşterideki adı" için.
  customerAliases     CustomerColorAlias[]
  /// Fason kabullerde renk olarak uygulandığı receipt'ler (boyahane dönüşü).
  appliedAtReceipts   SubcontractorReceipt[]
  productRecipes      ProductRecipe[]
  rollReturns         RollReturn[]

  @@index([isActive, sortOrder])
  @@map("colors")
}

/// Kumaş özellik kataloğu — Yanmazlık, Kayganlık, Su Geçirmezlik...
/// Üç farklı m:n ile bağlanır:
///   - ItemProperty   : bir Item'a hangi özelliklerin uygulanabileceği (allowed)
///   - WorkOrderTargetProperty : bir iş emrinin üretim çıktısında olacak özellikler
///   - RollProperty   : bir rulonun fiilen sahip olduğu özellikler
model FabricProperty {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32) // "YANMAZLIK", "KAYGAN"
  name        String   @db.VarChar(100)
  category    String? // "Dayanıklılık", "Yüzey", "Kimyasal" vb. (UI gruplama için)
  description String?
  color       String?  @db.VarChar(7) // UI badge hex
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  itemAllowed          ItemAllowedProperty[]
  workOrderTargets     WorkOrderTargetProperty[]
  rollProperties       RollProperty[]
  orderLineRequired    OrderLineRequiredProperty[]
  stationCapabilities  StationProperty[]
  /// Fason kabullerde uygulandığı receipt'ler (boyahane dönüşü gibi).
  appliedAtReceipts    SubcontractorReceiptProperty[]
  productRecipeTargets ProductRecipeProperty[]

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("fabric_properties")
}

/// Item ↔ FabricProperty M:N — bir Item'a uygulanabilir özellikler (allowed list).
/// Item kimliğini ETKİLEMEZ (Item kimliği sadece kod). Sadece sipariş/WO
/// planlamada filter kaynağıdır. Boş = tüm aktif FabricProperty serbest.
model ItemAllowedProperty {
  id         String @id @default(uuid()) @db.Uuid
  itemId     String @db.Uuid
  propertyId String @db.Uuid

  item     Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([itemId, propertyId])
  @@index([propertyId])
  @@map("item_allowed_properties")
}

/// Item ↔ Color M:N — bir Item'a uygulanabilir renkler (allowed list).
/// Item kimliğini ETKİLEMEZ. Sipariş satırında ve WO targetColor'da filter
/// kaynağıdır. Boş = tüm aktif Color serbest.
model ItemAllowedColor {
  id      String @id @default(uuid()) @db.Uuid
  itemId  String @db.Uuid
  colorId String @db.Uuid

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  color Color @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([itemId, colorId])
  @@index([colorId])
  @@map("item_allowed_colors")
}

/// Customer ↔ Item alias — müşterinin bizdeki ürün için kullandığı isim.
/// Örn: bizde "PATOS", ABC müşterisinde "AKTOS". Sipariş girişinde otomatik
/// öneri olarak gelir; OrderLine.customerItemName boşsa etiket basımında live
/// olarak buradan okunur. Operatörün uyguladığı OrderLine override bu kaydı
/// EZMEZ — bir-seferlik talep için.
model CustomerItemAlias {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  itemId     String @db.Uuid
  alias      String // Müşterideki ad (örn. "AKTOS")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, itemId])
  // D-6: @@index([customerId]) kaldırıldı — @@unique([customerId, itemId]) sol-prefix'i kapsar.
  @@index([itemId])
  @@map("customer_item_aliases")
}

/// Customer ↔ Color alias — aynı mantık, renk için. Örn: bizde "MAVI",
/// ABC müşterisinde "ROYAL BLUE".
model CustomerColorAlias {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @db.Uuid
  colorId    String  @db.Uuid
  // Müşterideki renk adı (etiket basımı için opsiyonel). Null = renge müşteri
  // tarafında özel ad verilmemiş.
  alias      String?
  // Renk bu müşteriye "özel renk" olarak atandı mı? `assigned` ile `alias` BAĞIMSIZ:
  //   - assigned=true,  alias=null  → müşterinin özel rengi, özel ad yok
  //   - assigned=false, alias='..'  → herkeste olan katalog rengi, sadece müşteri adı var
  //   - assigned=true,  alias='..'  → hem özel renk hem özel adlı
  // Atama renk formundan (customerIds), ad müşteri panelinden yönetilir. Picker
  // "Müşteri Renkleri" bölümü SADECE assigned=true satırları gösterir.
  assigned   Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  color    Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, colorId])
  // D-6: @@index([customerId]) kaldırıldı — @@unique([customerId, colorId]) sol-prefix'i kapsar.
  // Picker scope + sipariş guard sorguları: "renk herhangi bir müşteriye atanmış mı"
  // (none/some assigned) ve "bu renkler atanmış mı" (colorId IN + assigned).
  // (colorId, assigned) composite, colorId-prefix lookup'ları da karşılar.
  @@index([colorId, assigned])
  @@map("customer_color_aliases")
}

/// Etiket template'i — hangi alanlar gözüksün, sırası, başlığı, bold/font.
/// Her LabelKind için en fazla 1 isDefault=true (service-level enforcement).
/// `fields` JSON yapısı: src/config/label-fields.ts içindeki catalog'a uygun
/// olmalı. Şema-level sıkı yapı yok (esneklik için JSON), service validate.
///
/// Örnek fields:
///   [
///     { "key": "barcode",     "label": "Barkod",  "order": 1, "isVisible": true,  "isBold": true,  "fontSize": "lg" },
///     { "key": "itemName",    "label": "Ürün",    "order": 2, "isVisible": true },
///     { "key": "customerName","label": "Müşteri", "order": 3, "isVisible": true }
///   ]
/// Etiket şablonu — TEK HAVUZ (Etiket Stüdyosu v2): şablon türden bağımsızdır,
/// hangi bağlamda (ham/bitmiş/kartela) basılacağını ATAMALAR belirler
/// (LabelContextDefault + PeripheralTemplateRoute + CustomerTemplateRoute).
/// Yerleşim varyantlarda (LabelTemplateVariant.elements — kanvas modeli).
model LabelTemplate {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100) // "Standart Top Etiketi", "Müşteri X Özel"
  /// DEPRECATED (v2 havuz): kimlik değil, yalnız migration bilgisi — yeni şablonlar
  /// null doğar. Baskı bağlamı baskı anında veriden türer. Saha onayı sonrası drop.
  kind      LabelKind?
  /// DEPRECATED (v2): tek doğru kaynak LabelContextDefault; geçiş boyunca çift-yazım
  /// (eski client geri uyumu). Saha onayı sonrası drop.
  isDefault Boolean    @default(false)
  isActive  Boolean    @default(true)
  /// DEPRECATED (v2): akış-modeli alan listesi — varyantı olmayan şablon için
  /// fail-safe render yolu (dual-mode). Varyantlı şablonda kullanılmaz.
  fields    Json
  /// Uzman raw-code override (dil→kod): { PPLA?, PPLB?, ZPL?, RASTER_HTML? }. Bir dil
  /// için doluysa otomatik üretim yerine BU kod basılır ({{key}} yer-tutucuları payload
  /// değeriyle doldurulur). Boş/yok → varyant kanvası / akış üretimi.
  rawCode   Json?

  /// DEPRECATED (v2) yerleşim düğmeleri — kanvas modelinde eleman özelliğine taşındı;
  /// yalnız dual-mode akış yolunda okunur. Saha onayı sonrası drop.
  lineStepMm   Decimal? @db.Decimal(4, 1)
  qrScale      Int?
  lengthBanner Boolean?

  /// KALICI silinme damgası — dolu=silinmiş: listelerde görünmez, düzenlenemez;
  /// yönlendirme satırları silinir, ad DEL- önekiyle serbest kalır.
  deletedAt DateTime? @db.Timestamptz

  peripheralRoutes PeripheralTemplateRoute[]
  variants         LabelTemplateVariant[]
  customerRoutes   CustomerTemplateRoute[]
  contextDefaults  LabelContextDefault[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([isActive])
  // F188: DB'de ŞEMA-DIŞI partial unique — label_templates_one_default_per_kind (kind)
  // WHERE isDefault=true (migration 20260708180000; roll_movements_one_open emsali). Kind
  // başına tek isDefault=true garantisi; label-template.service rethrowDefaultConflict yakalar.
  @@map("label_templates")
}

/// Şablonun BOYUT VARYANTI — kendi tuvali (widthMm×heightMm) + kendi kanvas
/// eleman yerleşimi. Yeni varyant mevcut varyanttan KOPYALANARAK başlar, elle
/// düzeltilir/teyit edilir — OTOMATİK ÖLÇEKLEME YOK (sıfır-hata ilkesi).
/// Baskıda cihaz MEDYA boyutuna ±1mm eşleşen varyant seçilir; eşleşme yoksa
/// isPrimary varyant basılır (baskı bloklanmaz) + panelde proaktif uyarı.
model LabelTemplateVariant {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String        @db.VarChar(60) // "100×148 Standart"
  widthMm    Decimal       @db.Decimal(6, 2)
  heightMm   Decimal       @db.Decimal(6, 2)
  /// Şablon başına EN FAZLA bir primary (partial unique index — raw SQL).
  isPrimary  Boolean       @default(false)
  /// Kanvas eleman listesi { v: 1, elements: LabelElement[] } — servis
  /// validateElements ile doğrular (config/label-elements.ts tek kaynak).
  elements   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, widthMm, heightMm])
  @@map("label_template_variants")
}

/// Müşteriye özel şablon ataması (müşteri+bağlam → şablon). Çözüm zincirinde
/// cihaz route'unun ÖNÜNE girer: explicit > müşteri > cihaz > bağlam default.
/// Müşterisiz/stok baskıda hiç sorgulanmaz (etiket müşterisi explicit-only).
/// Emsal desen: PeripheralTemplateRoute + CustomerColorAlias.
model CustomerTemplateRoute {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       LabelKind
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, kind])
  @@index([templateId])
  @@map("customer_template_routes")
}

/// Bağlam (LabelKind) başına varsayılan şablon — eski "kind-başına isDefault"un
/// yeni evi. kind @unique = bağlam başına tek default DB seddi.
model LabelContextDefault {
  id         String        @id @default(uuid()) @db.Uuid
  kind       LabelKind     @unique
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@map("label_context_defaults")
}

/// WorkOrder ↔ FabricProperty M:N — planlamacının iş emri için belirlediği
/// üretim özellikleri. Tambur'da finalize sırasında bu liste otomatik olarak
/// üretilen Roll'lara RollProperty olarak yazılır. Step planlaması YOK.
model WorkOrderTargetProperty {
  id          String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  propertyId  String @db.Uuid

  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  property  FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([workOrderId, propertyId])
  @@index([propertyId])
  @@map("work_order_target_properties")
}

/// Roll ↔ FabricProperty M:N — bir rulonun fiilen sahip olduğu özellikler.
/// "Özellik veren" fason adımının (SubcontractorCategory.appliesProperty=true)
/// Fason Kabul'ünde WO.targetProperties'tan kopyalanır. Sonradan
/// inventory.applyManualProperties ile düzenlenebilir.
model RollProperty {
  id         String @id @default(uuid()) @db.Uuid
  rollId     String @db.Uuid
  propertyId String @db.Uuid

  roll     Roll           @relation(fields: [rollId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([rollId, propertyId])
  @@index([propertyId])
  @@map("roll_properties")
}

/// İstasyon ↔ Color M:N — bir istasyonun uygulayabileceği renkler.
/// WO planlamada hedef rengin atandığı adımın bu yetkinliğe sahip olması ZORUNLUDUR.
model StationColor {
  id        String @id @default(uuid()) @db.Uuid
  stationId String @db.Uuid
  colorId   String @db.Uuid

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stationId, colorId])
  @@index([colorId])
  @@map("station_colors")
}

/// İstasyon ↔ FabricProperty M:N — bir istasyonun uygulayabileceği özellikler.
/// WO planlamada hedef özelliğin atandığı adımın bu yetkinliğe sahip olması ZORUNLUDUR.
model StationProperty {
  id         String @id @default(uuid()) @db.Uuid
  stationId  String @db.Uuid
  propertyId String @db.Uuid

  station  Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stationId, propertyId])
  @@index([propertyId])
  @@map("station_properties")
}

// =============================================================================
// 12. SYSTEM LOG - Audit Trail
// =============================================================================

model SystemLog {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @db.Uuid
  category  SystemLogCategory @default(DOMAIN)
  action    String // DOMAIN: CREATE/UPDATE/DELETE — AUTH: LOGIN_SUCCESS/LOGIN_FAILED — SYSTEM: STARTUP/ERROR
  tableName String // domain table OR event source (e.g. "AUTH", "SYSTEM")
  recordId  String // record id OR target identifier (username, error code, "-")
  ipAddress String? // AUTH/SYSTEM event'leri için kaynak IP
  oldData   Json?
  newData   Json?

  // Relations
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableName, recordId])
  // Audit tablosu en hızlı büyüyen tablodur — zaman aralığı sorguları için
  @@index([createdAt])
  // Activity Page (DOMAIN) ve Sistem Kayıtları (AUTH/SYSTEM) ayrı liste sorgularını
  // tek index scan ile karşılar.
  @@index([category, createdAt])
  // Kullanıcı aktivite raporu (userId filtreli + zaman sıralı)
  @@index([userId, createdAt])
  @@map("system_logs")
}

/// Sistem loglarının periyodik arşivi. Admin tarafından tetiklenir;
/// system_logs tablosundan X aydan eski kayıtlar buraya taşınır.
/// Arşiv sorgulanmaz, sadece yasal/uyum amaçlı saklanır.
model SystemLogArchive {
  id         String            @id @db.Uuid // Orijinal UUID — arşivleme sonrası aynı kalır
  userId     String?           @db.Uuid
  category   SystemLogCategory @default(DOMAIN)
  action     String
  tableName  String
  recordId   String
  ipAddress  String?
  oldData    Json?
  newData    Json?
  archivedAt DateTime          @default(now())
  createdAt  DateTime
  updatedAt  DateTime

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@map("system_log_archives")
}

/// Endpoint gecikme GÜNLÜK özetleri (Faz 3 — SAHA-DAYANIKLILIK-FAZ3.md §P1).
/// RAM'deki latency-stats her ~5dk istek-güdümlü flush ile buraya merge edilir;
/// bucket sayaçları JSON'da tutulur → günler TOPLANABİLİR, persentil okuma
/// anında hesaplanır. Retention: flush 90 günden eskiyi siler (tablo TAVANLI —
/// ~150-200 satır/gün, yılda birkaç MB). JSON sorgulanmaz (GIN gerekmez); FK yok.
model EndpointLatencyDaily {
  id        String   @id @default(uuid()) @db.Uuid
  day       DateTime @db.Date
  routeKey  String   @db.VarChar(200)
  count     Int
  errCount  Int
  maxMs     Int
  buckets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, routeKey])
  @@map("endpoint_latency_daily")
}
