model WarpSpec {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(32)
  name   String @db.VarChar(100)
  /// Çözgü ipliği — `ItemType.YARN` ve `linearDensityDen` DOLU olmalı (servis 400).
  yarnItemId String @db.Uuid
  /// Toplam tel (kenar dahil). CHECK > 0 — devere formülünün ilk çarpanı.
  endsCount Int
  /// Kenar teli — bilgi; toplam telin İÇİNDEDİR, ayrıca eklenmez.
  selvedgeEnds Int?
  /// Tarak numarası. ⚠️ BİRİMİ PROFİLDİR (diş/cm ya da diş/10 cm) ve ölçülmeden
  /// hesaba GİRMEZ; bugün yalnız ekranda gösterilir.
  reedNo      Decimal? @db.Decimal(6, 2)
  /// Dişe tel — bilgi.
  endsPerDent Int?
  /// Tarak eni (cm) — bilgi.
  reedWidthCm Decimal? @db.Decimal(6, 2)
  notes       String?  @db.VarChar(500)
  isActive    Boolean  @default(true)

  yarnItem    Item   @relation("WarpSpecYarn", fields: [yarnItemId], references: [id], onDelete: Restrict)
  fabricItems Item[] @relation("ItemWarpSpec")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ
  /// (`GENERATED ALWAYS AS (public.tr_fold("name")) STORED`; Station emsali).
  nameFold  String?  @default(dbgenerated())

  // ── KAYIT KÜNYESİ (docs/design/KAYIT-KUNYESI-TASARIM.md) ──
  createdById String? @db.Uuid
  createdBy   User?   @relation("WarpSpecCreatedBy", fields: [createdById], references: [id])
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("WarpSpecUpdatedBy", fields: [updatedById], references: [id])

  /// AD SEDDİ — uygulama guard'ı kilitsiz check-then-act'tir; bu index onun
  /// kapatamadığı yarış/ham-SQL/içe-aktarım yollarına karşı sessiz son hattır.
  @@unique([nameFold])
  @@index([yarnItemId])
  @@map("warp_specs")
}

