// =============================================================================
// TeksERP - Prisma Schema
// =============================================================================
// Architecture Rules Applied (core-architecture.md):
//   - PK: String @id @default(uuid()) on ALL models
//   - Timestamps: createdAt + updatedAt on ALL models
//   - Soft Delete: isActive flag (no physical DELETE)
//   - Audit: SystemLog records every CUD operation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum StationType {
  INTERNAL
  EXTERNAL
}

/// İstasyonun domain rolü — API davranış farkları için kullanılır.
/// Örn. PROCESS_QC istasyonunda Kurşun+QC2 per-roll akışı çalışır.
enum StationKind {
  RAW_QC // KK1 — ham mal girişi / dokuma çıkışı
  PROCESS_QC // Kurşun + Kalite Kontrol 2 (tek fiziksel istasyon)
  TAMBUR // Final karar noktası
  SUBCONTRACTOR // Fason / boyahane (dış işlem)
  SHIPPING // Sevkiyat/tartı — üretim dışı, MAKİNESİZ istasyon (istasyona-bağlı donanım + istasyon-oturumu)
  OTHER // Diğer / özel istasyon
}

/// `FabricProperty` veri tipi — gerekçe ve tuzaklar için o modelin notuna bak.
enum FabricPropertyValueType {
  FLAG // var/yok (ZIMPARALI, KURSUN) — RollProperty satırı
  CHOICE // birbirini dışlayan değerlerden biri (KAT) — değer kaydın kolonunda
}

/// İstasyonun bir özelliği NASIL teyit ettiği — SAP rota operasyonundaki
/// *control key* (onay otomatik / opsiyonel / zorunlu) karşılığı.
///
/// ⚠️ Bu bayrak ÇALIŞMA ZAMANINA aittir, PLANLAMAYA değil. "Bu istasyon bu
/// özelliği VEREBİLİR mi" sorusunun cevabı satırın VARLIĞIDIR; mod yalnız
/// "nasıl teyit edilir" sorusunu yanıtlar. İkisini karıştırıp OPTIONAL satırı
/// kapsama dışı saymak, rotada zımpara adımı dururken ZIMPARALI hedefli iş
/// emirlerini 409'a düşürür (`workorder.service` özellik-başına rota kapsaması).
enum StationPropertyMode {
  AUTO // operatöre sorulmaz; adım kapanınca topa otomatik yazılır (backflush)
  OPTIONAL // tuş görünür, ön-seçim yok; yalnız operatör işaretlerse yazılır
  REQUIRED // tuş görünür; seçim yapılmadan adım kapanmaz
}

/// Top üzerinde yapılan her somut işlemin log'u.
/// Boolean bayrak kullanmak yerine tarih + operatör + metadata ile tam iz bırakır.
enum RollOperationType {
  KURSUN_APPLIED // PROCESS_QC: bu topa kurşun geçildi
  QC2_COMPLETED // PROCESS_QC: bu topun kalite kontrolü bitti
  TAMBUR_PROCESSED // TAMBUR: bu top için kesim/karar alındı
  SUBCONTRACTOR_SENT // SUBCONTRACTOR: fasona sevk edildi
  SUBCONTRACTOR_RETURNED // SUBCONTRACTOR: fasondan döndü
}

enum ItemType {
  YARN
  FABRIC
  CONSUMABLE
}

/// Top'un sisteme nasıl girdiğini ifade eder — raporlama ayrımı için kritik.
/// itemType "ne olduğunu", entrySource "nereden geldiğini" söyler.
enum RollEntrySource {
  SUPPLIER_RECEIPT // Mobil KK1 istasyonundan taranarak/girilerek gelen mal kabul (kumaş, yarn, consumable)
  MANUAL_ENTRY // Electron admin panelinden "Manuel Top Ekle" ile elle girilen top — istasyon taraması DEĞİL
  /// Tambur ekranından "Manuel Ekle" modunda, refakat kartı OLMADAN üretilip doğrudan
  /// bitmiş stoğa (WAREHOUSE) yazılan top. `MANUAL_ENTRY`den AYRI bir değer: ikisi de
  /// elle girilir ama GİRİŞ YERİ farklıdır ve envanterde ayırt edilebilmesi gerekir
  /// (detay panelinde "Tambur (Manuel)" yazar). Bu, "her top bir kaynağa dayanır"
  /// zincirinde bilinçli açılan tek delik — o yüzden kendi adıyla işaretli.
  TAMBUR_MANUAL
  TAMBUR_SPLIT // Tambur'da KES kararı sonucu ayrılan parça (parentRollId dolu)
  SUBCONTRACTOR_RETURN // Boyahane vb. fason dönüşü — açık kumaş Roll (parentReceiptId dolu, barcode null)
  /// SATIN ALINAN mal — Mal Kabul fişiyle (GoodsReceipt) doğrudan depoya giren top
  /// (2026-08-13, ticaret paketi). `SUPPLIER_RECEIPT`ten AYRI: o, KK1 istasyonunda
  /// ÖLÇÜLEREK/işlenerek alınan ham maldır ve üretim rotasının başıdır; bu ise
  /// üretime hiç girmeyen, alınıp satılan maldır. Envanterde ayırt edilebilmesi
  /// gerekir (alım-satım firmasında stoğun TAMAMI bu kaynaktan gelir).
  /// ⚠️ ALTER TYPE ADD VALUE enum'a SONA ekler — sıra DB ile uyumlu kalsın diye
  /// yeni değer daima en alta yazılır (PrintedDocType emsali).
  PURCHASE_RECEIPT
}

/// ÜRETİM SAPMASININ TÜRÜ (`RollVariance.kind`, 2026-08-09).
///
/// Ayrım keyfî değil, sektörel: tek soruya dayanır — **bu metraj fiziksel olarak
/// var mıydı?** SAP karşılığı: fire ayrı bir hurda hareketidir (551) ve hurda
/// sebep kodu ZORUNLUDUR; kayıt düzeltmesi ise envanter düzeltmesidir (701/702),
/// ayrı belge türü. İkisini tek kovaya atmak fire oranını SİSTEMATİK olarak
/// şişirir — "fireniz neden %8?" sorusunun cevabı aslında "yanlış ölçmüşüz" olur.
///
/// Projedeki emsal aynı ayrımdır: `InventoryService.softDelete` açık hareketi
/// `qtyOut = 0` ile kapatır ("mal buradan HİÇ geçmedi" = storno), WO-kapanış
/// dispozisyonu ise `qtyOut = qtyIn` ile ("mal vardı ve çıktı").
enum RollVarianceKind {
  /// Mal VARDI, kullanılamaz → gerçek üretim kaybı. Fire/verim KPI'sına girer.
  SCRAP
  /// Mal HİÇ YOKTU, kayıt yanlıştı → stok/ölçüm düzeltmesi. Fire DEĞİLDİR.
  /// Eski arayüz adı "At (kayıp)" idi; "kayıp" fire çağrıştırdığı için değişti.
  RECORD_CORRECTION
  /// Kayıtlıdan FAZLA çıktı (artı yön). 2026-08-09 öncesinde HİÇ kaydedilmiyordu:
  /// `tambur.overQuantityEnabled` (varsayılan AÇIK) aşımı kabul ediyor, parent
  /// `TAMBUR_CONSUMED` oluyor ve "40 m fazla çıktı" bilgisi buharlaşıyordu. Yani
  /// sapmanın eksi yönü iz bırakıyor, artı yönü bırakmıyordu → rapor tek yönlüydü.
  OVERAGE
}

/// Çuval brüt tartısının kaynağı (`Sack.weightSource`). İÇ izdir — belgeye basılmaz.
enum SackWeightSource {
  SCALE // Fiziksel kantardan okundu (mobil BT-SPP / Electron seri port)
  MANUAL // Operatör elle girdi — kantarsız/arızalı durumun kaçış yolu
  SIMULATED // Simüle cihaz (uydurma değer). `shipping.simulatedWeightEnabled` AÇIKKEN
  // yazılabilir; varsayılan KAPALI'da backend 400 ile reddeder (demo/eğitim kurulumu).
}

enum RollStatus {
  STOCK
  IN_PRODUCTION
  SCRAP // Gerçek fire — Tambur kalite reddi vb. fiziksel hurda
  CANCELLED // Operatör iptali (yanlış giriş) — fire değil, sadece kayıt geri alındı
  AT_SUBCONTRACTOR // Fason/boyahanede işlem görüyor
  A1_STOCK // 2. Kalite satılabilir stok
  RETURNED_FROM_SUBCONTRACTOR // Fason dönüşünde yeni barkodlar üretildi, eski kapatıldı
  WAREHOUSE // Tambur sonrası depoya kaldırıldı — satışa / sevke hazır
  SHIPPED // Çuval kapanıp tartıldı — müşteriye sevk edildi (sevk muhasebesi bu anda işlenir)
  TAMBUR_CONSUMED // Tambur'da bölündü; tüm metraj çocuk topları olarak doğdu — parent retire
  SUBCONTRACTOR_CONSUMED // Fason kabulde kapandı — yeni "açık kumaş" Roll'ları receipt üzerinden doğacak
  AT_KARTELA // Bitmiş top kartela fason firmasında işlemde (KartelaDispatch)
  KARTELA_CONSUMED // Kartela kabulde kapandı — metraj N kartela (Swatch) olarak doğdu, parent retire
}

/// Fiziksel form — bir top rulo mu (TOP) yoksa açık kumaş mı (ACIK). top ⟺ Tambur'dan
/// geçti (rulo yapıldı); açık ⟺ Tambur-DIŞI bir istasyondan çıktı / fason dönüşü / ham
/// üretime girdi. Kalite/bitmişlikten bağımsız fiziksel bir nitelik; sevkte fark etmez.
enum RollForm {
  TOP // Rulo (Tambur çocuğu veya işlenmemiş ham giriş)
  ACIK // Açık kumaş (Tambur-dışı son adım finalize'ı / fason dönüşü doğumu / açık kumaş)
}

enum CompanyType {
  CUSTOMER
  SUPPLIER
  /// Alıcı + Satıcı (2026-08-14, ticaret paketi) — sektör standardı üçlü
  /// (Logo/Mikro cari kartı). ⚠️ Tip bir ETİKET, duvar DEĞİL: hiçbir akış tipi
  /// zorlamaz (mal kabul/fatura yalnız "kart var + aktif" bakar); değer yalnız
  /// liste/rapor filtresini dürüstleştirir. Tek kart = tek cari = mahsup.
  BOTH
}

// F6+D-15: Device.kind serbest string yerine enum (saha cihaz tipi).
enum DeviceKind {
  TABLET
  PHONE
  DESKTOP
}

// Phase 1: yaşam döngüsü sadeleşti. READY/SHORT/IN_PRODUCTION kaldırıldı —
// "envanter hazır mı?" / "üretim sürüyor mu?" runtime hesabı (allocation +
// workOrder.status üzerinden). Lifecycle:
//   PENDING → APPROVED → PARTIAL_SHIPPED → COMPLETED / CANCELLED
enum OrderStatus {
  PENDING
  APPROVED
  PARTIAL_SHIPPED
  COMPLETED
  CANCELLED
}

enum WorkOrderType {
  ORDER_PRODUCTION // Siparişe Özel Üretim
  STOCK_PRODUCTION // Stoka Üretim
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  // SUPERSEDED ("Devredildi"): tebdil/parti-ayırma ile TÜM canlı topları yeni bir
  // iş emrine devredilip boşalan KAYNAK WO. CANCELLED değil — veri kaybı yok, malzeme
  // devam WO'sunda (WorkOrder.splitFromId ile bağlı). Terminal + değişmez (CANCELLED
  // gibi), ama rapor/filtrede "iptal" ile karışmaz. Yalnız cancelEmptiedSource... atar.
  SUPERSEDED
  // F71: PAUSED kaldırıldı (app'te hiç atanmıyordu; 16 ref backend'de temizlendi — bba0f15).
}

enum StepStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum TravelerCardStatus {
  ACTIVE // Mal ile birlikte gezen geçerli kart
  REPRINTED // Yeniden basıldı, bu kopya artık geçersiz
  VOIDED // Manuel iptal (hasar/kayıp dışında iptal)
  COMPLETED // WorkOrder COMPLETED olunca otomatik pasife çekilir
}

enum ScanType {
  ARRIVAL // İstasyona vardı
  DEPARTURE // İstasyondan ayrıldı
  INFO // Bilgi amaçlı tarama (istasyon hareketi değil)
}

/// Etiket türü — her tür için ayrı template havuzu var, default da ayrı.
/// ROLL_RAW: KK1 ham mal kabul (renksiz, sade alanlar).
/// ROLL_FINISHED: Tambur sonrası bitmiş kumaş (renk + müşteri + sipariş + alias).
/// SWATCH: Kartela etiketi.
/// SACK: Çuval etiketi — barkod/QR = `Sack.sackNo` (CV+GGAAYY+NNNN). Sack'te ayrı
///   `barcode` kolonu YOK; code-format.ts "insan-okur kod = tarama barkodu, tek kod"
///   kuralı geçerli. Çuval içeriği karışık olabildiği için ürün/renk alanı YOK —
///   toplam metraj/kg/top adedi + müşteri + (opsiyonel) çuval yorumu basılır.
enum LabelKind {
  ROLL_RAW
  ROLL_FINISHED
  SWATCH
  SACK
}

/// Yazıcı dili — etiket render driver registry anahtarı. Faz-1: yalnız
/// RASTER_HTML fiziksel basar (HTML + OS sürücü); PPLA ÜRETİLİR (Argox native
/// komut), ham gönderim simüle (donanım I/O Faz-2). PPLB/ZPL gelecek.
enum PrinterLanguage {
  RASTER_HTML
  PPLA
  PPLB
  ZPL
}

/// Baskı yöntemi — ribonlu (termal transfer) vs ribonsuz (direkt termal). Boş → yazıcı
/// otomatik algılar (komut gönderilmez, güvenli varsayılan). Seçiliyse dil-özel komuta
/// çevrilir: PPLA `<STX>KI7` 0/1, ZPL `^MTD`/`^MTT`. PPLB'de iş-başına komut yok (atlanır).
enum PrinterMediaType {
  DIRECT_THERMAL
  THERMAL_TRANSFER
}

/// Etiket yönü — medya geometrisinden türer (w ≥ h → LANDSCAPE).
enum LabelOrientation {
  PORTRAIT
  LANDSCAPE
}

/// Çevre cihazı bağlantı tipi — cihaz kaydı + yönlendirme. NETWORK_TCP=ağ yazıcı
/// (RAW 9100), BLUETOOTH_SPP=seri köprü (HC-05/06), BLE, USB, SERIAL_COM.
enum ConnectionType {
  NETWORK_TCP
  BLUETOOTH_SPP
  BLE
  USB
  SERIAL_COM
}

/// Çevre cihazı türü. LABEL_PRINTER tam bağlanır; SCALE/METER/SIGNAL_SOURCE
/// kayıt-only (gerçek BT okuma Faz-2, kayıt modelinde yer tutar).
enum PeripheralKind {
  LABEL_PRINTER
  SCALE
  METER
  SIGNAL_SOURCE
}

/// Tambur kararında bir hata için yapılan aksiyon.
enum RollErrorAction {
  CUT
  NO_CUT
}

/// Hata tipinin görsel/operasyonel önceliği — UI renklendirmesi.
enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/// SystemLog event türü. DOMAIN = CUD audit, AUTH = login event'leri,
/// SYSTEM = startup/error gibi sistem olayları.
enum SystemLogCategory {
  DOMAIN
  AUTH
  SYSTEM
}

/// Yetki katalogunun UI'da gruplanma kategorisi.
enum PermissionCategory {
  web
  mobile
  admin
}

/// Ürün birim cinsi — sipariş/üretim hesaplarında kullanılır.
enum ItemUnit {
  MT
  KG
  ADET
}

/// Sipariş para birimi — config/currencies.ts ile senkron tutulur.
/// Yeni currency eklemek için: enum'a ekle + currencies.ts'i güncelle + migration.
enum Currency {
  TRY
  USD
  EUR
  GBP
  /// 2026-08-13 — ticaret paketi (fiyatlama). SONA eklendi: ALTER TYPE ADD VALUE
  /// ile eklenen değer aynı transaction içinde KULLANILAMAZ, bu yüzden kendi
  /// migration'ında gelir.
  RUB
}

/// Login yapan istemci türü — aynı-tip oturum politikası bunun üzerinden çalışır
/// (1 Electron + 1 mobil serbest; 2. aynı-tip kick/notify/off ile yönetilir).
enum ClientType {
  ELECTRON
  MOBILE
}

// =============================================================================
// 1. RBAC - Auth & User Management
// =============================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String
  fullName     String    @db.VarChar(100)
  isActive     Boolean   @default(true)
  // JWT iptal sayacı: yetki grant/revoke/set + şifre sıfırlamada artar. verifyToken
  // her istekte token'daki sürümle karşılaştırır → eski oturum anında düşer.
  tokenVersion Int       @default(1)
  /// QR personel kartı sırrı (32-hex, düz saklanır — fiziksel kart taşıyıcı sır;
  /// bcrypt login sıcak yolunda gereksiz). Kart içeriği "TEKSU:<userId>:<cardToken>".
  /// Kart kaybolursa admin ROTASYON yapar → eski kart anında ölür. NULL = kart yok.
  /// Kartla giriş yalnız auth.loginMethods "card" içerirken çalışır.
  cardToken    String?   @unique @db.VarChar(64)
  /// Salt-PIN girişi için HIZLI PIN (6 hane) — şifreden AYRI ve sistem genelinde
  /// BENZERSİZ (PIN tek başına kimliği belirler; findUnique ile giriş). Düz saklanır
  /// (LAN-only + kısa ömür/rotasyon admin'den; cardToken emsali). NULL = tanımsız.
  /// Salt-PIN girişi yalnız auth.loginMethods "pin" içerirken çalışır.
  quickPin     String?   @unique @db.VarChar(12)
  /// KALICI SİLME işareti (geri alınamaz). NULL = normal kayıt (isActive true=aktif,
  /// false=GEÇİCİ pasif, geri alınabilir). Dolu = silinmiş: kayıt yalnız veri
  /// bütünlüğü/geçmiş için durur, listede görünmez, aktifleştirilemez; username
  /// serbest bırakılır (del_ ön-ek), kimlikler temizlenir. Pasif ≠ silinmiş.
  deletedAt    DateTime? @db.Timestamptz

  // Relations
  permissions                UserPermission[]         @relation("UserPermissionUser")
  grantedPermissions         UserPermission[]         @relation("UserPermissionGrantedBy")
  logs                       SystemLog[]
  printedTravelerCards       TravelerCard[]           @relation("TravelerCardPrintedBy")
  cardScans                  TravelerCardScan[]
  rollMovements              RollMovement[]
  printedManifests           Manifest[]               @relation("ManifestPrintedBy")
  printedDocuments           PrintedDocument[]        @relation("PrintedDocumentPrintedBy")
  dispatches                 SubcontractorDispatch[]  @relation("DispatchCreatedBy")
  cancelledDispatches        SubcontractorDispatch[]  @relation("DispatchCancelledBy")
  directShippedDispatches    SubcontractorDispatch[]  @relation("DispatchDirectShippedBy")
  receipts                   SubcontractorReceipt[]   @relation("ReceiptCreatedBy")
  cancelledReceipts          SubcontractorReceipt[]   @relation("ReceiptCancelledBy")
  kartelaDispatches          KartelaDispatch[]        @relation("KartelaDispatchBy")
  cancelledKartelaDispatches KartelaDispatch[]        @relation("KartelaDispatchCancelledBy")
  kartelaReceipts            KartelaReceipt[]         @relation("KartelaReceiptBy")
  cancelledKartelaReceipts   KartelaReceipt[]         @relation("KartelaReceiptCancelledBy")
  swatchesCreated            Swatch[]                 @relation("SwatchCreatedBy")
  rollOperations             RollOperation[]
  rollVariances              RollVariance[]
  reversedRollVariances      RollVariance[]           @relation("RollVarianceReversedBy")
  detectedRollErrors         RollError[]              @relation("RollErrorDetectedBy")
  processedRollErrors        RollError[]              @relation("RollErrorProcessedBy")
  createdRolls               Roll[]                   @relation("RollCreatedBy")
  cancelledRolls             Roll[]                   @relation("RollCancelledBy")
  // Ticaret paketi — depo hareketleri / transfer / mal kabul izleri
  warehouseMovements         WarehouseMovement[]      @relation("WarehouseMovementUser")
  createdTransfers           WarehouseTransfer[]      @relation("WarehouseTransferCreatedBy")
  cancelledTransfers         WarehouseTransfer[]      @relation("WarehouseTransferCancelledBy")
  createdGoodsReceipts       GoodsReceipt[]           @relation("GoodsReceiptCreatedBy")
  cancelledGoodsReceipts     GoodsReceipt[]           @relation("GoodsReceiptCancelledBy")
  manualClosedOrders         Order[]                  @relation("OrderManualClosedBy")
  systemSettingsUpdates      SystemSetting[]
  preference                 UserPreference?
  receivedReturns            RollReturn[]             @relation("RollReturnReceivedBy")
  cancelledReturns           RollReturn[]             @relation("RollReturnCancelledBy")
  workSessions               WorkSession[]
  sessions                   Session[]
  dispatchedShipments        Shipment[]               @relation("ShipmentDispatchedBy")
  invoicedShipments          Shipment[]               @relation("ShipmentInvoicedBy")
  directShipments            DirectShipment[]         @relation("DirectShipmentShippedBy")
  invoicedDirectShipments    DirectShipment[]         @relation("DirectShipmentInvoicedBy")
  weighedSacks               Sack[]                   @relation("SackWeighedBy")
  swatchStockReductions      SwatchStockReduction[]   @relation("SwatchStockReductionCreatedBy")
  kursunBypassAssigned       KursunBypassAssignment[] @relation("KursunBypassAssignedBy")
  kursunBypassCompleted      KursunBypassAssignment[] @relation("KursunBypassCompletedBy")
  kursunBypassCancelled      KursunBypassAssignment[] @relation("KursunBypassCancelledBy")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("users")
}

/// Kullanıcı bazlı UI tercihleri (accent rengi, tema, yoğunluk, menü favorileri,
/// kayıtlı tablo görünümleri). Şema esnekliği için tek `Json` blob — frontend
/// `AppPreferences` tipini sahiplenir, alan eklemek migration gerektirmez.
/// Sorgulanmaz (yalnız PK by userId fetch), bu yüzden GIN index gerekmez.
model UserPreference {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  preferences Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("user_preferences")
}

/// Oturum kaydı — anlık JWT iptal + aynı-tip cihaz oturum politikası (kick/notify/off).
/// jti login'de (jwt.sign jwtid) üretilir; auth.middleware her istekte revokedAt kontrol
/// eder → iptal edilen oturum bir sonraki istekte 401 alır (tokenVersion'dan bağımsız,
/// daha ince taneli: tek cihazı düşürür, tüm oturumları değil).
///
/// TEKLİK NOTU: (userId, deviceType) üzerinde partial-unique index YOK — kasıtlı.
/// 'off'/'notify' politikaları aynı kullanıcı için çoklu aktif same-type oturum
/// gerektirir; teklik ('kick') UYGULAMA KATMANINDA sağlanır
/// (SessionRegistryService.openLoginSession tx: updateMany revoke → create).
///
/// deviceId serbest VARCHAR (FK DEĞİL) — kayıtsız/eşleşmemiş client de login yapıp
/// oturum açabilmeli; buraya devices tablosuna FK koymak o senaryoyu kilitlerdi.
model Session {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  deviceType   ClientType
  jti          String     @unique @db.Uuid
  deviceId     String?    @db.VarChar(64)
  createdAt    DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz
  expiresAt    DateTime   @db.Timestamptz
  revokedAt    DateTime?  @db.Timestamptz
  revokeReason String?    @db.VarChar(32)
  lastSeenAt   DateTime?  @db.Timestamptz

  // Ayak izi korunur — kullanıcı silinirken (soft-delete kalıbı) oturum geçmişi kaybolmaz.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Yetki kataloğu — runtime'da sadece bu tablo + UserPermission birlikte tüketilir.
/// `category` admin UI'sında gruplamak için: "web" (web ekran/aksiyon), "mobile"
/// (mobil ekran), "admin" (admin operasyonları).
model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(64) // "order:read", "mobile:kk2", "admin:users", "mobile:*"
  module      String             @db.VarChar(32) // "SALES", "PRODUCTION", "FINANCE", "MOBILE" (D-15: sınırlı)
  category    PermissionCategory @default(web)
  description String?

  // Relations
  userPermissions     UserPermission[]
  templateMemberships PermissionTemplateItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([module])
  @@index([category])
  @@map("permissions")
}

/// Direct grant: User ↔ Permission (N:N).
/// Efektif yetki tek kaynaktan okunur — rol katmanı yoktur.
/// `validFrom`/`validUntil` opsiyonel: "Ali bu hafta Ahmet vardiyasına bakacak" gibi
/// zaman sınırlı atamalar için. Null ise sınırsız.
/// `grantedById` audit izi için: yetkiyi hangi admin verdi.
model UserPermission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  permissionId String    @db.Uuid
  validFrom    DateTime? @db.Timestamptz
  validUntil   DateTime? @db.Timestamptz
  grantedById  String?   @db.Uuid

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([userId, permissionId])
  // D-6: @@index([userId]) kaldırıldı — @@unique([userId, permissionId]) sol-prefix'i kapsar.
  @@index([permissionId])
  @@map("user_permissions")
}

/// Admin-side şablon — sadece "kullanıcı oluştururken hızlıca yetki paketi seç"
/// kısayolu. Runtime'da User'a hiçbir şekilde join'lenmez; uygulandığında
/// permission'ları UserPermission'a kopyalanır ve şablon-user bağı kalmaz.
/// Bu sayede şablonu sonradan değiştirmek mevcut kullanıcıları etkilemez.
model PermissionTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  /// Sistem rolünün KALICI kimliği (`constants/role-template-catalog.ts`).
  /// Boot uzlaştırması şablonu bu kodla bulur — fabrika adı değiştirse bile
  /// ikizi doğmaz. NULL = fabrikanın panelden kendi yarattığı şablon
  /// (uzlaştırma ona hiç dokunmaz). Sistem şablonu SİLİNMEZ, pasifleştirilir:
  /// sert silme bir sonraki restart'ta diriliş demekti.
  code        String? @unique @db.VarChar(64)
  name        String  @unique @db.VarChar(64)
  description String? @db.VarChar(200)
  isActive    Boolean @default(true)

  permissions PermissionTemplateItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("permission_templates")
}

model PermissionTemplateItem {
  templateId   String @db.Uuid
  permissionId String @db.Uuid

  template   PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([templateId, permissionId])
  @@index([permissionId])
  @@map("permission_template_items")
}

// =============================================================================
// 2. MASTER DATA - Station, Machine, Route
// =============================================================================

model Station {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(32) // e.g. "BOYAHANE_DIS", "KURSUN_1"
  name       String      @db.VarChar(100)
  type       StationType // INTERNAL or EXTERNAL
  kind       StationKind @default(OTHER) // Domain rolü — API davranış dispatch'i
  department String?     @db.VarChar(32) // DOKUMA, DEVERE, TERBIYE, SEVKIYAT etc. (D-15: sınırlı)
  isActive   Boolean     @default(true)

  /// İş emri adım picker'ında bu istasyon gösterilsin mi?
  /// false → KK1 gibi giriş noktası istasyonları (sadece Roll oluşturma için
  /// kullanılır, üretim akışına WorkOrderStep olarak girmez).
  allowAsWorkOrderStep Boolean @default(true)

  // EXTERNAL istasyonlar için varsayılan fason kategorisi. WO oluşturulurken
  // fason planlama modalında otomatik önerilir (kullanıcı değiştirebilir).
  defaultCategoryId String?                @db.Uuid
  defaultCategory   SubcontractorCategory? @relation("StationDefaultCategory", fields: [defaultCategoryId], references: [id])

  /// Bu istasyon RENK uygulayabilir mi? (2026-08-10)
  ///
  /// Eskiden bu soru YALNIZ `defaultCategory.appliesColor`'dan türetiliyordu ve
  /// kategorisi olmayan bir İÇ istasyon tanım gereği "renk veremez" oluyordu —
  /// iç boyahane senaryosunun önündeki asıl engel buydu. Yetenek artık
  /// istasyonun KENDİ alanı; EXTERNAL satırlar göçte kategoriden dolduruldu.
  ///
  /// ⚠️ VARSAYILAN FALSE. Göçte iç istasyonlara da `false` yazıldı — bugünkü
  /// davranışı BİREBİR korumak için: eski kural `hasDefaultCategory &&
  /// canApplyColor` bileşik koşuluydu ve kategorisiz istasyonda sonucu
  /// **false**'tu. `true` yazmak Tambur/Kurşun adımına renk yazılmasına izin
  /// verirdi (2026-08-06 notunun açıkça uyardığı şey).
  ///
  /// ⚠️ Bu bayrak PLANLAMA sorusunu yanıtlar ("bu adım renk verebilir mi").
  /// Fason kabulde rengin FİİLEN uygulanıp uygulanmadığı hâlâ o sevkin
  /// `requiredCategory.appliesColor` bayrağından okunur — satın alınan hizmet
  /// odur. İkisini birleştirme; ortak yüklem `stepCanApplyColor`.
  appliesColor Boolean @default(false)

  /// Bu istasyon ÖZELLİK uygulayabilir mi? Renk ile aynı gerekçe.
  /// ⚠️ VARSAYILAN TRUE — eski kural kategorisiz istasyonda `canApplyProperty`
  /// için **true** üretiyordu (KURSUN özelliği KURSUN_KK2'ye böyle bağlanmıştı).
  appliesProperty Boolean @default(true)

  // Relations
  machines             Machine[]
  /// Bu istasyonda sisteme GİREN toplar (Roll.entryStationId) — kalıcı köken izi.
  entryRolls           Roll[]             @relation("RollEntryStation")
  routeSteps           RouteStep[]
  workOrderSteps       WorkOrderStep[]
  cardScans            TravelerCardScan[]
  colorCapabilities    StationColor[]
  propertyCapabilities StationProperty[]
  peripherals          PeripheralDevice[] // MAKİNESİZ istasyona sabit donanım (SHIPPING kantarı vb.)
  workSessions         WorkSession[]
  // NOT: Kurşun bypass ataması İSTASYONA değil MAKİNEYE yapılır
  // (Machine.kursunBypasses) — PROCESS_QC istasyonu tektir, altındaki
  // fiziksel kurşun makineleri N adettir. Bu yüzden Station'da karşı-ilişki YOK.

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([type])
  @@index([kind])
  @@index([defaultCategoryId])
  @@map("stations")
}

model Machine {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  code      String  @unique @db.VarChar(32)
  name      String  @db.VarChar(100)
  isActive  Boolean @default(true)

  // Relations
  station        Station                  @relation(fields: [stationId], references: [id])
  devices        Device[]
  peripherals    PeripheralDevice[] // birleşik cihaz kaydı (yazıcı/kantar/metre/sinyal — makineye sabit)
  rollOperations RollOperation[]
  rollMovements  RollMovement[]
  workSessions   WorkSession[]
  rollsCreated   Roll[]                   @relation("RollCreatedMachine") // KK1 girişi makine atfı
  /// Kurşun bypass: bu MAKİNEYE atanan işler. Atama makine bazındadır — tek
  /// PROCESS_QC istasyonu altında N fiziksel kurşun makinesi vardır.
  kursunBypasses KursunBypassAssignment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([stationId])
  @@map("machines")
}

/// Sahada makinenin yanında sabit duran tablet/cihaz.
/// `deviceId` tablet ilk açılışta üretilen, AsyncStorage'da kalıcı UUID.
/// Allowlist modeli: tablet `announce` eder → PENDING → admin onaylar+atar → APPROVED.
/// `machineId` = atandığı makine (atıf + cihaz çözümü); null = atanmamış.
/// Cihaz değişmedikçe operatör değişse bile hangi makinede işlendiği bilinir.
model Device {
  id         String       @id @default(uuid()) @db.Uuid
  deviceId   String       @unique @db.VarChar(64) // Tablet local UUID
  name       String       @db.VarChar(100) // Admin'in verdiği etiket — "Tambur-1 Tablet"
  machineId  String?      @db.Uuid
  lastSeenAt DateTime?    @db.Timestamptz
  isActive   Boolean      @default(true)
  /// Allowlist durumu: PENDING (yeni, atama bekliyor) / APPROVED (onaylı + kullanır).
  status     DeviceStatus @default(PENDING)
  /// Cihaz türü: TABLET / PHONE / DESKTOP (yönetici PC'si). Sadece görsel/etiket.
  kind       DeviceKind   @default(TABLET)

  // Relations
  machine       Machine?           @relation(fields: [machineId], references: [id])
  peripherals   PeripheralDevice[] // (eski) tablete-bağlı tekil sahiplik (registerBt geçişte)
  hardwareLinks DevicePeripheral[] // YENİ: cihazın kullandığı donanım (çok-çok, paylaşılabilir)
  workSessions  WorkSession[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([machineId])
  @@index([status])
  @@map("devices")
}

/// Birleşik CİHAZ KAYDI — yazıcılar (ağ/Bluetooth/USB/seri) + tekstil makine
/// sinyal kaynakları (kantar/metraj, kayıt-only). Her cihaz dilini (languageOverride;
/// boş → global `label.printerLanguage`), MEDYASINI (labelWidthMm vd.; boş → sistem
/// varsayılan medyası) ve şablon yönlendirmesini taşır →
/// baskı anında cihaz→{dil,medya,şablon} çözülür. Sahiplik tam-biri: makineye
/// SABİT (machineId) VEYA tablete-BAĞLI (deviceId, BT yazıcı tabletle gezer).
/// Saha donanımının TEK kaynağı — eski `MachineHardware` emekliye ayrıldı.
/// Okuma davranışı — cihaz VERİsi (kod değil). POLL: pollCommand yolla, cevabı oku
/// (Tambur metresi "TTTTTT" → metraj). STREAM: cihaz sürekli yayınlar; dinle, son
/// (kararlı) çerçeveyi al (Sevkiyat kantarı sürekli kg akıtır). Yeni davranışlı
/// cihaz = yeni satır + bu alan; uygulama kodu değişmez.
enum PeripheralReadMode {
  POLL
  STREAM
}

model PeripheralDevice {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(48)
  name String @db.VarChar(100)

  kind           PeripheralKind
  connectionType ConnectionType

  address         String? @db.VarChar(128) // IP / MAC / COM yolu / BLE UUID
  port            Int? // NETWORK_TCP (null → 9100 kullanımda)
  identifyPattern String? @db.VarChar(255) // SCALE/METER veri çözüm regex'i

  // --- Giriş cihazı (SCALE/METER) okuma protokolü — davranış tamamen VERİ ---
  readMode    PeripheralReadMode @default(POLL) // POLL=sor-cevap (komut yolla), STREAM=sürekli yayın (dinle)
  pollCommand String?            @db.VarChar(64) // POLL sorgu komutu; escape destekli (\r \n \xNN), TAM gönderilir
  terminator  String?            @db.VarChar(8) // Yanıt satır sonu (örn "\r\n"); boş → herhangi CR/LF
  decimals    Int? // Codec yuvarlama hassasiyeti (boş → 1)
  scale       Decimal?           @db.Decimal(10, 4) // Ham → mühendislik çarpanı (cm→m: 0.01); boş → 1
  unit        String?            @db.VarChar(8) // "m" / "kg"
  timeoutMs   Int? // Okuma zaman aşımı ms (boş → 2500)
  role        String?            @db.VarChar(24) // Makine içi ayraç: "2-KAT" / "4-KAT" / "PRIMARY"
  simulate    Boolean            @default(false) // Per-cihaz simülasyon (gerçek I/O yerine sahte değer)

  // Sahiplik — tam biri (serviste enforce edilir).
  machineId String?  @db.Uuid
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  deviceId  String?  @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// MAKİNESİZ istasyona sabit donanım (örn. sevkiyat çuval kantarı). Yalnız makinesi
  /// olmayan istasyona bağlanabilir (serviste enforce) — makineli istasyonda donanım
  /// MAKİNEYE bağlanmalı (yan yana özdeş HC-06 belirsizliğinin tek çözümü makine bağı).
  stationId String?  @db.Uuid
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  // Yazıcı MEDYASI — takılı etiket ölçüsü DOĞRUDAN cihazda (Etiket Stüdyosu v2:
  // ayrı LabelFormatProfile "Boyutlar" kataloğu EMEKLİ; baskıda medya buradan,
  // eleman koordinatları varyanttan). Boş → sistem varsayılan medyası (ayar).
  labelWidthMm  Decimal? @db.Decimal(6, 2)
  labelHeightMm Decimal? @db.Decimal(6, 2)
  labelDpi      Int? // boş → 203
  labelGapMm    Decimal? @db.Decimal(5, 2) // etiketler arası (gap sensörü); boş → 2

  languageOverride PrinterLanguage? // cihaz dili (boş → global ayar label.printerLanguage)
  mediaType        PrinterMediaType? // baskı yöntemi (boş → yazıcı otomatik; PPLA/ZPL'de komuta çevrilir)
  /// Raster baskı: kanvas-varyantlı etiket 1bpp bitmap (raster) olarak gönderilir
  /// (önizleme=baskı birebir); false = bugünkü komut üretimi (bayt-aynı). Cihaz-başına
  /// opt-in; PPLA'da grafik komutu (F0) doğrulanana dek açılsa bile komuta düşer.
  rasterMode       Boolean           @default(false)

  isActive   Boolean   @default(true)
  /// KALICI silinme damgası (users.deletedAt kalıbı) — NULL=normal (isActive ile
  /// aktif/pasif); dolu=silinmiş: hiçbir listede görünmez, düzenlenemez/geri
  /// getirilemez; satır yalnız veri bütünlüğü için durur (kod DEL- önekiyle serbest).
  deletedAt  DateTime? @db.Timestamptz
  lastSeenAt DateTime? @db.Timestamptz
  notes      String?   @db.VarChar(500)

  templateRoutes PeripheralTemplateRoute[]
  deviceLinks    DevicePeripheral[] // YENİ: bu donanımı kullanan cihaz(lar) (çok-çok)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([machineId])
  @@index([deviceId])
  @@index([stationId])
  @@index([connectionType])
  @@index([isActive])
  @@map("peripheral_devices")
}

/// Cihaz ↔ donanım atama (ÇOK-ÇOK). Bir cihaz birçok donanım kullanır; bir donanım
/// (ör. ağ yazıcısı) birçok cihaza atanabilir — PAYLAŞIM. Admin manuel yönetir.
/// (BT okuyucu/kantar fiziksel olarak tek host'a bağlanır; model paylaşıma izin verir,
/// doğru atama yöneticinin sorumluluğudur.)
model DevicePeripheral {
  id           String           @id @default(uuid()) @db.Uuid
  deviceId     String           @db.Uuid
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([deviceId, peripheralId])
  @@index([peripheralId])
  @@map("device_peripherals")
}

/// Cihaz başına LabelKind → şablon yönlendirme. JSON yerine indekslenebilir +
/// FK-bütünlüklü child tablo. (peripheralId, kind) tekil.
model PeripheralTemplateRoute {
  id           String           @id @default(uuid()) @db.Uuid
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  kind         LabelKind
  templateId   String           @db.Uuid
  template     LabelTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([peripheralId, kind])
  @@index([templateId])
  @@map("peripheral_template_routes")
}

/// Tablet allowlist durumu — PairingCode (6-haneli kod) emekliye ayrıldı; cihaz
/// kimliği artık `Device.status` (announce → PENDING → admin onayı → APPROVED).
enum DeviceStatus {
  PENDING
  APPROVED
}

/// Çalışma oturumunun kapanış nedeni. Açık oturumda (endedAt null) NULL kalır;
/// kapatan HER yol set eder (servis tek geçit).
enum WorkSessionEndReason {
  LOGOUT // Kullanıcı çıkışı / mobil "oturumu kapat"
  NEW_LOGIN // Aynı cihazda yeni oturum açıldı (vardiya değişimi)
  TAKEOVER // Başka cihaz aynı makineyi devraldı
  IDLE // Hareketsizlik zaman aşımı (tembel kapatma — workSession.idleTimeoutMinutes)
  ADMIN // Panelden zorla kapatıldı
}

/// ÇALIŞMA OTURUMU (ayak izi): KİM (userId) HANGİ CİHAZLA (deviceId) NEREDE
/// (machineId/stationId) NE ZAMAN (startedAt–endedAt) çalıştı. Donanım çözümü
/// (for-session) ve üretim atfı (RollOperation.machineId vb.) AKTİF oturumdan okunur.
/// stationId HER ZAMAN dolu: makineli oturumda server makineden türetip DONDURUR
/// (makine sonradan istasyon değiştirse geçmiş bozulmaz — denormalize bilinçli);
/// makinesiz istasyon oturumunda (SHIPPING) machineId null kalır.
model WorkSession {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  /// FK devices.id (PK, UUID) — tabletin local kimliği (devices.deviceId) DEĞİL.
  deviceId  String  @db.Uuid
  machineId String? @db.Uuid
  stationId String  @db.Uuid

  startedAt      DateTime              @default(now()) @db.Timestamptz
  endedAt        DateTime?             @db.Timestamptz
  endReason      WorkSessionEndReason?
  /// Son aktivite — device.middleware'in lastSeenAt throttle'ına piggyback (60sn'de
  /// bir fire-and-forget). Tembel idle kapatma (resolveActiveSession) bunun eskiliğine bakar.
  lastActivityAt DateTime              @default(now()) @db.Timestamptz

  // Ayak izi tarihçesi korunur — hiçbir taraf silinirken oturum geçmişi kaybolmaz/boşalmaz.
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)
  station Station  @relation(fields: [stationId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId, startedAt])
  @@index([machineId, startedAt])
  @@index([stationId, startedAt])
  @@index([deviceId, startedAt])
  // Aktif oturum filtreleri (endedAt IS NULL) — canlı panel + resolveActiveSession
  @@index([endedAt])
  // DB'de ayrıca ŞEMA-DIŞI iki partial unique var (migration 20260702121000):
  //   work_sessions_active_machine_uq (machineId) WHERE "endedAt" IS NULL AND "machineId" IS NOT NULL
  //   work_sessions_active_device_uq  (deviceId)  WHERE "endedAt" IS NULL
  // "Bir makinede tek aktif oturum + bir cihazda tek aktif oturum" invariant'ının DB
  // seddi — eşzamanlı open yarışının kaybedeni P2002 alır (servis 409'a çevirir).
  // Partial UNIQUE @@index ile ifade edilemediğinden şemada karşılığı bilinçli YOK
  // (roll_movements_one_open_per_roll_step_uq emsali).
  @@map("work_sessions")
}

model Route {
  id          String  @id @default(uuid()) @db.Uuid
  code        String? @unique @db.VarChar(32) // Opsiyonel kısa kod: "BKT-STD"
  name        String  @db.VarChar(100) // e.g. "Boyahane + Kursun + Tambur"
  description String?
  isFavorite  Boolean @default(false) // Sık kullanılan şablon
  customerId  String? @db.Uuid // Müşteriye özel default rota (opsiyonel)
  isActive    Boolean @default(true)

  // Relations
  customer       Customer?       @relation("CustomerDefaultRoutes", fields: [customerId], references: [id])
  steps          RouteStep[]
  workOrders     WorkOrder[] // Bu şablondan türetilen WO'lar (analytics)
  productRecipes ProductRecipe[] // Bu rotayı kullanan üretim reçeteleri

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([customerId])
  @@index([isFavorite])
  @@map("routes")
}

model RouteStep {
  id                     String  @id @default(uuid()) @db.Uuid
  routeId                String  @db.Uuid
  stationId              String  @db.Uuid
  sequence               Int // Order in the route
  defaultNotes           String? // Şablonda saklanan istasyon talimatı — WO oluşturulurken notes'a kopyalanır
  // Saha #14: rota şablonu fason planlamasını da saklasın — eskiden yalnız
  // WO formunun stepPlanning overlay'i vardı, şablona seçilen firma KAYBOLUYORDU.
  // WO açılışında bu değerler default olarak klonlanır (overlay yine ezebilir).
  requiredCategoryId     String? @db.Uuid
  plannedSubcontractorId String? @db.Uuid
  /// 2026-08-06: rota şablonu artık adımın HEDEFİNİ de saklar — "bu akışta
  /// boyahane MAVİ basar, zımpara ZIMPARALI kazandırır". İş emri açılışında
  /// rota seçilince WO hedef renk/özellikleri buradan ön-doldurulur (operatör
  /// yine değiştirebilir; şablon bir ÖNERİDİR, kilit değil).
  ///
  /// ⚠️ `WorkOrder.targetColorId`/`WorkOrderTargetProperty` ile KARIŞTIRMA: orası
  /// üretimin gerçek hedefi (sipariş kalemi kilitleyebilir), burası yalnız şablon
  /// varsayılanı. Rota adımı tüketildiğinde hiçbir yere kopyalanmaz — kopyalayan
  /// tek yer istemcinin "rotayı uygula" adımıdır.
  ///
  /// Renk rotaya sabitlenince rota o renge özel hale gelir (kullanıcı kararı,
  /// 2026-08-06). Boş bırakmak meşru ve varsayılandır: renksiz rota her renkte
  /// yeniden kullanılır.
  plannedColorId         String? @db.Uuid

  // Relations
  route                Route                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station              Station                @relation(fields: [stationId], references: [id])
  requiredCategory     SubcontractorCategory? @relation("RouteStepRequiredCategory", fields: [requiredCategoryId], references: [id])
  plannedSubcontractor Subcontractor?         @relation("RouteStepPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])
  plannedColor         Color?                 @relation("RouteStepPlannedColor", fields: [plannedColorId], references: [id])
  plannedProperties    RouteStepProperty[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // UNIQUE (2026-07-31 denetimi, Bölüm C-A): aynı rotada iki adım aynı sıraya
  // sahip olamaz — kardeş WorkOrderStep'in D-12 seddiyle simetri. Bugünkü tek
  // yazma yolu (nested replace, in-memory Set) zaten güvenli; sed gelecekteki
  // ikinci yazma yolunu ve elle SQL'i korur.
  @@unique([routeId, sequence])
  // K7: stationId lider-kolon index'i — "bu istasyon hangi rotalarda?" sorguları
  // (station hardRemove guard'ı dahil) composite'in 2. kolonunu kullanamıyordu.
  @@index([stationId])
  @@index([requiredCategoryId])
  @@index([plannedSubcontractorId])
  @@index([plannedColorId])
  @@map("route_steps")
}

/// RouteStep ↔ FabricProperty M:N — rota adımının şablon hedef özellikleri
/// ("bu akışta zımpara adımı ZIMPARALI kazandırır"). Append-only pivot
/// (sadece createdAt) — `ProductRecipeProperty` ile birebir aynı kalıp.
///
/// Adım silinince satırlar da düşer (`onDelete: Cascade`): rota güncellemesi
/// adımları `deleteMany` + `create` ile tamamen değiştiriyor, cascade olmasaydı
/// her kayıtta FK ihlali dönerdi.
model RouteStepProperty {
  id          String @id @default(uuid()) @db.Uuid
  routeStepId String @db.Uuid
  propertyId  String @db.Uuid

  routeStep RouteStep      @relation(fields: [routeStepId], references: [id], onDelete: Cascade)
  property  FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([routeStepId, propertyId])
  @@index([propertyId])
  @@map("route_step_properties")
}

/// Üretim reçetesi — bir ürünü (kumaş + renk + özellikler + en + rota) tek
/// isim/kod altında paketler. İş emri açılışında seçilince hedef alanlar + rota
/// otomatik dolar (örn "PATOS GRİ-038"). Rota tekrar-kullanılabilir kalır;
/// reçete rotanın ÜSTÜNDE ayrı bir katmandır — rotayı dönüştürmez.
model ProductRecipe {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(32)
  name     String   @db.VarChar(100)
  itemId   String   @db.Uuid
  colorId  String?  @db.Uuid
  width    Decimal? @db.Decimal(12, 3)
  foldType String?
  routeId  String?  @db.Uuid
  isActive Boolean  @default(true)

  // Relations
  item       Item                    @relation(fields: [itemId], references: [id])
  color      Color?                  @relation(fields: [colorId], references: [id])
  route      Route?                  @relation(fields: [routeId], references: [id])
  properties ProductRecipeProperty[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([itemId])
  @@index([colorId])
  @@index([routeId])
  @@map("product_recipes")
}

/// ProductRecipe ↔ FabricProperty M:N — reçetenin üretim özellikleri.
/// Append-only pivot (sadece createdAt).
model ProductRecipeProperty {
  id         String @id @default(uuid()) @db.Uuid
  recipeId   String @db.Uuid
  propertyId String @db.Uuid

  recipe   ProductRecipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([recipeId, propertyId])
  @@index([propertyId])
  @@map("product_recipe_properties")
}

// =============================================================================
// 3. ITEM (Stock Card) & INVENTORY
// =============================================================================

/// Stok kartı — tek kayıt olarak ürünün kendisini tanımlar (örn. "Patos").
/// Renk ve özellikler kimliğin parçası DEĞİLDİR; rulo/sipariş/iş emri seviyesinde
/// taşınır. Üründe sadece "izin verilen renk/özellik listesi" tutulur (M:N).
/// Boş liste = tüm aktif renk/özelliğe izin var.
model Item {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(100)
  itemType      ItemType // YARN, FABRIC, CONSUMABLE
  unit          ItemUnit @default(MT)
  isActive      Boolean  @default(true)
  /// Saha (mobil KK1) tarafından "yeni desen" olarak açıldı → admin gözden
  /// geçirmesi/tamamlaması bekleniyor. Aktif ve kullanılabilir; yalnız işaret.
  /// Admin normal düzenleme/onay ile temizler. Normal admin create'te false kalır.
  pendingReview Boolean  @default(false)

  // Relations
  rolls              Roll[]
  orderLines         OrderLine[]
  swatches           Swatch[]
  /// Item'a uygulanabilir renkler (allowed). Boş = tüm aktif Color serbest.
  allowedColors      ItemAllowedColor[]
  /// Item'a uygulanabilir özellikler (allowed). Boş = tüm aktif FabricProperty serbest.
  allowedProperties  ItemAllowedProperty[]
  workOrdersAsTarget WorkOrder[]            @relation("WorkOrderTargetItem")
  /// Müşteri-bazlı isim alias'ları — etiket basımında "müşterideki adı" için.
  customerAliases    CustomerItemAlias[]
  productRecipes     ProductRecipe[]
  rollReturns        RollReturn[]
  swatchReductions   SwatchStockReduction[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([itemType])
  invoiceLines InvoiceLine[]
  @@map("items")
}

model Roll {
  id          String  @id @default(uuid()) @db.Uuid
  /// Fiziksel barkod. KK1 girişinde + Tambur kesim çıktısında basılır.
  /// Açık kumaş Roll'ları (Kurşun/KK2'de doğan) için NULL — fiziksel etiket basılmaz.
  /// Unique constraint: PostgreSQL'de NULL'lar tek olabilir (multiple NULLs allowed).
  barcode     String? @unique @db.VarChar(64)
  /// Idempotency anahtarı — mobil/istemci üretir (UUID); ağ-retry'de mükerrer top
  /// yaratılmasını önler. Barkod artık SUNUCU tarafından sıralı atandığından
  /// (TEKS+YYMMDD+H/F+A001..) dedup görevini barkod yerine bu alan yapar. Sunucu-üretimi
  /// (KK1 dışı) kayıtlar için NULL — partial unique index (NULL'lar çakışmaz).
  clientToken String? @unique @db.Uuid
  itemId      String  @db.Uuid
  /// Rulonun kazandığı renk. Üretim sürecinde "renk veren" fason adımı (örn.
  /// boyahane) başarıyla tamamlandıktan sonra WO.targetColorId'den kopyalanır.
  /// NULL = ham (henüz renk kazanmamış). Rulonun "ham/işlenmiş" ayrımının tek
  /// kaynak doğrusudur.
  colorId     String? @db.Uuid

  // Measurements
  initialQty Decimal  @db.Decimal(12, 3) // Initial measurement (meters)
  currentQty Decimal  @db.Decimal(12, 3) // Remaining/net quantity
  weightKg   Decimal? @db.Decimal(12, 3)

  // Status & Quality
  status         RollStatus  @default(STOCK)
  /// SEVK ÖNCESİ statü — sevk geri alma (storno) topu tam olarak eski rafına koysun diye.
  ///
  /// `performDispatchTx` çuvaldaki HER topu `SHIPPED` yapar ve bunu yaparken önceki
  /// statü BİLGİSİ KAYBOLUR. Çuvalda hem `WAREHOUSE` hem `A1_STOCK` (2. kalite) top
  /// bulunabildiği için geri almada hepsini `WAREHOUSE`'a döndürmek 2. kalite topu
  /// sessizce 1. kalite rafına yazardı — hata yok, log yok, yanlış stok.
  ///
  /// Emsal: `RollReturn.prevSackId`/`prevQualityGrade` (iade iptali de aynı soruyu
  /// "kaydın kendi satırındaki snapshot" ile yanıtlıyor; audit'ten türetmek
  /// `archive-scheduler` yüzünden 6 ay sonra sessizce boşa düşerdi).
  ///
  /// Yaşam döngüsü: sevkte YAZILIR, geri almada okunup NULL'lanır. İade yolu buna
  /// dokunmaz (iade `RollReturn`'ün kendi snapshot'ını kullanır) — iadeli sevkiyat
  /// zaten storno'ya kapalıdır. NULL = bu karardan önce sevk edilmiş / hiç sevk
  /// edilmemiş top; storno'da `WAREHOUSE` varsayılır.
  preShipStatus  RollStatus?
  /// Fiziksel form — TOP (rulo) | ACIK (açık kumaş). Otomatik set: ham giriş & Tambur
  /// çocukları TOP; Tambur-DIŞI son-adım finalize'ı + fason dönüşü doğumları + açık kumaş
  /// = ACIK. Operatör seçmez; "durgunda" (final/serbest) anlamlı — ara-üretim flip'i izlenmez.
  form           RollForm    @default(TOP)
  /// Snapshot — yazıldığı andaki kalite kodu (katalog değişse bile sabit). NULLABLE:
  /// kaliteyi YALNIZ kalite istasyonları belirler (KK1 opsiyonel giriş, KK2/Kurşun, Tambur);
  /// kaliteye bakılmamış top (açık kumaş, fason dönüşü, kalitesiz giriş) NULL kalır → UI "—",
  /// istatistik "Belirsiz". Finalize'da null → WAREHOUSE'a düşer (resolveFinalStatus).
  qualityGrade   String?
  /// Canonical — QualityGrade kataloğundaki gerçek kayda referans.
  /// Eski satırlarda null kalabilir; yeni Tambur finalize kayıtlarında doldurulur.
  qualityGradeId String?     @db.Uuid
  width          Decimal?    @db.Decimal(12, 3) // En (cm) — KK1 girişinde ölçülen kumaş eni

  // Top'un sisteme nasıl girdiği — raporlama ayrımı için.
  // itemType "ne olduğunu", entrySource "nereden geldiğini" söyler.
  entrySource RollEntrySource @default(SUPPLIER_RECEIPT)

  /// Elle eklenen topun SEBEBİ — "neden var" sorusunun cevabı.
  ///
  /// `entrySource` NEREDEN geldiğini söyler, bu alan NEDEN var olduğunu.
  /// Yalnız elle doğan toplarda dolar (Tambur "Manuel Top Ekle" / "Manuel Mod");
  /// zincire dayanan toplarda (KK1, kesim, fason kabulü) NULL kalır — onların
  /// sebebi zaten belgesidir.
  ///
  /// NEDEN KOLON, NEDEN AUDIT DEĞİL (2026-08-04 kararı — önceki tercih YANLIŞTI):
  ///  1. Audit 6 AYDA BİR ARŞİVLENİYOR (`archive-scheduler`, MONTHS_TO_KEEP=6):
  ///     satır `system_logs`'tan `system_log_archives`'a TAŞINIR. Sebebi yalnız
  ///     audit'ten okumak, altı ay sonra ekranda SESSİZCE kaybolması demekti.
  ///  2. Raporlanacak veri iş verisidir: "manuel girişlerin %70'i etiket kopması"
  ///     sorusu JSON audit alanından ancak GIN index ile cevaplanır (perf kuralı 6
  ///     — bugün hiçbir JSON alanı sorgulanmıyor). Kolonla GROUP BY yeter.
  ///  3. Sektör standardı: sebep, işlem kaydının ÜZERİNDE durur (SAP'de malzeme
  ///     belgesi satırındaki hareket sebebi gibi); audit adli izdir, iş verisi değil.
  ///  4. Maliyet gerekçesi de dayanaksızdı: nullable kolon eklemek PG11+'da tablo
  ///     yeniden yazımı YAPMAZ (ölçüldü: bu tabloda 6 ms). "ALTER = ACCESS
  ///     EXCLUSIVE rewrite" kaygısı TİP değişimleri içindir (timestamptz emsali).
  ///
  /// Audit kaydı KALDIRILMADI — orada operatör/makine/istasyon/iş emri bağlamıyla
  /// birlikte durmaya devam eder; bu kolon GÖRÜNEN ve RAPORLANAN kaynaktır.
  entryReason String? @db.VarChar(500)

  /// Kaç KAT sarıldığı — değer KATALOGDAN doğrulanır (2026-08-10): `KAT` kodlu
  /// SEÇİM (CHOICE) tipli FabricProperty'nin değer listesi (`FabricPropertyValue`,
  /// varsayılan 2-KAT/4-KAT/TUP; panelden 6-KAT eklenebilir). Serbest metin
  /// DEĞİLDİR — `resolveFoldTypeForWrite` katalog dışını 400 ile reddeder
  /// (katalog satırı yoksa fail-open, eski davranış). Değer bu KOLONDA yaşar
  /// (kolon-projeksiyon istisnası: filtre/sıralama için), RollProperty.valueId
  /// değil — GRAMAJ gibi diğer CHOICE özellikler valueId kullanır.
  ///
  /// TOPUN KALICI ÖZELLİĞİDİR (2026-08-04 ürün kararı). Önceden yalnız
  /// `WorkOrderStep.stepData` (adım seviyesi, her finalize ezer) ve
  /// `RollOperation.metadata` (finalize notu, JSON + indekssiz) içinde duruyordu:
  /// bir topun katı ekranda GÖRÜNMÜYOR ve FİLTRELENEMİYORDU.
  ///
  /// ⚠️ MİRAS ALINMAZ: kesimde doğan çocuk, ebeveyninin katını körlemesine
  /// devralmaz — o kesim anında seçilen değer neyse odur ("top kesilerek yeni bir
  /// kat değeri kazanabilir"). Yazan her yol değeri AÇIKÇA vermelidir.
  ///
  /// NULL = bilinmiyor (bu karardan önce doğmuş toplar). Uydurma varsayılan
  /// YAZILMADI: yanlış bir kat değeri, boş değerden daha zararlıdır.
  foldType String? @db.VarChar(64)

  /// İstemcinin BEYAN ETTİĞİ giriş anı — operatörün "Kaydet"e bastığı an.
  ///
  /// Mükerrer top tuzağının 90 sn'lik penceresi bununla ölçülür, `createdAt` ile
  /// DEĞİL. Sebep (2026-08-04 saha testi): mobil offline kuyruğu tek flush'ta
  /// boşalır → çevrimdışı 40 dakikaya yayılmış 5 girişin hepsi sunucuda
  /// milisaniyeler içinde doğar. Sunucu saatiyle ölçülen pencere bu yüzden **her
  /// flush'ta daima doludur**: tekstilde olağan olan "aynı partiden eşit metrajlı
  /// arka arkaya toplar" 409 fırtınası üretirdi. Damga operatörün gerçek ritmini
  /// taşır — 3 dk arayla girilenler geçer, 2 sn arayla girilen panik basışı takılır.
  ///
  /// `client` öneki `clientToken` ile aynı sözleşmeyi taşır: **istemci beyanıdır,
  /// sunucu üretimi değildir.** Doğrulanır (makul aralık kelepçesi,
  /// `helpers/duplicate-guard.helper.resolveEntryStamp`) ve güvenilmezse NULL
  /// yazılır — kolon doluysa "bu damgaya güvenildi" demektir.
  ///
  /// Saat kayması ihmal edilebilir: tuzak zaten `createdById` + `createdMachineId`
  /// eşitliği arar, yani karşılaştırılan iki damga AYNI cihazın AYNI saatinden
  /// gelir ve sabit ofset farkta sadeleşir.
  ///
  /// ⚠️ `RollMovement.enteredAt` ile KARIŞTIRMA — o "istasyona giriş anı"dır.
  /// ⚠️ İŞ ZAMANI OLARAK KULLANILMAZ: "ne zaman oluştu" sorusunun cevabı
  /// `createdAt`'tir (sunucu, güvenilir). Bu alan yalnız tuzağın penceresi içindir.
  /// NULL = beyan yok (eski istemci / dahili çağrı / bu karardan önceki toplar).
  clientEnteredAt DateTime? @db.Timestamptz

  // Kartelalık işareti — Tambur finalize'da set edilir. Depoda kartelaya gidecek
  // topları kolay bulmak için bir filtre/rozet. Sevki ENGELLEMEZ; işaretsiz top da
  // kartelaya gönderilebilir. Backend toggle ile kaldırılabilir (frontend gerekmez).
  markedForKartela Boolean @default(false)

  // Production Links (real relations — not plain strings)
  producedInStepId String? @db.Uuid // Hangi WO step'inde üretildi (KK1 girişi / Tambur çıktısı)
  currentStepId    String? @db.Uuid // Şu anda hangi WO step'inde

  // Lineage — fason dönüşünde veya tambur kesiminde kaynak rulo
  parentRollId String? @db.Uuid

  // Lineage — fason kabul (boyahane vb.) sonrası açık kumaş olarak doğan Roll'ların
  // kaynak SubcontractorReceipt'i. Receipt = batch (renk + property) referansı.
  // Açık kumaş ileride Tambur'da bölünüp gerçek toplara dönüşür (parentRollId).
  parentReceiptId String? @db.Uuid

  // Parti (Batch) üyeliği. Attach anında doğan partiye yazılır; fason kabulde born
  // roll'a (dispatch.batchId'den), Tambur kesiminde çocuk roll'a KALITILIR → bir parti
  // tüm rota boyunca (depodaki bölünmüş çocuklar dahil) tek kimlikle izlenir.
  // NULL = henüz bir partiye bağlanmamış serbest STOCK top.
  batchId String? @db.Uuid

  // Audit — KK1 girişinde / sistem genelinde topu kim oluşturdu
  // (vardiya devirlerinde "bu kaydı kim aldı" sorgusu için)
  createdById String? @db.Uuid

  // Audit — KK1 girişinde topun oluşturulduğu MAKİNE (aktif çalışma oturumundan
  // damgalanır — Faz 2). KK1 girişi RollOperation üretmediği için makine atfı Roll
  // üstünde kapanır (createdById'nin makine kardeşi). NULL = oturumsuz giriş (web).
  createdMachineId String? @db.Uuid

  /// GİRİŞ İSTASYONU — topun sisteme DOĞDUĞU istasyon (2026-08-05).
  ///
  /// `createdMachineId`in kardeşi ama ONUN YERİNE GEÇMEZ ve ondan TÜRETİLMEZ:
  /// makine sonradan başka istasyona taşınabilir; o an `Machine.stationId`
  /// üzerinden okunan "giriş istasyonu" GERİYE DÖNÜK DEĞİŞİRDİ. Kolon, giriş
  /// anında damgalanır ve bir daha değişmez — donmuş belge mantığının aynısı.
  /// Ayrıca makine damgası yalnız oturumlu (tablet) girişlerde dolar; istasyon
  /// bağlamı bazı yollarda (Tambur kesimi, fason kabulü) makine olmadan da
  /// bilinir.
  ///
  /// ⚠️ `currentStepId → step.station` ile KARIŞTIRMA: o, topun ŞU AN nerede
  /// olduğunu söyler ve top depoya inince NULL'a düşer. Bu alan "nereden geldi"
  /// sorusunun kalıcı cevabıdır.
  ///
  /// NULL meşrudur: istasyon bağlamı olmayan girişler (Electron paneli) ve bu
  /// karardan ÖNCE doğmuş toplar.
  entryStationId String? @db.Uuid

  /// TOPUN DEPOSU — şu an (ya da en son) bulunduğu fiziksel depo (2026-08-13).
  ///
  /// Öncesinde "depo" bir varlık değil bir STATÜYDÜ (`WAREHOUSE` + `shipmentId`/
  /// `sackId` boşluğu). Tek depolu fabrikada bu doğruydu; çok depolu ticaret
  /// kurulumunda "mal hangi depoda" cevapsız kalıyordu.
  ///
  /// ⚠️ HİÇ NULL'LANMAZ. Sevk/iptal/fire topu başka statüye çeker ama deposunu
  /// SİLMEZ — bu yüzden sevk stornosu için ayrı bir snapshot alanı (`preShipStatus`
  /// emsali) GEREKMEZ: geri dönüş adresi topun kendi satırındadır.
  ///
  /// ⚠️ NULL yalnız GEÇİŞ DÖNEMİDİR (backfill öncesi). Doldurma sonrası
  /// `test_db_invariants` NULL sayısını 0'a sabitler; kolon bir sonraki sürümde
  /// NOT NULL'a çekilir. Nullable başlamanın sebebi: 9 fiziksel `roll.create`
  /// noktasından biri gözden kaçarsa NOT NULL production'da 500 üretirdi.
  ///
  /// Tek doldurma noktası: `helpers/warehouse.helper.resolveTargetWarehouseId`
  /// (açık depo yoksa varsayılan depo) — fabrika akışları hiç parametre vermez.
  warehouseId String? @db.Uuid

  /// Bu topu doğuran MAL KABUL FİŞİ (satın alınan mal). NULL = üretimden/başka
  /// yoldan doğmuş top. `parentReceiptId` (fason kabulü) ile karıştırma: o
  /// fasondan DÖNEN malın izidir, bu SATIN ALINAN malın.
  goodsReceiptId String? @db.Uuid

  /// Satın alma BİRİM fiyatı (ticaret paketi, 2026-08-14) — topun metre/kg
  /// başına alış bedeli. Para birimi topun KENDİ alanında değil, doğduğu
  /// fişte (`GoodsReceipt.currency`): fiş tek para birimlidir ve fiyatı
  /// satırda, birimi belgede tutmak "aynı fişte iki para birimi" saçmalığını
  /// yapısal olarak imkânsız kılar.
  ///
  /// ⚠️ NEDEN TOPTA: alış fiyatı topun KALICI özelliğidir — stok değerlemesi
  /// ("depoda kaç para var") ve alış faturasının satır tutarı ondan türer;
  /// fişe tek fiyat yazmak aynı fişte farklı fiyatlı kalemleri (olağan)
  /// imkânsız kılardı. Nullable: üretimden doğan topun alış fiyatı YOKTUR ve
  /// uydurulmaz. Fabrikada daima NULL — kolon eklemek PG11+'ta metadata-only.
  ///
  /// Index BİLİNÇLİ EKLENMEDİ: hiçbir sorgu fiyatla süzmüyor (raporlar topu
  /// başka kolondan bulup fiyatı OKUR) ve `rolls` zaten en çok indeksli tablo.
  purchasePrice Decimal? @db.Decimal(14, 4)

  // Paketleme — topun okutulduğu sevkiyat oturumu. NULL = henüz sevkiyata girmedi
  // (serbest depo). Çuvallanan top PLANNED boyunca WAREHOUSE kalır ama
  // shipmentId dolu → SERBEST stoktan düşer (çuval depo/kapı önü). SHIPPED'a yalnız
  // DISPATCHED'te (kamyon aldı) çekilir; iptalde shipmentId temizlenir, serbest depoya döner.
  // GEVŞEK MODEL: top→sipariş bağı YOK; etiket müşterisi baskı anında seçilir.
  shipmentId String? @db.Uuid

  // Çuval — topun fiziksel olarak içinde bulunduğu çuval (Sack). NULL = sevkiyata
  // okutuldu ama henüz çuvalda değil. Çuval-önce akışta okutma doğrudan aktif çuvala
  // yazar. Çuval içeriği = sackId'si o çuval olan toplar (irsaliyede ürün-bazlı döküm +
  // claim/iz sürme). shipment ile tutarlı: sack.shipmentId == roll.shipmentId.
  sackId String? @db.Uuid

  // Fasondan doğrudan sevk edilen top bu DirectShipment olayına bağlıdır (kısmi
  // split'te kesilen çocuk top). NULL = normal akış / çuval sevkiyatı.
  directShipmentId String? @db.Uuid

  // GEVŞEK MODEL: topun ÜSTÜNDEKİ son basılan etiketin denormalize snapshot'ı
  // (müşteri/sipariş/ürün-renk adı + baskı tarihi/operatör). BAĞ DEĞİL — yalnız
  // "şu an hangi etiket basılı" bilgisi; kapsama/sevk mantığına GİRMEZ. Müşterisiz
  // (stok) baskıda null'a çekilir. Küçük/nullable alan; index/filtre yok → liste
  // sorgusunda dönse de perf etkisi yok, asıl detay (findRollById) kullanır.
  lastLabelSnapshot Json?

  // Etiket bayat mı? Veri/metraj/renk/kalite/en/özellik "Yeniden Etiketle/Düzelt" ile
  // değiştirilince true → topun ÜSTÜNDEKİ fiziksel etiket artık veriyle uyuşmuyor
  // (yeniden basılmalı). Etiket basılınca (recordPrintEvent) false'a döner. Küçük bayrak;
  // filtre/index yok — detay/context/liste select'inde döner, "yeniden bas" uyarısını besler.
  labelDirty Boolean @default(false)

  /// Topun ÜSTÜNDEKİ fiziksel etiketin BASILDIĞI an (NULL = hiç basılmadı).
  ///
  /// `labelDirty` ile KARIŞTIRMA — ikisi FARKLI soruları yanıtlar: o "basılı etiket
  /// veriyle uyuşuyor mu", bu "ortada bir etiket VAR mı". Bayat olmayan bir etiket de
  /// fiziksel olarak topun üstünde durur, ve iptalin sorduğu soru budur.
  ///
  /// İptal yolu (`softDelete`) buna bakar: etiketi basılmış topu sessizce iptal etmek
  /// sahaya ÖLÜ ETİKET bırakır — kayıt ölür, kâğıt topun üstünde kalır, sonraki okutma
  /// "stokta değil" der ve kimse sebebini bilmez (2026-08-05 saha vakası: T050826H0033
  /// 10:48:30'da basıldı, 10:56:02'de iptal edildi, aynı fiziksel top saatler sonra
  /// ikinci bir barkodla — T050826H0072 — yeniden kaydedilip boyahaneye gitti).
  ///
  /// ⚠️ Audit'ten (LABEL_PRINT_EVENT) OKUNMAZ ve okunmamalı: `archive-scheduler`
  /// 6 ayda bir `system_logs`'u arşive TAŞIR → altı ay sonra "bu topun etiketi basıldı
  /// mı" sorusunun cevabı sessizce kaybolur. `Roll.entryReason` dersinin birebir aynısı:
  /// kararın kendisi kaydın KENDİ satırında yaşar, denetim log'unda değil. Audit yazımı
  /// kaldırılmadı (iki ayrı soru: *kim ne zaman bastı* ↔ *basılı etiket var mı*).
  ///
  /// Tek yazma noktası: `label.service.recordPrintEvent` (niyet kaydı
  /// `seedRollLabelSnapshot` DEĞİL — o yazıcısız/iptal edilmiş baskıda da koşar).
  /// Index YOK: `rolls` zaten en çok indeksli tablo ve bu alan her zaman `status`
  /// ile birlikte süzülür (ölü etiket raporu), tek başına aranmaz.
  labelPrintedAt DateTime? @db.Timestamptz

  /// ── İPTAL (STORNO) İZİ ────────────────────────────────────────────────────
  /// `softDelete` yazar, `restoreCancelledRoll` okuyup NULL'lar. Emsal:
  /// `SubcontractorDispatch.cancelledAt/cancelledById/cancelReason`.
  ///
  /// Sebep AUDIT'TE DEĞİL BURADA: iptal edilmiş bir kaydı inceleyen kişinin ilk
  /// sorusu "bu neden iptal edildi" ve cevabı altı ay sonra da durmalı (bkz.
  /// `labelPrintedAt` notundaki arşivleme tuzağı).
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(500)

  /// İptalden ÖNCEKİ statü — geri alma (`restoreCancelledRoll`) buraya döner.
  /// `preShipStatus` emsalinin birebir aynısı ve aynı sebeple: körlemesine `STOCK`'a
  /// döndürmek 2. kalite (`A1_STOCK`) ya da depo (`WAREHOUSE`) topunu sessizce yanlış
  /// rafa yazardı. NULL = bu karardan önce iptal edilmiş top; geri almada `STOCK`
  /// varsayılır (iptal edilebilir statülerin çoğunluğu odur ve kapsam guard'ı zaten
  /// hareketsiz/partisiz topa daraltır).
  preCancelStatus RollStatus?

  /// ETİKETİNDE YAZAN MÜŞTERİ (2026-08-09) — `lastLabelSnapshot.customerId`'nin
  /// SORGULANABİLİR aynası. Tek yazma noktası `label.service`; snapshot ile AYNI
  /// transaction'da yazılır.
  ///
  /// ⚠️ ADI LOAD-BEARING: `customerId` DEĞİL. Kök kural *"Top→sipariş bağı yok"* —
  /// çuval havuzu modelinde tahsis ÇUVAL bazında ve SEVK ANINDA yapılır
  /// (`SackAllocation`); `packedQty`/`rebalanceCustomerPool` bilinçli olarak
  /// kaldırılmıştı. Kullanıcının kendi ifadesiyle: *"top gerçekten birine tahsis
  /// edilemez, her an her şey olabilir; X için üretilmiş top Y'ye gönderilebilir."*
  /// Düz `customerId` deseydik altı ay sonra biri üstüne tahsis mantığı yazardı.
  /// Bu kolon bir SAHİPLİK değil, **basılmış kâğıdın izidir**.
  ///
  /// NEDEN KOLON, neden JSON'dan okumuyoruz: `lastLabelSnapshot` bir JSON blob;
  /// indekslenemez, `buildWhereClause` yolundan filtrelenemez. Üç yüzey bunu
  /// sorgulanabilir ister — müşteri filtresi, toplu müşteri değiştirme ve
  /// çuval/top uyuşmazlık uyarısı.
  ///
  /// NULL = stok etiketi (müşterisiz, BİLİNÇLİ bir seçim) VEYA bu karardan önce
  /// basılmış top. İkisi ayırt edilmez ve edilmemeli: ikisinde de "bu topun
  /// etiketinde müşteri yazmıyor" doğrudur.
  labelCustomerId String? @db.Uuid

  /// ── TAMBUR KAPANIŞINDAN ÖNCEKİ HÂL (2026-08-09) ──────────────────────────
  /// `preShipStatus` / `preCancelStatus` ile AYNI aile, AYNI gerekçe: bir kapanış
  /// işlemi topun önceki hâlini YOK EDİYOR ve geri alma onu türetmeye çalışıyordu.
  ///
  /// Sahada ölçülen hasar (IE0808260001, 2026-08-08): `applyFull` kaynak topun
  /// metrajını ÇOCUKLARIN TOPLAMINDAN türetiyordu (`currentQty: restored`).
  /// Aşımlı kesimde (bkz. `tambur.overQuantityEnabled`, varsayılan AÇIK) çocukların
  /// toplamı kayıtlı metrajı geçebildiği için ortaya `initialQty=500` iken
  /// `currentQty=520,5` taşıyan — yani giriş metrajından fazla mevcut metraj
  /// gösteren — bir satır çıktı. Türetme yerine KAYIT: kapanış anındaki değerler
  /// burada saklanır, geri alma onları aynen geri koyar.
  ///
  /// İkisi de geri almada OKUNUR ve NULL'lanır (bayat değer kalmasın).
  /// NULL = bu karardan önce kapanmış top; geri alma eski türetme yoluna düşer
  /// (davranış değişmez, yeni kayıtlar doğru olur).

  /// Kapanış anındaki `currentQty`. Türetilemez: `initialQty` kapanışta
  /// değişmiyor ama `currentQty` sıfırlanıyor.
  preTamburCloseQty Decimal? @db.Decimal(12, 3)

  /// Kapanış anındaki statü. YALNIZ depo kesimi (`finalizeWarehouseCut`) için
  /// gerekli — üretim akışında kapanış öncesi statü her zaman `IN_PRODUCTION`.
  /// ⚠️ Renkten TÜRETİLEMEZ: `colorId IS NULL → STOCK` kuralı, renksiz ama
  /// `WAREHOUSE`'a inmiş topu (ham kumaş bitmiş ürün olarak depoya alınabiliyor)
  /// yanlış rafa yazardı.
  preTamburCloseStatus RollStatus?

  /// ── ÜRETİM ZAMAN ÇIPALARI (rapor tabanı) ─────────────────────────────────
  /// İkisini de UYGULAMA KODU YAZMAZ — `rolls` tablosundaki BEFORE trigger
  /// `roll_stamp_production_timestamps` yazar (migration 20260809090000).
  ///
  /// NEDEN TRIGGER, neden helper değil: `Roll.status`'e yazan 40+ çağrı noktası
  /// var (tambur, kurşun, fason, WO-kapanış, kurtarma, storno, iade, manuel
  /// taşıma…). Bir tanesini atlamak raporda SESSİZ eksik demek — hata yok, log
  /// yok, sadece o toplar hiçbir dönemde görünmez. Trigger atlanamaz; ham SQL
  /// bile onu geçemez. Envanter + bekçi: `scripts/test_db_invariants.ts` §6.
  ///
  /// ⚠️ `updatedAt` BU İŞİ GÖREMEZ ve yerine kullanılmamalı: etiket yeniden
  /// basımı ya da not düzenlemesi de onu günceller (kök CLAUDE.md "Buraya geliş
  /// ≠ oluşturma" notu). Fire raporu 2026-08-09'a kadar tam o kumun üstündeydi.

  /// Topun ÜRETİMDEN ÇIKTIĞI an — kalite kararı verilip nihai rafına girdiği an.
  /// Kalite/fire/fason karnelerinin dönem çıpası budur.
  ///
  /// YAZILIR: üretim tarafı bir statüden (`IN_PRODUCTION`, `STOCK`,
  /// `AT_SUBCONTRACTOR`, `RETURNED_FROM_SUBCONTRACTOR`) final statüye
  /// (`WAREHOUSE`, `A1_STOCK`, `SCRAP`) geçişte; ayrıca top doğrudan final
  /// statüde DOĞDUYSA (fason kabul çocuğu) INSERT'te.
  ///
  /// YAZILMAZ: `SHIPPED → WAREHOUSE` (sevk storno / iade — mal üretimi yeniden
  /// bitirmedi) ve `CANCELLED → *` (iptal geri alma). Bu iki dal olmasaydı bir
  /// storno, aylar önce üretilmiş topu BUGÜNÜN kalite karnesine sokardı.
  ///
  /// ⚠️ ÜZERİNE YAZILIR (write-once DEĞİL): depo topu yeni bir iş emrine girip
  /// tekrar finalize olursa damga tazelenir. Bilinçli — `qualityGradeId` de
  /// üzerine yazılıyor; damga sabitlenseydi top ESKİ tarihle YENİ kaliteyi
  /// taşır ve bugünün kalite kararı geçen ayın karnesine yazılırdı. Bu kolonun
  /// tek invariant'ı: **`finalizedAt` her zaman mevcut `qualityGradeId` ile
  /// aynı olaydan gelir.**
  ///
  /// NULL = hiç finalize olmamış (ham stok / üretimde) VEYA geriye doldurma
  /// kapsamı dışında kalmış eski kayıt (bkz. `scripts/backfill_roll_production_timestamps.ts`).
  finalizedAt DateTime? @db.Timestamptz

  /// Statünün EN SON değiştiği an — her `status` değişiminde tazelenir.
  /// Stok yaşlandırma / FIFO ("en eski depo topunu önce sevk et") bunun için
  /// var: kök CLAUDE.md'nin *"yalnız statü geçişlerinde damgalanan ayrı bir
  /// kolon gerekir; `updatedAt` bunun yerine kullanılmamalı"* dediği kolon.
  ///
  /// `finalizedAt`ten farkı: bu HER geçişte yazılır (sevk, iptal, iade dahil),
  /// o yalnız üretim çıkışında. İkisini karıştırma — yaşlandırma "kaç gündür
  /// bu rafta" sorar, kalite karnesi "ne zaman üretildi" sorar.
  ///
  /// Index BİLİNÇLİ olarak EKLENMEDİ: tüketicisi (Stok & Ölü Stok karnesi) henüz
  /// yazılmadı ve `rolls` zaten en çok indeksli tablo. O rapor yazılırken
  /// `[status, statusChangedAt]` composite'i EXPLAIN kanıtıyla eklenecek.
  statusChangedAt DateTime? @db.Timestamptz

  // Relations
  item                 Item                        @relation(fields: [itemId], references: [id])
  color                Color?                      @relation(fields: [colorId], references: [id])
  qualityGradeRef      QualityGrade?               @relation(fields: [qualityGradeId], references: [id])
  errors               RollError[]
  movements            RollMovement[]
  operations           RollOperation[]
  variances            RollVariance[]
  parent               Roll?                       @relation("RollLineage", fields: [parentRollId], references: [id])
  children             Roll[]                      @relation("RollLineage")
  directShipment       DirectShipment?             @relation(fields: [directShipmentId], references: [id])
  parentReceipt        SubcontractorReceipt?       @relation("RollFromReceipt", fields: [parentReceiptId], references: [id])
  /// Bu rol parent olarak hangi RollOperation kayıtlarına kaynak — Tambur kalıtım izi
  inheritedOperations  RollOperation[]             @relation("RollOperationInherited")
  dispatchItems        SubcontractorDispatchItem[]
  receiptItems         SubcontractorReceiptItem[]
  kartelaDispatchItems KartelaDispatchItem[]       @relation("RollKartelaDispatchItems")
  kartelaConsumedItems KartelaReceiptItem[]        @relation("RollKartelaConsumed")
  swatchesFrom         Swatch[]                    @relation("SwatchParentRoll")
  currentStep          WorkOrderStep?              @relation("RollCurrentStep", fields: [currentStepId], references: [id])
  producedInStep       WorkOrderStep?              @relation("RollProducedInStep", fields: [producedInStepId], references: [id])
  createdBy            User?                       @relation("RollCreatedBy", fields: [createdById], references: [id])
  cancelledBy          User?                       @relation("RollCancelledBy", fields: [cancelledById], references: [id])
  createdMachine       Machine?                    @relation("RollCreatedMachine", fields: [createdMachineId], references: [id])
  entryStation         Station?                    @relation("RollEntryStation", fields: [entryStationId], references: [id])
  /// ⚠️ onDelete: Restrict — Prisma'nın opsiyonel ilişkilerdeki VARSAYILANI
  /// `SetNull`'dır ve burada YANLIŞ olurdu: bir depoyu silmek, içindeki topları
  /// SESSİZCE deposuz bırakırdı (ölçüldü — bekçi bunu yakaladı). Servis guard'ı
  /// zaten dolu depoyu silmiyor; RESTRICT o kuralı DB seddine çevirir.
  warehouse            Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// Aynı gerekçe: fiş silinirse topun kökeni sessizce kaybolurdu (fişler zaten
  /// silinmez, iptal edilir).
  goodsReceipt         GoodsReceipt?               @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  warehouseMovements   WarehouseMovement[]
  labelCustomer        Customer?                   @relation("RollLabelCustomer", fields: [labelCustomerId], references: [id])
  properties           RollProperty[]
  shipment             Shipment?                   @relation(fields: [shipmentId], references: [id])
  sack                 Sack?                       @relation(fields: [sackId], references: [id])
  returns              RollReturn[]
  batch                Batch?                      @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([itemId])
  @@index([parentRollId])
  // PARTIAL (WHERE "parentReceiptId" IS NOT NULL) — migration 20260606001717.
  // Çoğu ruloda null; partial = küçük indeks + null insert'te bakım yok. Şemada
  // @@index tam görünür ama DB'de partial'dır (Prisma 7 predicate'i drift saymaz).
  @@index([parentReceiptId])
  @@index([createdById])
  // KK1 makine atfı raporu ("bu makinede girilen toplar")
  @@index([createdMachineId])
  // "Bu istasyonda girilen toplar" — sütun bugün, filtre yarın.
  // createdMachineId ile AYNI desen (kardeş alan): tam index, opsiyonel ilişki.
  @@index([entryStationId])
  // Depo bazlı stok listesi/sayımı: "X deposunda WAREHOUSE olan toplar".
  // Eşitlik kolonu önce (perf kuralı 2). Mevcut [status, itemId, colorId, width]
  // fungible-havuz indeksine depo boyutu BİLİNÇLİ eklenmedi: o sorgu bugün
  // depo-bağımsız koşuyor ve `rolls` zaten en çok indeksli tablo — depo filtresi
  // o yola girerse EXPLAIN kanıtıyla eklenecek.
  @@index([warehouseId, status])
  // Mal kabul fişinin topları (fiş detayı + iptal kapsamı).
  // PARTIAL (WHERE "goodsReceiptId" IS NOT NULL) — çoğu topta null.
  @@index([goodsReceiptId])
  // Liste sayfaları: status filter + createdAt desc sort
  @@index([status, createdAt])
  // Envanter sekmeleri: status filter + updatedAt desc sort ("son hareket" sıralaması).
  // Ham Stok DIŞINDAKİ sekmeler bunu kullanır — topun oraya GELİŞ anı createdAt değil
  // (kurtarma / kapanış dispozisyonu / fason kabulü haftalar önce yaratılmış topu bugün
  // depoya alır). createdAt sıralı listede o top binlerce satırın altına düşerdi.
  @@index([status, updatedAt])
  // Ham/işlenmiş filter: WHERE "colorId" IS NULL (ham) — yüksek seçicilikli partial index
  // (Postgres native; Prisma şemasında native değil ama @@index runtime'da partial olmadan
  // eklenir; ileride raw migration ile partial CONCURRENTLY üretmek gerekebilir.)
  @@index([colorId, status])
  // Raporlama: kaynak bazlı dönem sorguları (örn. "Mart 2027 ham kumaş üretimi")
  @@index([entrySource, createdAt])
  // WO detayı: "şu adımda üretilen + WAREHOUSE/A1_STOCK" sorgusu
  @@index([producedInStepId, status])
  // Fason kuyruğu: "bu adımda + AT_SUBCONTRACTOR" listeleme
  @@index([currentStepId, status])
  // Parti izi: bir partinin (batchId) tüm rotadaki tops'larını topla.
  // PARTIAL (WHERE "batchId" IS NOT NULL) — parti_modeli migration.
  @@index([batchId])
  @@index([qualityGradeId])
  // Sevkiyat oturumunun topları (shipmentId = X). PARTIAL (WHERE "shipmentId" IS
  // NOT NULL) — migration 20260606001717. NOT: "depodaki serbest stok" (shipmentId
  // IS NULL) bu indeksi KULLANMAZ — o sorgu zaten status indeksinden geçer (null
  // satırlar çoğunluk, düşük seçicilik; ölçüldü: balance groupBy status indeksini seçer).
  @@index([shipmentId])
  // Çuval içeriği: bir çuvaldaki toplar (irsaliye/detay dökümü).
  // PARTIAL (WHERE "sackId" IS NOT NULL) — migration 20260606001717.
  @@index([sackId])
  // Spec-toplam karşılanma: item+renk+en eşleşen WAREHOUSE/STOCK toplar (fungible havuz)
  @@index([status, itemId, colorId, width])
  // Kartelalık filtresi: Tambur'da işaretlenmiş depodaki toplar. PARTIAL (WHERE
  // "markedForKartela" = true) — migration 20260607020000. True olan satırlar
  // toplam rollerin %1-2'si → micro-index; false satırlar indekslenmez.
  @@index([markedForKartela])
  // F123: status-filtreli listede currentQty sıralaması (depo miktar). initialQty/width/
  // qualityGrade İÇİN eklenmedi — rolls çok-index'li (D-8); ölçekte EXPLAIN ihtiyaç gösterirse.
  @@index([status, currentQty])
  // Etiket müşterisi süzgeci ("şu müşteriye basılmış toplar"). DB'de PARTIAL'dır
  // (WHERE "labelCustomerId" IS NOT NULL — migration 20260809023731): kolon
  // çoğunlukla NULL (stok etiketi yaygın ve bilinçli) ve NULL satırlar hiç
  // aranmıyor. Drift-free desen: şemada düz @@index, migration'da predicate —
  // Prisma 7 predicate farkını drift SAYMAZ (index↔unique farkını sayar).
  @@index([labelCustomerId])
  // Kalite/fire/fason karnelerinin dönem taraması (`finalizedAt BETWEEN a AND b`).
  // PARTIAL (WHERE "finalizedAt" IS NOT NULL) — migration 20260809090000. Yalnız
  // üretimi bitmiş toplar damgalanır (ham stok + üretimdekiler NULL), yani index
  // tablonun bir alt kümesini tutar. Tek kolon yeter: raporlar önce dönemle
  // daraltıp sonra JOIN'liyor (kırılım item/color/subcontractor üzerinden).
  @@index([finalizedAt])
  @@map("rolls")
}

// =============================================================================
// 4. SALES, ORDER & FINANCE
// =============================================================================

model Customer {
  id           String      @id @default(uuid()) @db.Uuid
  code         String      @unique @db.VarChar(32)
  name         String      @db.VarChar(100)
  taxNumber    String?
  // ---------------------------------------------------------------------------
  // "Her şube = ayrı müşteri" düzeni (2026-07): şube kartında yaşayan alanlar
  // müşteri kartına taşındı — hepsi opsiyonel, mevcut kayıtlar null kalır.
  // exportCode: firma ihracat kodu — sevk belgelerinde şube kodundan
  // (CustomerBranch.code) BAĞIMSIZ ayrı satır; ikisi de kendi section toggle'ıyla
  // ("branchCode" / "exportCode") basılır. Bkz. document-render üreticileri + DOC_DEFS.
  // ---------------------------------------------------------------------------
  exportCode   String?     @db.VarChar(50)
  address      String?
  city         String?     @db.VarChar(80)
  district     String?     @db.VarChar(80)
  country      String?     @db.VarChar(80)
  contactName  String?     @db.VarChar(120)
  contactPhone String?     @db.VarChar(40)
  email        String?     @db.VarChar(200)
  notes        String?
  type         CompanyType @default(CUSTOMER)
  isActive     Boolean     @default(true)

  /// Belge şablon profili — bu müşteriye basılan belgeler profil override'ını
  /// kullanır (atanmamışsa genel Belge Şablonları ayarı). Bkz. DocumentProfile.
  documentProfileId String? @db.Uuid

  // Relations
  orders           Order[]
  defaultRoutes    Route[]                   @relation("CustomerDefaultRoutes")
  /// Etiketinde bu müşteri yazan toplar — SAHİPLİK DEĞİL (bkz. `Roll.labelCustomerId`).
  labelledRolls    Roll[]                    @relation("RollLabelCustomer")
  branches         CustomerBranch[]
  itemAliases      CustomerItemAlias[]
  colorAliases     CustomerColorAlias[]
  shipments        Shipment[]
  sacks            Sack[]
  rollReturns      RollReturn[]
  /// Bu firmadan alınan mal kabul fişleri (tedarikçi rolü — CompanyType.SUPPLIER).
  goodsReceipts    GoodsReceipt[]            @relation("GoodsReceiptSupplier")
  directShipments  DirectShipment[]
  templateRoutes   CustomerTemplateRoute[]
  standaloneLabels CustomerStandaloneLabel[]
  documentProfile  DocumentProfile?          @relation("CustomerDocProfile", fields: [documentProfileId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([type])
  @@index([documentProfileId])
  cariAccount CariAccount?
  @@map("customers")
}

// =============================================================================
// CUSTOMER BRANCH — Müşterinin sevk noktası (şube/depo/mağaza adresi)
// =============================================================================
// Sevkiyatın hedefi her zaman bir şubedir. Aynı müşterinin farklı şehir/şube
// sevkiyatları ayrı planlanır. Soft delete: isActive=false.
// =============================================================================
model CustomerBranch {
  id           String  @id @default(uuid()) @db.Uuid
  customerId   String  @db.Uuid
  code         String? @db.VarChar(50) // Şube ihracat kodu (opsiyonel) — sevk belgesinde tek "İhracat Kodu" satırına, dolu ise şirket exportCode'unun ÖNÜNE geçerek basılır (branchCode ?? customerExportCode). Kolon adı tarihsel "code"; arama/anahtar değil, salt görüntü.
  name         String  @db.VarChar(100) // "Ankara Şubesi", "Merkez Depo" gibi
  address      String?
  city         String?
  district     String?
  contactName  String?
  contactPhone String?
  notes        String?
  isActive     Boolean @default(true)

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders          Order[]
  shipments       Shipment[]
  sacks           Sack[]
  directShipments DirectShipment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // UNIQUE (2026-07-31 denetimi): müşteri-içi şube kodu tekil — diğer master-data'nın
  // code @unique backstop'unun buradaki karşılığı. code NULL'ken serbest (PG'de
  // NULL'lar çakışmaz — partial gerekmez); ad-dup bilinçli app-level (kök CLAUDE.md).
  @@unique([customerId, code])
  @@index([customerId, isActive])
  @@map("customer_branches")
}

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique @db.VarChar(64)
  /// İdempotency anahtarı — istemci form-oturumu başına üretir (UUID); timeout
  /// sonrası tekrar gönderimde mükerrer sipariş yaratılmasını önler (Roll emsali).
  /// Sunucu-içi/eski kayıtlar için NULL — partial unique index (NULL'lar çakışmaz).
  clientToken String? @unique @db.Uuid
  customerId  String  @db.Uuid
  branchId    String? @db.Uuid // Hedef şube — opsiyonel; bir sipariş tek bir şubeye gider. Mevcut kayıtlar için null kabul.

  // Finance & Pricing
  currency    Currency @default(TRY)
  totalAmount Decimal? @db.Decimal(14, 2)

  status    OrderStatus @default(PENDING)
  orderDate DateTime    @default(now()) @db.Timestamptz
  deadline  DateTime?   @db.Timestamptz

  /// Denormalize sevk toplamı (m). Tek yazma noktası: recomputeOrderFulfillment.
  /// Liste sayfasında "shippedQty / sum(lines.quantity)" gösterimi için.
  shippedQty Decimal @default(0) @db.Decimal(12, 3)

  // Tamamlanma kaydı
  completedAt       DateTime? @db.Timestamptz // İlk COMPLETED'a düştüğü an (otomatik veya manuel)
  manualClosedById  String?   @db.Uuid // Manuel kapatan kullanıcı (null = otomatik kapandı)
  manualCloseReason String?   @db.Text

  // Relations
  customer       Customer        @relation(fields: [customerId], references: [id])
  branch         CustomerBranch? @relation(fields: [branchId], references: [id])
  manualClosedBy User?           @relation("OrderManualClosedBy", fields: [manualClosedById], references: [id])
  lines          OrderLine[]
  shipmentLinks  ShipmentOrder[] // Paketleme oturumlarında seçildiği sevkiyatlar
  rollReturns    RollReturn[] // Bu siparişe atfedilen iadeler (sevk muhasebesini değiştirmez)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([customerId])
  @@index([branchId])
  @@index([manualClosedById])
  @@index([status, createdAt(sort: Desc)])
  @@index([deadline])
  @@map("orders")
}

// Sipariş satırı — `itemId` baz ürünü (örn. PATOS) işaret eder. Renk ayrı
// alanda (`colorId`); özellikler `requiredProperties` (M:N) ile saklanır.
// Planlamacı WO açarken bu üçü targetItem/targetColor/targetProperties
// önerisi olarak kullanır.
model OrderLine {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  itemId     String   @db.Uuid
  /// Müşterinin istediği renk. NULL = ham talep (ileride satılabilir; bugün
  /// default akış değil). Item.allowedColors dolu ise bu listeden olmalı.
  colorId    String?  @db.Uuid
  quantity   Decimal  @db.Decimal(12, 3) // Requested quantity (meters)
  /// Denormalize SEVK toplamı (m) — Σ(SackAllocation.qty; çuval DISPATCHED'te). Tek yazma
  /// noktası recomputeOrderFulfillment. recomputeOrderStatus/status bunu okur.
  /// Açık miktar = quantity − shippedQty (rezerv/packedQty YOK — düşüş yalnız sevkte).
  shippedQty Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice  Decimal? @db.Decimal(12, 2) // For future finance module
  width      Decimal? @db.Decimal(12, 3) // İstenen en (cm)

  /// Tambur kesim talimatı — eşit-parça otomatik öneri. Örn 400 = "her 400 m'de bir kes".
  /// NULL = serbest kesim (operatör karar verir). Tambur bu değerden kesim önerir.
  pieceLengthM Decimal? @db.Decimal(12, 3)
  /// Kesim/sevk için serbest not (pieceLengthM'e sığmayan istisna talimatlar).
  cutNote      String?

  /// "Müşterideki adı" — sipariş satırı bazlı override (1-shot).
  /// NULL ise effective name CustomerItemAlias.alias'tan (master, live) okunur;
  /// o da yoksa Item.name (default). Master değişti → bu null satırlar otomatik
  /// yansıtır; bu alan dolu ise kilit (özel istek için frozen).
  customerItemName  String?
  /// "Müşterideki rengin adı" — aynı override mantığı (CustomerColorAlias → Color.name).
  customerColorName String?

  // Relations
  order                 Order                               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item                  Item                                @relation(fields: [itemId], references: [id])
  color                 Color?                              @relation(fields: [colorId], references: [id])
  workOrderLinks        WorkOrderToOrderLine[]
  requiredProperties    OrderLineRequiredProperty[]
  sackAllocations       SackAllocation[]
  directShipAllocations SubcontractorDirectShipAllocation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([orderId])
  // D-6: @@index([itemId]) kaldırıldı — @@index([itemId, createdAt]) sol-prefix'i kapsar.
  @@index([colorId])
  // Sipariş-önce aramalı liste (cursor keyset createdAt asc) + ürün-filtreli sayfalama.
  @@index([createdAt])
  @@index([itemId, createdAt])
  @@map("order_lines")
}

/// OrderLine ↔ FabricProperty M:N — müşterinin sipariş satırı için
/// istediği özellikler. WO oluşturulurken planlamacıya öneri olarak gelir.
model OrderLineRequiredProperty {
  id          String @id @default(uuid()) @db.Uuid
  orderLineId String @db.Uuid
  propertyId  String @db.Uuid

  orderLine OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  property  FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([orderLineId, propertyId])
  @@index([propertyId])
  @@map("order_line_required_properties")
}

// =============================================================================
// 5. WORK ORDER (BATCH) & DYNAMIC ROUTING
// =============================================================================

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  workOrderNumber  String          @unique @db.VarChar(64) // İş Emri Numarası (IE+GGAAYY+NNNN)
  /// İdempotency anahtarı — istemci form-oturumu başına üretir (UUID); timeout
  /// sonrası tekrar gönderimde mükerrer İE + refakat kartı yaratılmasını önler
  /// (Roll emsali). NULL = sunucu-içi/eski kayıt; partial unique (NULL'lar çakışmaz).
  /// hardDelete (zero-attach telafisi) token'ı NULL'lar — taze deneme çalışabilsin.
  clientToken      String?         @unique @db.Uuid
  type             WorkOrderType   @default(ORDER_PRODUCTION)
  width            Decimal?        @db.Decimal(12, 3) // En (cm) — kumaş eni
  targetQuantity   Decimal?        @db.Decimal(12, 3) // Hedef uzunluk/metraj
  targetWeight     Decimal?        @db.Decimal(12, 3) // Hedef ağırlık (kg) — opsiyonel; tekstilde mt+kg planlanır
  parameters       Json? // Dynamic params: serbest meta
  status           WorkOrderStatus @default(PLANNED)
  plannedStartDate DateTime?       @db.Timestamptz // Planlanan başlangıç tarihi
  plannedEndDate   DateTime?       @db.Timestamptz // Planlanan termin / bitiş tarihi

  // 3.1 — Rota şablonu referansı (snapshot kopya sonrası bile tutulur; analytics için)
  routeTemplateId String? @db.Uuid
  routeTemplate   Route?  @relation(fields: [routeTemplateId], references: [id])

  // Hedef ürün — planlamacının "ne üretiyoruz" cevabı. Item'ın kendisini işaret
  // eder. Renk ve özellikler ayrı alanlardadır: targetColorId + targetProperties M:N.
  // targetColorId, rotadaki "renk veren" (SubcontractorCategory.appliesColor=true)
  // Fason Kabul'ünde Roll'a kopyalanır. targetProperties ise "özellik veren"
  // (SubcontractorCategory.appliesProperty=true) adımda kopyalanır — aynı adım
  // her ikisini de yapabilir (Boyahane gibi).
  // ORDER_PRODUCTION: orderLine.itemId/colorId/properties'den otomatik
  // STOCK_PRODUCTION: zorunlu (manuel seçilir)
  targetItemId  String? @db.Uuid
  targetColorId String? @db.Uuid

  /// Tambur planlama bilgisi — kumaşın kaç-kat sarılacağı. Değer KAT kataloğundan
  /// gelir (bkz. Roll.foldType notu). Tambur ekranında **bilgi olarak** gösterilir;
  /// nihai kararı operatör verir (finalize sırasında override edebilir, gerçek
  /// değer topun KENDİ kolonuna — `Roll.foldType` — yazılır; 2026-08-04'ten beri
  /// RollOperation.metadata yalnız ikincil izdir).
  foldType String?

  // O-9: WorkOrder.dyehouseNote kaldırıldı — fason talimatı tek kaynağı
  // WorkOrderStep.notes (bkz. project_dyehouse_note). Kolon drift-fix ile yanlışlıkla
  // geri gelmişti, kod kullanmıyordu; migration 20260708140000 ile DROP edildi.

  // Soft-delete bayrağı — hardDelete artık `isActive=false` yapar; bağlı
  // RollOperation / TravelerCard / Manifest / Swatch / Dispatch / Receipt
  // ve WorkOrderStep kayıtları korunur (izlenebilirlik + audit). Listeler
  // default `isActive: true` filtreler. Detay endpoint (findById) arşivli
  // WO'ları da getirir.
  isActive Boolean @default(true)

  /// Parti ayırma soy bağı — bu WO, başka bir WO'nun partisinden ayrıldıysa
  /// kaynak WO'nun id'si. Eski refakat kartı okutulunca kabul ekranı bu bağla
  /// ayrılan partilerin bekleyen gruplarını da gösterir; Dallar panelinde
  /// "ayrıldı → P-XXX" izi bu bağdan okunur. NULL = ayrılmamış normal WO.
  splitFromId String? @db.Uuid

  // Relations
  steps            WorkOrderStep[]
  orderLinks       WorkOrderToOrderLine[]
  batches          Batch[]
  travelerCards    TravelerCard[]
  manifests        Manifest[]
  dispatches       SubcontractorDispatch[]
  receipts         SubcontractorReceipt[]
  targetItem       Item?                     @relation("WorkOrderTargetItem", fields: [targetItemId], references: [id])
  targetColor      Color?                    @relation("WorkOrderTargetColor", fields: [targetColorId], references: [id])
  targetProperties WorkOrderTargetProperty[]
  splitFrom        WorkOrder?                @relation("WorkOrderSplitLineage", fields: [splitFromId], references: [id])
  splitChildren    WorkOrder[]               @relation("WorkOrderSplitLineage")
  kursunBypasses   KursunBypassAssignment[] // Kurşun bypass atamaları (append-only)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([routeTemplateId])
  @@index([targetItemId])
  @@index([targetColorId])
  // Sevk picker'ı: WHERE status IN (...) ORDER BY createdAt DESC için composite
  @@index([status, createdAt(sort: Desc)])
  // "Termini Yakın" sıralaması: WHERE status IN (...) ORDER BY plannedEndDate ASC
  @@index([status, plannedEndDate])
  // Soft-delete filtreli listeler için
  @@index([isActive])
  // Ayrılma soy bağı — null-yoğun; migration'da partial'a çevrilir (IS NOT NULL)
  @@index([splitFromId])
  @@map("work_orders")
}

// Parti (Batch) — üretime aynı anda giren top grubu (bir iş emri N parti içerir).
// Attach dalgasında doğar; ton/izlenebilirlik birimi; refakat kartı parti başına.
// "Dal" (eski batchSplitId=dispatch.id) kavramının yerini alır. Detay: PARTI-MODELI-TASARIM.md.
model Batch {
  id          String @id @default(uuid()) @db.Uuid
  /// Parti numarası. İKİ BİÇİM, `batch.shortNumberEnabled` bayrağına göre:
  ///   • AÇIK (varsayılan) → `P01 … P99`, 99'dan sonra P01'e SARAR.
  ///   • KAPALI            → `P + GGAAYY + günlük sıra` (dolgusuz, eski biçim).
  /// ⚠️ BENZERSİZ DEĞİLDİR — `@unique` 2026-08-05'te KALDIRILDI (migration
  /// `20260805120000_batch_short_number`): kısa numara tanım gereği birkaç günde
  /// bir yeniden kullanılır (fabrika numaralı fiziksel parti plakası kullanıyor).
  /// Partinin KİMLİĞİ `id`'dir; hiçbir yerde `batchNumber` ile lookup YAPMA.
  /// Yarış koruması artık kısıt değil, `generateBatchNumberTx`'teki advisory lock.
  batchNumber String @db.VarChar(64)
  workOrderId String @db.Uuid

  /// Parti soy bağı — kısmi sevk kalanı / elle bölme / redye'da kaynak parti.
  /// NULL = doğrudan ekleme dalgasıyla doğan kök parti.
  splitFromId String? @db.Uuid

  /// Merge soy bağı (K17) — bu parti başka bir partiye BİRLEŞTİYSE survivor'ı işaret
  /// eder. Kaynak parti silinmez, "→ P… altına birleşti" tarihçe satırı olarak yaşar.
  /// NULL = birleşmemiş (canlı) parti.
  mergedIntoId String? @db.Uuid

  workOrder      WorkOrder               @relation(fields: [workOrderId], references: [id])
  splitFrom      Batch?                  @relation("BatchSplitLineage", fields: [splitFromId], references: [id])
  splitChildren  Batch[]                 @relation("BatchSplitLineage")
  mergedInto     Batch?                  @relation("BatchMergeLineage", fields: [mergedIntoId], references: [id])
  mergedChildren Batch[]                 @relation("BatchMergeLineage")
  rolls          Roll[]
  dispatches     SubcontractorDispatch[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([workOrderId])
  // Null-yoğun — parti_modeli migration'da partial'a çevrilir (IS NOT NULL, drift-free)
  @@index([splitFromId])
  // Null-yoğun — batch_merged_into migration'da partial (IS NOT NULL, drift-free)
  @@index([mergedIntoId])
  // Kısa parti sayacının kaynağı: "en son doğan kısa parti" (`createdAt DESC LIMIT 1`).
  // batchNumber ile SIRALANAMAZ — numara sarıyor, en büyük numara "en yeni" demek değil.
  @@index([createdAt])
  @@map("batches")
}

model WorkOrderStep {
  id           String     @id @default(uuid()) @db.Uuid
  workOrderId  String     @db.Uuid
  stationId    String     @db.Uuid
  stepSequence Int // Order in the route: 1, 2, 3
  status       StepStatus @default(PENDING)
  stepData     Json? // Station-specific data (e.g. Tambur: { "foldType": "4-kat" })
  notes        String? // Adıma özel talimat / not
  skipReason   String? // R6: SKIPPED ise neden
  startedAt    DateTime?  @db.Timestamptz
  completedAt  DateTime?  @db.Timestamptz

  // EXTERNAL adımlar için planlama alanları:
  //   requiredCategoryId    : Adım hangi tür fason hizmeti gerektiriyor (Boyahane, Yıkama vs)
  //   plannedSubcontractorId: Planlamada hangi firma seçildi (opsiyonel — sevk anında değiştirilebilir)
  requiredCategoryId     String? @db.Uuid
  plannedSubcontractorId String? @db.Uuid

  /// Planlamanın atadığı sıralama önceliği (Kurşun/KK2 kuyruğu gibi WO bazlı
  /// kuyruklar için). Düşük değer önce işlenir; tablet `open-cards`
  /// listesi ve Electron Kurşun Sırası bu alanı ortak okur.
  priority       Int       @default(0)
  /// Acil rozeti — planlama işaretler, operatör tablette kırmızı görür.
  isUrgent       Boolean   @default(false)
  urgentMarkedAt DateTime? @db.Timestamptz

  // Relations
  workOrder            WorkOrder                @relation(fields: [workOrderId], references: [id])
  station              Station                  @relation(fields: [stationId], references: [id])
  movements            RollMovement[]
  cardScans            TravelerCardScan[]
  dispatches           SubcontractorDispatch[]
  receipts             SubcontractorReceipt[]
  operations           RollOperation[]
  variances            RollVariance[]
  currentRolls         Roll[]                   @relation("RollCurrentStep")
  producedRolls        Roll[]                   @relation("RollProducedInStep")
  detectedErrors       RollError[]              @relation("RollErrorDetectedAt")
  processedErrors      RollError[]              @relation("RollErrorProcessedAt")
  requiredCategory     SubcontractorCategory?   @relation("StepRequiredCategory", fields: [requiredCategoryId], references: [id])
  plannedSubcontractor Subcontractor?           @relation("StepPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])
  // Kurşun bypass: bu adım için açılmış atamalar (aynı adıma çok-parti nedeniyle
  // birden fazla satır düşebilir; AÇIK olanın tekliği partial unique ile korunur)
  kursunBypasses       KursunBypassAssignment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // D-12: adım sırası benzersiz — aynı WO'da iki adım aynı stepSequence'a sahip
  // olamaz (refakat kartı okutma sırası / "sıradaki adım" çözümlemesi belirsizleşmesin).
  @@unique([workOrderId, stepSequence])
  @@index([workOrderId, status])
  @@index([requiredCategoryId])
  @@index([plannedSubcontractorId])
  // Kurşun+KK2 / Tambur "Açık Kartlar" kuyruğu: station + bekleyen step + sıra.
  // @@index tam görünür ama DB'de PARTIAL'dır (WHERE status <> 'COMPLETED') —
  // COMPLETED yığını indekslenmez, açık kuyruk sorgusu O(açık step). Prisma 7
  // predicate'i drift saymaz. Migration: 20260607010000.
  @@index([stationId, status, isUrgent, priority, startedAt])
  @@map("work_order_steps")
}

/// Kurşun bypass atamasının hangi yoldan TAMAMLANDIĞI.
///   TAMBUR_SCAN            — Tambur tabletinde refakat kartının karekodu okutuldu,
///                            operatör önizlemeyi onayladı → Kurşun/KK2 adımı COMPLETED.
///   DISTRIBUTION_LAST_STEP — Kurşun rotanın SON adımıydı; Kurşun Dağıtım ekranındaki
///                            "İşi Bitir" ile tamamlandı (finalizeRollsAtLastStep → WAREHOUSE).
enum KursunBypassCompletionSource {
  TAMBUR_SCAN
  DISTRIBUTION_LAST_STEP
}

/// Kurşun bypass ataması — fabrika kurşun makinelerine tablet KOYMUYOR. Kurşun
/// işlemi fiziksel olarak yapılır ama dijital izlenmez (hatalar kâğıtta): yetkili
/// personel, kurşun adımında bekleyen iş emrini bir fiziksel kurşun MAKİNESİNE
/// ATAR; adım daha sonra Tambur'da kart okutmasıyla ya da (kurşun rotanın son
/// adımıysa) dağıtım ekranından tamamlanır.
///
/// ⚠️ ATAMA MAKİNE BAZINDADIR, İSTASYON BAZINDA DEĞİL. Fabrikada TEK bir
/// PROCESS_QC istasyonu (KURSUN_KK2) vardır ve altında N adet fiziksel kurşun
/// makinesi (`Machine`) durur — dağıtımcının seçtiği şey o makinedir. Bunun üç
/// sonucu var:
///   1. `WorkOrderStep.stationId` **REPOINT EDİLMEZ** (eski tasarımdaki
///      `stationId`/`originalStationId` çifti bu yüzden DÜŞTÜ). İstasyon zaten
///      tek ve değişmiyor; atama bilgisi adımda değil, BU SATIRDA yaşar.
///      `WorkOrderStep`'te `machineId` alanı da YOKTUR ve eklenmeyecektir.
///   2. Makine atfı `RollMovement.machineId`'ye damgalanır (bypass kapanışında
///      atanan makine yazılır) — makine bazlı hacim raporları böylece çalışır.
///   3. İstasyon yetenekleri (KURŞUN `StationProperty`) makinenin İSTASYONUNDAN
///      okunur: `copyStationCapabilitiesToRoll(machine.stationId)`.
///
/// ⚠️ Bu SKIPPED DEĞİLDİR: adım atlanmaz, `RollMovement`'lar normal şekilde
/// kapanır ve adım COMPLETED olur. Fark, `RollOperation` (KURSUN_APPLIED /
/// QC2_COMPLETED) YAZILMAMASI ve `RollError` açılmamasıdır. İstasyon yetenekleri
/// (copyStationCapabilitiesToRoll) YİNE kopyalanır — KURŞUN özelliği kaybolmasın.
/// İz üçlüsü: movement notes marker'ı (`KURSUN_BYPASS_FINISHED:<uuid>`) + bu satır
/// + audit kaydı.
///
/// TASARIM — satır APPEND-ONLY + SOFT-CANCEL'dir:
/// • Tamamlanan satır silinmez; `completedAt`/`completedById`/`completedVia` ile
///   damgalanır. İptal edilen satır `cancelledAt`/`cancelledById`/`cancelReason`
///   alır — adımda geri yüklenecek bir şey YOKTUR (istasyon hiç değişmedi),
///   iptal yalnız bu satırı kapatır.
/// • `workOrderStepId`'ye @unique KOYULMADI — fason çok-parti gerçeği: parti 1
///   bypass ile biter, parti 2 haftalar sonra gelir ve AYNI adım için YENİ bir
///   atama satırı gerekir. Teklik yalnız AÇIK atamada anlamlıdır.
/// • Onun yerine ŞEMA-DIŞI partial unique kullanılır (migration
///   `20260731120000_add_kursun_bypass_assignment`):
///     kursun_bypass_one_pending_per_step_uq ("workOrderStepId")
///       WHERE "completedAt" IS NULL AND "cancelledAt" IS NULL
///   = "bir adımda EN FAZLA BİR açık atama" invariant'ının DB seddi; eşzamanlı
///   atama yarışının kaybedeni P2002 alır (servis 409'a çevirir). Partial UNIQUE
///   `@@unique` ile ifade edilemediğinden şemada karşılığı bilinçli olarak YOK
///   (`roll_movements_one_open_per_roll_step_uq` emsali). Envanteri
///   `scripts/test_db_invariants.ts` tutar — silinirse test DÜŞER.
/// • `workOrderId` DENORMALİZE'dir (adımdan türetilebilir): "bu WO'nun açık bypass
///   ataması var mı" sorgusu hem dağıtım ekranının hem Tambur önizlemesinin sıcak
///   yolu — join'siz tek index taraması için tutulur.
model KursunBypassAssignment {
  id              String @id @default(uuid()) @db.Uuid
  workOrderId     String @db.Uuid
  workOrderStepId String @db.Uuid
  /// ATANAN fiziksel kurşun makinesi (station.kind = PROCESS_QC olan makine).
  /// Yetenek okuması `machine.stationId` üzerinden yapılır; movement kapanışında
  /// `RollMovement.machineId` bu değerle damgalanır.
  machineId       String @db.Uuid

  assignedById String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz
  /// Dağıtımcının serbest notu ("2. vardiyaya kaldı" gibi) — opsiyonel.
  notes        String?  @db.VarChar(500)

  completedAt   DateTime?                     @db.Timestamptz
  completedById String?                       @db.Uuid
  completedVia  KursunBypassCompletionSource?

  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(200)

  // Relations
  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id])
  workOrderStep WorkOrderStep @relation(fields: [workOrderStepId], references: [id])
  machine       Machine       @relation(fields: [machineId], references: [id])
  assignedBy    User          @relation("KursunBypassAssignedBy", fields: [assignedById], references: [id])
  // onDelete: Restrict AÇIKÇA yazılı — DB'de (migration 20260731120000) RESTRICT
  // yaratıldı ama Prisma opsiyonel ilişkide varsayılan olarak SetNull sayıyordu →
  // datamodel/DB drift'i. Niyet RESTRICT: bypass izi, "kim tamamladı/kim iptal etti"
  // bilgisi kullanıcı kaydı üzerinden koparılamaz (satır append-only).
  completedBy   User?         @relation("KursunBypassCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy   User?         @relation("KursunBypassCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // WO bazlı açık-atama lookup'ı (denormalize kolon sayesinde join'siz)
  @@index([workOrderId])
  @@index([workOrderStepId])
  // Dağıtım/izleme ekranı: "bu kurşun MAKİNESİNE atanmış işler" listesi
  @@index([machineId])
  @@map("kursun_bypass_assignments")
}

/// Join table: WorkOrder ↔ OrderLine (N:N)
/// 3.2 — `allocatedQty`: bu WO'nun bu sipariş satırından tahsis ettiği metraj
model WorkOrderToOrderLine {
  workOrderId  String  @db.Uuid
  orderLineId  String  @db.Uuid
  allocatedQty Decimal @default(0) @db.Decimal(12, 3) // Metraj/kg cinsinden tahsis (sipariş birimiyle aynı)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@id([workOrderId, orderLineId])
  @@index([orderLineId])
  @@map("work_order_to_order_lines")
}

// =============================================================================
// 6. PRODUCTION DATA - Errors & Defects
// =============================================================================

/// Kalite derecesi kataloğu — Tambur/QC kararlarında operatör ekranında
/// buton olarak çıkar. Admin yönetir. Roll.qualityGrade alanı bu katalogdan
/// seçilen code'un snapshot'ıdır (katalog değişse bile eski toplar bozulmaz).
model QualityGrade {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(32) // "1.KALITE", "A1", "A2", "FIRE" (eski) veya KAL-YYMM-XXXX (admin)
  name         String     @db.VarChar(100) // UI'da görünen etiket
  description  String?
  color        String?    @db.VarChar(7) // "#10b981" vb. — UI rozeti için opsiyonel
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  /// Tambur'da bu kalite seçildiğinde çocuk top'un alacağı hedef RollStatus.
  /// 1. Kalite → WAREHOUSE, alt kaliteler (A1/A2/2.K) → A1_STOCK, FİRE → SCRAP.
  targetStatus RollStatus @default(SCRAP)

  /// İADE'ye özel hedef statü — müşteri iadesinde (returnGradingEnabled açık) bu
  /// kalite seçilirse top bu statüye iner (FİRE→SCRAP, A1→A1_STOCK, 1.Kalite→WAREHOUSE).
  /// `targetStatus`'tan KASTEN AYRI: targetStatus Tambur kesimi içindir (seed hep
  /// WAREHOUSE, dokunulmaz); bu kolon YALNIZ iade akışınca okunur. null → WAREHOUSE.
  returnTargetStatus RollStatus?

  rolls       Roll[]
  rollReturns RollReturn[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([isActive, sortOrder])
  @@map("quality_grades")
}

/// İade nedeni kataloğu — admin CRUD. İade ekranında seçilebilir; ayrıca serbest
/// metin (RollReturn.reasonText) de girilebilir, ikisi de opsiyonel/boş bırakılabilir.
/// Soft-delete (isActive=false); mevcut RollReturn.reasonId snapshot'ları korunur.
model ReturnReason {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32) // "YANLIS_URUN", "HASARLI" ...
  name        String  @db.VarChar(100)
  description String?
  color       String? @db.VarChar(7) // UI rozeti (opsiyonel)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  rollReturns RollReturn[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([isActive, sortOrder])
  @@map("return_reasons")
}

/// Hata tipi kataloğu — operatör ekranında buton olarak çıkar, elle girilmez.
/// Yönetici ekranı üzerinden eklenir/silinir. severity hataya görsel öncelik verir.
model DefectType {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(32)
  name        String          @db.VarChar(100)
  description String?
  severity    DefectSeverity? // UI renklendirme için
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  rollErrors RollError[]

  @@index([isActive])
  @@map("defect_types")
}

/// Top barkod sıra sayacı — gün+tip başına atomik sıralı numara kaynağı.
/// Barkod = `TEKS`+`YYMMDD`+`H|F`+encodeRollSeq(n). `INSERT … ON CONFLICT (day,type)
/// DO UPDATE n=n+1 RETURNING n` ile ÇAKIŞMASIZ (satır kilidi serileştirir) — offline
/// istemci sırayı üretemediği için sunucu tek kaynak. Yeni gün → yeni satır (n=1'den).
model RollBarcodeCounter {
  day  String @db.VarChar(6) /// YYMMDD
  type String @db.VarChar(1) /// H (ham) | F (final)
  n    Int    @default(0)

  @@id([day, type])
  @@map("roll_barcode_counters")
}

/// Top üzerinde tespit edilen hatalar. Kurşun/QC2 istasyonunda açılır,
/// Tambur istasyonunda karara bağlanır (kesildi/korundu/A1).
///
/// Hata tipi iki alanla tutulur:
///   - defectTypeId → DefectType FK (canonical, işlem anında seçilir)
///   - errorType    → DefectType.name'in snapshot'ı (katalog ileride yeniden
///                    adlandırılsa bile historik etiket korunur)
model RollError {
  id           String           @id @default(uuid()) @db.Uuid
  rollId       String           @db.Uuid
  /// Hatanın tespit edildiği metre noktası (KK2 operatörü "60. metrede hata"
  /// girer). Hata sadece NOKTA olarak takip edilir; aralık bilgisi tutulmaz.
  /// Tambur operatörü ekranda bu noktayı görüp fiziksel kesim kararı verir.
  startMeter   Decimal          @db.Decimal(12, 3)
  defectTypeId String?          @db.Uuid
  errorType    String? // DefectType.name snapshot (kayıt anında kopyalanır)
  isProcessed  Boolean          @default(false) // Tambur kararı verildi mi?
  actionTaken  RollErrorAction? // Tambur kararı

  // Lifecycle — tespit (Kurşun/QC2) ve işlem (Tambur) ayrı izlenir.
  detectedAtStepId  String?   @db.Uuid
  detectedByUserId  String?   @db.Uuid
  detectedAt        DateTime  @default(now()) @db.Timestamptz
  processedAtStepId String?   @db.Uuid
  processedByUserId String?   @db.Uuid
  processedAt       DateTime? @db.Timestamptz

  // Relations
  roll            Roll           @relation(fields: [rollId], references: [id])
  defectType      DefectType?    @relation(fields: [defectTypeId], references: [id])
  detectedAtStep  WorkOrderStep? @relation("RollErrorDetectedAt", fields: [detectedAtStepId], references: [id])
  processedAtStep WorkOrderStep? @relation("RollErrorProcessedAt", fields: [processedAtStepId], references: [id])
  detectedBy      User?          @relation("RollErrorDetectedBy", fields: [detectedByUserId], references: [id])
  processedBy     User?          @relation("RollErrorProcessedBy", fields: [processedByUserId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Mükerrer-hata yarışı guard'ı: (rollId,startMeter,defectTypeId) tekil. Migration
  // 20260623100000 bu @@index'i PARTIAL UNIQUE'e (WHERE defectTypeId IS NOT NULL)
  // çevirir (drift-free yöntem — şemada index, migration'da unique+partial). Tambur/
  // KK2 reportError eşzamanlı çift-tıkta P2002 → 409 DUPLICATE_ROLL_ERROR.
  // @@unique (index DEĞİL): DB'de PARTIAL UNIQUE (WHERE defectTypeId IS NOT NULL). Prisma 7
  // partial predicate'i drift saymaz; ama uniqueness FARKI (index↔unique) drift SAYAR →
  // bu yüzden @@unique olmalı (aksi halde migrate dev sonsuz CREATE üretir).
  @@unique([rollId, startMeter, defectTypeId], map: "roll_errors_roll_meter_defect_uq")
  @@index([detectedAtStepId])
  @@index([processedAtStepId])
  @@index([isProcessed])
  @@index([defectTypeId])
  // Tambur ekranı: bir topun bekleyen hatalarını listele
  @@index([rollId, isProcessed])
  // Operatör performans raporu: kim hangi tarihte hata kapadı
  @@index([processedByUserId, processedAt])
  // D-5: detectedByUserId sorgu yolu (Cihaz İşlem Dökümü raporu); processedBy emsaliyle simetrik.
  @@index([detectedByUserId, detectedAt])
  // Dashboard "bugün açılan hata" + kalite raporu tarih aralıkları (H-14):
  @@index([detectedAt])
  @@index([processedAt])
  @@map("roll_errors")
}

/// Top üzerinde yapılan somut işlem log'u (Kurşun geçildi, QC2 bitti, Tambur kararı, paketleme vb.).
/// Boolean bayrak yerine tarih + operatör + metadata ile tam iz bırakır.
/// Aynı roll × step × type için tek kayıt (@@unique) — idempotent tekrar basışlarda overwrite edilmez.
model RollOperation {
  id                        String            @id @default(uuid()) @db.Uuid
  rollId                    String            @db.Uuid
  workOrderStepId           String            @db.Uuid
  operationType             RollOperationType
  operatorId                String?           @db.Uuid
  /// Aynı istasyonda birden fazla makine varsa hangisinde işlendiğinin kaydı.
  /// İşlemin tabletten geldiği durumlarda Device→Machine üzerinden otomatik dolar.
  machineId                 String?           @db.Uuid
  metadata                  Json? // Operasyona özgü veri (qty, weight, cutPoints, foldType vb.)
  /// Tambur bölünmesinde parent'tan kopyalanan op'larda parent.id; orijinal kayıtlarda null.
  /// Aggregation/istatistik sorguları bu satırları "WHERE inheritedFromParentRollId IS NULL"
  /// ile filtreleyerek çift sayımı önler.
  inheritedFromParentRollId String?           @db.Uuid

  // Relations
  roll                Roll          @relation(fields: [rollId], references: [id])
  step                WorkOrderStep @relation(fields: [workOrderStepId], references: [id])
  operator            User?         @relation(fields: [operatorId], references: [id])
  machine             Machine?      @relation(fields: [machineId], references: [id])
  inheritedFromParent Roll?         @relation("RollOperationInherited", fields: [inheritedFromParentRollId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([rollId, workOrderStepId, operationType])
  // O-13: @@index([rollId]) (unique sol-prefix'i) ve @@index([operationType]) (tek başına
  // sürücü değil) kaldırıldı. O-14: rapor için operationType+createdAt (operationType-only'yi de kapsar).
  @@index([operationType, createdAt])
  @@index([operatorId])
  @@index([machineId])
  @@index([inheritedFromParentRollId])
  // Bir adımın işlem log'u (workOrderStepId filtreli + zaman sıralı)
  @@index([workOrderStepId, createdAt])
  // Operatör performans raporu createdAt aralığıyla tarar (H-14)
  @@index([createdAt])
  @@map("roll_operations")
}

// =============================================================================
// ROLL VARIANCE — üretim sapması defteri (2026-08-09)
// =============================================================================
// APPEND-ONLY. "Planlanan/kayıtlı metraj ile gerçekleşen arasındaki fark nereye
// gitti" sorusunun TEK sorgulanabilir cevabı.
//
// NEDEN AYRI TABLO, neden `RollOperation.metadata` DEĞİL: sapma bugüne kadar üç
// yerde birden yaşıyordu ve üçü de raporlanamazdı —
//   • `scrap` kararı  → gerçek bir FIRE topu doğuruyor (görünür ✅)
//   • `discard` kararı → HİÇBİR kayıt doğmuyor; iz yalnız TAMBUR_PROCESSED'ın
//     `metadata` JSON'unda (`remainingAction: "discard"`). JSON indekslenemez;
//     "bu ay ne kadar metraj düzeltmesi yapıldı" sorusu tüm satırları taramadan
//     cevaplanamaz (perf kuralı 6: JSON sorgulanacaksa GIN index, endpoint
//     yazılmadan ÖNCE — yani JSON'a yazmak burada baştan yanlış tercih olurdu).
//   • aşım (fazla kesim) → HİÇBİR yere yazılmıyordu.
//
// NEDEN `RollOperationType`'a yeni değer EKLENMEDİ: o enum "istasyonda şu işlem
// yapıldı" diyor ve `@@unique([rollId, workOrderStepId, operationType])` taşıyor
// — yani adım başına TEK satır. Sapma ise aynı adımda birden çok kez doğabilir
// (üç ayrı kesimde üç aşım). Emsal: WO-kapanış dispozisyonu da o enum'u
// genişletmedi (kök CLAUDE.md).
//
// ⚠️ `qty` HER ZAMAN POZİTİFTİR; yönü `kind` söyler (SCRAP/RECORD_CORRECTION
// eksi, OVERAGE artı). İşaretli sayı saklamak "SUM(qty)" yazan her raporu sessiz
// biçimde yanlışlar — biri işareti dikkate alır, diğeri almaz.
// =============================================================================
model RollVariance {
  id              String           @id @default(uuid()) @db.Uuid
  rollId          String           @db.Uuid
  /// Sapmanın doğduğu iş emri adımı. NULL olabilir: depo kesimi (`cutWarehouseRoll`
  /// / `finalizeWarehouseCut`) hiçbir adıma bağlı değildir — depo topu bir iş
  /// emrine girmeden kesilebiliyor.
  workOrderStepId String?          @db.Uuid
  kind            RollVarianceKind
  /// Sapan metraj — HER ZAMAN POZİTİF (bkz. üstteki not).
  qty             Decimal          @db.Decimal(12, 3)
  /// Hazır katalogdan seçilen sebep kodu (`constants/variance-reasons.ts`).
  /// OVERAGE'da NULL olabilir — aşımı sistem tespit eder, operatör beyan etmez.
  reasonCode      String?          @db.VarChar(64)
  /// "Diğer" seçildiğinde operatörün yazdığı serbest metin. Serbest yazım
  /// KALDIRILMADI, katalogun altına alındı: eldivenli operatör vardiya ortasında
  /// "aaa" / "." gibi doldurmalar üretiyordu ve o, boş bırakmaktan DAHA KÖTÜDÜR
  /// (denetimde cevap varmış gibi görünür, hiçbir şey söylemez).
  reasonText      String?          @db.VarChar(500)
  /// Sapmayı doğuran YOL — `constants/variance-reasons.ts` `VarianceSource`.
  /// Örn. TAMBUR_FINALIZE · TAMBUR_WAREHOUSE_FINALIZE · TAMBUR_OVERCUT ·
  /// TAMBUR_UNDO_SINGLE. Sebep "neden", kaynak "nerede" sorusunu yanıtlar.
  source          String           @db.VarChar(64)
  createdById     String?          @db.Uuid

  /// TERSLENDİ (2026-08-09) — satır SİLİNMEZ, işaretlenir (append-only defter).
  ///
  /// Sapmayı doğuran işlem geri alınırsa (Tambur "Geri Al") sapma da geçersizdir.
  /// Satırı silmek defteri geçmişe dönük değiştirmek olurdu (sektör kuralı:
  /// tersleme bir OLAYDIR, silme değil); işaretlememek ise defterde HAYALET fire
  /// bırakırdı — iptal edilmiş bir işin firesi raporda sonsuza dek görünürdü.
  ///
  /// ⚠️ Dönem raporları `reversedAt IS NULL` ile süzmeli. Süzmeyen rapor,
  /// geri alınmış her finalize'ın firesini de sayar.
  reversedAt   DateTime? @db.Timestamptz
  reversedById String?   @db.Uuid

  // Relations
  roll       Roll           @relation(fields: [rollId], references: [id])
  step       WorkOrderStep? @relation(fields: [workOrderStepId], references: [id])
  createdBy  User?          @relation(fields: [createdById], references: [id])
  reversedBy User?          @relation("RollVarianceReversedBy", fields: [reversedById], references: [id])

  // Append-only log → `updatedAt` YOK (kök CLAUDE.md konvansiyonu).
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([rollId])
  @@index([workOrderStepId])
  // Dönem raporu: "bu ay fire / kayıt düzeltmesi / aşım ne kadar" (eşitlik önce,
  // range sonra — perf kuralı 2).
  @@index([kind, createdAt])
  // "Kim ne kadar fire verdi" — operatör kırılımı.
  @@index([createdById, createdAt])
  @@map("roll_variances")
}

// =============================================================================
// SYSTEM SETTING — runtime'da güncellenebilir konfigürasyon (key-value)
// =============================================================================
// Admin (admin:settings) okur/yazar.
// =============================================================================
model SystemSetting {
  key         String  @id @db.VarChar(100)
  /// Tip-güvenli değer: boolean, number, string, array veya object.
  /// Reader fonksiyonları JsonValue'dan beklenen tipi çıkarır.
  value       Json
  description String?
  updatedById String? @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("system_settings")
}

// =============================================================================
// 8. REFAKAT KARTI (Traveler Card) — Adım 5
// =============================================================================

// Refakat Kartı — İŞ EMRİ başına TEK kart (2026-07-14 redesign: kart WO açılışında
// doğar, parti değil). Tek-kod: cardNumber = barcode = workOrderNumber (İE+GGAAYY+NNNN).
// Karekod versiyonlar arası SABİT (WO değişirse reprint = aynı satırda snapshot yenile +
// version++, kod DEĞİŞMEZ). Parti (Batch) veri modeli kalır ama kart üretmez.
model TravelerCard {
  id          String             @id @default(uuid()) @db.Uuid
  cardNumber  String             @unique @db.VarChar(64) // = workOrderNumber (İE) — insan-okur = tarama (tek kod)
  barcode     String             @unique @db.VarChar(64) // = workOrderNumber (İE) — QR içeriği; versiyonlar arası sabit
  workOrderId String             @unique @db.Uuid // Bir iş emri = tek refakat kartı
  version     Int                @default(1) // Kaçıncı basım (reprint = aynı satırda version++)
  status      TravelerCardStatus @default(ACTIVE)
  printedAt   DateTime           @default(now()) @db.Timestamptz
  printedById String?            @db.Uuid
  voidedAt    DateTime?          @db.Timestamptz
  voidReason  String?

  /// Basılı kartın içeriği gerçekle ayrıştı mı — `Roll.labelDirty` / `Sack.labelDirty`
  /// ile AYNI sözleşme (bayat kâğıt uyarısı; baskı olayında temizlenir).
  /// ⚠️ ROL ETİKETİNDEN BİR NOKTADA AYRILIR: K18 "ilk parti ataması bayraklanmaz" der,
  /// çünkü top etiketi henüz parti numarasıyla basılmamıştır. KARTTA TERSİ geçerlidir —
  /// kart iş emri AÇILIŞINDA (henüz top/parti yokken) basılabildiği için ilk parti
  /// doğuşu tam da kâğıdı yanlışlayan olaydır. K18 mantığını buraya kopyalama.
  /// Tek yazma noktası: `services/helpers/traveler-card-dirty.helper.markTravelerCardDirtyTx`.
  contentDirty Boolean @default(false)

  /// SON BASILAN kopyanın kaydı (ürün/renk/rota/sipariş + render config). Değişken
  /// veriler (top sayısı/metraj/parti) BURAYA GİRMEZ — baskı anında canlı çözülür.
  /// ⚠️ 2026-08-05'ten beri "doğuşta donan içerik" DEĞİLDİR: ACTIVE kart her baskıda
  /// iş emrinin GÜNCEL hâlinden basılır (`resolvePrintPlan`) ve baskı olayı bu alanı
  /// tazeler; içerik gerçekten değiştiyse `version++` olur (otomatik revizyon).
  /// Kartın SUNUMU (şablon/config) bunun dışındadır — donmuş kalır, yalnız `reprint`
  /// tazeler. Sorgulanmıyor → GIN yok (detay/print'te okunur).
  snapshot Json?

  // Relations
  workOrder WorkOrder          @relation(fields: [workOrderId], references: [id])
  printedBy User?              @relation("TravelerCardPrintedBy", fields: [printedById], references: [id])
  scans     TravelerCardScan[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@map("traveler_cards")
}

model TravelerCardScan {
  id              String   @id @default(uuid()) @db.Uuid
  cardId          String   @db.Uuid
  stationId       String   @db.Uuid
  workOrderStepId String?  @db.Uuid // Eşleştirilen WO adımı (server-side otomatik çözümlenir)
  scanType        ScanType
  scannedAt       DateTime @default(now()) @db.Timestamptz
  scannedById     String?  @db.Uuid
  deviceId        String? // El terminali MAC/serial
  notes           String?

  // Relations
  card      TravelerCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  station   Station        @relation(fields: [stationId], references: [id])
  step      WorkOrderStep? @relation(fields: [workOrderStepId], references: [id])
  scannedBy User?          @relation(fields: [scannedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([stationId, scannedAt])
  @@index([workOrderStepId])
  @@index([scannedById])
  // Bir kartın taramaları (cardId filtreli + zaman sıralı)
  @@index([cardId, scannedAt(sort: Desc)])
  @@map("traveler_card_scans")
}

// =============================================================================
// 10. ROLL MOVEMENT — Top hareket geçmişi (3.4)
// =============================================================================

model RollMovement {
  id              String    @id @default(uuid()) @db.Uuid
  rollId          String    @db.Uuid
  workOrderStepId String    @db.Uuid
  qtyIn           Decimal   @db.Decimal(12, 3) // İstasyona girişteki metraj
  qtyOut          Decimal?  @db.Decimal(12, 3) // İstasyon çıkışındaki metraj (FINISH/SKIP'te doldurulur)
  weightIn        Decimal?  @db.Decimal(12, 3)
  weightOut       Decimal?  @db.Decimal(12, 3)
  enteredAt       DateTime  @default(now()) @db.Timestamptz
  exitedAt        DateTime? @db.Timestamptz
  operatorId      String?   @db.Uuid
  /// Aynı istasyonda birden fazla makine varsa hangisinde işlendiğinin kaydı.
  machineId       String?   @db.Uuid
  notes           String?

  // Relations
  roll     Roll          @relation(fields: [rollId], references: [id])
  step     WorkOrderStep @relation(fields: [workOrderStepId], references: [id])
  operator User?         @relation(fields: [operatorId], references: [id])
  machine  Machine?      @relation(fields: [machineId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([workOrderStepId])
  @@index([enteredAt])
  // Dashboard "bugün biten" + tarih aralıklı raporlar (H-14). DB'de PARTIAL'dır
  // (WHERE "exitedAt" IS NOT NULL — açık hareket sorguları zaten küçük partial
  // unique'i tarar; migration 20260612102000, drift-free desen).
  @@index([exitedAt])
  @@index([operatorId])
  @@index([machineId])
  // Bir topun hareket geçmişi (rollId filtreli + zaman sıralı)
  @@index([rollId, enteredAt(sort: Desc)])
  // DB'de ayrıca ŞEMA-DIŞI partial unique var: roll_movements_one_open_per_roll_step_uq
  // (rollId, workOrderStepId) WHERE "exitedAt" IS NULL — "bir top bir adımda en
  // fazla BİR açık movement" invariant'ının DB seddi (çift START/SKIP/FINISH
  // yarışlarının kaybedeni P2002 alır). Migration 20260612101000. Partial UNIQUE
  // @@index ile eşleşmediğinden şemada karşılığı bilinçli olarak YOK.
  @@map("roll_movements")
}

// =============================================================================
// 10.1 SUBCONTRACTOR (Fason) — Sevk & Mal Kabul
// =============================================================================

model SubcontractorDispatch {
  id                     String   @id @default(uuid()) @db.Uuid
  dispatchNo             String   @unique @db.VarChar(64) // SD-YYMM-NNNNNN
  workOrderId            String   @db.Uuid
  // Bir sevk = bir parti (K10). Fason dönüşünde born roll'ların partisi buradan kalıtılır.
  batchId                String   @db.Uuid
  stepId                 String   @db.Uuid
  subcontractorId        String   @db.Uuid // Gerçekleşen fason firma
  // Sevk anında "plan ne diyordu" snapshot'ı — rapor için.
  // step.plannedSubcontractorId değişebilir; bu alan o anki değeri dondurur.
  plannedSubcontractorId String?  @db.Uuid
  plateNumber            String?
  driverName             String?
  dispatchedAt           DateTime @default(now()) @db.Timestamptz
  dispatchedById         String?  @db.Uuid
  notes                  String?
  // Fason talimatı — genel "sevk notu"ndan (notes) AYRI. Default kaynağı sevk
  // edilen adımın notu (WorkOrderStep.notes); operatör flag açıkken override eder.
  // Belgeye DONDURULMAZ; requestedColor gibi canlı tutulur → sevk sonrası
  // (Electron'dan) düzenlenebilir, baskı her zaman güncel değeri overlay gösterir.
  instruction            String?
  totalQty               Decimal  @default(0) @db.Decimal(12, 3) // Toplam sevk edilen metraj (snapshot)
  // İrsaliye snapshot'ı artık PrintedDocument tablosunda (versiyonlu resmi belge).

  // İptal — soft cancel (kayıt silinmez, izlenebilirlik korunur)
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Doğrudan sevk — fason fiilen son durak; mal fabrikaya dönmeden fasondan
  // doğrudan müşteriye sevk edildi. Bu sevk receive() ile değil bu işaretle
  // kapanır (toplar SUBCONTRACTOR_CONSUMED, adım/WO tamamlanır).
  directShippedAt   DateTime? @db.Timestamptz
  directShippedById String?   @db.Uuid
  directShipReason  String?

  // Relations
  workOrder             WorkOrder                           @relation(fields: [workOrderId], references: [id])
  batch                 Batch                               @relation(fields: [batchId], references: [id])
  step                  WorkOrderStep                       @relation(fields: [stepId], references: [id])
  subcontractor         Subcontractor                       @relation("DispatchSubcontractor", fields: [subcontractorId], references: [id])
  plannedSubcontractor  Subcontractor?                      @relation("DispatchPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])
  dispatchedBy          User?                               @relation("DispatchCreatedBy", fields: [dispatchedById], references: [id])
  cancelledBy           User?                               @relation("DispatchCancelledBy", fields: [cancelledById], references: [id])
  directShippedBy       User?                               @relation("DispatchDirectShippedBy", fields: [directShippedById], references: [id])
  items                 SubcontractorDispatchItem[]
  directShipAllocations SubcontractorDirectShipAllocation[]
  directShipments       DirectShipment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([plannedSubcontractorId])
  @@index([cancelledById])
  // Liste sayfasında ORDER BY dispatchedAt DESC için — derin sayfalama hızlanır
  @@index([dispatchedAt])
  // Composite: WO-filtreli + tarih sıralı liste (workorder detay panelinde kullanılır)
  @@index([workOrderId, dispatchedAt])
  // Parti-filtreli sevkler (getBatches lane hesabı + born kalıtım kaynağı)
  @@index([batchId])
  // Composite: Fason firma-filtreli + tarih sıralı liste (firma raporları için)
  @@index([subcontractorId, dispatchedAt])
  // Composite: Step-filtreli + tarih sıralı (step başına son sevkiyat)
  @@index([stepId, dispatchedAt(sort: Desc)])
  @@index([dispatchedById])
  @@map("subcontractor_dispatches")
}

model SubcontractorDispatchItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispatchId       String   @db.Uuid
  rollId           String   @db.Uuid
  dispatchedQty    Decimal  @db.Decimal(12, 3)
  dispatchedWeight Decimal? @db.Decimal(12, 3)

  // Relations
  dispatch     SubcontractorDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  roll         Roll                       @relation(fields: [rollId], references: [id])
  receiptItems SubcontractorReceiptItem[] @relation("ReceiptItemSource")

  createdAt DateTime @default(now()) @db.Timestamptz

  // Derinlemesine savunma: aynı top aynı sevke iki kez yazılamaz (uygulama
  // katmanındaki atomik claim'in DB seddi — kardeş tablolarla simetri:
  // SubcontractorReceiptItem/KartelaReceiptItem/SackAllocation). Sol-prefix
  // dispatchId'yi kapsar → ayrı @@index([dispatchId]) kaldırıldı (D-6 emsali).
  @@unique([dispatchId, rollId])
  @@index([rollId])
  @@map("subcontractor_dispatch_items")
}

/// Fasondan doğrudan sevkte (Shipment'sız) hangi sipariş satırına ne kadar
/// metraj karşılandığını kaydeder. SackAllocation'ın (çuval-merkezli) fason
/// kardeşi — çuvala/sevkiyata bağlı değil, doğrudan dispatch'ten yazılır. OrderLine.
/// shippedQty = Σ(sevk edilmiş SackAllocation) + Σ(SubcontractorDirectShipAllocation).
/// Append-only, izlenebilirlik için (doğrudan sevk terminaldir, geri-alma kapsam dışı).
model SubcontractorDirectShipAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  dispatchId  String  @db.Uuid
  orderLineId String  @db.Uuid
  qty         Decimal @db.Decimal(12, 3)

  /**
   * Bu karşılanma hangi DirectShipment olayına ait (kısmi/çoklu sevk ayrımı). NULL =
   * eski (DirectShipment entity öncesi) kayıtlar.
   */
  directShipmentId String? @db.Uuid

  dispatch       SubcontractorDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderLine      OrderLine             @relation(fields: [orderLineId], references: [id])
  directShipment DirectShipment?       @relation(fields: [directShipmentId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  // Karşılanma OLAY-başınadır: aynı DirectShipment olayında bir satıra iki kez
  // karşılanma yazılamaz. Constraint (dispatchId, orderLineId) DEĞİL — bir dispatch'ten
  // birden çok kısmi doğrudan sevk çıkabilir ve AYNI sipariş satırına her olayda tekrar
  // karşılanma yazılabilir (F: "kalan kısma tekrar sevk" P2002 veriyordu).
  // map: DB'deki gerçek index adı (63-karakter truncation) — aksi halde migrate sonsuz RENAME.
  @@unique([directShipmentId, orderLineId], map: "subcontractor_direct_ship_allocations_dsId_orderLineId_key")
  @@index([orderLineId])
  @@index([directShipmentId])
  @@map("subcontractor_direct_ship_allocations")
}

/// Fasondan doğrudan müşteriye sevk OLAYI — mal fabrikaya dönmeden fason firmasından
/// müşteriye gider. Bir fason sevkinin (dispatch) top/parçalarının BİR seferde tek
/// müşteriye doğrudan sevkini temsil eder (kısmi split ile bir dispatch birden çok
/// DirectShipment üretebilir). "Sevkiyatlar" birleşik listesinde çuval Shipment'larıyla
/// birlikte görünür; her biri sevk irsaliyesi (SUBCONTRACTOR_DIRECT_SHIP) dondurur.
/// Çuval Shipment modeline dokunulmaz — ayrı, roll-bazlı entity.
model DirectShipment {
  id          String   @id @default(uuid()) @db.Uuid
  /// DSK + GGAAYY + NNNN
  shipmentNo  String   @unique
  dispatchId  String   @db.Uuid
  customerId  String   @db.Uuid
  branchId    String?  @db.Uuid
  reason      String
  /// Sevk edilen toplam metraj (efektif toplar — kısmi split'te kesilen çocuk metreleri).
  totalQty    Decimal  @db.Decimal(12, 3)
  rollCount   Int
  shippedAt   DateTime @default(now()) @db.Timestamptz
  shippedById String?  @db.Uuid

  /// Fatura izi — çuval sevkiyatındakiyle AYNI sözleşme (bkz. Shipment.invoiceNo).
  /// Doğrudan sevkler muhasebe listesinde aynı akışta göründüğü için burada da tutulur.
  invoiceNo    String?   @db.VarChar(64)
  invoicedAt   DateTime? @db.Timestamptz
  invoicedById String?   @db.Uuid

  dispatch    SubcontractorDispatch               @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  customer    Customer                            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      CustomerBranch?                     @relation(fields: [branchId], references: [id])
  shippedBy   User?                               @relation("DirectShipmentShippedBy", fields: [shippedById], references: [id])
  invoicedBy  User?                               @relation("DirectShipmentInvoicedBy", fields: [invoicedById], references: [id])
  rolls       Roll[]
  allocations SubcontractorDirectShipAllocation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([dispatchId])
  @@index([customerId])
  @@index([shippedAt])
  invoices Invoice[]
  @@map("direct_shipments")
}

model SubcontractorReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNo       String   @unique @db.VarChar(64) // SR-YYMM-NNNNNN
  manifestNo      String?  @db.VarChar(64) // İrsaliye no (fason firma tarafından verilir, opsiyonel)
  workOrderId     String   @db.Uuid
  stepId          String   @db.Uuid
  subcontractorId String   @db.Uuid
  receivedAt      DateTime @default(now()) @db.Timestamptz
  receivedById    String?  @db.Uuid
  notes           String?
  // Ölçüm (metraj/ağırlık/fire) fason kabulde yapılmaz; sonraki istasyonun
  // FINISH akışı kendi qty/weight değerlerini kaydeder.

  /// Boyahane gibi "açık kumaş döndüren" fason senaryosu: fason kabulde orijinal
  /// Roll'lar SUBCONTRACTOR_CONSUMED'a çekilir, yeni "açık kumaş" Roll'ları bu
  /// receipt'ten doğar. appliedColorId + appliedProperties = receipt seviyesinde
  /// uygulanan kimlik (renk + özellikler); yeni Roll'lar bunu inherit eder.
  /// Renk vermeyen fason kategorilerinde (yıkama, zımpara) NULL kalır.
  appliedColorId String? @db.Uuid

  /// Bu kabulde ÖLÇÜLEN en (cm) — doğan tüm açık-kumaş toplarına uygulanır.
  /// `appliedColorId` ile aynı seviyede ve aynı gerekçeyle makbuzdadır: ikisi de
  /// "bu kabulde uygulanan kimlik"tir, top başına değil kabul başına yazılır
  /// (aynı sevkten dönen parçaların eni aynıdır; 10 parçalı kabulde 10 giriş yerine 1).
  ///
  /// ⚠️ `appliedColorId`'den bir farkı var: renk YALNIZ "renk veren" kategoride
  /// (boyahane) sorulur, en ise HER fason dönüşünde sorulur — zımpara eni
  /// değiştirmese de yazılan değer bir ölçüm teyididir. Gerekçe veri: ham girişte
  /// en tasarım gereği yazılmıyor (`kk1.rawWidthEnabled` kapalı, KK1 kaynaklı
  /// 47 topun 47'si ensiz), yani topun enini ilk kez öğrendiğimiz yer burasıdır.
  /// Yalnız boyahanede sorulsaydı zımparadan dönen top sonsuza dek ensiz kalırdı.
  ///
  /// NULL = bu kabulde en girilmedi (2026-08-05 öncesi kayıtlar + alanı göndermeyen
  /// eski APK'lar). Zorunluluk ARAYÜZDE yaşar, API'de değil: burada zorunlu yapmak
  /// sahadaki eski APK'ların HER fason kabulünü 400'e düşürürdü.
  appliedWidth Decimal? @db.Decimal(12, 3)

  // Soft-cancel — kabul yanlış girilmişse operatör geri çeker.
  // Rulalar AT_SUBCONTRACTOR'a döner, colorId/RollProperty (renk veren adımdan
  // gelmişse) sıfırlanır. Belge silinmez, audit izi kalır.
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  workOrder         WorkOrder                      @relation(fields: [workOrderId], references: [id])
  step              WorkOrderStep                  @relation(fields: [stepId], references: [id])
  subcontractor     Subcontractor                  @relation("ReceiptSubcontractor", fields: [subcontractorId], references: [id])
  receivedBy        User?                          @relation("ReceiptCreatedBy", fields: [receivedById], references: [id])
  cancelledBy       User?                          @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id])
  items             SubcontractorReceiptItem[]
  appliedColor      Color?                         @relation(fields: [appliedColorId], references: [id])
  appliedProperties SubcontractorReceiptProperty[]
  /// Bu receipt'ten doğan "açık kumaş" Roll'ları (Kurşun/KK2 öncesi).
  bornRolls         Roll[]                         @relation("RollFromReceipt")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([stepId])
  @@index([manifestNo])
  @@index([appliedColorId])
  // Mobil/web liste sayfası ORDER BY receivedAt DESC için — milyon satırda kritik
  @@index([receivedAt])
  // Composite: WO-filtreli + tarih sıralı liste (WO detayında "kabuller" sekmesi)
  @@index([workOrderId, receivedAt])
  // Composite: Fason firma-filtreli + tarih sıralı liste
  @@index([subcontractorId, receivedAt])
  invoices Invoice[]
  @@map("subcontractor_receipts")
}

/// SubcontractorReceipt ↔ FabricProperty M:N — fason kabulde uygulanan özellikler.
/// Receipt seviyesinde tutulur (Roll seviyesinde değil), çünkü fason boyahane
/// dönüşünde Roll'lar terminal'e çekilir; yeni doğan açık kumaş Roll'ları bu
/// listeyi inherit eder.
model SubcontractorReceiptProperty {
  id         String @id @default(uuid()) @db.Uuid
  receiptId  String @db.Uuid
  propertyId String @db.Uuid

  receipt  SubcontractorReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  property FabricProperty       @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([receiptId, propertyId])
  @@index([propertyId])
  @@map("subcontractor_receipt_properties")
}

model SubcontractorReceiptItem {
  id                   String  @id @default(uuid()) @db.Uuid
  receiptId            String  @db.Uuid
  /// Fason dönüşünde kabul edilen orijinal top (yeni etiket basılmaz).
  /// Composite unique ile (receiptId, newRollId) — aynı top birden fazla
  /// CANCELLED receipt'te audit izi olarak kalabilir, sadece aktif receipt
  /// içinde tek satır olur. Globally @unique idi → cancel sonrası tekrar
  /// kabul "Unique constraint" ile patlıyordu.
  newRollId            String  @db.Uuid
  sourceDispatchItemId String? @db.Uuid // Göz kontrolü ile eşleştirilen kaynak sevk kalemi
  notes                String?

  // Relations
  receipt            SubcontractorReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  newRoll            Roll                       @relation(fields: [newRollId], references: [id])
  sourceDispatchItem SubcontractorDispatchItem? @relation("ReceiptItemSource", fields: [sourceDispatchItemId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([receiptId, newRollId])
  // D-6: @@index([receiptId]) kaldırıldı — @@unique([receiptId, newRollId]) sol-prefix'i kapsar.
  @@index([newRollId])
  @@index([sourceDispatchItemId])
  @@map("subcontractor_receipt_items")
}

// =============================================================================
// 10.3 SUBCONTRACTOR (Fason Firma) — Customer'dan ayrı domain
// =============================================================================
// Müşteri ≠ Fason firma. Bir firma her ikisi olursa iki ayrı kayıt açılır.
// Kategori (Boyahane, Yıkama, Zımpara...) admin tarafından yönetilen DB-driven
// liste; firma birden fazla kategoride hizmet verebilir (M:N).

model SubcontractorCategory {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32) // DYE_HOUSE, SANDING, PRINTING...
  name        String  @db.VarChar(100) // "Boyahane", "Zımpara"
  description String?
  isActive    Boolean @default(true)

  /// "Renk veren" kategori bayrağı. true ise bu kategorideki Fason Kabul
  /// başarıyla tamamlandığında, kabul edilen rulonun colorId'si
  /// WO.targetColorId'den otomatik kopyalanır. Bir rotada tek bir adımın
  /// bu flag'li kategoride olması beklenir (sistem ilk kabul'de uygular;
  /// aynı rota içinde ikinci kez uygulanmaz). Örn. Boyahane.
  appliesColor Boolean @default(false)

  /// "Özellik veren" kategori bayrağı. true ise bu kategorideki Fason Kabul
  /// başarıyla tamamlandığında, kabul edilen rulonun özellikleri
  /// WO.targetProperties'tan otomatik kopyalanır. appliesColor'dan bağımsızdır
  /// — Boyahane ikisini de uygular; Zımpara/Kurşun gibi adımlar ileride
  /// yalnız özellik uygulayabilir ("zımparalanmış", "kurşunlanmış").
  appliesProperty Boolean @default(false)

  // Relations
  subcontractors  SubcontractorToCategory[]
  workOrderSteps  WorkOrderStep[]           @relation("StepRequiredCategory")
  routeSteps      RouteStep[]               @relation("RouteStepRequiredCategory")
  defaultStations Station[]                 @relation("StationDefaultCategory")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("subcontractor_categories")
}

model Subcontractor {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(32)
  name       String  @db.VarChar(100)
  taxNumber  String?
  phone      String?
  address    String?
  isActive   Boolean @default(true)
  /// İş emri fason adımında firma seçicide default gelir (kategori bazında client eşleşir).
  isFavorite Boolean @default(false)

  /// Belge şablon profili — fason/kartela sevk belgeleri profil override'ını
  /// kullanır (atanmamışsa genel ayar). Bkz. DocumentProfile.
  documentProfileId String? @db.Uuid

  // Relations
  categories        SubcontractorToCategory[]
  dispatches        SubcontractorDispatch[]   @relation("DispatchSubcontractor")
  plannedDispatches SubcontractorDispatch[]   @relation("DispatchPlannedSubcontractor")
  receipts          SubcontractorReceipt[]    @relation("ReceiptSubcontractor")
  plannedSteps      WorkOrderStep[]           @relation("StepPlannedSubcontractor")
  plannedRouteSteps RouteStep[]               @relation("RouteStepPlannedSubcontractor")
  kartelaDispatches KartelaDispatch[]         @relation("KartelaDispatchSub")
  kartelaReceipts   KartelaReceipt[]          @relation("KartelaReceiptSub")
  documentProfile   DocumentProfile?          @relation("SubcontractorDocProfile", fields: [documentProfileId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([documentProfileId])
  cariAccount CariAccount?
  @@map("subcontractors")
}

/// M:N — bir firma birden fazla kategoride hizmet verebilir
model SubcontractorToCategory {
  subcontractorId String @db.Uuid
  categoryId      String @db.Uuid

  subcontractor Subcontractor         @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  category      SubcontractorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([subcontractorId, categoryId])
  @@index([categoryId])
  @@map("subcontractor_category_links")
}

// =============================================================================
// 10.2 SWATCH (Kartela) — Tambur'dan üretilen örnek kart
// =============================================================================

model Swatch {
  id              String   @id @default(uuid()) @db.Uuid
  cardNumber      String   @unique @db.VarChar(64) // SW-YYMM-NNN
  barcode         String   @unique @db.VarChar(64) // SW-YYMM-XXXXXX-C (Crockford checksum)
  itemId          String   @db.Uuid
  /// Kartelanın rengi — kaynak rolden veya manuel girilir.
  colorId         String?  @db.Uuid
  width           Decimal? @db.Decimal(12, 3) // cm
  length          Decimal? @db.Decimal(12, 3) // cm (örn. 30cm) — kabulde opsiyonel girilir
  weightKg        Decimal? @db.Decimal(12, 3) // kabulde/tartıda opsiyonel girilir (ihracat araç kg kapasitesi için)
  // Doğum batch'i — kartela fason kabulinde bu receipt'ten doğdu.
  parentReceiptId String?  @db.Uuid
  // Kaynak (tükenen) orijinal top — kartelanın çıktığı bitmiş ürün.
  parentRollId    String?  @db.Uuid
  purpose         String? // Müşteri sunumu, arşiv, laboratuvar vb.
  createdById     String?  @db.Uuid

  // Sevkiyat — kartelanın okutulduğu sevkiyat oturumu (top gibi gönderilir, siparişe sayılmaz).
  shipmentId String? @db.Uuid
  // Çuval — kartela da bitmiş ürün gibi çuvala konur; çuval içeriğinde/irsaliyede görünür.
  sackId     String? @db.Uuid

  // Soft delete — kartela fason kabulü iptal edilince doğan kartelalar geri alınır
  // (fiziksel DELETE yok). Listeler default cancelledAt: null filtreler.
  cancelledAt  DateTime? @db.Timestamptz
  cancelReason String?

  // Relations
  item          Item            @relation(fields: [itemId], references: [id])
  color         Color?          @relation(fields: [colorId], references: [id])
  parentReceipt KartelaReceipt? @relation("SwatchFromReceipt", fields: [parentReceiptId], references: [id])
  parentRoll    Roll?           @relation("SwatchParentRoll", fields: [parentRollId], references: [id])
  createdBy     User?           @relation("SwatchCreatedBy", fields: [createdById], references: [id])
  shipment      Shipment?       @relation(fields: [shipmentId], references: [id])
  sack          Sack?           @relation(fields: [sackId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([itemId])
  @@index([colorId])
  @@index([parentReceiptId])
  @@index([parentRollId])
  @@index([shipmentId])
  @@index([sackId])
  // Cursor listesi + stats (ORDER BY createdAt DESC WHERE cancelledAt IS NULL).
  // @@index tam görünür ama DB'de PARTIAL'dır (WHERE cancelledAt IS NULL) —
  // soft-delete tablosunda iptal edilmiş kartelalar indekslenmez (migration
  // 20260607030000). Prisma 7 partial predicate'i drift saymaz.
  @@index([createdAt])
  @@map("swatches")
}

/// Kartela stok düşüm OLAYI — reduceStock'un doğal kaydı + idempotency çapası.
/// Sayaç-bazlı işlem (FIFO N kartela iptal) tek olay kaydına bağlanır: replay'de
/// clientToken @unique P2002 → tx rollback → FARKLI N kartela daha iptal OLMAZ,
/// cached { reduced } döner. Kalem listesi audit'te (swatchIds) — ayrı pivot yok.
/// Append-only olay kaydı — updatedAt bilinçli yok (kök CLAUDE.md istisnası).
model SwatchStockReduction {
  id          String  @id @default(uuid()) @db.Uuid
  /// İdempotency anahtarı — istemci üretir; NULL'lar çakışmaz (partial unique).
  clientToken String? @unique @db.Uuid
  itemId      String  @db.Uuid
  colorId     String? @db.Uuid
  count       Int
  reason      String
  createdById String? @db.Uuid

  item      Item   @relation(fields: [itemId], references: [id])
  color     Color? @relation(fields: [colorId], references: [id])
  createdBy User?  @relation("SwatchStockReductionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  // Düşüm geçmişi (itemId eşitlik + createdAt sıralama); sol-prefix itemId FK'yı kapsar
  @@index([itemId, createdAt(sort: Desc)])
  @@index([colorId])
  // createdById bilinçli indexsiz — düşük-trafik "kim yaptı" audit FK istisnası
  @@map("swatch_stock_reductions")
}

// =============================================================================
// 10.4 KARTELA FASON — Bitmiş ürün → kartela firmasına sevk & dönüş
// =============================================================================
// Üretim fasonundan AYRI, WO'suz akış. Depodaki bitmiş bir top kartela firmasına
// (Subcontractor) top olarak gönderilir; fasonda işlenip N kartela (Swatch) olarak
// döner. Orijinal top KABULDE komple tükenir (KARTELA_CONSUMED). İzlenebilirlik:
// Swatch → parentReceipt → dispatch → firma + Swatch.parentRoll (kaynak top).

model KartelaDispatch {
  id              String   @id @default(uuid()) @db.Uuid
  dispatchNo      String   @unique @db.VarChar(64) // KD-YYMM-NNNNNN
  subcontractorId String   @db.Uuid // Kartela fason firma
  plateNumber     String?
  driverName      String?
  dispatchedAt    DateTime @default(now()) @db.Timestamptz
  dispatchedById  String?  @db.Uuid
  notes           String?
  totalQty        Decimal  @default(0) @db.Decimal(12, 3) // Toplam sevk metrajı (snapshot)
  // Çeki listesi snapshot'ı artık PrintedDocument tablosunda (versiyonlu resmi belge).

  // İptal — soft cancel (kayıt silinmez, iz korunur)
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  subcontractor Subcontractor         @relation("KartelaDispatchSub", fields: [subcontractorId], references: [id])
  dispatchedBy  User?                 @relation("KartelaDispatchBy", fields: [dispatchedById], references: [id])
  cancelledBy   User?                 @relation("KartelaDispatchCancelledBy", fields: [cancelledById], references: [id])
  items         KartelaDispatchItem[]
  receipts      KartelaReceipt[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([dispatchedAt])
  @@index([subcontractorId, dispatchedAt])
  @@index([dispatchedById])
  @@index([cancelledById])
  @@map("kartela_dispatches")
}

model KartelaDispatchItem {
  id               String   @id @default(uuid()) @db.Uuid
  dispatchId       String   @db.Uuid
  rollId           String   @db.Uuid
  dispatchedQty    Decimal  @db.Decimal(12, 3)
  dispatchedWeight Decimal? @db.Decimal(12, 3)

  // Relations
  dispatch     KartelaDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  roll         Roll                 @relation("RollKartelaDispatchItems", fields: [rollId], references: [id])
  receiptItems KartelaReceiptItem[] @relation("KartelaReceiptItemSource")

  createdAt DateTime @default(now()) @db.Timestamptz

  // Derinlemesine savunma (SubcontractorDispatchItem ile simetrik): aynı top
  // aynı kartela sevkine iki kez yazılamaz; sol-prefix dispatchId'yi kapsar.
  @@unique([dispatchId, rollId])
  @@index([rollId])
  @@map("kartela_dispatch_items")
}

model KartelaReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNo       String   @unique @db.VarChar(64) // KR-YYMM-NNNNNN
  manifestNo      String?  @db.VarChar(64) // Fason firma irsaliye no (opsiyonel)
  dispatchId      String?  @db.Uuid // Bilgi amaçlı; asıl bağ top üzerinden (receiptItem.consumedRoll)
  subcontractorId String   @db.Uuid
  receivedAt      DateTime @default(now()) @db.Timestamptz
  receivedById    String?  @db.Uuid
  notes           String?

  // İptal — soft cancel
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Relations
  dispatch      KartelaDispatch?     @relation(fields: [dispatchId], references: [id])
  subcontractor Subcontractor        @relation("KartelaReceiptSub", fields: [subcontractorId], references: [id])
  receivedBy    User?                @relation("KartelaReceiptBy", fields: [receivedById], references: [id])
  cancelledBy   User?                @relation("KartelaReceiptCancelledBy", fields: [cancelledById], references: [id])
  items         KartelaReceiptItem[]
  swatches      Swatch[]             @relation("SwatchFromReceipt") // Bu kabulde doğan kartelalar

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([receivedAt])
  @@index([subcontractorId, receivedAt])
  @@index([dispatchId])
  @@index([receivedById])
  @@index([cancelledById])
  @@map("kartela_receipts")
}

model KartelaReceiptItem {
  id                   String  @id @default(uuid()) @db.Uuid
  receiptId            String  @db.Uuid
  consumedRollId       String  @db.Uuid // KARTELA_CONSUMED'a çekilen orijinal (tükenen) top
  sourceDispatchItemId String? @db.Uuid // Otomatik eşleşen kaynak sevk kalemi
  kartelaCount         Int // Bu toptan doğan kartela adedi (1 top → N kartela)
  notes                String?

  // Relations
  receipt            KartelaReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  consumedRoll       Roll                 @relation("RollKartelaConsumed", fields: [consumedRollId], references: [id])
  sourceDispatchItem KartelaDispatchItem? @relation("KartelaReceiptItemSource", fields: [sourceDispatchItemId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([receiptId, consumedRollId])
  // D-6: @@index([receiptId]) kaldırıldı — @@unique([receiptId, consumedRollId]) sol-prefix'i kapsar.
  @@index([consumedRollId])
  @@index([sourceDispatchItemId])
  @@map("kartela_receipt_items")
}

// =============================================================================
// 11. MANIFEST (Çeki Listesi) — 3.5
// =============================================================================

model Manifest {
  id          String   @id @default(uuid()) @db.Uuid
  manifestNo  String   @unique @db.VarChar(64)
  workOrderId String   @db.Uuid
  printedAt   DateTime @default(now()) @db.Timestamptz
  printedById String?  @db.Uuid
  snapshot    Json // Yazdırma anındaki roll listesi (immutable belge)
  notes       String?

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  printedBy User?     @relation("ManifestPrintedBy", fields: [printedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([workOrderId])
  @@map("manifests")
}

// =============================================================================
// 11.6b YAZDIRILABİLİR RESMİ BELGE DEFTERİ — versiyonlu irsaliye snapshot'ları
// =============================================================================
// Bir sevk OLAYI (Shipment / SubcontractorDispatch / KartelaDispatch) = bir belge
// zinciri; her satır bir VERSİYON. İçerik + belge şablon ayarı (override) + firma
// künyesi freeze anında `snapshot` JSON'una donar — kaynak sonradan değişse bile
// belge sabit kalır (yasal kayıt). Yeni sevk olayı = yeni sourceId = yepyeni zincir;
// önceki belge ASLA güncellenmez. Düzeltme = reissue (gerekçeli yeni versiyon,
// eski SUPERSEDED olarak saklanır). Kaynak iptal edilirse VOIDED (İPTAL filigranı).
// Satır içerikleri immutable; yalnız status/supersede/void meta alanları güncellenir.
// =============================================================================

enum PrintedDocType {
  SHIPMENT_DISPATCH // Sevk irsaliyesi (Shipment)
  SUBCONTRACTOR_DISPATCH // Fason sevk irsaliyesi (SubcontractorDispatch)
  KARTELA_DISPATCH // Kartela çeki listesi (KartelaDispatch)
  // NOT: ALTER TYPE ADD VALUE enum'a SONA ekler; sıra DB ile uyumlu kalsın diye
  // (drift-free) en altta. (migration 20260614130000_subcontractor_direct_ship)
  SUBCONTRACTOR_DIRECT_SHIP // Fasondan doğrudan sevk irsaliyesi (son durak fason)
  // 2026-07-27 belge genişletmesi — hepsi mevcut kaynağa (Receipt/Shipment/RollReturn) bağlı:
  SUBCONTRACTOR_RECEIPT // Fason kabul makbuzu (SubcontractorReceipt)
  QUALITY_CERTIFICATE // Kalite/sevk sertifikası (Shipment — kalite özeti)
  RETURN_DISPATCH // İade irsaliyesi (RollReturn)
  // 2026-08-13 ticaret paketi (yine SONA — ALTER TYPE ADD VALUE kuralı). İkisi de
  // İÇ belgedir (müşteriye gitmez) ama resmi zincir aynıdır: donmuş snapshot +
  // versiyon + İPTAL filigranı.
  TRANSFER_DISPATCH // Depolar arası transfer irsaliyesi (WarehouseTransfer)
  GOODS_RECEIPT // Mal kabul fişi (GoodsReceipt — satın alınan malın depo girişi)
  // 2026-08-14 ön muhasebe çıktıları (yine SONA — ALTER TYPE ADD VALUE kuralı).
  // ⚠️ İkisi de DONMUŞ DEFTER semantiği taşır ve bu bilinçli: fatura/makbuz
  // resmi kayıttır, sonradan içerik değişirse basılı kâğıt yalan söyler.
  // Zincir aynı: snapshot + versiyon + revizyon + İPTAL filigranı.
  INVOICE_INTERNAL // İç satış/alış faturası (Invoice — ONAYDA donar, stornoda VOID)
  PAYMENT_RECEIPT // Tahsilat/ödeme makbuzu (Payment — KAYITTA donar, iptalde VOID)
}

enum PrintedDocStatus {
  ACTIVE // Güncel versiyon — baskı bunu kullanır
  SUPERSEDED // Revizyonla yerini yeni versiyona bıraktı (tarihsel kayıt)
  VOIDED // Kaynak iptal edildi — baskıda İPTAL filigranı
}

model PrintedDocument {
  id            String           @id @default(uuid()) @db.Uuid
  docType       PrintedDocType
  // Polimorfik kaynak: shipmentId / subcontractorDispatchId / kartelaDispatchId.
  // FK YOK (3 tabloya birden bağlanamaz); bütünlük servis katmanında.
  sourceId      String           @db.Uuid
  version       Int              @default(1)
  status        PrintedDocStatus @default(ACTIVE)
  // İnsan-okur belge no (shipmentNo/dispatchNo) — listede snapshot JSON'u
  // çekmeden göstermek için ayrı kolon (perf kuralı 13).
  documentNo    String           @db.VarChar(64)
  snapshot      Json
  // Revizyon (v2+) gerekçesi — v1'de null. Yıkıcı-işlem-onayı konvansiyonu gereği zorunlu.
  reissueReason String?
  supersededAt  DateTime?        @db.Timestamptz
  voidedAt      DateTime?        @db.Timestamptz
  voidReason    String?
  // Lazy-freeze ile (eski kayıttan) geriye dönük üretildi mi — baskıda dipnot.
  reconstructed Boolean          @default(false)
  printedById   String?          @db.Uuid
  printedBy     User?            @relation("PrintedDocumentPrintedBy", fields: [printedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([docType, sourceId, version])
  @@index([docType, sourceId, status])
  @@index([printedById])
  @@map("printed_documents")
}

/// Belge şablon PROFİLİ — genel Belge Şablonları ayarının üzerine binen adlandırılmış
/// override paketi (örn. "İhracat", "Fiyatsız"). `config` = { [belgeKey]: DocumentConfig }
/// (system-setting.service sanitizeDocumentsConfig şekli). Çözüm zinciri (freeze anında):
/// kayıt defteri varsayılanı → genel DOCUMENTS_CONFIG → kaynağın müşteri/fason profili
/// (alan-düzeyi shallow merge; sections/columns/style bütün olarak ezilir).
/// Soft delete: isActive=false (atamalar bozulmasın diye fiziksel silme yok).
model DocumentProfile {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(80)
  description String? @db.VarChar(300)
  config      Json
  isActive    Boolean @default(true)

  customers      Customer[]      @relation("CustomerDocProfile")
  subcontractors Subcontractor[] @relation("SubcontractorDocProfile")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("document_profiles")
}

/// SERBEST BELGE — herhangi bir kayda bağlı OLMAYAN, admin'in elle yazdığı belge
/// (üst yazı, teslim tutanağı, dekont, duyuru vb.). Kaynak yoktur — belge KENDİSİ
/// kaynaktır; PrintedDocument freeze zincirinden bağımsız, doğrudan düzenlenir.
/// `config` = tek DocumentConfig (stil/logo/damga/blok/imza) — sanitizeDocStyleConfig
/// vb. ile süzülür. Baskı: title + recipient + body + bloklar; antet/logo/damga reuse.
model FreeDocument {
  id          String  @id @default(uuid()) @db.Uuid
  documentNo  String  @unique @db.VarChar(64) // SB+GGAAYY+NNNN
  title       String  @db.VarChar(120)
  /// Muhatap ("Sayın ...") — opsiyonel; boşsa basılmaz.
  recipient   String? @db.VarChar(200)
  /// Serbest gövde metni (çok satırlı).
  body        String  @db.Text
  /// Görünüm ayarı (DocumentConfig) — stil/logo/damga/blok/imza.
  config      Json
  isActive    Boolean @default(true)
  /// "Kim oluşturdu" — düşük trafik audit FK'sı (relation YOK, konvansiyon).
  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("free_documents")
}

// =============================================================================
// 11.7 SEVKIYAT — Sevkiyat (Shipment) + Çuval (Sack = depo nesnesi)
// =============================================================================
// ÇUVAL DEPO MODELİ (top→sipariş bağı YOK; mühür/rezerv YOK). Akış: WAREHOUSE serbest top →
// çuval aç (customerId OPSİYONEL) → top okut → (opsiyonel tart). Çuval DEPODA bekler
// (shipmentId NULL, her an düzenlenebilir). Çuval(lar) seçilip müşteri/şube atanır + sipariş
// seçilir → sevkiyat kurulur (Shipment PLANNED; SackAllocation sevk-anı spec+şube FIFO ile
// yazılır — distributeSacksToLines). Düşüş yalnız DISPATCHED'te: shippedQty'ye terfi + toplar
// SHIPPED. Çuval İÇERİK tutar (Roll/Swatch.sackId) → irsaliyede ürün-bazlı döküm.
// =============================================================================

enum ShipmentStatus {
  PLANNED // Onay bekliyor (yalnız sevk-onayı AÇIKKEN): kuruldu + tahsis yazıldı, toplar hâlâ WAREHOUSE. Sevk Kapısı'ndan dispatch edilir.
  DISPATCHED // Sevk edildi — toplar SHIPPED, fiziksel stok bina dışı (stok yalnız burada düşer). Onay KAPALIYKEN createShipment doğrudan buraya kurar.
  CANCELLED // İptal — çuvallar depoya döner (shipmentId null), tahsisler silinir
}

/// Saha #19+#22: sevkiyat varış kapsamı. Yurtiçi default; çuval tartısı zorunluluğu
/// yalnız EXPORT'ta (yurtiçi kg girilmeden sevk edilebilir). Sevkiyatta rozet + filtre
/// olarak görünür (sıkı bir ayrım değil, farkedilebilirlik).
enum ShipmentDestination {
  DOMESTIC // Yurtiçi
  EXPORT // Yurtdışı / ihracat
}

/// Çuval — MÜŞTERİYE ait fiziksel paket birimi + ÇUVAL DEPO HAVUZUNUN çekirdeği.
/// Brüt tartı (no + kg) + İÇERİK: hangi toplar/kartelalar bu çuvalda (Roll.sackId /
/// Swatch.sackId). Çuval DEPODA duran bir nesnedir: açılır, içine top okutulur, (brüt
/// tartılır + kod girilir). shipmentId NULL = depoda (her an düzenlenebilir); dolu =
/// sevkiyata atanmış. customerId OPSİYONEL (oluştururken atanabilir; yoksa sevkte atanır).
/// Mühür/rezerv YOK — sipariş bağı yalnız sevkte kurulur. İçinde karışık ürün serbest;
/// irsaliyedeki çuval-bazlı ürün dökümü buradan türetilir.
model Sack {
  id           String            @id @default(uuid()) @db.Uuid
  sackNo       String            @unique @db.VarChar(64) // Sistem çuval kodu — CV + GGAAYY + NNNN (insan-okur = tarama)
  /// İdempotency anahtarı (A4, 2026-07-31 denetimi) — istemci mantıksal deneme
  /// başına BİR kez üretir; ağ-retry'de mükerrer BOŞ çuval açılmasını önler
  /// (openSack replay). Token'sız eski istemci → NULL (davranış değişmez).
  clientToken  String?           @unique @db.Uuid
  // Çuval müşterisi OPSİYONEL — oluştururken atanabilir (bilinen sipariş için), yoksa
  // sevk kurarken atanır. Depoda müşterisiz çuval = genel stok.
  customerId   String?           @db.Uuid
  branchId     String?           @db.Uuid
  shipmentId   String?           @db.Uuid // NULL = çuval depo havuzunda; dolu = sevkiyata atanmış
  /// Çuvalın bulunduğu depo (2026-08-14, ticaret paketi). NULLABLE — fabrika
  /// sıfır-fark: tek depolu kurulumda hiçbir yüzey okumaz, eski satırlar NULL
  /// kalabilir. Doğumda damgalanır (openSack/split), NULL kalmış eski çuval İLK
  /// transferinde SAHİPLENİLİR (lazy adoption — üye topların ortak deposu).
  /// İnvariant: çuvalın topları çuvalın deposundadır; transfer çuvalı BÜTÜN
  /// taşıdığı ve top-transferi çuvaldaki topu reddettiği için korunur.
  warehouseId  String?           @db.Uuid
  seq          Int? // Sevkiyat içinde sıra (Çuval 1, 2, 3...); havuzdayken NULL
  weightKg     Decimal?          @db.Decimal(12, 3) // Brüt tartı (kumaş + dara); tekli top kg tutulmaz
  // O-19: tartı izi — kim tarttı, ne zaman.
  weighedById  String?           @db.Uuid
  weighedAt    DateTime?         @db.Timestamptz
  /// Tartının KAYNAĞI. Bu alan olmadan simüle 47.3 kg ile gerçek 47.3 kg DB'de
  /// BİT-BİT AYNIYDI (2026-07-30) — çuval kg'si sevk irsaliyesine ve çeki listesine
  /// basıldığı için (müşteri/gümrük belgesi) "bu sayı nereden geldi?" sorusunun
  /// cevabı kalıcı olmalı. NULL = bu alandan ÖNCE tartılmış (tarihsel) — DEFAULT
  /// verilmedi ve VERİLMEMELİ: mevcut canlı satırların kaynağı gerçekten BİLİNMİYOR,
  /// `DEFAULT 'MANUAL'` geçmişi uydururdu.
  /// ⚠️ İÇ İZ — BELGEYE/ETİKETE BASILMAZ: `config/label-fields.ts` SACK_FIELDS bir
  /// ALLOWLIST'tir, oraya EKLEME (eklenirse Etiket Stüdyosu'nda sürüklenebilir hale
  /// gelir ve müşteriye giden çuval etiketine iç iz sızar). Aynı şekilde
  /// `document-render/shipment-dispatch.html.ts` kolon setine de eklenmez.
  /// `resetSackWeightsTx` kg'yi sıfırlarken bunu da NULL'lar (bayat kaynak kalmasın).
  weightSource SackWeightSource?
  /// Çuvalın ÜSTÜNDEKİ fiziksel etiket geçersiz mi. `Roll.labelDirty` ile aynı
  /// mekanizma: müşteri değişince MÜŞTERİYE ÖZEL çuval şablonu (`CustomerTemplateRoute`
  /// kind=SACK) farklıysa basılı etiket yanlış şablonu taşır. Tetikleyici "müşteri
  /// değişti" DEĞİL — eski ve yeni müşteri AYNI şablona çözülüyorsa (ikisi de rotasız
  /// → bağlam varsayılanı) etiket geçerli kalır ve işaretlenmez; gereksiz "yeniden bas"
  /// uyarısı operatörü körleştirir. Baskıda temizlenir (`recordSackPrintEvent`).
  labelDirty   Boolean           @default(false)
  // Çuval yorumu — İÇ serbest not ("kendimiz için"): "ölçü şüpheli", "çuval yırtık,
  // aktarılacak" gibi. Ne ölçüm ne içerik → iki bilinçli sonuç:
  //  1) `resetSackWeightsTx` bu alana DOKUNMAZ (içerik değişince kg bayatlar, not bayatlamaz).
  //  2) `touchWarehouseSackTx` guard'ı UYGULANMAZ — sevkiyata atanmış/sevk edilmiş çuvala da
  //     yorum yazılabilir (annotation; `Shipment.dispatchNote` ile aynı gerekçe). Guard'ı
  //     "eksik" sanıp EKLEME — özelliği sessizce öldürür (kök CLAUDE.md'de yazılı istisna).
  // Gösterimi üç yerde de OPSİYONEL + varsayılan KAPALI: (a) çuval etiketi (etiket
  // stüdyosunda `sackNote` alanı), (b) sevk irsaliyesi çuval tablosu "Açıklama" kolonu
  // (kalıcı toggle VEYA tek-seferlik baskı bayrağı), (c) iç ekranlar (mobil + admin).
  // Sevk belgesine ANNOTATION olarak girer — donmuş çekirdeğe yazılmaz, baskıda canlı çözülür.
  notes        String?           @db.VarChar(500)

  // Relations
  customer    Customer?        @relation(fields: [customerId], references: [id])
  branch      CustomerBranch?  @relation(fields: [branchId], references: [id])
  shipment    Shipment?        @relation(fields: [shipmentId], references: [id])
  /// Restrict: içinde çuval duran depo silinemez (Roll.warehouseId ile aynı karar —
  /// SET NULL, konum bilgisini sessizce yok ederdi).
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  weighedBy   User?            @relation("SackWeighedBy", fields: [weighedById], references: [id])
  rolls       Roll[] // Bu çuvaldaki toplar (içerik)
  swatches    Swatch[] // Bu çuvaldaki kartelalar (içerik)
  allocations SackAllocation[] // Sevkte yazılan sipariş-satırı tahsisi (hangi çuval → hangi satır)
  warehouseMovements WarehouseMovement[] // Çuval-bütün transfer izleri

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Sevkiyat içinde çuval sırası benzersiz (NULL'lar çakışmaz — havuz çuvalları seq=NULL).
  @@unique([shipmentId, seq])
  // O-22: Roll/Swatch↔Sack↔Shipment tutarlılık invariant'ının FK hedefi. Bu unique
  // sayesinde rolls & swatches'a composite FK (sackId, shipmentId) -> sacks(id,
  // shipmentId) kurulur (DEFERRABLE, raw-SQL). MATCH SIMPLE: shipmentId NULL (havuz
  // çuvalı) iken FK atlanır. Composite FK Prisma şemasında YOK — DB seviyesinde yaşar.
  // ⚠️ DRIFT: `migrate dev` bu 2 FK'yı (rolls/swatches consistency) DROP etmek İSTER.
  // ASLA uygulama — `migrate dev --create-only` kullan, üretilen DropForeignKey satırlarını SİL.
  @@unique([id, shipmentId])
  // Havuz/liste sorguları: müşteri + oluşturma sırası (FIFO = createdAt).
  @@index([customerId, createdAt])
  @@index([warehouseId])
  @@map("sacks")
}

/// Sevkiyat — çuval depo havuzundan seçilen çuvallarla kurulan "kamyon". Tek müşteri+şube.
/// PLANNED (kuruldu, karşılanma donduruldu) → DISPATCHED (kamyona
/// yüklendi, toplar SHIPPED). Sipariş kümesi (ShipmentOrder) donmuş tahsislerden türetilir;
/// irsaliye çuval içeriğinden basılır.
model Shipment {
  id            String              @id @default(uuid()) @db.Uuid
  shipmentNo    String              @unique @db.VarChar(64)
  /// İdempotency anahtarı (A4, 2026-07-31 denetimi) — timeout-retry'de istemci
  /// kör 409 yerine kurulmuş sevkiyatın kendisini geri alır (createShipment
  /// replay). Token'sız eski istemci → NULL.
  clientToken   String?             @unique @db.Uuid
  customerId    String              @db.Uuid
  branchId      String?             @db.Uuid
  status        ShipmentStatus      @default(PLANNED)
  // Saha #19+#22: yurtiçi/yurtdışı — tartı zorunluluğu yalnız EXPORT, board'da rozet+filtre.
  destination   ShipmentDestination @default(DOMESTIC)
  // Saha #21: sevkiyata özel prosedür / ihracat referans kodu (örn. gümrük beyanname no).
  // Boşsa ekranlarda müşteri/şube `code`'u gösterilir; bu alan sevkiyat bazında override.
  procedureCode String?             @db.VarChar(64)

  // İrsaliye açıklaması — sevkiyata özel, KAYITLI serbest not. Donmuş belge
  // çekirdeğine GİRMEZ (annotation katmanı): irsaliye basılırken canlı çözülür,
  // her an düzenlenebilir (SÜRÜM DOĞURMAZ), tekrar baskıda da çıkar. Opsiyonel.
  dispatchNote String? @db.VarChar(500)

  // Araç / sürücü (dispatch'te girilir)
  plateNumber String? @db.VarChar(32)
  driverName  String? @db.VarChar(100)
  carrier     String? @db.VarChar(100)

  dispatchedAt   DateTime? @db.Timestamptz // Kamyona yüklenip çıktığı an
  // O-19: operatör izi — kim sevk etti (kalıcı, best-effort audit yerine).
  dispatchedById String?   @db.Uuid

  // FATURA İZİ (2026-08-02) — muhasebeci "bu sevkin faturası kesildi mi" sorusunu
  // ERP'de yanıtlasın diye. ERP fatura KESMEZ: burada tutulan yalnız dış muhasebe
  // programındaki belgenin numarası + tarihi (mali alan yok — miktar-odaklı kural).
  // Bir sevk = bir fatura varsayımı; kısmi faturalama modellenmedi.
  invoiceNo    String?   @db.VarChar(64)
  invoicedAt   DateTime? @db.Timestamptz
  invoicedById String?   @db.Uuid

  // Relations
  customer           Customer            @relation(fields: [customerId], references: [id])
  dispatchedBy       User?               @relation("ShipmentDispatchedBy", fields: [dispatchedById], references: [id])
  invoicedBy         User?               @relation("ShipmentInvoicedBy", fields: [invoicedById], references: [id])
  branch             CustomerBranch?     @relation(fields: [branchId], references: [id])
  sacks              Sack[]
  orders             ShipmentOrder[] // Donmuş tahsislerden türetilen sipariş kümesi (denorm; irsaliye orderNos)
  rolls              Roll[] // Atanan çuvalların içindeki toplar
  swatches           Swatch[] // Atanan çuvalların içindeki kartelalar (siparişe sayılmaz)
  returns            RollReturn[] // Bu sevkiyattan gelen iadeler (izlenebilirlik)
  /// Bu sevkin depo defterindeki izleri (SHIPMENT / SHIPMENT_REVERSAL).
  warehouseMovements WarehouseMovement[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([customerId, status])
  @@index([branchId])
  @@index([status, createdAt])
  // Muhasebe listesi sevk tarihine göre sıralanır (status=DISPATCHED sabit filtre) →
  // eşitlik kolonu önce, sıralama kolonu sonra (perf kuralı 2).
  @@index([status, dispatchedAt])
  invoices Invoice[]
  @@map("shipments")
}

/// Sevkiyat ↔ Order (N:N) — DENORM: sevkiyat kurulurken donmuş tahsislerin sipariş
/// kümesinden türetilir (irsaliye/fiş orderNos bunu okur). Append-only.
model ShipmentOrder {
  shipmentId String  @db.Uuid
  orderId    String  @db.Uuid
  // Sevkiyatın aktifliğinin DENORM bayrağı (shipment.status = PLANNED).
  // Bakımı UYGULAMA katmanında: dispatch/cancel -> false. Havuz modelinde "bir sipariş
  // tek aktif sevkiyatta" kuralı KALKTI (malı iki planlı sevkiyata bölünebilir) →
  // eski partial unique (shipment_orders_active_order_uq) migration ile düşürülür.
  isActive   Boolean @default(true)

  // D-10: muhasebe defteri — shipment fiziksel silinirse allocation/order defteri
  // sessizce yok olup shippedQty'yi bozmasın. App shipment'ı hard-delete etmez.
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([shipmentId, orderId])
  @@index([orderId])
  @@map("shipment_orders")
}

/// Sevk defteri (ÇUVAL bazlı) — bir çuvalın metrajının sipariş satırlarına tahsisi.
/// SEVK kurulurken yazılır (createShipment): distributeSacksToLines spec+şube FIFO ile
/// hangi çuval → hangi satır → ne kadar. PLANNED: bekler (shippedQty'ye SAYILMAZ).
/// DISPATCHED: OrderLine.shippedQty'ye sayılır. Sevkiyat iptalinde silinir. Rezerv/packedQty
/// YOK. "Hangi top" değil "ne kadar metraj".
model SackAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  sackId      String  @db.Uuid
  orderLineId String  @db.Uuid
  qty         Decimal @db.Decimal(12, 3) // Bu çuvalın bu satıra düşürdüğü metraj

  // Restrict: çuval silinmeden önce tahsis rebalance ile temizlenir (defter kaybolmasın).
  sack      Sack      @relation(fields: [sackId], references: [id], onDelete: Restrict)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  // Aynı çuval+satıra iki kez tahsis yazılamaz (rebalance sil-yaz deseni + saf savunma).
  @@unique([sackId, orderLineId])
  @@index([orderLineId])
  @@map("sack_allocations")
}

/// İADE DEFTERİ — müşteriden geri dönen topun kaydı. Append-only; izlenebilirliğin
/// omurgası. Sevk muhasebesine (OrderLine.shippedQty / SackAllocation) DOKUNMAZ
/// → sipariş kapalı (COMPLETED) kalır. "Hangi siparişten / hangi üründen / ne kadar
/// iade" tamamen bu tablodan türetilir. İade anında top SHIPPED→WAREHOUSE'a çekilir
/// (statü hep WAREHOUSE — Tambur çıktısıyla tutarlı); kalite yalnız personel
/// (returnGradingEnabled açıkken) override ederse `qualityGradeId`'de saklanır.
model RollReturn {
  id             String  @id @default(uuid()) @db.Uuid
  rollId         String  @db.Uuid // İade edilen top
  fromShipmentId String? @db.Uuid // Geldiği sevkiyat (varsa)
  customerId     String  @db.Uuid // Müşteri (sevkiyattan türetilir)
  orderId        String? @db.Uuid // Personelin seçtiği sipariş (tek aday=otomatik; yoksa null)

  // Spec snapshot — top sonradan Tambur'da kesilse bile rapor sağlam kalsın
  itemId  String   @db.Uuid
  colorId String?  @db.Uuid
  width   Decimal? @db.Decimal(12, 3)
  qty     Decimal  @db.Decimal(12, 3) // İade anındaki currentQty

  // Neden + not (hepsi opsiyonel; ikisi de boş olabilir)
  reasonId   String? @db.Uuid // ReturnReason FK (seçilen)
  reasonText String? @db.Text // Serbest metin neden
  note       String? @db.Text // Teslim alan personel notu

  // Kalite — yalnız personel override ettiyse dolar (yoksa top çıktığı kaliteyle döner)
  qualityGradeId String? @db.Uuid

  receivedById String @db.Uuid // İadeyi teslim alan personel

  // İade öncesi durum snapshot'ı — iptal (geri al) bunlarla topu eski haline döndürür.
  prevSackId         String? @db.Uuid // İade anındaki sackId (iptalde geri yazılır)
  prevQualityGrade   String? // İade anındaki qualityGrade etiketi
  prevQualityGradeId String? @db.Uuid // İade anındaki qualityGradeId

  /// İade anında topa UYGULANAN statü (WAREHOUSE/A1_STOCK/SCRAP — kalite override'ına
  /// göre). İptal (geri al) guard'ı "top hâlâ iade ettiği rafta mı" kontrolünü bununla
  /// yapar; sonradan kesim/yeniden sevk görmüşse iptal engellenir. null → legacy/WAREHOUSE.
  appliedStatus RollStatus?

  // İptal (yanlış iade kabulü geri alındı) — sebeple birlikte.
  cancelledAt   DateTime? @db.Timestamptz
  cancelReason  String?   @db.Text
  cancelledById String?   @db.Uuid

  /// ÇOK KALEMLİ İADE — aynı olayda (tek çuval / tek okutma oturumu) alınan
  /// iadelerin ortak anahtarı. Değeri grubun LİDER satırının `id`'sidir.
  ///
  /// Defter satır bazında kalır (her top ayrı `RollReturn` — brüt kuralı, iade
  /// raporları ve `prevSackId` geri-ekleme mantığı bozulmasın), BELGE ise grup
  /// bazındadır: `PrintedDocument.sourceId` = lider id. Sektör standardı bir
  /// iade = bir çok kalemli irsaliyedir; top başına 20 kâğıt basmak değil.
  ///
  /// NULL = tekil iade (2026-08-05 öncesi TÜM kayıtlar + mobil tek-top akışı).
  /// Belge çözümü o durumda bugünkü davranışı AYNEN sürdürür (sourceId = kendi
  /// id'si) → eski donmuş belgeler ve eski APK etkilenmez.
  returnGroupId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  roll               Roll                @relation(fields: [rollId], references: [id])
  fromShipment       Shipment?           @relation(fields: [fromShipmentId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id])
  /// İadenin depo defterindeki izi (RETURN — mal hangi depoya geri girdi).
  warehouseMovements WarehouseMovement[]
  order              Order?              @relation(fields: [orderId], references: [id])
  item               Item                @relation(fields: [itemId], references: [id])
  color              Color?              @relation(fields: [colorId], references: [id])
  reason             ReturnReason?       @relation(fields: [reasonId], references: [id])
  qualityGrade       QualityGrade?       @relation(fields: [qualityGradeId], references: [id])
  receivedBy         User                @relation("RollReturnReceivedBy", fields: [receivedById], references: [id])
  cancelledBy        User?               @relation("RollReturnCancelledBy", fields: [cancelledById], references: [id])

  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([itemId, colorId, width])
  // K7: colorId lider-kolon index'i — renge göre iade sorgusu composite'in
  // 2. kolonunu kullanamıyordu (renk pasifleştirme/rapor yolları).
  @@index([colorId])
  @@index([fromShipmentId])
  @@index([rollId])
  @@index([reasonId])
  @@index([receivedById])
  @@index([qualityGradeId])
  @@index([cancelledById])
  @@index([cancelledAt])
  @@index([createdAt])
  // Grup üyelerini toplama yolu (belge kurulumu + grup iptali). Null-yoğun
  // (tekil iadeler NULL) → partial index migration'da uygulanır.
  @@index([returnGroupId])
  @@map("roll_returns")
}

// =============================================================================
// 11.6 FABRIC IDENTITY — Color, FabricProperty + ItemProperty + Capabilities + Targets
// =============================================================================
//
// Final Item ham bir kumaşın renk + özellik kombinasyonunu içerir (örn.
// "PATOS-MAVI-YANMAZ"). Müşteri sipariş verirken doğrudan final Item seçer;
// renk/özellik bilgisi Item.colorId ve Item.properties'de zaten gömülüdür.
//
// Akış:
//   1) Admin Color (Mavi) ve FabricProperty (Yanmazlık) kayıtlarını yönetir.
//   2) Admin StationColor + StationProperty ile bir istasyonun hangi renk/özellik
//      uygulayabileceğini bağlar (zorunlu kısıt — WO planlamada kontrol edilir).
//   3) Planlamacı/Tanımlar ekranı: ham + renk + özellikler kombinasyonu için
//      manuel olarak final Item tanımlar (kod deterministic üretilir, isim
//      otomatik önerilir). Aynı kombinasyon ikinci kez tanımlanmaya
//      çalışılırsa sistem mevcut Item'ı önerir.
//   4) WorkOrder.targetItemId final Item'a işaret eder; renk/özellik bilgisi
//      hedef Item'dan okunur. Fason dönüşünde Roll.itemId final Item ile
//      güncellenir (item-derive.helper.ts → findDerivedItemOrThrow).
// =============================================================================

/// Renk kataloğu — Mavi, Kırmızı, Yeşil...
/// Roll, OrderLine, WorkOrder.targetColor, Swatch ve Item.allowedColors buradan
/// referans alır.
model Color {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32) // "MAVI", "KIRMIZI"
  name      String   @db.VarChar(100)
  hex       String?  @db.VarChar(7) // UI rozeti için #RRGGBB
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  itemAllowed         ItemAllowedColor[]
  rolls               Roll[]
  orderLines          OrderLine[]
  workOrderTargets    WorkOrder[]            @relation("WorkOrderTargetColor")
  swatches            Swatch[]
  stationCapabilities StationColor[]
  /// Müşteri-bazlı isim alias'ları — etiket basımında "müşterideki adı" için.
  customerAliases     CustomerColorAlias[]
  /// Fason kabullerde renk olarak uygulandığı receipt'ler (boyahane dönüşü).
  appliedAtReceipts   SubcontractorReceipt[]
  productRecipes      ProductRecipe[]
  rollReturns         RollReturn[]
  swatchReductions    SwatchStockReduction[]
  /// Rota şablonu adımlarında planlanan hedef renk (şablon varsayılanı).
  routeStepPlanned    RouteStep[]            @relation("RouteStepPlannedColor")

  @@index([isActive, sortOrder])
  @@map("colors")
}

/// Kumaş özellik kataloğu — Yanmazlık, Kayganlık, Su Geçirmezlik...
/// Üç farklı m:n ile bağlanır:
///   - ItemProperty   : bir Item'a hangi özelliklerin uygulanabileceği (allowed)
///   - WorkOrderTargetProperty : bir iş emrinin üretim çıktısında olacak özellikler
///   - RollProperty   : bir rulonun fiilen sahip olduğu özellikler
model FabricProperty {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32) // "YANMAZLIK", "KAYGAN"
  name        String  @db.VarChar(100)
  category    String? // "Dayanıklılık", "Yüzey", "Kimyasal" vb. (UI gruplama için)
  description String?
  color       String? @db.VarChar(7) // UI badge hex
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  /// BAYRAK mı, SEÇİM mi? (2026-08-10 — "üretim karakteristiği" modeli)
  ///
  /// BAYRAK: klasik var/yok özelliği (ZIMPARALI, KURSUN). Topa `RollProperty`
  /// satırı olarak yazılır, değeri yoktur.
  ///
  /// SEÇİM: birbirini DIŞLAYAN değerlerden biri seçilir (KAT → 2-KAT/4-KAT/TÜP).
  /// Değer listesi `values` ilişkisindedir. ⚠️ SEÇİM tipli özelliğin değeri
  /// `RollProperty`'ye YAZILMAZ — o pivot bir KÜME modelidir (`@@unique([rollId,
  /// propertyId])`, değer kolonu yok) ve bir topa hem 2-KAT hem 4-KAT
  /// yazılmasını engelleyemez. Değer, kaydın KENDİ kolonunda durur
  /// (`Roll.foldType` / `WorkOrder.foldType` / `ProductRecipe.foldType`);
  /// katalog yalnız "hangi değerler geçerli + hangi istasyon sorar" sorusunu
  /// yanıtlar. Sektör emsali: SAP'ta sınıflandırma katalogda, raporlanan değer
  /// kaydın kolonunda durur.
  ///
  /// ⚠️ SEÇİM tipli özellik HEDEF-ÖZELLİK seçicilerinde GÖRÜNMEZ (WO hedef
  /// özellikleri, rota adımı chip'leri, `ItemAllowedProperty`). Görünürse
  /// planlamacı "KAT" işaretler (hangi kat?) ve `workorder.service`'in
  /// "renk/özellik verebilen adım var mı" guard'ı iş emrini reddeder.
  ///
  /// İkinci bir SEÇİM tipli özellik doğduğunda ya kendi kolonunu ister ya da
  /// `RollProperty`/`WorkOrderTargetProperty` pivotlarına `valueId` eklenir.
  valueType FabricPropertyValueType @default(FLAG)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  itemAllowed          ItemAllowedProperty[]
  workOrderTargets     WorkOrderTargetProperty[]
  rollProperties       RollProperty[]
  orderLineRequired    OrderLineRequiredProperty[]
  stationCapabilities  StationProperty[]
  /// Fason kabullerde uygulandığı receipt'ler (boyahane dönüşü gibi).
  appliedAtReceipts    SubcontractorReceiptProperty[]
  productRecipeTargets ProductRecipeProperty[]
  /// Rota şablonu adımlarında planlanan hedef özellikler (şablon varsayılanı).
  routeStepTargets     RouteStepProperty[]
  /// SEÇİM tipli özelliğin izin verilen değerleri (BAYRAK tipte boş).
  values               FabricPropertyValue[]

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("fabric_properties")
}

/// SEÇİM tipli `FabricProperty`'nin izin verilen değerleri — `Color`
/// kataloğunun küçük ikizi. Bugünkü tek tüketicisi KAT (2-KAT / 4-KAT / TÜP).
///
/// ⚠️ KİMLİK `code`'DUR, ad DEĞİL. Kod `Roll.foldType` gibi kolonlara AYNEN
/// yazılır ve envanter filtresi/sıralaması onun üzerinden çalışır; fabrika
/// görüntü adını değiştirirse ("4 Kat") kod bozulmamalı.
///
/// ⚠️ KOD ASCII OLMALI. Seed "TUP" yazar, "TÜP" DEĞİL — görünen ad "Tüp" kalır.
/// Türkçe karakterli bir kod, ASCII yazan her istemciyi sessizce reddettirir
/// (ölçüldü: `test_recipe` "TUP" gönderiyor ve "TÜP" koduna takıldı). Bekçi
/// `test_fold_catalog.ts` katalogdaki ASCII-dışı kodu kırmızı verir.
///
/// ⚠️ Kod karşılaştırması `toUpperCase()` ile yapılır, `toLocaleUpperCase("tr")`
/// ile DEĞİL — Türkçe upper "i"yi "İ" yapıp eşleşmeyi sessizce bozar
/// (2026-08-02 etiket koşulu dersinin aynısı).
model FabricPropertyValue {
  id         String  @id @default(uuid()) @db.Uuid
  propertyId String  @db.Uuid
  /// Kayda yazılan değer ("4-KAT"). Özellik içinde benzersiz.
  code       String  @db.VarChar(32)
  /// Ekranda görünen ad ("4 Kat"). Kimlik DEĞİL.
  name       String  @db.VarChar(100)
  sortOrder  Int     @default(0)
  /// Pasif değer yeni kayıtlarda seçilemez ama GEÇMİŞ kayıtlarda durur —
  /// bu yüzden değer satırı silinmez, pasifleştirilir.
  isActive   Boolean @default(true)

  property       FabricProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Bu değeri taşıyan toplar — FK `Restrict`, yani kullanılan değer silinemez
  /// (zaten silinmiyor: `fabric-property.service` pasifleştiriyor).
  rollProperties RollProperty[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([propertyId, code])
  @@index([propertyId, sortOrder])
  @@map("fabric_property_values")
}

/// Item ↔ FabricProperty M:N — bir Item'a uygulanabilir özellikler (allowed list).
/// Item kimliğini ETKİLEMEZ (Item kimliği sadece kod). Sadece sipariş/WO
/// planlamada filter kaynağıdır. Boş = tüm aktif FabricProperty serbest.
model ItemAllowedProperty {
  id         String @id @default(uuid()) @db.Uuid
  itemId     String @db.Uuid
  propertyId String @db.Uuid

  item     Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([itemId, propertyId])
  @@index([propertyId])
  @@map("item_allowed_properties")
}

/// Item ↔ Color M:N — bir Item'a uygulanabilir renkler (allowed list).
/// Item kimliğini ETKİLEMEZ. Sipariş satırında ve WO targetColor'da filter
/// kaynağıdır. Boş = tüm aktif Color serbest.
model ItemAllowedColor {
  id      String @id @default(uuid()) @db.Uuid
  itemId  String @db.Uuid
  colorId String @db.Uuid

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  color Color @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([itemId, colorId])
  @@index([colorId])
  @@map("item_allowed_colors")
}

/// Customer ↔ Item alias — müşterinin bizdeki ürün için kullandığı isim.
/// Örn: bizde "PATOS", ABC müşterisinde "AKTOS". Sipariş girişinde otomatik
/// öneri olarak gelir; OrderLine.customerItemName boşsa etiket basımında live
/// olarak buradan okunur. Operatörün uyguladığı OrderLine override bu kaydı
/// EZMEZ — bir-seferlik talep için.
model CustomerItemAlias {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  itemId     String @db.Uuid
  alias      String // Müşterideki ad (örn. "AKTOS")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([customerId, itemId])
  // D-6: @@index([customerId]) kaldırıldı — @@unique([customerId, itemId]) sol-prefix'i kapsar.
  @@index([itemId])
  @@map("customer_item_aliases")
}

/// Customer ↔ Color alias — aynı mantık, renk için. Örn: bizde "MAVI",
/// ABC müşterisinde "ROYAL BLUE".
model CustomerColorAlias {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @db.Uuid
  colorId    String  @db.Uuid
  // Müşterideki renk adı (etiket basımı için opsiyonel). Null = renge müşteri
  // tarafında özel ad verilmemiş.
  alias      String?
  // Renk bu müşteriye "özel renk" olarak atandı mı? `assigned` ile `alias` BAĞIMSIZ:
  //   - assigned=true,  alias=null  → müşterinin özel rengi, özel ad yok
  //   - assigned=false, alias='..'  → herkeste olan katalog rengi, sadece müşteri adı var
  //   - assigned=true,  alias='..'  → hem özel renk hem özel adlı
  // Atama renk formundan (customerIds), ad müşteri panelinden yönetilir. Picker
  // "Müşteri Renkleri" bölümü SADECE assigned=true satırları gösterir.
  assigned   Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  color    Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([customerId, colorId])
  // D-6: @@index([customerId]) kaldırıldı — @@unique([customerId, colorId]) sol-prefix'i kapsar.
  // Picker scope + sipariş guard sorguları: "renk herhangi bir müşteriye atanmış mı"
  // (none/some assigned) ve "bu renkler atanmış mı" (colorId IN + assigned).
  // (colorId, assigned) composite, colorId-prefix lookup'ları da karşılar.
  @@index([colorId, assigned])
  @@map("customer_color_aliases")
}

/// Etiket template'i — hangi alanlar gözüksün, sırası, başlığı, bold/font.
/// Her LabelKind için en fazla 1 isDefault=true (service-level enforcement).
/// `fields` JSON yapısı: src/config/label-fields.ts içindeki catalog'a uygun
/// olmalı. Şema-level sıkı yapı yok (esneklik için JSON), service validate.
///
/// Örnek fields:
///   [
///     { "key": "barcode",     "label": "Barkod",  "order": 1, "isVisible": true,  "isBold": true,  "fontSize": "lg" },
///     { "key": "itemName",    "label": "Ürün",    "order": 2, "isVisible": true },
///     { "key": "customerName","label": "Müşteri", "order": 3, "isVisible": true }
///   ]
/// Etiket şablonu — TEK HAVUZ (Etiket Stüdyosu v2): şablon türden bağımsızdır,
/// hangi bağlamda (ham/bitmiş/kartela) basılacağını ATAMALAR belirler
/// (LabelContextDefault + PeripheralTemplateRoute + CustomerTemplateRoute).
/// Yerleşim varyantlarda (LabelTemplateVariant.elements — kanvas modeli).
model LabelTemplate {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @db.VarChar(100) // "Standart Top Etiketi", "Müşteri X Özel"
  /// DEPRECATED (v2 havuz): kimlik değil, yalnız migration bilgisi — yeni şablonlar
  /// null doğar. Baskı bağlamı baskı anında veriden türer. Saha onayı sonrası drop.
  kind       LabelKind?
  /// DEPRECATED (v2): tek doğru kaynak LabelContextDefault; geçiş boyunca çift-yazım
  /// (eski client geri uyumu). Saha onayı sonrası drop.
  isDefault  Boolean    @default(false)
  isActive   Boolean    @default(true)
  /// Serbest (statik) etiket şablonu — rulo/kartela bağlamına ATANAMAZ (bağlam
  /// varsayılanı / müşteri rotası / cihaz rotası); barkodsuz kaydedilebilir ve
  /// talep üzerine (şablon + kopya seç) basılır. Baskı seçicisinde görünür,
  /// atama seçicilerinde görünmez. kind bu şablonlarda null kalır.
  standalone Boolean    @default(false)
  /// DEPRECATED (v2): akış-modeli alan listesi — varyantı olmayan şablon için
  /// fail-safe render yolu (dual-mode). Varyantlı şablonda kullanılmaz.
  fields     Json
  /// Uzman raw-code override (dil→kod): { PPLA?, PPLB?, ZPL?, RASTER_HTML? }. Bir dil
  /// için doluysa otomatik üretim yerine BU kod basılır ({{key}} yer-tutucuları payload
  /// değeriyle doldurulur). Boş/yok → varyant kanvası / akış üretimi.
  rawCode    Json?

  /// DEPRECATED (v2) yerleşim düğmeleri — kanvas modelinde eleman özelliğine taşındı;
  /// yalnız dual-mode akış yolunda okunur. Saha onayı sonrası drop.
  lineStepMm   Decimal? @db.Decimal(4, 1)
  qrScale      Int?
  lengthBanner Boolean?

  /// KALICI silinme damgası — dolu=silinmiş: listelerde görünmez, düzenlenemez;
  /// yönlendirme satırları silinir, ad DEL- önekiyle serbest kalır.
  deletedAt DateTime? @db.Timestamptz

  peripheralRoutes        PeripheralTemplateRoute[]
  variants                LabelTemplateVariant[]
  customerRoutes          CustomerTemplateRoute[]
  customerStandaloneLinks CustomerStandaloneLabel[]
  contextDefaults         LabelContextDefault[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([name])
  @@index([isActive])
  // F188: DB'de ŞEMA-DIŞI partial unique — label_templates_one_default_per_kind (kind)
  // WHERE isDefault=true (migration 20260708180000; roll_movements_one_open emsali). Kind
  // başına tek isDefault=true garantisi; label-template.service rethrowDefaultConflict yakalar.
  @@map("label_templates")
}

/// Şablonun BOYUT VARYANTI — kendi tuvali (widthMm×heightMm) + kendi kanvas
/// eleman yerleşimi. Yeni varyant mevcut varyanttan KOPYALANARAK başlar, elle
/// düzeltilir/teyit edilir — OTOMATİK ÖLÇEKLEME YOK (sıfır-hata ilkesi).
/// Baskıda cihaz MEDYA boyutuna ±1mm eşleşen varyant seçilir; eşleşme yoksa
/// isPrimary varyant basılır (baskı bloklanmaz) + panelde proaktif uyarı.
model LabelTemplateVariant {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String        @db.VarChar(60) // "100×148 Standart"
  widthMm    Decimal       @db.Decimal(6, 2)
  heightMm   Decimal       @db.Decimal(6, 2)
  /// Şablon başına EN FAZLA bir primary (partial unique index — raw SQL).
  isPrimary  Boolean       @default(false)
  /// Kanvas eleman listesi { v: 1, elements: LabelElement[] } — servis
  /// validateElements ile doğrular (config/label-elements.ts tek kaynak).
  elements   Json

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([templateId, widthMm, heightMm])
  @@map("label_template_variants")
}

/// Müşteriye özel şablon ataması (müşteri+bağlam → şablon). Çözüm zincirinde
/// cihaz route'unun ÖNÜNE girer: explicit > müşteri > cihaz > bağlam default.
/// Müşterisiz/stok baskıda hiç sorgulanmaz (etiket müşterisi explicit-only).
/// Emsal desen: PeripheralTemplateRoute + CustomerColorAlias.
model CustomerTemplateRoute {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       LabelKind
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([customerId, kind])
  @@index([templateId])
  @@map("customer_template_routes")
}

/// Müşteriye bağlı SERBEST (statik) etiketler — M:N kolaylık bağı (customer ⟺
/// standalone LabelTemplate). ROTA DEĞİL: rulo/kartela etiket çözümüne
/// (label-routing.resolver / CustomerTemplateRoute) KATILMAZ — yalnız baskı
/// ekranındaki serbest etiket seçicisini müşteriye göre filtrelemek için.
/// Bağ OPSİYONEL: hiç bağı olmayan serbest şablon "genel"dir ve her müşteride
/// görünür; müşteri seçilince liste = o müşterinin bağlı etiketleri ∪ genel.
/// Yalnız standalone=true şablon bağlanabilir (servis guard). Pivot: sadece
/// createdAt (M:N konvansiyonu); iki uç da onDelete Cascade.
model CustomerStandaloneLabel {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([customerId, templateId])
  @@index([templateId])
  @@index([customerId])
  @@map("customer_standalone_labels")
}

/// Bağlam (LabelKind) başına varsayılan şablon — eski "kind-başına isDefault"un
/// yeni evi. kind @unique = bağlam başına tek default DB seddi.
model LabelContextDefault {
  id         String        @id @default(uuid()) @db.Uuid
  kind       LabelKind     @unique
  templateId String        @db.Uuid
  template   LabelTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([templateId])
  @@map("label_context_defaults")
}

/// WorkOrder ↔ FabricProperty M:N — planlamacının iş emri için belirlediği
/// üretim özellikleri. Tambur'da finalize sırasında bu liste otomatik olarak
/// üretilen Roll'lara RollProperty olarak yazılır. Step planlaması YOK.
model WorkOrderTargetProperty {
  id          String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  propertyId  String @db.Uuid

  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  property  FabricProperty @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([workOrderId, propertyId])
  @@index([propertyId])
  @@map("work_order_target_properties")
}

/// Roll ↔ FabricProperty M:N — bir rulonun fiilen sahip olduğu özellikler.
/// "Özellik veren" fason adımının (SubcontractorCategory.appliesProperty=true)
/// Fason Kabul'ünde WO.targetProperties'tan kopyalanır. Sonradan
/// inventory.applyManualProperties ile düzenlenebilir.
model RollProperty {
  id         String @id @default(uuid()) @db.Uuid
  rollId     String @db.Uuid
  propertyId String @db.Uuid

  /// SEÇİM tipli özellikte operatörün seçtiği DEĞER (2026-08-11).
  /// Örnek: Kurşun istasyonunda "GRAMAJ" özelliği → 25GR / 50GR / 75GR.
  ///
  /// BAYRAK tipli özellikte NULL — orada özelliğin varlığı zaten cevaptır
  /// ("zımparalı mı? evet"). SEÇİM tipinde varlık yetmez, hangisi olduğu lazım.
  ///
  /// ⚠️ `@@unique([rollId, propertyId])` KORUNUYOR ve bu, DIŞLAYICILIĞIN
  /// kendisidir: bir topa aynı özellikten iki değer (hem 25GR hem 50GR)
  /// yazılamaz. Bu yüzden değer AYRI bir satır değil, MEVCUT satırın kolonu.
  ///
  /// ⚠️ KATALOG SATIRINA FK — serbest metin DEĞİL. `Roll.foldType`'tan farkı
  /// bilinçli: kat indekslenip filtrelenip sıralanıyor (skaler kolon şart),
  /// bu değer ise yalnız okunup gösteriliyor → FK bütünlüğü daha değerli
  /// ("50 GR" / "50gr" gibi yazım çeşitlemesi doğamaz).
  ///
  /// ⚠️ Değer satırı SİLİNMEZ, pasifleşir (`fabric-property.service`) — bu
  /// yüzden `onDelete: Restrict`: geçmiş topun taşıdığı değer yok edilemez.
  valueId String? @db.Uuid

  roll     Roll                 @relation(fields: [rollId], references: [id], onDelete: Cascade)
  property FabricProperty       @relation(fields: [propertyId], references: [id])
  value    FabricPropertyValue? @relation(fields: [valueId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([rollId, propertyId])
  @@index([propertyId])
  @@index([valueId])
  @@map("roll_properties")
}

/// İstasyon ↔ Color M:N — DEPRECATED (2026-08-02), okuyan kod YOK.
///
/// Eskiden rota adımındaki renk seçicisini kısıtlıyordu. Kaldırıldı: boyahane
/// fiziksel olarak HER rengi boyar — renk bir reçetedir, makine kısıtı değil.
/// Backend zaten bu tabloya hiç bakmıyordu (WO doğrulaması `Item.allowedColors`
/// + `SubcontractorCategory.appliesColor` üzerinden); kısıt yalnız panelde
/// yaşıyordu ve yeni eklenen renk hiçbir istasyonun listesinde olmadığı için
/// rota adımında GÖRÜNMÜYORDU. "Renk veren adım var mı" sorusunun tek kaynağı
/// artık `appliesColor` bayrağı.
///
/// Tablo ve satırları BİLİNÇLİ olarak duruyor (canlı veri; ileride "bu boyahane
/// bu rengi tutturamıyor" gibi bir tedarikçi-kalite kaydı gerekirse zemin hazır).
/// `setCapabilities` bu tarafa yalnız `colorIds` AÇIKÇA gönderilirse dokunur.
model StationColor {
  id        String @id @default(uuid()) @db.Uuid
  stationId String @db.Uuid
  colorId   String @db.Uuid

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([stationId, colorId])
  @@index([colorId])
  @@map("station_colors")
}

/// İstasyon ↔ FabricProperty M:N — bir istasyonun uygulayabileceği özellikler.
/// WO planlamada hedef özelliğin atandığı adımın bu yetkinliğe sahip olması ZORUNLUDUR.
///
/// ⚠️ Renkten FARKLI: bu KALDIRILMADI, çünkü özellik gerçek bir proses kısıtıdır
/// (boyahane zımpara yapamaz). Kaldırılan şey kısıtın BOŞ DOĞMASIYDI — yeni
/// `FabricProperty` artık `stationIds` ZORUNLU olarak yaratılır ve bağ aynı
/// insert'te kurulur (bkz. `fabric-property.service.ts`).
///
/// ⚠️ BU TABLO İKİ AYRI İŞ YAPAR ve 2026-08-10'da bunlar AYRIŞTIRILDI:
///   1. **Planlama filtresi** — "bu istasyon şu özelliği verebilir": WO create'te
///      (`workorder.service` özellik-başına rota kapsaması) ve edit'te
///      (`workorder-locks.applicablePropertyIds`) hedef özellik kümesini sınırlar.
///      Kaynağı satırın **VARLIĞI**dır; `mode` bu soruya KARIŞMAZ.
///   2. **Otomatik uygulama** — `copyStationCapabilitiesToRoll`: artık yalnız
///      `mode == AUTO` satırları kopyalanır. Çağıranlar bugün yalnız Kurşun/QC2
///      yolları (kursun-qc, inventory.kursunFinish, kursun-bypass); fason kabul
///      bu tabloyu KULLANMAZ, `WO.targetProperties`'tan kopyalar.
///
/// Eskiden ayrım YOKTU ve şu tuzak açıktı: "Kurşun'un listesine ikinci bir
/// özellik eklendiği gün o özellik oradan geçen HER TOPA sessizce yazılır."
/// `mode` varsayılanı OPTIONAL olduğu için bu tuzak kapandı — yeni satır hiçbir
/// şey yapmaz, otomatiklik açık bir karardır.
///
/// ⚠️ Fason istasyonlarında mod bugün İNERT: `copyStationCapabilitiesToRoll` o
/// yolda hiç çağrılmıyor, özellik fason kabulde `WO.targetProperties`'ten
/// yazılıyor. Bu yüzden `BOYA_FASON`/`ZIMPARA_FASON` satırları OPTIONAL taşır —
/// toplu AUTO işaretlemek, iç boyahane akışı yazıldığı gün 7 özelliği sessizce
/// her topa yazdırırdı.
model StationProperty {
  id         String @id @default(uuid()) @db.Uuid
  stationId  String @db.Uuid
  propertyId String @db.Uuid

  /// İstasyonun bu özelliği NASIL teyit ettiği (2026-08-10). Yukarıdaki "bu tablo
  /// iki iş yapar" uyarısının çözümü: artık planlama filtresi = satırın VARLIĞI,
  /// otomatik uygulama = `mode == AUTO`.
  ///
  /// ⚠️ Varsayılan OPTIONAL, AUTO DEĞİL — eski davranış "eklenen her özellik
  /// oradan geçen HER TOPA sessizce yazılır" idi ve tam da bu notta tuzak olarak
  /// işaretlenmişti. Bundan sonra otomatiklik açık bir karardır.
  ///
  /// ⚠️ `setCapabilities`/`fabric-property.update` replace deseni
  /// (`deleteMany notIn` + `createMany skipDuplicates`) mevcut satırı
  /// GÜNCELLEMEZ → modu değiştirmek ayrı bir `update` ister. Bu, özellik adı
  /// düzenlenirken modun korunmasını sağladığı için istenen davranıştır.
  mode StationPropertyMode @default(OPTIONAL)

  station  Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  property FabricProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([stationId, propertyId])
  @@index([propertyId])
  @@map("station_properties")
}

// =============================================================================
// 12. SYSTEM LOG - Audit Trail
// =============================================================================

model SystemLog {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @db.Uuid
  category  SystemLogCategory @default(DOMAIN)
  action    String // DOMAIN: CREATE/UPDATE/DELETE — AUTH: LOGIN_SUCCESS/LOGIN_FAILED — SYSTEM: STARTUP/ERROR
  tableName String // domain table OR event source (e.g. "AUTH", "SYSTEM")
  recordId  String // record id OR target identifier (username, error code, "-")
  ipAddress String? // AUTH/SYSTEM event'leri için kaynak IP
  oldData   Json?
  newData   Json?

  // Relations
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([tableName, recordId])
  // Audit tablosu en hızlı büyüyen tablodur — zaman aralığı sorguları için
  @@index([createdAt])
  // Activity Page (DOMAIN) ve Sistem Kayıtları (AUTH/SYSTEM) ayrı liste sorgularını
  // tek index scan ile karşılar.
  @@index([category, createdAt])
  // Kullanıcı aktivite raporu (userId filtreli + zaman sıralı)
  @@index([userId, createdAt])
  @@map("system_logs")
}

/// Sistem loglarının periyodik arşivi. Admin tarafından tetiklenir;
/// system_logs tablosundan X aydan eski kayıtlar buraya taşınır.
/// Arşiv sorgulanmaz, sadece yasal/uyum amaçlı saklanır.
model SystemLogArchive {
  id         String            @id @db.Uuid // Orijinal UUID — arşivleme sonrası aynı kalır
  userId     String?           @db.Uuid
  category   SystemLogCategory @default(DOMAIN)
  action     String
  tableName  String
  recordId   String
  ipAddress  String?
  oldData    Json?
  newData    Json?
  archivedAt DateTime          @default(now()) @db.Timestamptz
  createdAt  DateTime          @db.Timestamptz
  updatedAt  DateTime          @db.Timestamptz

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@map("system_log_archives")
}

/// Endpoint gecikme GÜNLÜK özetleri (Faz 3 — SAHA-DAYANIKLILIK-FAZ3.md §P1).
/// RAM'deki latency-stats her ~5dk istek-güdümlü flush ile buraya merge edilir;
/// bucket sayaçları JSON'da tutulur → günler TOPLANABİLİR, persentil okuma
/// anında hesaplanır. Retention: flush 90 günden eskiyi siler (tablo TAVANLI —
/// ~150-200 satır/gün, yılda birkaç MB). JSON sorgulanmaz (GIN gerekmez); FK yok.
model EndpointLatencyDaily {
  id        String   @id @default(uuid()) @db.Uuid
  day       DateTime @db.Date
  routeKey  String   @db.VarChar(200)
  count     Int
  errCount  Int
  maxMs     Int
  buckets   Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([day, routeKey])
  @@map("endpoint_latency_daily")
}

/// Refakat kartı ŞABLONU — üç kademeli kişiselleştirme (2026-08-03).
///
///   BUILTIN  : yerleşik yerleşim. Kart bugünkü gibi basılır; `config` yalnız
///              marka/görünürlük ayarını taşır (SystemSetting ile aynı şekil).
///   SECTIONS : Şablon Stüdyosu — bölümlerin SIRASI ve açık/kapalısı değişir
///              (`config.sections`). Yerleşik CSS ve blok üreticileri kullanılır.
///   RAW_HTML : uzman modu — `html` alanındaki tam HTML basılır, {{alan}} ve
///              {{#liste}}…{{/liste}} ile veri gömülür. Yerleşik CSS YÜKLENMEZ.
///
/// Şablon karta BASIM ANINDA DONAR (`TravelerCard.snapshot.template`): şablon
/// sonradan düzenlense de basılmış kart aynı çıkar; `reprint` yeni şablonu alır.
/// Bu yüzden şablon satırını silmek geçmiş kartları etkilemez (soft delete).
model TravelerCardTemplate {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(80)
  mode      TravelerTemplateMode @default(SECTIONS)
  /// Baskıda açıkça şablon seçilmediğinde kullanılan şablon. DB'de ŞEMA-DIŞI
  /// partial unique — traveler_card_templates_one_default WHERE isDefault=true
  /// (label_templates_one_default_per_kind emsali). Şemada @@unique olarak durur
  /// çünkü Prisma 7 index↔unique farkını drift SAYAR (perf kuralı 4).
  isDefault Boolean              @default(false)
  isActive  Boolean              @default(true)
  /// SECTIONS/BUILTIN: TravelerCardConfig (+ sections[]). RAW_HTML'de de tutulur
  /// (sayfa boyutu/kenar payı oradan okunur — ham HTML @page'i yönetmez).
  config    Json
  /// RAW_HTML gövdesi. Diğer modlarda null.
  html      String?
  /// KALICI silinme damgası — dolu=silinmiş: listede görünmez, seçilemez.
  deletedAt DateTime?            @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([name])
  @@unique([isDefault])
  @@index([isActive])
  @@map("traveler_card_templates")
}

enum TravelerTemplateMode {
  BUILTIN
  SECTIONS
  RAW_HTML
}

// =============================================================================
// TİCARET PAKETİ — ÇOKLU DEPO + MAL KABUL (2026-08-13)
// =============================================================================
// Tasarım + gerekçeler: docs/design/TICARET-PAKETI-TASARIM.md
//
// Öncesinde "depo" bir VARLIK değil bir STATÜYDÜ (`RollStatus.WAREHOUSE` +
// `shipmentId`/`sackId` boşluğu → `getWarehouseScope`). Tek depolu üretici
// fabrikada bu doğruydu. Alım-satım kurulumunda N depo + depolar arası transfer
// gerekiyor ve "mal hangi depoda / nereden nereye gitti" sorusu cevapsızdı.
//
// ⚠️ FABRİKA UYUMU: bu blok tamamen EKLEMELİdir. Depo verilmeyen her yol
// varsayılan depoya düşer (`resolveTargetWarehouseId`); tek depo varken arayüzde
// hiçbir depo yüzeyi çizilmez. Bekçi: scripts/test_single_warehouse_parity.ts
// =============================================================================

/// FİZİKSEL DEPO. Saf tanım verisi (BaseService CRUD).
///
/// ⚠️ `Station` DEĞİLDİR: istasyon bir ÜRETİM noktasıdır (`StationKind`), depo bir
/// STOK lokasyonudur. İkisini birleştirmek fabrikanın istasyon listesine sahte
/// depo satırları sokardı.
model Warehouse {
  id   String @id @default(uuid()) @db.Uuid
  /// DP + GGAAYY + NNNN (BaseService autoCode).
  code String @unique @db.VarChar(32)
  name String @db.VarChar(100)

  /// Depo belirtilmeyen her girişin düştüğü depo. Sistemde TAM BİR TANE olur.
  /// DB'de ŞEMA-DIŞI partial unique — warehouses_one_default WHERE "isDefault"=true
  /// (traveler_card_templates_one_default emsali). Şemada `@@unique` olarak durur
  /// çünkü Prisma 7 index↔unique farkını drift SAYAR (perf kuralı 4).
  /// Servis guard'ı: varsayılan depo pasifleştirilemez/silinemez.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  address   String? @db.VarChar(300)
  notes     String? @db.VarChar(500)

  rolls         Roll[]
  transfersFrom WarehouseTransfer[] @relation("TransferFrom")
  transfersTo   WarehouseTransfer[] @relation("TransferTo")
  movementsFrom WarehouseMovement[] @relation("MovementFrom")
  movementsTo   WarehouseMovement[] @relation("MovementTo")
  goodsReceipts GoodsReceipt[]
  sacks         Sack[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([isDefault])
  @@index([isActive])
  @@map("warehouses")
}

/// Depo hareketinin TÜRÜ. Yön `fromWarehouseId`/`toWarehouseId` doluluğundan değil
/// BURADAN okunur — `qty` her zaman pozitiftir (RollVariance emsali).
enum WarehouseEventType {
  ENTRY // depoya doğum (mal kabul, KK1, tambur finalize, fason dönüşü) — from boş
  TRANSFER // depolar arası — from + to dolu ve FARKLI
  TRANSFER_REVERSAL // transfer iptali (ters yön, aynı transferId)
  SHIPMENT // müşteriye sevk — to boş
  SHIPMENT_REVERSAL // sevk stornosu — mal depoya döndü
  RETURN // müşteri iadesi girişi
  CANCEL // top iptali/fire (softDelete) — depodan düştü
}

/// DEPO HAREKET DEFTERİ — append-only: "mal hangi depoya girdi / hangisinden çıktı".
///
/// ⚠️ NEDEN AYRI TABLO, neden `RollMovement` DEĞİL: o tablonun `workOrderStepId`
/// alanı NOT NULL'dır ve bir İŞ EMRİ ADIMINA giriş/çıkışı temsil eder; iş emri
/// olmayan bir depo transferi oraya yapısal olarak sığmaz. Ayrıca ölçüldü: depo
/// hayatı bugün TAMAMEN hareketsiz (bitmiş topların hiçbirinde kapanmış
/// RollMovement yok) — yani orası bu soruyu zaten yanıtlamıyor. Emsal gerekçe:
/// `RollVariance` ("neden ayrı tablo, neden metadata değil").
///
/// ⚠️ Statü TERFİSİ hareket DEĞİLDİR: `STOCK → WAREHOUSE` (prepareRawForSale)
/// satır YAZMAZ — bu defter KONUM defteridir, statü izi audit'tedir.
model WarehouseMovement {
  id        String             @id @default(uuid()) @db.Uuid
  rollId    String             @db.Uuid
  eventType WarehouseEventType

  fromWarehouseId String? @db.Uuid
  toWarehouseId   String? @db.Uuid

  /// Olay anındaki metraj — HER ZAMAN POZİTİF; yönü `eventType` söyler.
  qty Decimal @db.Decimal(12, 3)

  // Belge bağları — typed FK (polimorfik değil). Hangi olayda hangisi dolar:
  // TRANSFER*/transferId · ENTRY(mal kabul)/goodsReceiptId · SHIPMENT*/shipmentId
  // · RETURN/rollReturnId. Diğer ENTRY yolları (KK1, tambur) belgesizdir.
  transferId     String? @db.Uuid
  goodsReceiptId String? @db.Uuid
  shipmentId     String? @db.Uuid
  rollReturnId   String? @db.Uuid
  /// Top bu harekete bir ÇUVALIN üyesi olarak girdiyse çuvalın kimliği — transfer
  /// iptalinin guard'ı ("top hâlâ AYNI çuvalda mı") buradan okur. onDelete SET NULL
  /// bilinçli: boş çuval silinebilir (bilinçli istisna listesinde) ve silinmiş
  /// çuvalın izini NULL'a düşürmek zararsızdır — toplar zaten çuvaldan çıkarılmış
  /// olur ve iptal onları serbest top olarak geri taşır (fiziksel gerçekle birebir).
  sackId         String? @db.Uuid

  userId String? @db.Uuid
  notes  String? @db.VarChar(300)

  roll          Roll               @relation(fields: [rollId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse?         @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?         @relation("MovementTo", fields: [toWarehouseId], references: [id])
  transfer      WarehouseTransfer? @relation(fields: [transferId], references: [id])
  goodsReceipt  GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id])
  shipment      Shipment?          @relation(fields: [shipmentId], references: [id])
  rollReturn    RollReturn?        @relation(fields: [rollReturnId], references: [id])
  sack          Sack?              @relation(fields: [sackId], references: [id], onDelete: SetNull)
  user          User?              @relation("WarehouseMovementUser", fields: [userId], references: [id])

  /// Append-only log → `updatedAt` YOK (konvansiyon).
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([rollId, createdAt])
  @@index([toWarehouseId, eventType, createdAt])
  @@index([fromWarehouseId, eventType, createdAt])
  @@index([transferId])
  @@index([goodsReceiptId])
  @@index([sackId])
  @@map("warehouse_movements")
}

enum WarehouseTransferStatus {
  COMPLETED
  CANCELLED
}

/// DEPOLAR ARASI TRANSFER BELGESİ.
///
/// TEK ADIMLI: "yolda" (in-transit) durumu yok — yerel depolar arasında araç takibi
/// ihtiyacı yok. Gerekirse enum'a SONA `IN_TRANSIT` eklenerek açılır.
///
/// ⚠️ SATIR TABLOSU YOK: kalemler `WarehouseMovement` satırlarıdır (`transferId`).
/// Belgenin donmuş içeriği zaten `PrintedDocument.snapshot`'ta yaşar.
model WarehouseTransfer {
  id         String @id @default(uuid()) @db.Uuid
  /// DT + GGAAYY + NNNN (nextPrefixedSequence + withBarcodeRetry).
  transferNo String @unique @db.VarChar(32)

  fromWarehouseId String                  @db.Uuid
  toWarehouseId   String                  @db.Uuid
  status          WarehouseTransferStatus @default(COMPLETED)
  notes           String?                 @db.VarChar(500)

  /// İstemci idempotency anahtarı — timeout/retry'da mükerrer transfer doğmasın.
  clientToken String? @unique @db.Uuid

  createdById   String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User?               @relation("WarehouseTransferCreatedBy", fields: [createdById], references: [id])
  cancelledBy   User?               @relation("WarehouseTransferCancelledBy", fields: [cancelledById], references: [id])
  movements     WarehouseMovement[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@index([status, createdAt])
  @@map("warehouse_transfers")
}

enum GoodsReceiptStatus {
  ACTIVE
  CANCELLED
}

/// MAL KABUL FİŞİ — satın alınan malın depoya girişi (üretimsiz stok girişi).
///
/// Topları `InventoryService.createInitialEntry` ÜRETİR (`forcedStatus: WAREHOUSE`,
/// `forcedEntrySource: PURCHASE_RECEIPT`) — ikinci bir giriş motoru YAZILMAZ;
/// mükerrer tuzağı, barkod rezervasyonu, izinli renk/özellik doğrulaması ve
/// idempotency o yoldan bedava gelir. Emsal: `tambur-manual.produceFinishedRoll`.
///
/// ALIŞ SİPARİŞİ (PurchaseOrder) Faz 2 — kullanıcı kararı gereği sipariş
/// OPSİYONEL. Faz 1'de tedarikçi + tedarikçinin kâğıt irsaliye numarası yeterli.
model GoodsReceipt {
  id        String @id @default(uuid()) @db.Uuid
  /// MK + GGAAYY + NNNN.
  receiptNo String @unique @db.VarChar(32)

  warehouseId    String  @db.Uuid
  /// Tedarikçi — `Customer` (`CompanyType.SUPPLIER`). Ayrı tedarikçi modeli
  /// AÇILMADI: cari kart tek yerde kalsın (ön muhasebe de oraya bağlanacak).
  supplierId     String? @db.Uuid
  /// Tedarikçinin kendi irsaliye numarası (serbest metin) — alış faturası
  /// mutabakatının çıpası.
  deliveryNoteNo String? @db.VarChar(64)

  /// Fişin para birimi (ticaret paketi) — satırların `Roll.purchasePrice`
  /// değerleri BU birimdedir. Fiş TEK para birimlidir: karışık fiş, alış
  /// faturasını iki para biriminde kesmeyi gerektirirdi ve fatura tek
  /// birimlidir. Varsayılan TRY → mevcut fişler ve fabrika davranışı aynı.
  currency Currency @default(TRY)

  status GoodsReceiptStatus @default(ACTIVE)
  notes  String?            @db.VarChar(500)

  clientToken String? @unique @db.Uuid

  createdById   String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier    Customer?           @relation("GoodsReceiptSupplier", fields: [supplierId], references: [id])
  createdBy   User?               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?               @relation("GoodsReceiptCancelledBy", fields: [cancelledById], references: [id])
  rolls       Roll[]
  movements   WarehouseMovement[]
  invoices    Invoice[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([warehouseId, createdAt])
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("goods_receipts")
}

// =============================================================================
// ÖN MUHASEBE (Paket 2) — cari · fatura · tahsilat · kasa/banka · kur
// =============================================================================
// KAPSAM: bu bir MUHASEBE PROGRAMI DEĞİL, bir ÖN muhasebe defteridir. ERP resmî
// fatura KESMEZ (e-fatura yok); dış muhasebe programında kesilen belgenin izi
// `externalNo` ile eşlenir. Amaç "kim bana ne kadar borçlu, ben kime ne kadar
// borçluyum, kasada/bankada ne var" sorularını sevkiyat/fason verisinden
// TÜRETEREK cevaplamak.
//
// ⚠️ FABRİKA SIFIR-FARK: tüm yüzeyler `finance.enabled` bayrağı (varsayılan
// KAPALI) + `finance:*` izinleri arkasında. Tablolar boş kaldığı sürece hiçbir
// mevcut sorgu bunlara dokunmaz.
// =============================================================================

/// Cari hesabın hangi taraf kaydına bağlı olduğu.
enum CariKind {
  CUSTOMER
  SUBCONTRACTOR
}

/// Cari hesap — MÜŞTERİ/FASON kartının MUHASEBE yüzü.
///
/// ⚠️ Neden ayrı tablo: `Customer`/`Subcontractor` operasyonun kartlarıdır ve
/// onlara vergi dairesi / vade / risk limiti eklemek, muhasebe alanlarını
/// operasyon ekranlarına sızdırırdı. Ayrıca cari LAZY açılır (ilk fatura/tahsilat
/// anında) — bugün 200 müşterinin çoğunun cari hareketi yok, hepsine boş hesap
/// açmak listeyi anlamsız şişirirdi.
///
/// ⚠️ `customerId` XOR `subcontractorId`: ikisi de dolu ya da ikisi de boş
/// OLAMAZ. DB'de CHECK constraint ile kilitli (şema-dışı, envanterde kayıtlı).
model CariAccount {
  id   String   @id @default(uuid()) @db.Uuid
  kind CariKind

  customerId      String? @unique @db.Uuid
  subcontractorId String? @unique @db.Uuid

  /// Vergi dairesi BURADA — Customer/Subcontractor kartlarına dokunulmaz.
  taxOffice String? @db.VarChar(100)

  /// Fatura/tahsilat formlarının ön-doldurduğu para birimi (ezilebilir).
  defaultCurrency Currency @default(TRY)

  /// Vade günü — "fatura + N gün". Yaşlandırma raporunun girdisi.
  paymentTermDays Int?

  /// Risk limiti UYARIDIR, bloklamaz: satışı durdurma kararı ticari bir karardır
  /// ve yazılımın vardiya ortasında sessizce vermesi yanlış olurdu.
  riskLimit Decimal? @db.Decimal(14, 2)

  notes    String? @db.VarChar(500)
  isActive Boolean @default(true)

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)

  balances     CariBalance[]
  transactions CariTransaction[]
  invoices     Invoice[]
  payments     Payment[]

  /// Çek/senet (C1) — üç ayrı rol, üç ayrı ilişki:
  ///   `cheques`         : bu cariden ALINAN / bu cariye VERİLEN çekler
  ///   `endorsedCheques` : bu cariye CİRO EDİLEN çekler (borcumuzu çekle kapattık)
  ///   `chequeEvents`    : olay defterinde karşı taraf olarak geçtiği satırlar
  cheques         Cheque[]      @relation("ChequeCari")
  endorsedCheques Cheque[]      @relation("ChequeEndorsedTo")
  chequeEvents    ChequeEvent[] @relation("ChequeEventCounterCari")

  /// Dönem kapanışları (C3) — ekstrenin DEVİR satırının kaynağı.
  periodCloses CariPeriodClose[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([kind, isActive])
  @@map("cari_accounts")
}

/// Cari bakiyesi — PARA BİRİMİ BAZINDA AYRI.
///
/// ⚠️ Döviz bakiyeleri TL'ye EZİLMEZ: 1000 USD alacak ile 30.000 TL alacak farklı
/// şeylerdir ve tek kolona toplanırsa hangi kurla kapatılacağı bilgisi kaybolur.
/// TL karşılığı raporda, rapor günü kuruyla ve DİPNOTLU gösterilir.
///
/// Denormalize: `CariTransaction` toplamıyla aynı tx'te atomik increment edilir.
/// Doğruluğunun DB seddi yoktur → `test_consistency` bölümü zorunludur
/// (`Order.shippedQty` emsali).
model CariBalance {
  cariId   String   @db.Uuid
  currency Currency
  balance  Decimal  @default(0) @db.Decimal(14, 2)

  cari CariAccount @relation(fields: [cariId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@id([cariId, currency])
  @@map("cari_balances")
}

enum InvoiceType {
  SALES
  PURCHASE
  SALES_RETURN
  PURCHASE_RETURN
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Fatura — TASLAK üretilir, ONAY ile deftere işler.
///
/// ⚠️ CONFIRMED fatura ASLA düzenlenmez/silinmez; düzeltme = İPTAL (storno) +
/// yeni fatura. Sektör standardı budur ve `CariTransaction`'ın append-only
/// olmasının sebebi de odur.
///
/// ⚠️ "Bir kaynak → en çok BİR aktif fatura": kaynak bağları üzerinde şema-dışı
/// partial unique'ler var (WHERE status <> 'CANCELLED'). Çift taslak yapısal
/// olarak imkânsız — aksi halde aynı sevkiyat iki kez faturalanır ve cari
/// bakiyesi sessizce iki katına çıkardı.
model Invoice {
  id     String        @id @default(uuid()) @db.Uuid
  /// SF/AF/SI/AI + GGAAYY + NNNN.
  docNo  String        @unique @db.VarChar(32)
  type   InvoiceType
  status InvoiceStatus @default(DRAFT)

  cariId String @db.Uuid

  currency Currency @default(TRY)

  /// Belgeye DAMGALANAN kur — sonradan kur tablosu düzeltilse bile bu belge
  /// kendi kuruyla kalır (donmuş belge kuralının muhasebe karşılığı).
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  issueDate DateTime  @db.Timestamptz
  dueDate   DateTime? @db.Timestamptz

  /// Dış muhasebe programında kesilen faturanın numarası (varsa).
  externalNo String? @db.VarChar(64)
  notes      String? @db.VarChar(500)

  /// Satırlardan Decimal ile yeniden hesaplanıp ONAY anında damgalanır.
  subtotal         Decimal @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal @default(0) @db.Decimal(14, 2)
  vatTotal         Decimal @default(0) @db.Decimal(14, 2)
  withholdingTotal Decimal @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal @default(0) @db.Decimal(14, 2)

  /// TL karşılığı — rapor toplamları tek para biriminde okunabilsin diye.
  grandTotalTry Decimal @default(0) @db.Decimal(14, 2)

  /// KAPANAN TUTAR (C2) — `PaymentAllocation` satırlarının denormalize toplamı.
  ///
  /// ⚠️ AÇIK/KISMİ/KAPALI DURUMU AYRI BİR KOLON DEĞİLDİR: `paidTotal` ile
  /// `grandTotal` KARŞILAŞTIRILARAK türetilir. İki denormalize alan (tutar +
  /// durum) bir gün birbirinden ayrışır ve o gün "kapalı görünen ama parası
  /// gelmemiş fatura" doğar; tek sayı + türetme ayrışamaz.
  ///
  /// ⚠️ Yazımı RAW ATOMİK SAYAÇTIR: `UPDATE ... SET "paidTotal" = "paidTotal" + $a
  /// WHERE id = $i AND "paidTotal" + $a <= "grandTotal"` (Prisma `where`'i iki
  /// kolonu karşılaştıramaz) + `count === 0` → 409. DB seddi ayrıca CHECK ile
  /// kilitli; ikisi aynı şeyi iki katmanda söyler.
  paidTotal Decimal @default(0) @db.Decimal(14, 2)

  /// KAYNAK BAĞLARI — typed nullable FK (polimorfik sourceType+sourceId DEĞİL:
  /// FK'siz bağ, kaynak silinince sessizce hayalet fatura bırakırdı).
  shipmentId             String? @db.Uuid
  directShipmentId       String? @db.Uuid
  returnGroupId          String? @db.Uuid
  subcontractorReceiptId String? @db.Uuid
  /// Mal kabul fişi (ticaret paketi) — alış faturasının kaynağı. Partial unique
  /// ile "bir fiş → en çok BİR aktif fatura" (diğer kaynaklarla aynı sed).
  goodsReceiptId         String? @db.Uuid

  confirmedAt   DateTime? @db.Timestamptz
  confirmedById String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  createdById String? @db.Uuid
  clientToken String? @unique @db.Uuid

  cari                 CariAccount           @relation(fields: [cariId], references: [id], onDelete: Restrict)
  shipment             Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  directShipment       DirectShipment?       @relation(fields: [directShipmentId], references: [id], onDelete: Restrict)
  subcontractorReceipt SubcontractorReceipt? @relation(fields: [subcontractorReceiptId], references: [id], onDelete: Restrict)
  goodsReceipt         GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)

  lines        InvoiceLine[]
  transactions CariTransaction[]
  allocations  PaymentAllocation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // AÇIK FATURA yolu (C2/C4 yaşlandırmasının tek sorgusu). DB'de PARTIAL'dır:
  // `WHERE status = 'CONFIRMED' AND "paidTotal" < "grandTotal"` (migration
  // 20260814102000). Şemada düz `@@index` bırakılır — Prisma 7 predicate farkını
  // drift SAYMAZ ama index↔unique farkını SAYAR (perf kuralı 4).
  // Kolon sırası: eşitlikler (cari, para birimi) önce, sıralama (vade) sonra.
  @@index([cariId, currency, dueDate], map: "invoices_open")
  @@index([cariId, status, issueDate])
  @@index([type, status, issueDate])
  @@index([status, issueDate])
  @@index([shipmentId])
  @@index([directShipmentId])
  @@index([returnGroupId])
  @@index([subcontractorReceiptId])
  @@index([goodsReceiptId])
  @@map("invoices")
}

/// Fatura satırı — `itemId` OPSİYONEL.
///
/// ⚠️ Serbest satır bilinçli: firma iplik de satabiliyor ve iplik stok modelinde
/// YOK. Zorunlu `itemId`, olmayan bir ürünü uydurmaya zorlardı. Açıklama her
/// satırda vardır ve belgeye o basılır.
model InvoiceLine {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  lineNo    Int

  itemId      String? @db.Uuid
  description String  @db.VarChar(300)

  qty       Decimal @db.Decimal(14, 3)
  unit      String  @default("m") @db.VarChar(16)
  unitPrice Decimal @db.Decimal(14, 4)

  /// Oranlar SATIRA DAMGALANIR — KDV kataloğu sonradan değişse bile geçmiş
  /// fatura kendi oranıyla okunur.
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  vatRate      Decimal @default(0) @db.Decimal(5, 2)

  /// Fason tevkifatı (satın alma faturasında).
  withholdingRate Decimal @default(0) @db.Decimal(5, 2)

  lineTotal Decimal @db.Decimal(14, 2)
  vatAmount Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([invoiceId, lineNo])
  @@index([itemId])
  @@map("invoice_lines")
}

/// Cari hareketin KAYNAĞI — ekstrede satırın "neden var olduğu".
///
/// ⚠️ ÇEK DEĞERLERİ SONA EKLENDİ (2026-08-14, migration 20260814100000). PG
/// kuralı: `ALTER TYPE ... ADD VALUE` ile eklenen değer AYNI transaction içinde
/// KULLANILAMAZ → kendi migration'ında gelirler (RUB / PrintedDocType emsali).
///
/// ÇEKİN DEFTER ANLARI (C1 kilitli kararı — Logo "Çek Giriş Bordrosu" davranışı):
/// çek ALINDIĞI AN cari alacaklanır; müşteri çeki verdiğinde ticari olarak
/// ödemiştir. Karşılıksız riski, kaydı GECİKTİRMENİN değil TERS KAYITLA geri
/// almanın gerekçesidir (append-only felsefesi).
///   • `CHEQUE_RECEIVE`  — müşteriden çek/senet alındı → müşteri CREDIT
///   • `CHEQUE_ISSUE`    — kendi çekimiz/senedimiz verildi → cari DEBIT
///   • `CHEQUE_ENDORSE`  — ciro → ciro edilen cariye DEBIT (tek olay, iki cari)
///   • `CHEQUE_BOUNCE`   — karşılıksız → müşteriye DEBIT (+ ciro edilmişse ciro
///     carisine ters CREDIT)
///   • `CHEQUE_CANCEL`   — çek kaydının geri alınması: portföyden İADE (sahibine
///     geri verildi) ve hatalı kaydın stornosu. `INVOICE_CANCEL`/`PAYMENT_CANCEL`
///     konvansiyonunun aynısı; ekstrede olayın hangisi olduğunu `description`
///     söyler. **`CHEQUE_BOUNCE` bunun içine KATLANMADI** çünkü "karşılıksız",
///     muhasebecinin ekstrede aktif olarak ARADIĞI olaydır — iptalle aynı ada
///     düşerse aranamaz hâle gelir.
///
/// ⚠️ TAHSİL (COLLECT) ve KENDİ ÇEKİMİZİN ÖDENMESİ (PAY) burada YOKTUR ve bu
/// bilinçlidir: o anlarda yalnız banka/kasa bakiyesi oynar, cari İKİNCİ kez
/// hareket görmez (görseydi aynı borç iki kez kapanmış sayılırdı).
enum CariTxnSource {
  INVOICE
  INVOICE_CANCEL
  PAYMENT
  PAYMENT_CANCEL
  ADJUSTMENT
  CHEQUE_RECEIVE
  CHEQUE_ISSUE
  CHEQUE_ENDORSE
  CHEQUE_BOUNCE
  CHEQUE_CANCEL
}

/// Cari hareket defteri — APPEND-ONLY.
///
/// ⚠️ UPDATE/DELETE YOK. Düzeltme daima TERS SATIRDIR (storno). Bir defterin
/// güvenilirliği tam olarak bundan gelir: geçmişi değiştirilebilen defter,
/// denetimde hiçbir şey kanıtlamaz.
///
/// `debit`/`credit` iki AYRI kolon (tek işaretli kolon değil): muhasebede borç
/// ve alacak ayrı sütunlardır ve ekstre o şekilde basılır.
model CariTransaction {
  id       String   @id @default(uuid()) @db.Uuid
  cariId   String   @db.Uuid
  currency Currency
  txnDate  DateTime @db.Timestamptz

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  /// TL karşılığı — dönem toplamları tek birimde okunabilsin diye damgalanır.
  amountTry    Decimal @default(0) @db.Decimal(14, 2)
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  sourceType  CariTxnSource
  invoiceId   String?       @db.Uuid
  paymentId   String?       @db.Uuid
  /// Çek/senet kaynağı (C1). Diğer iki kaynak bağıyla aynı desen: polimorfik
  /// sourceId DEĞİL, typed nullable FK — kaynak silinemez, hayalet satır doğmaz.
  chequeId    String?       @db.Uuid
  description String?       @db.VarChar(300)

  createdById String? @db.Uuid

  cari    CariAccount @relation(fields: [cariId], references: [id], onDelete: Restrict)
  invoice Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cheque  Cheque?     @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([cariId, currency, txnDate])
  @@index([invoiceId])
  @@index([paymentId])
  // Bir çekin defterdeki tüm izleri (alış → ciro → karşılıksız zinciri) tek
  // sorguda okunur. PARTIAL DEĞİL — komşu iki kaynak bağı da (invoiceId,
  // paymentId) tam index; aynı tablodaki üç bağın üçü aynı desende kalsın.
  @@index([chequeId])
  @@map("cari_transactions")
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum PaymentStatus {
  ACTIVE
  CANCELLED
}

/// Tahsilat / ödeme.
///
/// ⚠️ Çek/senet BU FAZDA YOK (Faz 2): çekin kendi yaşam döngüsü var (portföy →
/// ciro → tahsil → karşılıksız) ve onu `PaymentMethod`'a bir değer olarak
/// eklemek, o döngüyü modellemeden "tahsil edildi" demek olurdu.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  /// TH/OD + GGAAYY + NNNN.
  docNo String @unique @db.VarChar(32)

  direction PaymentDirection
  method    PaymentMethod
  status    PaymentStatus    @default(ACTIVE)

  cariId String @db.Uuid

  currency     Currency @default(TRY)
  exchangeRate Decimal  @default(1) @db.Decimal(18, 6)
  amount       Decimal  @db.Decimal(14, 2)
  amountTry    Decimal  @db.Decimal(14, 2)

  /// FATURAYA KAPATILAN tutar (C2) — `amount`'ı AŞAMAZ (CHECK). Kalanı "serbest
  /// tahsilat"tır ve yaşlandırma raporunda sanal FIFO mahsupla gösterilir.
  allocatedTotal Decimal @default(0) @db.Decimal(14, 2)

  /// Kasa VEYA banka — ikisi birden olamaz (CHECK constraint).
  cashBoxId     String? @db.Uuid
  bankAccountId String? @db.Uuid

  paymentDate DateTime @db.Timestamptz
  reference   String?  @db.VarChar(120)
  notes       String?  @db.VarChar(500)

  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  createdById String? @db.Uuid
  clientToken String? @unique @db.Uuid

  cari        CariAccount  @relation(fields: [cariId], references: [id], onDelete: Restrict)
  cashBox     CashBox?     @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  transactions CariTransaction[]
  allocations  PaymentAllocation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([cariId, status, paymentDate])
  @@index([direction, status, paymentDate])
  @@index([cashBoxId, paymentDate])
  @@index([bankAccountId, paymentDate])
  @@map("payments")
}

/// Kasa — TEK PARA BİRİMLİ.
///
/// ⚠️ Çok para birimli tek kasa, "kasada ne var" sorusunu cevaplanamaz yapardı
/// (hangi kurla toplanacak?). RUB kasası ayrı karttır.
model CashBox {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(32)
  name     String   @db.VarChar(100)
  currency Currency @default(TRY)

  /// Denormalize — İKİ YAZAR: `Payment` (carili tahsilat/ödeme) ve
  /// `CashTransaction` (carisiz masraf/gelir/virman/açılış). İkisi de aynı
  /// tx'te increment eder; mutabakat `test_consistency` §23 İKİ TABLOYU birden
  /// toplar — yalnız birine bakan bir sorgu, diğer yazarın hareketlerini
  /// "drift" sanardı.
  balance Decimal @default(0) @db.Decimal(14, 2)

  isActive Boolean @default(true)
  notes    String? @db.VarChar(500)

  payments         Payment[]
  cashTransactions CashTransaction[]
  /// Elden tahsil edilen çekin olay satırı (C1) — kasa bakiyesinin ÜÇÜNCÜ
  /// yazarı. `test_consistency` §23 formülü bu tabloyu da toplamak zorunda.
  chequeEvents     ChequeEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([isActive])
  @@map("cash_boxes")
}

/// Banka hesabı — kasa ile aynı kural (tek para birimi).
model BankAccount {
  id       String   @id @default(uuid()) @db.Uuid
  code     String   @unique @db.VarChar(32)
  name     String   @db.VarChar(100)
  bankName String?  @db.VarChar(100)
  iban     String?  @db.VarChar(34)
  currency Currency @default(TRY)
  balance  Decimal  @default(0) @db.Decimal(14, 2)
  isActive Boolean  @default(true)
  notes    String?  @db.VarChar(500)

  payments         Payment[]
  cashTransactions CashTransaction[]
  /// Tahsile/teminata verilen çekler (C1) — `Cheque.bankAccountId` denormalize
  /// başlığı; `chequeEvents` ise o çekin banka bakiyesini oynatan olay satırları.
  cheques          Cheque[]
  chequeEvents     ChequeEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([isActive])
  @@map("bank_accounts")
}

/// Carisiz kasa/banka hareketinin TÜRÜ.
///
/// ⚠️ Neden ayrı model (`Payment`e nullable `cariId` DEĞİL): `Payment`'ın
/// sözleşmesi "cari deftere satır + bakiye + kasa aynı tx'te oynar"dır ve o
/// sözleşme storno, kapama ve ekstre yollarının tamamında varsayılır. Kira
/// ödemesinin carisi YOKTUR; `cariId`yi nullable yapmak, en hassas kod
/// yolundaki her `Payment` okumasına sessiz bir "cari var mı" dalı eklerdi.
/// Ayrım aynı zamanda ekranı da doğru böler: Tahsilat/Ödeme listesi CARİ
/// hareketidir, Kasa Hareketleri ise kasanın kendi defteridir.
enum CashTxnKind {
  /// Gider — kira, maaş, elektrik, nakliye…
  EXPENSE
  /// Carisiz gelir — kur farkı geliri, hurda satışı, tahsilat dışı giriş.
  INCOME
  /// Virman — kasadan bankaya / bankadan kasaya. TEK uç İKİ satır üretir
  /// (`transferGroupId` ile bağlı): biri OUT, diğeri IN.
  TRANSFER_OUT
  TRANSFER_IN
  /// Açılış/devir bakiyesi — sisteme geçişte kasada/bankada var olan para.
  /// Bakiye elle YAZILMAZ (generic CRUD'da `stripBalance` engelliyor); açılış
  /// da bir HAREKETTİR, böylece "bu para nereden geldi" defterden okunur.
  OPENING
}

/// Kasa/banka hareketi — CARİSİZ.
///
/// Yön `direction` kolonundadır, tutar HER ZAMAN POZİTİFTİR (RollVariance /
/// WarehouseMovement emsali: işaretli tutar yönü iki yerde saklamaktır ve
/// ikisi bir gün ayrışır).
model CashTransaction {
  id     String           @id @default(uuid()) @db.Uuid
  /// KH + GGAAYY + NNNN.
  docNo  String           @unique @db.VarChar(32)
  kind   CashTxnKind
  direction PaymentDirection
  status PaymentStatus    @default(ACTIVE)

  /// Kasa VEYA banka — ikisi birden olamaz (CHECK, Payment ile aynı kural).
  cashBoxId     String? @db.Uuid
  bankAccountId String? @db.Uuid

  currency Currency @default(TRY)
  /// Hesabın para biriminde; kur damgası TL karşılığı raporlar için.
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  amount       Decimal @db.Decimal(14, 2)
  amountTry    Decimal @db.Decimal(14, 2)

  txnDate     DateTime @db.Timestamptz
  /// Serbest kategori metni ("Kira", "Elektrik"). Katalog BİLİNÇLİ olarak
  /// yok: fabrika/ticaret gider kalemleri çok değişken ve boş bir katalog
  /// kullanıcıyı "Diğer"e mahkûm ederdi (KK1 sebep kataloğu dersi: kategori
  /// GERÇEK serbest metinlere bakılarak sonradan kurulur).
  category    String?  @db.VarChar(120)
  description String?  @db.VarChar(300)
  reference   String?  @db.VarChar(120)

  /// Virmanın İKİ satırını bağlar (aynı uçta doğarlar). Tekil hareketlerde NULL.
  transferGroupId String? @db.Uuid

  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  createdById String? @db.Uuid
  clientToken String? @unique @db.Uuid

  cashBox     CashBox?     @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([cashBoxId, txnDate])
  @@index([bankAccountId, txnDate])
  @@index([kind, status, txnDate])
  @@index([transferGroupId])
  @@map("cash_transactions")
}

enum ExchangeRateSource {
  MANUAL
  TCMB
}

/// Günlük kur.
///
/// ⚠️ `rateDate` @db.Date — bu bir TAKVİM GÜNÜ anahtarıdır, an değil
/// (`EndpointLatencyDaily.day` emsali). Timestamptz'ye çevrilirse gün sınırı
/// saat dilimine bağlanır ve "13 Ağustos kuru" iki farklı satıra düşebilir.
/// `test_timestamptz_contract` muaf listesine yazılmıştır.
///
/// Faz 1'de yalnız MANUAL (elle giriş); TCMB çekme işi Faz 2.
model ExchangeRate {
  id       String   @id @default(uuid()) @db.Uuid
  rateDate DateTime @db.Date
  currency Currency

  /// 1 birim döviz kaç TL.
  rate   Decimal            @db.Decimal(18, 6)
  source ExchangeRateSource @default(MANUAL)

  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([rateDate, currency])
  @@index([currency, rateDate])
  @@map("exchange_rates")
}

// =============================================================================
// ÇEK / SENET PORTFÖYÜ (Paket C1) — migration 20260814101000
// =============================================================================
// ⚠️ NEDEN AYRI MODEL, NEDEN `PaymentMethod`'a CHEQUE DEĞERİ EKLENMEDİ:
// `Payment` bir ANDIR — para o an el değiştirir ve olay orada biter. Çek bir
// VARLIKTIR: haftalarca yaşar, vadesi vardır ve dört ayrı yola sapabilir
// (tahsil · ciro · karşılıksız · iade). Çeki `PaymentMethod`'a bir değer olarak
// eklemek, sistemin EN HASSAS kod yoluna (tahsilat + cari bakiye + storno)
// sessiz bir "bu aslında henüz para değil" dalı sokmak olurdu. Logo/Mikro da
// aynı ayrımı yapar (Çek/Senet ayrı modül, kendi bordro belgeleriyle).
//
// ⚠️ KASA/BANKA BAKİYESİNE İKİNCİ YAZAR: `Payment` ve `CashTransaction`'ın
// yanına şimdi `ChequeEvent` (COLLECT/PAY) da geliyor. `test_consistency`
// §23/§24 mutabakat formülü ÜÇ tabloyu birden toplamak zorundadır — yalnız
// ikisine bakan bir sorgu, ilk çek tahsilatında "drift" diye KIRMIZI verir.
// =============================================================================

/// Çekin yönü — ALINAN (müşteri çeki, portföyümüzde) mi VERİLEN (kendi çekimiz)
/// mi. Kart ayrı tutulmadı çünkü iki yönün alanları birebir aynı; ayıran şey
/// yalnız defter işaretleri ve izlenen durum kümesidir.
enum ChequeKind {
  RECEIVED
  ISSUED
}

/// Çek mi senet mi. Senet AYNI modülde: yaşam döngüsü (portföy → tahsil /
/// karşılıksız / ciro) birebir aynıdır; ayrı tablo, aynı kodu iki kez yazmak
/// olurdu. Fark yalnız belge numarası ön ekinde ve baskıda görünür.
enum ChequeDocType {
  CHEQUE
  PROMISSORY_NOTE
}

/// Çekin DENORMALİZE başlık durumu — gerçek tarihçe `ChequeEvent`'tedir.
///
/// ⚠️ Bu kolon bir ÖZETTİR, kaynak değil: portföy listesi ve vade takibi her
/// satır için olay defterini taramak zorunda kalmasın diye var. Geçişler ATOMİK
/// CLAIM ile yazılır (`updateMany WHERE {id, beklenen-durum}` + count===0 → 409)
/// — aksi halde iki eşzamanlı "tahsil et" iki kez banka bakiyesi artırırdı.
///
/// TERMİNAL: `COLLECTED` · `BOUNCED` · `RETURNED` · `PAID` · `CANCELLED`.
/// `ENDORSED` terminal DEĞİLDİR: ciro edilen çek de karşılıksız çıkabilir ve o
/// zaman İKİ cari birden ters kayıt alır.
enum ChequeStatus {
  /// Alınan çek elimizde (kind=RECEIVED doğuş durumu).
  PORTFOLIO
  /// Tahsile/teminata bankaya verildi — henüz para gelmedi.
  AT_BANK
  /// Ciro edildi (borcumuzu bu çekle kapattık).
  ENDORSED
  /// Tahsil edildi — banka/kasa +amount.
  COLLECTED
  /// Karşılıksız çıktı — defter TERS KAYITLA geri alınır.
  BOUNCED
  /// Sahibine iade edildi (müşteri nakit ödedi, çeki geri istedi).
  RETURNED
  /// Kendi çekimiz verildi (kind=ISSUED doğuş durumu).
  ISSUED
  /// Kendi çekimiz ödendi — banka −amount.
  PAID
  /// Kayıt hatası stornosu. Fiziksel DELETE yok; satır durur, defter ters kayıtla kapanır.
  CANCELLED
}

/// Çek / senet — PORTFÖY VARLIĞI.
///
/// ⚠️ DEFTER ANI (kilitli karar): çek ALINDIĞI AN cari alacaklanır. Müşteri çeki
/// verdiğinde ticari olarak ödemiştir; ekstre aksini söylerse iki taraf iki
/// gerçekle çalışır ve mutabakat imkânsızlaşır. Karşılıksız riski, kaydı
/// GECİKTİRMENİN değil TERS KAYITLA geri almanın gerekçesidir.
///
/// ⚠️ `status` ile `ChequeEvent` AYRIŞAMAZ: her geçiş aynı tx'te hem başlığı
/// hem olay satırını yazar (`ChequeEvent.toStatus` = yeni başlık). Bekçi bu
/// mutabakatı mekanik doğrular.
model Cheque {
  id String @id @default(uuid()) @db.Uuid

  /// CKA/CKV/SNA/SNV + GGAAYY + NNNN (alınan/verilen çek · alınan/verilen senet).
  docNo String @unique @db.VarChar(32)

  kind    ChequeKind
  docType ChequeDocType @default(CHEQUE)

  /// Doğuş durumunu KIND belirler (RECEIVED→PORTFOLIO, ISSUED→ISSUED) → bilinçli
  /// olarak `@default` YOK: sabit bir varsayılan, iki yönden birini sessizce
  /// yanlış durumda doğururdu.
  status ChequeStatus

  /// Çeki VEREN (kind=RECEIVED) ya da çeki ALDIĞIMIZ (kind=ISSUED) cari.
  cariId String @db.Uuid

  /// Ciro edildiyse ALAN cari. Ciro sonrası da DOLU KALIR (NULL'lanmaz): çek
  /// karşılıksız çıkarsa ters kaydın kime yazılacağını bu alan söyler ve portföy
  /// listesi "kimde" sorusunu buradan cevaplar.
  endorsedToCariId String? @db.Uuid

  /// Tahsile/teminata verildiği ya da (kendi çekimizde) üzerine yazıldığı banka.
  bankAccountId String? @db.Uuid

  currency Currency @default(TRY)
  /// Belgeye DAMGALANAN kur — kur tablosu sonradan düzeltilse bile bu çek kendi
  /// kuruyla okunur (fatura emsali).
  exchangeRate Decimal  @default(1) @db.Decimal(18, 6)
  amount       Decimal  @db.Decimal(14, 2)
  amountTry    Decimal  @db.Decimal(14, 2)

  /// FATURAYA KAPATILAN tutar (C2) — `amount`'ı AŞAMAZ (CHECK). Çekle kapama,
  /// tahsilatla kapamayla AYNI `PaymentAllocation` tablosundan geçer: iki ayrı
  /// kapama motoru, "bu fatura ne kadar kapandı" sorusuna iki cevap üretirdi.
  allocatedTotal Decimal @default(0) @db.Decimal(14, 2)

  /// Keşide/işlem tarihi — çekin deftere girdiği gün.
  issueDate DateTime @db.Timestamptz
  /// VADE — portföyün birinci sıralama anahtarı ve yaşlandırmanın girdisi.
  /// `@db.Date` DEĞİL: `Invoice.dueDate` ile aynı sözleşmede kalsın (istemci
  /// yerel gün sınırını mutlak ana çevirip gönderiyor).
  dueDate   DateTime @db.Timestamptz

  /// Çekin ÜZERİNDEKİ numara — bizim `docNo`'muzdan farklıdır (o bizim iç belge
  /// numaramız). Opsiyonel: eldivenli girişte okunaksız çeki bloklamamak için.
  serialNo   String? @db.VarChar(64)
  bankName   String? @db.VarChar(100)
  branchName String? @db.VarChar(100)
  /// KEŞİDECİ — çeki yazan kişi/firma. Sektörde sıkça ÜÇÜNCÜ ŞAHIS çeki alınır
  /// (müşteri kendi müşterisinin çekini ciro eder), yani cari ile aynı olmayabilir.
  drawerName String? @db.VarChar(150)

  notes String? @db.VarChar(500)

  cancelledAt   DateTime? @db.Timestamptz
  cancelledById String?   @db.Uuid
  cancelReason  String?   @db.VarChar(300)

  createdById String? @db.Uuid
  /// Kayıt-yaratan uç sözleşmesi. Olay geçişlerinde clientToken YOK ve gerekmez:
  /// orada idempotency'yi atomik claim'in kendisi verir (beklenen durum bir kez
  /// tüketilir, ikinci istek 409 alır).
  clientToken String? @unique @db.Uuid

  cari           CariAccount  @relation("ChequeCari", fields: [cariId], references: [id], onDelete: Restrict)
  endorsedToCari CariAccount? @relation("ChequeEndorsedTo", fields: [endorsedToCariId], references: [id], onDelete: Restrict)
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  events       ChequeEvent[]
  transactions CariTransaction[]
  allocations  PaymentAllocation[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // "Şu carinin portföyünde ne var" — eşitlik önce, vade (sıralama) sonra.
  @@index([cariId, status, dueDate])
  // "Vadesi yaklaşan / geçen çekler" — portföy ekranının varsayılan sorgusu.
  @@index([status, dueDate])
  @@index([endorsedToCariId])
  @@index([bankAccountId])
  @@map("cheques")
}

/// Çek olayının TÜRÜ — `ChequeStatus` ile birebir eşlenmez:
/// `DEPOSIT`→AT_BANK, `COLLECT`→COLLECTED, `PAY`→PAID gibi olay→durum eşlemesi
/// serviste yaşar. Ayrı enum olmasının sebebi: durum "nerede", olay "ne oldu"
/// sorusunu cevaplar; ikisi tek enuma katlanırsa iade ile iptalin AYNI durumda
/// bitmesi gerekirdi.
enum ChequeEventType {
  RECEIVE
  ISSUE
  DEPOSIT
  COLLECT
  ENDORSE
  BOUNCE
  RETURN
  PAY
  CANCEL
}

/// Çekin durum defteri — APPEND-ONLY (`CariTransaction` emsali: `updatedAt` YOK).
///
/// ⚠️ UPDATE/DELETE YOK. "Çek ne zaman bankaya verildi, ne zaman karşılıksız
/// döndü" sorusunun tek güvenilir kaynağı budur; `Cheque.status` yalnız son
/// satırın özetidir.
model ChequeEvent {
  id       String          @id @default(uuid()) @db.Uuid
  chequeId String          @db.Uuid
  type     ChequeEventType

  /// Geçişin İKİ ucu da saklanır: `toStatus` başlıkla mutabakatı (son satır =
  /// `Cheque.status`) mekanik doğrulanabilir yapar, `fromStatus` ise atomik
  /// claim'in NEYİ tükettiğini kayda geçirir. Doğuş satırında `fromStatus` NULL.
  fromStatus ChequeStatus?
  toStatus   ChequeStatus

  eventDate DateTime @db.Timestamptz

  /// ENDORSE'ta ciro edilen cari — olayın karşı tarafı.
  counterCariId String? @db.Uuid
  /// COLLECT/PAY/DEPOSIT hesabı. Tahsil elden de olabildiği için kasa da meşru;
  /// ikisi BİRDEN dolu olamaz (CHECK).
  bankAccountId String? @db.Uuid
  cashBoxId     String? @db.Uuid

  notes       String? @db.VarChar(300)
  createdById String? @db.Uuid

  cheque      Cheque       @relation(fields: [chequeId], references: [id], onDelete: Restrict)
  counterCari CariAccount? @relation("ChequeEventCounterCari", fields: [counterCariId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  cashBox     CashBox?     @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([chequeId, eventDate])
  // Kasa defteri (C4): "dönemde tahsil edilen çekler" — tür + tarih aralığı.
  @@index([type, eventDate])
  // Hesap bazlı kasa/banka defteri — bakiyenin üçüncü yazarının okuma yolu.
  @@index([bankAccountId, eventDate])
  @@index([cashBoxId, eventDate])
  @@index([counterCariId])
  @@map("cheque_events")
}

// =============================================================================
// FATURA KAPAMA (Paket C2) — migration 20260814102000
// =============================================================================
// "Hangi tahsilat hangi faturayı kapattı" bağı. Bu bağ olmadan yaşlandırma
// raporu yazılamaz: cari bakiyesi TEK sayıdır ve "bu 10.000 TL hangi faturanın
// karşılığı" sorusunu cevaplayamaz.
// =============================================================================

/// Fatura ↔ tahsilat/çek kapama satırı.
///
/// ⚠️ DEFTERE SATIR YAZMAZ. Cari bakiyesi zaten İKİ kez oynadı (fatura onayında
/// ve tahsilatta); kapama üçüncü kez yazsaydı aynı para iki kez sayılırdı.
/// Kapama yalnız EŞLEŞTİRMEDİR — bakiyeyi değil, bakiyenin YAŞINI belirler.
///
/// ⚠️ `paymentId` XOR `chequeId` (CHECK): bir kapama satırının kaynağı ya nakit/
/// havale tahsilatıdır ya çektir. İkisi birden dolu olsaydı aynı kapama iki
/// sayacı birden tüketir (`Payment.allocatedTotal` + `Cheque.allocatedTotal`) ve
/// ikisi de fatura tarafıyla ayrışırdı.
///
/// ⚠️ FIFO bir ÖNERİDİR, otomatik commit DEĞİL: `GET open-invoices` vade sıralı
/// aday listesi döner, kullanıcı düzeltebilir. Muhasebede "hangi ödemenin hangi
/// faturaya sayılacağı" ticari bir karardır (vade farkı, iskonto, itiraz).
///
/// ⚠️ Kapsam BİLİNÇLİ DAR (Faz 3'e bırakılanlar): aynı cari + aynı para birimi +
/// yön eşleşmesi (IN↔SALES, OUT↔PURCHASE). Çapraz kur / çapraz cari kapama
/// (mahsuplaşma) ayrı bir iştir ve kur farkı hesabı gerektirir.
model PaymentAllocation {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @db.Uuid

  paymentId String? @db.Uuid
  chequeId  String? @db.Uuid

  /// Kapatılan tutar — FATURANIN para biriminde (eşleşme serviste zorunlu).
  amount Decimal @db.Decimal(14, 2)

  notes       String? @db.VarChar(300)
  createdById String? @db.Uuid

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cheque  Cheque?  @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  // ⚠️ `@@unique([invoiceId, paymentId])` BİLİNÇLİ OLARAK YOK: aynı tahsilatın
  // aynı faturaya birden çok kez kısmi kapaması meşrudur (düzeltme/bölme) ve
  // toplamı zaten sayaç CHECK'leri sınırlar. Unique koymak, mükerrer tıklamayı
  // engellemek yerine meşru düzeltmeyi bloklardı.
  @@index([invoiceId])
  @@index([paymentId])
  @@index([chequeId])
  @@map("payment_allocations")
}

// =============================================================================
// DÖNEM KAPANIŞI (Paket C3) — migration 20260814103000
// =============================================================================
// Kapanış bir FOTOĞRAFTIR: "31.12.2025 itibarıyla bu cari bize 42.150 TL
// borçluydu". Deftere satır YAZMAZ — devir bir hareket değil, hareketlerin o
// ana kadarki toplamıdır; satır yazsaydı bir sonraki ekstre aynı tutarı hem
// devir satırında hem hareketlerde sayardı.
// =============================================================================

/// Cari dönem kapanışı — para birimi BAZINDA.
///
/// ⚠️ KAPALI DÖNEME KAYIT = KİLİT (409), uyarı DEĞİL. Uyarı okunmaz; sessiz
/// yeniden-hesap ise daha kötüdür — kapanmış ve dışarıya beyan edilmiş bir
/// rakamı kimse istemeden değiştirir. Tek yüklem `assertPeriodOpenTx`;
/// `CariTransaction` yazan BEŞ yol (fatura onay/storno, tahsilat/storno, çek
/// olayları) satır yazmadan ÖNCE onu çağırır.
///   • Storno'lar doğal olarak sızmaz: iptal satırları `txnDate = now` taşır,
///     yani cari (açık) döneme düşerler — geçmiş dönem yeniden yazılmaz.
///
/// ⚠️ REOPEN SATIRI SİLMEZ, İŞARETLER (`reopenedAt`). Kapanış her an yeniden
/// türetilebilir (kaynak defter append-only), o yüzden kaydın kendisi değil
/// "kapalı sayılıp sayılmadığı" bilgisi taşınır — ve "bu dönem bir kez kapandı,
/// sonra açıldı" izi denetimde tam olarak aranan şeydir.
///
/// ⚠️ `periodEnd` `@db.Date` — TAKVİM GÜNÜ anahtarıdır, an değil ("2025 Aralık
/// kapanışı"). Timestamptz olsaydı gün sınırı saat dilimine bağlanır ve aynı
/// kapanış iki farklı satıra düşebilirdi (`ExchangeRate.rateDate` emsali).
/// `test_timestamptz_contract` muaf listesine gerekçesiyle yazılmıştır.
model CariPeriodClose {
  id       String   @id @default(uuid()) @db.Uuid
  cariId   String   @db.Uuid
  currency Currency

  /// Dönemin SON GÜNÜ (dahil). Başlangıç saklanmaz: bir önceki kapanıştan
  /// türetilir — iki uç da saklansaydı aralarında boşluk/örtüşme doğabilirdi.
  periodEnd DateTime @db.Date

  /// O ana kadarki bakiye. NEGATİF OLABİLİR (alacaklıysak) → CHECK yok.
  closingBalance Decimal @db.Decimal(14, 2)
  /// Kapanışa giren hareket sayısı — "fotoğraf ne kadar hareketten üretildi"
  /// kontrol toplamı; yeniden türetildiğinde tutmuyorsa defter değişmiş demektir.
  txnCount       Int

  notes      String? @db.VarChar(500)
  closedById String? @db.Uuid

  reopenedAt   DateTime? @db.Timestamptz
  reopenedById String?   @db.Uuid
  reopenReason String?   @db.VarChar(300)

  cari CariAccount @relation(fields: [cariId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // DB'de PARTIAL UNIQUE: `WHERE "reopenedAt" IS NULL` (migration 20260814103000).
  // Düz unique olsaydı yeniden açılan bir dönem BİR DAHA kapatılamazdı (eski
  // satır aynı anahtarı tutmaya devam ederdi). Şemada `@@unique` kalmak ZORUNDA:
  // Prisma predicate farkını drift saymaz ama index↔unique farkını SAYAR.
  @@unique([cariId, currency, periodEnd], map: "cari_period_close_active_uq")
  // Kapanış GEÇMİŞİ (yeniden açılmışlar dahil) — partial unique bu sorguyu
  // karşılayamaz, çünkü PG partial index'i yalnız predicate'i ispatlanabilen
  // sorguda kullanır.
  @@index([cariId, periodEnd])
  @@map("cari_period_closes")
}
