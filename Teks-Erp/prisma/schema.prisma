  sequence               Int // Order in the route
  defaultNotes           String? // Şablonda saklanan istasyon talimatı — WO oluşturulurken notes'a kopyalanır
  // Saha #14: rota şablonu fason planlamasını da saklasın — eskiden yalnız
  // WO formunun stepPlanning overlay'i vardı, şablona seçilen firma KAYBOLUYORDU.
  // WO açılışında bu değerler default olarak klonlanır (overlay yine ezebilir).
  requiredCategoryId     String? @db.Uuid
  plannedSubcontractorId String? @db.Uuid
  /// 2026-08-06: rota şablonu artık adımın HEDEFİNİ de saklar — "bu akışta
  /// boyahane MAVİ basar, zımpara ZIMPARALI kazandırır". İş emri açılışında
  /// rota seçilince WO hedef renk/özellikleri buradan ön-doldurulur (operatör
  /// yine değiştirebilir; şablon bir ÖNERİDİR, kilit değil).
  ///
  /// ⚠️ `WorkOrder.targetColorId`/`WorkOrderTargetProperty` ile KARIŞTIRMA: orası
  /// üretimin gerçek hedefi (sipariş kalemi kilitleyebilir), burası yalnız şablon
  /// varsayılanı. Rota adımı tüketildiğinde hiçbir yere kopyalanmaz — kopyalayan
  /// tek yer istemcinin "rotayı uygula" adımıdır.
  ///
  /// Renk rotaya sabitlenince rota o renge özel hale gelir (kullanıcı kararı,
  /// 2026-08-06). Boş bırakmak meşru ve varsayılandır: renksiz rota her renkte
  /// yeniden kullanılır.
  plannedColorId         String? @db.Uuid
  /// Şablon varsayılanı — iş emri açılışında `WorkOrderStep.dispatchWithoutColor`a
  /// kopyalanır. Gerekçe için oradaki nota bak (2026-08-17 "ekru" kuralı).
  dispatchWithoutColor   Boolean @default(false)

  // Relations
  route                Route                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station              Station                @relation(fields: [stationId], references: [id])
  requiredCategory     SubcontractorCategory? @relation("RouteStepRequiredCategory", fields: [requiredCategoryId], references: [id])
  plannedSubcontractor Subcontractor?         @relation("RouteStepPlannedSubcontractor", fields: [plannedSubcontractorId], references: [id])
  plannedColor         Color?                 @relation("RouteStepPlannedColor", fields: [plannedColorId], references: [id])
  plannedProperties    RouteStepProperty[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // UNIQUE (2026-07-31 denetimi, Bölüm C-A): aynı rotada iki adım aynı sıraya
  // sahip olamaz — kardeş WorkOrderStep'in D-12 seddiyle simetri. Bugünkü tek
  // yazma yolu (nested replace, in-memory Set) zaten güvenli; sed gelecekteki
  // ikinci yazma yolunu ve elle SQL'i korur.
  @@unique([routeId, sequence])
  // K7: stationId lider-kolon index'i — "bu istasyon hangi rotalarda?" sorguları
  // (station hardRemove guard'ı dahil) composite'in 2. kolonunu kullanamıyordu.
  @@index([stationId])
  @@index([requiredCategoryId])
  @@index([plannedSubcontractorId])
  @@index([plannedColorId])
  @@map("route_steps")
