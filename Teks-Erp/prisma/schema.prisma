  code      String  @unique @db.VarChar(32)
  name      String  @db.VarChar(100)
  isActive  Boolean @default(true)

  // Relations
  station        Station                  @relation(fields: [stationId], references: [id])
  devices        Device[]
  peripherals    PeripheralDevice[] // birleşik cihaz kaydı (yazıcı/kantar/metre/sinyal — makineye sabit)
  rollOperations RollOperation[]
  rollMovements  RollMovement[]
  workSessions   WorkSession[]
  rollsCreated   Roll[]                   @relation("RollCreatedMachine") // KK1 girişi makine atfı
  /// Kurşun bypass: bu MAKİNEYE atanan işler. Atama makine bazındadır — tek
  /// PROCESS_QC istasyonu altında N fiziksel kurşun makinesi vardır.
  kursunBypasses KursunBypassAssignment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ.
  /// `GENERATED ALWAYS AS (public.tr_fold("name")) STORED` (migration
  /// `20260819060000_search_fold`). Prisma generated kolonu bilmez; `dbgenerated()`
  /// olmadan `migrate dev` her diff'te `DROP DEFAULT` üretir (ölçüldü).
  /// ⚠️ Yazma yolları bu alanı GÖNDEREMEZ — `sanitizeWriteData` dbgenerated
  /// alanları düşürür; PG de reddeder. `sortBy`/`filter` yüzeyine de KAPALIDIR.
  /// ⚠️ Kolonun tipini/collation'ını değiştirmek isteyen ÖNCE bunu DROP etmeli.
  nameFold  String?  @default(dbgenerated())

  // ── KAYIT KÜNYESİ (2026-08-19) — docs/design/KAYIT-KUNYESI-TASARIM.md ──
  // Kaydın kimliğine ait KALICI gerçek: kim oluşturdu / kim son değiştirdi.
  // Audit'ten OKUNMAZ — audit 6 ayda arşivlenir, künye kaybolmamalı.
  // NULLABLE: geçmiş kayıtlarda değer yok; NOT NULL migration'ı canlıda tablo
  // yeniden yazımı demektir. Backfill audit'ten yapılır, eşleşmeyen null kalır.
  // FK index BİLİNÇLİ YOK — "kim yaptı" audit FK'sı, sorgulanmadıkça indexlenmez
  // (printedById/grantedById emsali, CLAUDE.md perf kuralı 1 istisnası).
  createdById String? @db.Uuid
  createdBy   User?   @relation("MachineCreatedBy", fields: [createdById], references: [id])
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("MachineUpdatedBy", fields: [updatedById], references: [id])

  /// AD SEDDİ (2026-08-31, BULGU-T1-007) — KAPSAMLI: makine adı İSTASYON İÇİNDE
  /// tekildir (`duplicateNameScopeField: "stationId"`), global DEĞİL. Düz
  /// `@@unique([nameFold])` yazmak "Makine 1" adını fabrikada tek bir istasyona
  /// hapsederdi; denetimin "kalan tablolara nameFold seddi ekle" tavsiyesi bu
  /// ayrımı içermiyordu. Migration: `20260831120000_namefold_sed_kalan_tablolar`.
  @@unique([stationId, nameFold])
  // Bu kolonun index'i NON-PARTIAL bir @@unique tarafından kapsanıyor ([DB-12]) —
  // ayrı @@index migration 20260905172000 ile DÜŞÜRÜLDÜ (EXPLAIN ile doğrulandı).
  @@index([nameFold])
  @@map("machines")
}

/// Sahada makinenin yanında sabit duran tablet/cihaz.
/// `deviceId` tablet ilk açılışta üretilen, AsyncStorage'da kalıcı UUID.
/// Allowlist modeli: tablet `announce` eder → PENDING → admin onaylar+atar → APPROVED.
/// `machineId` = atandığı makine (atıf + cihaz çözümü); null = atanmamış.
/// Cihaz değişmedikçe operatör değişse bile hangi makinede işlendiği bilinir.
model Device {
  id         String       @id @default(uuid()) @db.Uuid
  deviceId   String       @unique @db.VarChar(64) // Tablet local UUID
  name       String       @db.VarChar(100) // Admin'in verdiği etiket — "Tambur-1 Tablet"
  machineId  String?      @db.Uuid
  lastSeenAt DateTime?    @db.Timestamptz
  isActive   Boolean      @default(true)
  /// Allowlist durumu: PENDING (yeni, atama bekliyor) / APPROVED (onaylı + kullanır).
  status     DeviceStatus @default(PENDING)
  /// Cihaz türü: TABLET / PHONE / DESKTOP (yönetici PC'si). Sadece görsel/etiket.
  kind       DeviceKind   @default(TABLET)

  // Relations
  machine       Machine?           @relation(fields: [machineId], references: [id])
  peripherals   PeripheralDevice[] // (eski) tablete-bağlı tekil sahiplik (registerBt geçişte)
  hardwareLinks DevicePeripheral[] // YENİ: cihazın kullandığı donanım (çok-çok, paylaşılabilir)
  workSessions  WorkSession[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([machineId])
  @@index([status])
  @@map("devices")
}

/// Birleşik CİHAZ KAYDI — yazıcılar (ağ/Bluetooth/USB/seri) + tekstil makine
/// sinyal kaynakları (kantar/metraj, kayıt-only). Her cihaz dilini (languageOverride;
/// boş → global `label.printerLanguage`), MEDYASINI (labelWidthMm vd.; boş → sistem
/// varsayılan medyası) ve şablon yönlendirmesini taşır →
/// baskı anında cihaz→{dil,medya,şablon} çözülür. Sahiplik tam-biri: makineye
/// SABİT (machineId) VEYA tablete-BAĞLI (deviceId, BT yazıcı tabletle gezer).
/// Saha donanımının TEK kaynağı — eski `MachineHardware` emekliye ayrıldı.
/// Okuma davranışı — cihaz VERİsi (kod değil). POLL: pollCommand yolla, cevabı oku
/// (Tambur metresi "TTTTTT" → metraj). STREAM: cihaz sürekli yayınlar; dinle, son
/// (kararlı) çerçeveyi al (Sevkiyat kantarı sürekli kg akıtır). Yeni davranışlı
/// cihaz = yeni satır + bu alan; uygulama kodu değişmez.
enum PeripheralReadMode {
  POLL
  STREAM
}

model PeripheralDevice {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(48)
  name String @db.VarChar(100)

  kind           PeripheralKind
  connectionType ConnectionType

  address         String? @db.VarChar(128) // IP / MAC / COM yolu / BLE UUID
  port            Int? // NETWORK_TCP (null → 9100 kullanımda)
  identifyPattern String? @db.VarChar(255) // SCALE/METER veri çözüm regex'i

  // --- Giriş cihazı (SCALE/METER) okuma protokolü — davranış tamamen VERİ ---
  readMode    PeripheralReadMode @default(POLL) // POLL=sor-cevap (komut yolla), STREAM=sürekli yayın (dinle)
  pollCommand String?            @db.VarChar(64) // POLL sorgu komutu; escape destekli (\r \n \xNN), TAM gönderilir
  terminator  String?            @db.VarChar(8) // Yanıt satır sonu (örn "\r\n"); boş → herhangi CR/LF
  decimals    Int? // Codec yuvarlama hassasiyeti (boş → 1)
  scale       Decimal?           @db.Decimal(10, 4) // Ham → mühendislik çarpanı (cm→m: 0.01); boş → 1
  unit        String?            @db.VarChar(8) // "m" / "kg"
  timeoutMs   Int? // Okuma zaman aşımı ms (boş → 2500)
  role        String?            @db.VarChar(24) // Makine içi ayraç: "2-KAT" / "4-KAT" / "PRIMARY"
  simulate    Boolean            @default(false) // Per-cihaz simülasyon (gerçek I/O yerine sahte değer)

  // Sahiplik — tam biri (serviste enforce edilir).
  machineId String?  @db.Uuid
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  deviceId  String?  @db.Uuid
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// MAKİNESİZ istasyona sabit donanım (örn. sevkiyat çuval kantarı). Yalnız makinesi
  /// olmayan istasyona bağlanabilir (serviste enforce) — makineli istasyonda donanım
  /// MAKİNEYE bağlanmalı (yan yana özdeş HC-06 belirsizliğinin tek çözümü makine bağı).
  stationId String?  @db.Uuid
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  // Yazıcı MEDYASI — takılı etiket ölçüsü DOĞRUDAN cihazda (Etiket Stüdyosu v2:
  // ayrı LabelFormatProfile "Boyutlar" kataloğu EMEKLİ; baskıda medya buradan,
  // eleman koordinatları varyanttan). Boş → sistem varsayılan medyası (ayar).
  labelWidthMm  Decimal? @db.Decimal(6, 2)
  labelHeightMm Decimal? @db.Decimal(6, 2)
  labelDpi      Int? // boş → 203
  labelGapMm    Decimal? @db.Decimal(5, 2) // etiketler arası (gap sensörü); boş → 2

  languageOverride PrinterLanguage? // cihaz dili (boş → global ayar label.printerLanguage)
  mediaType        PrinterMediaType? // baskı yöntemi (boş → yazıcı otomatik; PPLA/ZPL'de komuta çevrilir)
  /// Raster baskı: kanvas-varyantlı etiket 1bpp bitmap (raster) olarak gönderilir
  /// (önizleme=baskı birebir); false = bugünkü komut üretimi (bayt-aynı). Cihaz-başına
  /// opt-in; PPLA'da grafik komutu (F0) doğrulanana dek açılsa bile komuta düşer.
  rasterMode       Boolean           @default(false)

  isActive   Boolean   @default(true)
  /// KALICI silinme damgası (users.deletedAt kalıbı) — NULL=normal (isActive ile
  /// aktif/pasif); dolu=silinmiş: hiçbir listede görünmez, düzenlenemez/geri
  /// getirilemez; satır yalnız veri bütünlüğü için durur (kod DEL- önekiyle serbest).
  deletedAt  DateTime? @db.Timestamptz
  lastSeenAt DateTime? @db.Timestamptz
  notes      String?   @db.VarChar(500)

  templateRoutes PeripheralTemplateRoute[]
  deviceLinks    DevicePeripheral[] // YENİ: bu donanımı kullanan cihaz(lar) (çok-çok)

  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ.
  /// `GENERATED ALWAYS AS (public.tr_fold("name")) STORED` (migration
  /// `20260819060000_search_fold`). Prisma generated kolonu bilmez; `dbgenerated()`
  /// olmadan `migrate dev` her diff'te `DROP DEFAULT` üretir (ölçüldü).
  /// ⚠️ Yazma yolları bu alanı GÖNDEREMEZ — `sanitizeWriteData` dbgenerated
  /// alanları düşürür; PG de reddeder. `sortBy`/`filter` yüzeyine de KAPALIDIR.
  /// ⚠️ Kolonun tipini/collation'ını değiştirmek isteyen ÖNCE bunu DROP etmeli.
  nameFold    String?  @default(dbgenerated())
  /// KATLANMIŞ ARAMA GÖLGESİ — DEĞERİ DB ÜRETİR, UYGULAMA HİÇ YAZMAZ.
  /// `GENERATED ALWAYS AS (public.tr_fold("address")) STORED` (migration
  /// `20260819060000_search_fold`). Prisma generated kolonu bilmez; `dbgenerated()`
  /// olmadan `migrate dev` her diff'te `DROP DEFAULT` üretir (ölçüldü).
  /// ⚠️ Yazma yolları bu alanı GÖNDEREMEZ — `sanitizeWriteData` dbgenerated
  /// alanları düşürür; PG de reddeder. `sortBy`/`filter` yüzeyine de KAPALIDIR.
  /// ⚠️ Kolonun tipini/collation'ını değiştirmek isteyen ÖNCE bunu DROP etmeli.
  addressFold String?  @default(dbgenerated())

  // ── KAYIT KÜNYESİ (2026-08-19) — docs/design/KAYIT-KUNYESI-TASARIM.md ──
  // Kaydın kimliğine ait KALICI gerçek: kim oluşturdu / kim son değiştirdi.
  // Audit'ten OKUNMAZ — audit 6 ayda arşivlenir, künye kaybolmamalı.
  // NULLABLE: geçmiş kayıtlarda değer yok; NOT NULL migration'ı canlıda tablo
  // yeniden yazımı demektir. Backfill audit'ten yapılır, eşleşmeyen null kalır.
  // FK index BİLİNÇLİ YOK — "kim yaptı" audit FK'sı, sorgulanmadıkça indexlenmez
  // (printedById/grantedById emsali, CLAUDE.md perf kuralı 1 istisnası).
  createdById String? @db.Uuid
  createdBy   User?   @relation("PeripheralDeviceCreatedBy", fields: [createdById], references: [id])
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("PeripheralDeviceUpdatedBy", fields: [updatedById], references: [id])

  /// AD SEDDİ (2026-08-31, BULGU-T1-007). Uygulama guard'ı
  /// (`assertNameNotDuplicate`) kilitsiz check-then-act'tir: iki eşzamanlı istek
  /// aynı adı yazabilir. Kullanıcıya Türkçe 409'u guard verir; bu index onun
  /// kapatamadığı yarış/ham-SQL/içe-aktarım yollarına karşı SESSİZ SON HATTIR.
  /// Migration: `20260831120000_namefold_sed_kalan_tablolar` (YUMUŞAK KAPI).
  @@unique([nameFold])
  @@index([machineId])
  @@index([deviceId])
  @@index([stationId])
  @@index([connectionType])
  @@index([isActive])
  // Bu kolonun index'i NON-PARTIAL bir @@unique tarafından kapsanıyor ([DB-12]) —
  // ayrı @@index migration 20260905172000 ile DÜŞÜRÜLDÜ (EXPLAIN ile doğrulandı).
  @@index([addressFold])
  @@map("peripheral_devices")
}

/// Cihaz ↔ donanım atama (ÇOK-ÇOK). Bir cihaz birçok donanım kullanır; bir donanım
/// (ör. ağ yazıcısı) birçok cihaza atanabilir — PAYLAŞIM. Admin manuel yönetir.
/// (BT okuyucu/kantar fiziksel olarak tek host'a bağlanır; model paylaşıma izin verir,
/// doğru atama yöneticinin sorumluluğudur.)
model DevicePeripheral {
  id           String           @id @default(uuid()) @db.Uuid
  deviceId     String           @db.Uuid
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([deviceId, peripheralId])
  @@index([peripheralId])
  @@map("device_peripherals")
}

/// Cihaz başına LabelKind → şablon yönlendirme. JSON yerine indekslenebilir +
/// FK-bütünlüklü child tablo. (peripheralId, kind) tekil.
model PeripheralTemplateRoute {
  id           String           @id @default(uuid()) @db.Uuid
  peripheralId String           @db.Uuid
  peripheral   PeripheralDevice @relation(fields: [peripheralId], references: [id], onDelete: Cascade)
  kind         LabelKind
  templateId   String           @db.Uuid
  template     LabelTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([peripheralId, kind])
  @@index([templateId])
  @@map("peripheral_template_routes")
}

/// Tablet allowlist durumu — PairingCode (6-haneli kod) emekliye ayrıldı; cihaz
/// kimliği artık `Device.status` (announce → PENDING → admin onayı → APPROVED).
enum DeviceStatus {
  PENDING
  APPROVED
}

/// Çalışma oturumunun kapanış nedeni. Açık oturumda (endedAt null) NULL kalır;
/// kapatan HER yol set eder (servis tek geçit).
enum WorkSessionEndReason {
  LOGOUT // Kullanıcı çıkışı / mobil "oturumu kapat"
  NEW_LOGIN // Aynı cihazda yeni oturum açıldı (vardiya değişimi)
  TAKEOVER // Başka cihaz aynı makineyi devraldı
  IDLE // Hareketsizlik zaman aşımı (tembel kapatma — workSession.idleTimeoutMinutes)
  ADMIN // Panelden zorla kapatıldı
}

/// ÇALIŞMA OTURUMU (ayak izi): KİM (userId) HANGİ CİHAZLA (deviceId) NEREDE
/// (machineId/stationId) NE ZAMAN (startedAt–endedAt) çalıştı. Donanım çözümü
/// (for-session) ve üretim atfı (RollOperation.machineId vb.) AKTİF oturumdan okunur.
/// stationId HER ZAMAN dolu: makineli oturumda server makineden türetip DONDURUR
/// (makine sonradan istasyon değiştirse geçmiş bozulmaz — denormalize bilinçli);
/// makinesiz istasyon oturumunda (SHIPPING) machineId null kalır.
model WorkSession {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  /// FK devices.id (PK, UUID) — tabletin local kimliği (devices.deviceId) DEĞİL.
  deviceId  String  @db.Uuid
  machineId String? @db.Uuid
  stationId String  @db.Uuid

  startedAt      DateTime              @default(now()) @db.Timestamptz
  endedAt        DateTime?             @db.Timestamptz
  endReason      WorkSessionEndReason?
  /// Son aktivite — device.middleware'in lastSeenAt throttle'ına piggyback (60sn'de
  /// bir fire-and-forget). Tembel idle kapatma (resolveActiveSession) bunun eskiliğine bakar.
  lastActivityAt DateTime              @default(now()) @db.Timestamptz

  // Ayak izi tarihçesi korunur — hiçbir taraf silinirken oturum geçmişi kaybolmaz/boşalmaz.
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)
  station Station  @relation(fields: [stationId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId, startedAt])
  @@index([machineId, startedAt])
  @@index([stationId, startedAt])
  @@index([deviceId, startedAt])
  // Aktif oturum filtreleri (endedAt IS NULL) — canlı panel + resolveActiveSession
  @@index([endedAt])
  // DB'de ayrıca ŞEMA-DIŞI iki partial unique var (migration 20260702121000):
  //   work_sessions_active_machine_uq (machineId) WHERE "endedAt" IS NULL AND "machineId" IS NOT NULL
  //   work_sessions_active_device_uq  (deviceId)  WHERE "endedAt" IS NULL
  // "Bir makinede tek aktif oturum + bir cihazda tek aktif oturum" invariant'ının DB
  // seddi — eşzamanlı open yarışının kaybedeni P2002 alır (servis 409'a çevirir).
  // Partial UNIQUE @@index ile ifade edilemediğinden şemada karşılığı bilinçli YOK
  // (roll_movements_one_open_per_roll_step_uq emsali).
  @@map("work_sessions")
}

model Route {
  id          String  @id @default(uuid()) @db.Uuid
  code        String? @unique @db.VarChar(32) // Opsiyonel kısa kod: "BKT-STD"
  name        String  @db.VarChar(100) // e.g. "Boyahane + Kursun + Tambur"
  description String?
  isFavorite  Boolean @default(false) // Sık kullanılan şablon
  customerId  String? @db.Uuid // Müşteriye özel default rota (opsiyonel)
  isActive    Boolean @default(true)

  // Relations
  customer       Customer?       @relation("CustomerDefaultRoutes", fields: [customerId], references: [id])
  steps          RouteStep[]
  workOrders     WorkOrder[] // Bu şablondan türetilen WO'lar (analytics)
  productRecipes ProductRecipe[] // Bu rotayı kullanan üretim reçeteleri

