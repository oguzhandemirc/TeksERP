  mergedBy       User?      @relation("CustomerMergedBy", fields: [mergedById], references: [id])

  cariAccount CariAccount?

  // @@unique (index DEĞİL): DB'de PARTIAL UNIQUE (WHERE "mergedIntoId" IS NULL) — ad mükerreri
