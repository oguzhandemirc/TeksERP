# TeksERP korumalı Linux kurulumu — ortam şablonu. Kopyala: cp .env.ornek .env && chmod 600 .env
# Sırlar ÜRETİLİR, elle uydurulmaz (runbook §2):
#   openssl rand -hex 24   → POSTGRES_PASSWORD
#   openssl rand -hex 48   → JWT_SECRET
# Bu dosya ve .env repoya, sürüm notuna, destek talebine GİRMEZ.

# docker load çıktısındaki etiket (PAKET künyesindeki imaj etiketiyle AYNI olmalı)
TEKSERP_IMAJ=tekserp-korumali:SURUM
POSTGRES_USER=tekserp
POSTGRES_DB=tekserp
POSTGRES_PASSWORD=
JWT_SECRET=
# 127.0.0.1 KALIR: 4000 şifresizdir ve Docker yayını ufw'yi atlar; ağdan erişim yalnız TLS vekiliyle (runbook §7).
TEKSERP_DINLE=127.0.0.1
TEKSERP_PORT=4000
# Panel/tablet sunucu listesinde görünen ad (harf, rakam, boşluk, . _ -; en çok 63). Boş = konteyner
# kimliği (her yeniden yaratılışta değişir; yalnız görüntüdür, eşleşme kurulum kimliğiyle yapılır).
TEKSERP_SUNUCU_ADI=
# Gece yedeği (Europe/Istanbul). Şifreleme: yedek_anahtar biriminde *.tkpub alıcısı (runbook §4).
YEDEK_SAAT=03:00
YEDEK_SAKLAMA_GUN=30
YEDEK_EN_AZ=3
# Satıcı lisans sunucusu kökü. BOŞ = üretim lisans sunucusu (https://lisans.etkiliyazilim.com);
# `kapali` = dışarı hiç çıkılmaz. Etkinleştirilmemiş kurulum her durumda dışarı istek atmaz.
LICENSE_SERVER_URL=
# Vekil (nginx/Cloudflare) arkası — runbook §7. Boş = vekil yok (bugünkü davranış).
# Önünde TEK vekil varsa TRUST_PROXY=1 ve RATE_LIMIT_ENABLED=true; TRUST_PROXY=1 yalnız
# TEKSERP_DINLE=127.0.0.1 iken güvenlidir. TRUST_PROXY=true YAZMAYIN (sahte adresle kilit atlanır).
TRUST_PROXY=
RATE_LIMIT_ENABLED=
